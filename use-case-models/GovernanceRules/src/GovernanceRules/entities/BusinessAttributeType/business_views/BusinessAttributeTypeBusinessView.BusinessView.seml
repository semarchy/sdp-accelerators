# BusinessAttributeTypeBusinessView: business view on BusinessAttributeType of the GovernanceRules accelerator.
_package: GovernanceRules.entities.BusinessAttributeType.business_views
_type: BusinessView
_name: BusinessAttributeTypeBusinessView
entity: GovernanceRules.entities.BusinessAttributeType.BusinessAttributeType
rootLabel: Attribute types
rootPluralLabel: Attribute types
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: BusinessAttributeType
  entity: GovernanceRules.entities.BusinessAttributeType.BusinessAttributeType
  actionSet: GovernanceRules.entities.BusinessAttributeType.action_sets.BusinessAttributeTypeActionSet
  collection: GovernanceRules.entities.BusinessAttributeType.collection_views.BusinessAttributeTypeCollectionView
  form: GovernanceRules.entities.BusinessAttributeType.forms.BusinessAttributeTypeForm
  displayCard: GovernanceRules.entities.BusinessAttributeType.display_cards.BusinessAttributeTypeDisplayCard
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: CustomFormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: CUSTOM_FORM
      customForm: GovernanceRules.entities.BusinessAttributeType.search_forms.BusinessAttributeTypeSearchForm
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: true
  sortExpression: Name asc
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: false
  transitions:
    - _type: BusinessViewTransition
      _name: RuleScopesTab
      label: Rules scoped to this attribute type
      pluralLabel: Rules scoped to this attribute type
      useCustomLabel: true
      transitionPath: RuleScopes
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: LABEL
      displayTransitionNodeAs: LABEL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: BusinessAttributeTypeRuleScopes
        entity: GovernanceRules.entities.RuleScope.RuleScope
        actionSet: GovernanceRules.entities.RuleScope.action_sets.RuleScopeActionSet
        collection: GovernanceRules.entities.RuleScope.collection_views.RuleScopeByAttributeTypeCollectionView
        form: GovernanceRules.entities.RuleScope.forms.RuleScopeForm
        displayCard: GovernanceRules.entities.RuleScope.display_cards.RuleScopeDisplayCard
        outlineVisible: false
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        overrideDefaultSort: true
        sortExpression: ID asc
        listAllowed: true
        tableAllowed: true
        gridAllowed: false
        businessEntitySearchConfigs:
          - _name: TextConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: TEXT
enableHierarchyView: false
useHierarchyOnOpen: false
