# BusinessAttributeTypeActionSet: action set on BusinessAttributeType of the GovernanceRules accelerator.
_package: GovernanceRules.entities.BusinessAttributeType.action_sets
_type: ActionSet
_name: BusinessAttributeTypeActionSet
entity: GovernanceRules.entities.BusinessAttributeType.BusinessAttributeType
label: Attribute type
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorBusinessAttributeTypes
    label: Create
    useCustomLabel: true
    stepper: GovernanceRules.entities.BusinessAttributeType.steppers.AuthorBusinessAttributeTypes
    createMultiple: false
    createdRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: EditAction
    _name: EditAuthorBusinessAttributeTypes
    label: Edit
    useCustomLabel: true
    stepper: GovernanceRules.entities.BusinessAttributeType.steppers.AuthorBusinessAttributeTypes
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorBusinessAttributeTypes
    label: Mass update
    useCustomLabel: true
    stepper: GovernanceRules.entities.BusinessAttributeType.steppers.AuthorBusinessAttributeTypes
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorBusinessAttributeTypes
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: GovernanceRules.entities.BusinessAttributeType.steppers.AuthorBusinessAttributeTypes
    importedRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse graph
    useCustomLabel: true
    waitDialogEnabled: false
