# GovernancePolicyActionSet: action set on GovernancePolicy of the GovernanceRules accelerator.
_package: GovernanceRules.entities.GovernancePolicy.action_sets
_type: ActionSet
_name: GovernancePolicyActionSet
entity: GovernanceRules.entities.GovernancePolicy.GovernancePolicy
label: Policy
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorGovernancePolicies
    label: Create
    useCustomLabel: true
    stepper: GovernanceRules.entities.GovernancePolicy.steppers.AuthorGovernancePolicies
    createMultiple: false
    createdRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: EditAction
    _name: EditAuthorGovernancePolicies
    label: Edit
    useCustomLabel: true
    stepper: GovernanceRules.entities.GovernancePolicy.steppers.AuthorGovernancePolicies
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorGovernancePolicies
    label: Mass update
    useCustomLabel: true
    stepper: GovernanceRules.entities.GovernancePolicy.steppers.AuthorGovernancePolicies
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorGovernancePolicies
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: GovernanceRules.entities.GovernancePolicy.steppers.AuthorGovernancePolicies
    importedRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse graph
    useCustomLabel: true
    waitDialogEnabled: false
