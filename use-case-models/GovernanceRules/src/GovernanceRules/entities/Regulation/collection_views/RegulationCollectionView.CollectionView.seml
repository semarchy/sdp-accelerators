# RegulationCollectionView: collection view on Regulation of the GovernanceRules accelerator.
_package: GovernanceRules.entities.Regulation.collection_views
_type: CollectionView
_name: RegulationCollectionView
description: 'Default list of regulations and standards, with their type, issuer, jurisdiction and URL.'
entity: GovernanceRules.entities.Regulation.Regulation
default: true
displayCard: GovernanceRules.entities.Regulation.display_cards.RegulationDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: '1:1'
gridTileLines: 2
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Regulation or standard
tableRowLines: 2
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: Code
    value: Code
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: Type
    value: Type
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayFormat: label
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Jurisdiction
    value: Jurisdiction
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: URL
    value: URL
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: Name
    value: Name
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: Issuer
    value: Issuer
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: Description
    value: Description
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
