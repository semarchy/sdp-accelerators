# AuthorRegulations: stepper on Regulation of the GovernanceRules accelerator.
_package: GovernanceRules.entities.Regulation.steppers
_type: Stepper
_name: AuthorRegulations
description: 'Creates and edits regulations and standards (Create, Edit, Mass update and Import actions). Used by the governance steward, without workflow.'
entity: GovernanceRules.entities.Regulation.Regulation
label: Enter regulations and standards
rootStep:
  _type: CollectionStep
  _name: Regulations
  label: Regulations and standards
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: GovernanceRules.entities.Regulation.collection_views.RegulationCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Regulation
      label: Regulation or standard
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: GovernanceRules.entities.Regulation.forms.RegulationForm.Regulation
