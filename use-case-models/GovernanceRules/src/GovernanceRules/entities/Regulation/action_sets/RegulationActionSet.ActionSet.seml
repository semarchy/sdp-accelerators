# RegulationActionSet: action set on Regulation of the GovernanceRules accelerator.
_package: GovernanceRules.entities.Regulation.action_sets
_type: ActionSet
_name: RegulationActionSet
entity: GovernanceRules.entities.Regulation.Regulation
label: Regulation or standard
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorRegulations
    label: Create
    useCustomLabel: true
    stepper: GovernanceRules.entities.Regulation.steppers.AuthorRegulations
    createMultiple: false
    createdRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: EditAction
    _name: EditAuthorRegulations
    label: Edit
    useCustomLabel: true
    stepper: GovernanceRules.entities.Regulation.steppers.AuthorRegulations
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorRegulations
    label: Mass update
    useCustomLabel: true
    stepper: GovernanceRules.entities.Regulation.steppers.AuthorRegulations
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorRegulations
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: GovernanceRules.entities.Regulation.steppers.AuthorRegulations
    importedRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse graph
    useCustomLabel: true
    waitDialogEnabled: false
