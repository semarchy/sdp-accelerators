# RegulationBusinessView: business view on Regulation of the GovernanceRules accelerator.
_package: GovernanceRules.entities.Regulation.business_views
_type: BusinessView
_name: RegulationBusinessView
entity: GovernanceRules.entities.Regulation.Regulation
rootLabel: Regulations and standards
rootPluralLabel: Regulations and standards
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Regulation
  entity: GovernanceRules.entities.Regulation.Regulation
  actionSet: GovernanceRules.entities.Regulation.action_sets.RegulationActionSet
  collection: GovernanceRules.entities.Regulation.collection_views.RegulationCollectionView
  form: GovernanceRules.entities.Regulation.forms.RegulationForm
  displayCard: GovernanceRules.entities.Regulation.display_cards.RegulationDisplayCard
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: CustomFormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: CUSTOM_FORM
      customForm: GovernanceRules.entities.Regulation.search_forms.RegulationSearchForm
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: true
  sortExpression: Name asc
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: false
  transitions:
    - _type: BusinessViewTransition
      _name: AttributeTypesTab
      label: Attribute types
      pluralLabel: Attribute types
      useCustomLabel: true
      transitionPath: AttributeTypes
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: LABEL
      displayTransitionNodeAs: LABEL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: RegulationAttributeTypes
        entity: GovernanceRules.entities.BusinessAttributeType.BusinessAttributeType
        actionSet: GovernanceRules.entities.BusinessAttributeType.action_sets.BusinessAttributeTypeActionSet
        collection: GovernanceRules.entities.BusinessAttributeType.collection_views.BusinessAttributeTypeByReferenceStandardCollectionView
        form: GovernanceRules.entities.BusinessAttributeType.forms.BusinessAttributeTypeForm
        displayCard: GovernanceRules.entities.BusinessAttributeType.display_cards.BusinessAttributeTypeDisplayCard
        outlineVisible: false
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        overrideDefaultSort: true
        sortExpression: Name asc
        listAllowed: true
        tableAllowed: true
        gridAllowed: false
        businessEntitySearchConfigs:
          - _name: TextConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: TEXT
    - _type: BusinessViewTransition
      _name: CitationsTab
      label: Rules citing it
      pluralLabel: Rules citing it
      useCustomLabel: true
      transitionPath: Citations
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: LABEL
      displayTransitionNodeAs: LABEL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: RegulationCitations
        entity: GovernanceRules.entities.RuleCitation.RuleCitation
        actionSet: GovernanceRules.entities.RuleCitation.action_sets.RuleCitationActionSet
        collection: GovernanceRules.entities.RuleCitation.collection_views.RuleCitationByRegulationCollectionView
        form: GovernanceRules.entities.RuleCitation.forms.RuleCitationForm
        displayCard: GovernanceRules.entities.RuleCitation.display_cards.RuleCitationDisplayCard
        outlineVisible: false
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        overrideDefaultSort: true
        sortExpression: Clause asc
        listAllowed: true
        tableAllowed: true
        gridAllowed: false
        businessEntitySearchConfigs:
          - _name: TextConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: TEXT
enableHierarchyView: false
useHierarchyOnOpen: false
