# RuleScopeActionSet: action set on RuleScope of the GovernanceRules accelerator.
_package: GovernanceRules.entities.RuleScope.action_sets
_type: ActionSet
_name: RuleScopeActionSet
entity: GovernanceRules.entities.RuleScope.RuleScope
label: Rule scope
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorRuleScopes
    label: Create
    useCustomLabel: true
    stepper: GovernanceRules.entities.RuleScope.steppers.AuthorRuleScopes
    createMultiple: false
    createdRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: EditAction
    _name: EditAuthorRuleScopes
    label: Edit
    useCustomLabel: true
    stepper: GovernanceRules.entities.RuleScope.steppers.AuthorRuleScopes
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorRuleScopes
    label: Mass update
    useCustomLabel: true
    stepper: GovernanceRules.entities.RuleScope.steppers.AuthorRuleScopes
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorRuleScopes
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: GovernanceRules.entities.RuleScope.steppers.AuthorRuleScopes
    importedRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse graph
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: CopyAction
    _name: CopyAuthorRuleScopes
    label: Copy
    useCustomLabel: true
    stepper: GovernanceRules.entities.RuleScope.steppers.AuthorRuleScopes
    multipleSelectionAllowed: true
    waitDialogEnabled: false
