# RuleScope: entity of the GovernanceRules accelerator. One applicability combination of a rule: a data domain, a data classification and an attribute type, each optional.
_package: GovernanceRules.entities.RuleScope
_type: Entity
_name: RuleScope
label: Rule scope
pluralLabel: Rule scopes
physicalTableName: GOV_RULE_SCOPE
entityType: BASIC
description: 'One applicability combination of a rule: a data domain, a data classification and an attribute type, each optional.
  An empty dimension means any. A rule applies when any of its scope rows matches.


  AI agent instructions: A scope row with no domain, no classification and no attribute type makes the rule apply everywhere.'
historizeGolden: false
historizeMaster: false
enableDelete: true
primaryKey: GovernanceRules.entities.RuleScope.RuleScope.ID
sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1
attributes:
- _type: EntityAttribute
  _name: ID
  label: ID
  physicalName: RS_ID
  dataType: LongInteger
  mandatory: false
  description: Generated identifier of the scope row.
  precision: 38
