# RuleScopeDisplayCard: display card on RuleScope of the GovernanceRules accelerator.
_package: GovernanceRules.entities.RuleScope.display_cards
_type: DisplayCard
_name: RuleScopeDisplayCard
entity: GovernanceRules.entities.RuleScope.RuleScope
default: true
primaryTextExpression: Rule.Code || ' ' || COALESCE(Rule.Title, '')
primaryImageValueInterpreter: LITERAL
avatarImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
primaryImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
secondaryTextExpression: '''Domain: '' || COALESCE(DataDomain.Name, ''any'') || '' · Classification: '' || COALESCE(DataClassification.Name, ''any'') || '' · Attribute type: '' || COALESCE(AttributeType.Name, ''any'')'
