# RuleCitationDisplayCard: display card on RuleCitation of the GovernanceRules accelerator.
_package: GovernanceRules.entities.RuleCitation.display_cards
_type: DisplayCard
_name: RuleCitationDisplayCard
entity: GovernanceRules.entities.RuleCitation.RuleCitation
default: true
