# DataDomainCollectionView: collection view on DataDomain of the GovernanceRules accelerator.
_package: GovernanceRules.entities.DataDomain.collection_views
_type: CollectionView
_name: DataDomainCollectionView
description: 'Default list of data domains.'
entity: GovernanceRules.entities.DataDomain.DataDomain
default: true
displayCard: GovernanceRules.entities.DataDomain.display_cards.DataDomainDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: '1:1'
gridTileLines: 2
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Data domain
tableRowLines: 2
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: Code
    value: Code
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: Name
    value: Name
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: Description
    value: Description
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
