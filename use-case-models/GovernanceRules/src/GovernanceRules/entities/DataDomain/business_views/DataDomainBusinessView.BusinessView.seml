# DataDomainBusinessView: business view on DataDomain of the GovernanceRules accelerator.
_package: GovernanceRules.entities.DataDomain.business_views
_type: BusinessView
_name: DataDomainBusinessView
entity: GovernanceRules.entities.DataDomain.DataDomain
rootLabel: Data domains
rootPluralLabel: Data domains
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: DataDomain
  entity: GovernanceRules.entities.DataDomain.DataDomain
  actionSet: GovernanceRules.entities.DataDomain.action_sets.DataDomainActionSet
  collection: GovernanceRules.entities.DataDomain.collection_views.DataDomainCollectionView
  form: GovernanceRules.entities.DataDomain.forms.DataDomainForm
  displayCard: GovernanceRules.entities.DataDomain.display_cards.DataDomainDisplayCard
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: CustomFormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: CUSTOM_FORM
      customForm: GovernanceRules.entities.DataDomain.search_forms.DataDomainSearchForm
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: true
  sortExpression: Name asc
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: false
  transitions:
    - _type: BusinessViewTransition
      _name: RuleScopesTab
      label: Rules scoped to this domain
      pluralLabel: Rules scoped to this domain
      useCustomLabel: true
      transitionPath: RuleScopes
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: LABEL
      displayTransitionNodeAs: LABEL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: DataDomainRuleScopes
        entity: GovernanceRules.entities.RuleScope.RuleScope
        actionSet: GovernanceRules.entities.RuleScope.action_sets.RuleScopeActionSet
        collection: GovernanceRules.entities.RuleScope.collection_views.RuleScopeByDataDomainCollectionView
        form: GovernanceRules.entities.RuleScope.forms.RuleScopeForm
        displayCard: GovernanceRules.entities.RuleScope.display_cards.RuleScopeDisplayCard
        outlineVisible: false
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        overrideDefaultSort: true
        sortExpression: ID asc
        listAllowed: true
        tableAllowed: true
        gridAllowed: false
        businessEntitySearchConfigs:
          - _name: TextConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: TEXT
enableHierarchyView: false
useHierarchyOnOpen: false
