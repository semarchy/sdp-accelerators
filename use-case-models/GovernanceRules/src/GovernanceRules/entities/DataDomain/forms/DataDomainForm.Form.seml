# DataDomainForm: Form on DataDomain of the GovernanceRules accelerator.
_package: GovernanceRules.entities.DataDomain.forms
_type: Form
_name: DataDomainForm
entity: GovernanceRules.entities.DataDomain.DataDomain
default: true
formTabs:
  - _type: FormTab
    _name: DataDomain
    label: Data domain
    documentationInterpreter: LITERAL
    visibleValue: '1'
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: FormSection
        _name: Identity
        label: Identification
        layoutDirection: COLUMN
        content:
          - _type: IdField
            _name: Code
            value: Code
            useCustomLabel: false
            dataType: STRING
            helperText: Natural key of the data domain, entered by the author and never changed (for example CUSTOMER).
            helperTextValueInterpreter: LITERAL
          - _type: TextField
            _name: Name
            value: Name
            useCustomLabel: false
            dataType: STRING
            helperText: Name of the domain.
            helperTextValueInterpreter: LITERAL
          - _type: TextField
            _name: Description
            value: Description
            useCustomLabel: false
            dataType: STRING
            helperText: What the domain covers.
            helperTextValueInterpreter: LITERAL
