# DataDomainActionSet: action set on DataDomain of the GovernanceRules accelerator.
_package: GovernanceRules.entities.DataDomain.action_sets
_type: ActionSet
_name: DataDomainActionSet
entity: GovernanceRules.entities.DataDomain.DataDomain
label: Data domain
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorDataDomains
    label: Create
    useCustomLabel: true
    stepper: GovernanceRules.entities.DataDomain.steppers.AuthorDataDomains
    createMultiple: false
    createdRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: EditAction
    _name: EditAuthorDataDomains
    label: Edit
    useCustomLabel: true
    stepper: GovernanceRules.entities.DataDomain.steppers.AuthorDataDomains
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorDataDomains
    label: Mass update
    useCustomLabel: true
    stepper: GovernanceRules.entities.DataDomain.steppers.AuthorDataDomains
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorDataDomains
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: GovernanceRules.entities.DataDomain.steppers.AuthorDataDomains
    importedRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse graph
    useCustomLabel: true
    waitDialogEnabled: false
