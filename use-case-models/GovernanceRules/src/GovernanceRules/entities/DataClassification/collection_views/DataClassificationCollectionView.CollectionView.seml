# DataClassificationCollectionView: collection view on DataClassification of the GovernanceRules accelerator.
_package: GovernanceRules.entities.DataClassification.collection_views
_type: CollectionView
_name: DataClassificationCollectionView
description: 'Default list of data classifications, with their sensitivity rank.'
entity: GovernanceRules.entities.DataClassification.DataClassification
default: true
displayCard: GovernanceRules.entities.DataClassification.display_cards.DataClassificationDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: '1:1'
gridTileLines: 2
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Data classification
tableRowLines: 2
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: Code
    value: Code
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: SensitivityRank
    value: SensitivityRank
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: true
  - _type: TextColumn
    _name: Name
    value: Name
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: Description
    value: Description
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
