label: Enter data classifications
rootStep:
  _type: CollectionStep
  _name: DataClassifications
  label: Data classifications
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
