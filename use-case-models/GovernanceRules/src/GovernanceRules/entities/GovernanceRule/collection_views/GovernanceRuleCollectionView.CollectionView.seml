# GovernanceRuleCollectionView: collection view on GovernanceRule of the GovernanceRules accelerator.
_package: GovernanceRules.entities.GovernanceRule.collection_views
_type: CollectionView
_name: GovernanceRuleCollectionView
description: 'Default list of governance rules, with their status, dates, text, classification, implementation and in-force flag. Also used by the rule steppers and by My tasks in the Rule review workflow.'
entity: GovernanceRules.entities.GovernanceRule.GovernanceRule
default: true
displayCard: GovernanceRules.entities.GovernanceRule.display_cards.GovernanceRuleDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: '1:1'
gridTileLines: 2
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Governance rule
tableRowLines: 2
tableShowDisplayCard: true
tableColumns:
