# GovernanceRuleRetiredBusinessView: business view on GovernanceRule of the GovernanceRules accelerator.
_package: GovernanceRules.entities.GovernanceRule.business_views
_type: BusinessView
_name: GovernanceRuleRetiredBusinessView
entity: GovernanceRules.entities.GovernanceRule.GovernanceRule
rootLabel: Retired rules
rootPluralLabel: Retired rules
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: GovernanceRule
  entity: GovernanceRules.entities.GovernanceRule.GovernanceRule
  actionSet: GovernanceRules.entities.GovernanceRule.action_sets.GovernanceRuleActionSet
