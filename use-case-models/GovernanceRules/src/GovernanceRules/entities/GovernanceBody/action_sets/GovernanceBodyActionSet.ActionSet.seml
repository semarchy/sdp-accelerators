# GovernanceBodyActionSet: action set on GovernanceBody of the GovernanceRules accelerator.
_package: GovernanceRules.entities.GovernanceBody.action_sets
_type: ActionSet
_name: GovernanceBodyActionSet
entity: GovernanceRules.entities.GovernanceBody.GovernanceBody
label: Governance body
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorGovernanceBodies
    label: Create
    useCustomLabel: true
    stepper: GovernanceRules.entities.GovernanceBody.steppers.AuthorGovernanceBodies
    createMultiple: false
    createdRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: EditAction
    _name: EditAuthorGovernanceBodies
    label: Edit
    useCustomLabel: true
    stepper: GovernanceRules.entities.GovernanceBody.steppers.AuthorGovernanceBodies
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorGovernanceBodies
    label: Mass update
    useCustomLabel: true
    stepper: GovernanceRules.entities.GovernanceBody.steppers.AuthorGovernanceBodies
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorGovernanceBodies
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: GovernanceRules.entities.GovernanceBody.steppers.AuthorGovernanceBodies
    importedRecordType: GOLDEN
    allowOtherPublishers: true
    waitDialogEnabled: false
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse graph
    useCustomLabel: true
    waitDialogEnabled: false
