# GovernanceBodyCollectionView: collection view on GovernanceBody of the GovernanceRules accelerator.
_package: GovernanceRules.entities.GovernanceBody.collection_views
_type: CollectionView
_name: GovernanceBodyCollectionView
description: 'Default list of governance bodies, with their type and contact email.'
entity: GovernanceRules.entities.GovernanceBody.GovernanceBody
default: true
displayCard: GovernanceRules.entities.GovernanceBody.display_cards.GovernanceBodyDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: '1:1'
gridTileLines: 2
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Governance body
tableRowLines: 2
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: Code
    value: Code
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: Type
    value: Type
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayFormat: label
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Name
    value: Name
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: ContactEmail
    value: ContactEmail
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: Description
    value: Description
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
