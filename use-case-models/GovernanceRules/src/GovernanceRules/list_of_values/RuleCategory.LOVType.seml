# RuleCategory: list of values of the GovernanceRules accelerator. Topic of a governance rule. The rule code prefix follows the category.
_package: GovernanceRules.list_of_values
_type: LOVType
_name: RuleCategory
label: Rule category
description: 'Topic of a governance rule. The rule code prefix follows the category.'
length: 32
lovValues:
- code: DATA_QUALITY
  label: Data quality
  description: 'Completeness, validity and consistency of data (code prefix DQ-).'
- code: PRIVACY
  label: Privacy
  description: 'Protection of personal data and data subject rights (code prefix PRIV-).'
- code: SECURITY_ACCESS
  label: Security and access
  description: 'Access control, need to know and protection of sensitive data (code prefix SEC-).'
- code: RETENTION
  label: Retention
  description: 'How long data and its history are kept, and how they are purged (code prefix RET-).'
- code: REFERENCE_DATA
  label: Reference data
  description: 'Use of managed reference data and code standards (code prefix REF-).'
- code: IDENTITY_MATCHING
  label: Identity and matching
  description: 'Identification, matching and merging of master records (code prefix MDM-).'
- code: METADATA_DOCUMENTATION
  label: Metadata and documentation
  description: 'Documentation of models and data for people and AI agents (code prefix META-).'
- code: AI_USAGE
  label: AI usage
  description: 'Use of data by AI agents and AI features (code prefix AI-).'
- code: STEWARDSHIP
  label: Stewardship
  description: 'Ownership, review and approval of data changes (code prefix STW-).'
- code: MODELING_CONVENTIONS
  label: Modeling conventions
  description: 'Naming and modeling conventions of data products (code prefix MOD-).'
