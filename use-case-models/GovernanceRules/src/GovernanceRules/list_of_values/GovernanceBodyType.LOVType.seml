# GovernanceBodyType: list of values of the GovernanceRules accelerator. Kind of governance body that owns rules and policies.
_package: GovernanceRules.list_of_values
_type: LOVType
_name: GovernanceBodyType
label: Governance body type
description: 'Kind of governance body that owns rules and policies.'
length: 16
lovValues:
- code: COUNCIL
  label: Council
  description: 'A committee of several members that decides collectively, for example the Data Governance Council.'
- code: OFFICE
  label: Office
  description: 'A permanent organisational unit, for example the Chief Data Officer office.'
- code: ROLE
  label: Role
  description: 'A single accountable function held by one person, for example the Data Protection Officer.'
