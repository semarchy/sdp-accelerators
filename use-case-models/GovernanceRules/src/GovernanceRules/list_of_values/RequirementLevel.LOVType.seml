# RequirementLevel: list of values of the GovernanceRules accelerator. Strength of a governance rule, as defined by RFC 2119.
_package: GovernanceRules.list_of_values
_type: LOVType
_name: RequirementLevel
label: Requirement level
description: 'Strength of a governance rule, as defined by RFC 2119.'
length: 8
lovValues:
- code: MUST
  label: Must
  description: 'Mandatory: every design in scope applies the rule.'
- code: SHOULD
  label: Should
  description: 'Expected: apply the rule unless there is a valid reason, and state that reason.'
- code: MAY
  label: May
  description: 'Optional: apply the rule when it helps.'
