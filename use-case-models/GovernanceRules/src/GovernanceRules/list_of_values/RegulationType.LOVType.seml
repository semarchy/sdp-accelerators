# RegulationType: list of values of the GovernanceRules accelerator. Kind of source that a governance rule cites.
_package: GovernanceRules.list_of_values
_type: LOVType
_name: RegulationType
label: Regulation type
description: 'Kind of source that a governance rule cites.'
length: 16
lovValues:
- code: REGULATION
  label: Regulation
  description: 'A law or binding regulation, for example GDPR or HIPAA.'
- code: STANDARD
  label: Standard
  description: 'A published standard, for example ISO 3166-1 or ISO 8000.'
- code: FRAMEWORK
  label: Framework
  description: 'A body of good practice that is not binding, for example DAMA-DMBOK.'
- code: INTERNAL
  label: Internal
  description: 'An internal policy or standard of the company.'
