# RuleDetail: named query of the GovernanceRules accelerator. Returns one governance rule by its code (parameter code, STRING, mandatory, for example PRIV-003), with its statement, rationale, requirement level,...
_package: GovernanceRules.named_queries
_type: NamedQuery
_name: RuleDetail
active: true
description: 'Returns one governance rule by its code (parameter code, STRING, mandatory, for example PRIV-003), with its statement, rationale,
  requirement level, category, implementation pattern and guidance, example, status, in-force flag, dates, approval, policy, owner, citations
  and scope rows.


  AI agent instructions: Use it to read a rule cited in a design or returned by RuleChecklist or ApplicableRules. Only in-force rules are visible to the agent
  role: an empty result means the code does not exist or the rule is not in force; do not cite it.'
defaultLimit: 1
rootQueryObject: GovernanceRules.named_queries.RuleDetail.Rule
filter: Code = :CODE
sort: Code
queryParameters:
- _type: QueryParameter
  _name: code
  bindingName: CODE
  dataType: STRING
  mandatory: true
queryObjects:
- _type: QueryObject
  _name: Rule
  entity: GovernanceRules.entities.GovernanceRule.GovernanceRule
  description: Governance rule with its citations and scopes.
  objectProperties:
  - _type: ObjectProperty
    _name: Code
    type: VALUE
    semQlExpression: Code
  - _type: ObjectProperty
    _name: Title
    type: VALUE
    semQlExpression: Title
  - _type: ObjectProperty
    _name: Statement
    type: VALUE
    semQlExpression: Statement
  - _type: ObjectProperty
    _name: RequirementLevel
    type: VALUE
    semQlExpression: RequirementLevel
  - _type: ObjectProperty
    _name: Category
    type: VALUE
    semQlExpression: Category
  - _type: ObjectProperty
    _name: ImplementationPattern
    type: VALUE
    semQlExpression: ImplementationPattern
  - _type: ObjectProperty
    _name: ImplementationGuidance
    type: VALUE
    semQlExpression: ImplementationGuidance
  - _type: ObjectProperty
    _name: Example
    type: VALUE
    semQlExpression: Example
  - _type: ObjectProperty
    _name: Rationale
    type: VALUE
    semQlExpression: Rationale
  - _type: ObjectProperty
    _name: LifecycleStatus
    type: VALUE
    semQlExpression: LifecycleStatus
  - _type: ObjectProperty
    _name: InForce
    type: VALUE
    semQlExpression: InForce
  - _type: ObjectProperty
    _name: EffectiveDate
    type: VALUE
    semQlExpression: EffectiveDate
  - _type: ObjectProperty
    _name: RetirementDate
    type: VALUE
    semQlExpression: RetirementDate
  - _type: ObjectProperty
    _name: ApprovedOn
    type: VALUE
    semQlExpression: ApprovedOn
  - _type: ObjectProperty
    _name: ApprovedBy
    type: VALUE
    semQlExpression: ApprovedBy
  - _type: ObjectProperty
    _name: PolicyCode
    type: VALUE
    semQlExpression: Policy.Code
  - _type: ObjectProperty
    _name: PolicyName
    type: VALUE
    semQlExpression: Policy.Name
  - _type: ObjectProperty
    _name: OwnerCode
    type: VALUE
    semQlExpression: OwnerBody.Code
  - _type: ObjectProperty
    _name: OwnerName
    type: VALUE
    semQlExpression: OwnerBody.Name
  - _type: ObjectProperty
    _name: Citations
    type: MULTI_RECORDS
    semQlExpression: Citations
    targetObject: GovernanceRules.named_queries.RuleDetail.Citation
    sort: Regulation.Code
  - _type: ObjectProperty
    _name: Scopes
    type: MULTI_RECORDS
    semQlExpression: Scopes
    targetObject: GovernanceRules.named_queries.RuleDetail.Scope
    sort: ID
- _type: QueryObject
  _name: Citation
  entity: GovernanceRules.entities.RuleCitation.RuleCitation
  description: A regulation or standard cited by the rule, with the article or clause.
  objectProperties:
  - _type: ObjectProperty
    _name: RegulationCode
    type: VALUE
    semQlExpression: Regulation.Code
  - _type: ObjectProperty
    _name: RegulationName
    type: VALUE
    semQlExpression: Regulation.Name
  - _type: ObjectProperty
    _name: RegulationType
    type: VALUE
    semQlExpression: Regulation.Type
  - _type: ObjectProperty
    _name: Clause
    type: VALUE
    semQlExpression: Clause
  - _type: ObjectProperty
    _name: Note
    type: VALUE
    semQlExpression: Note
  - _type: ObjectProperty
    _name: URL
    type: VALUE
    semQlExpression: Regulation.URL
- _type: QueryObject
  _name: Scope
  entity: GovernanceRules.entities.RuleScope.RuleScope
  description: One applicability row of the rule; an empty code means any value of that dimension.
  objectProperties:
  - _type: ObjectProperty
    _name: DataDomainCode
    type: VALUE
    semQlExpression: DataDomain.Code
  - _type: ObjectProperty
    _name: DataClassificationCode
    type: VALUE
    semQlExpression: DataClassification.Code
  - _type: ObjectProperty
    _name: AttributeTypeCode
    type: VALUE
    semQlExpression: AttributeType.Code
