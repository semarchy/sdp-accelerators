# GovernanceSteward: privilege grant of the GovernanceRules accelerator. Governance steward (rule author).
_package: GovernanceRules.privilege_grants
_type: DataProductPrivGrant
_name: GovernanceSteward
roleName: GovernanceSteward
description: Governance steward (rule author). Drafts rules with their scopes and citations, maintains the reference lists (domains, classifications,
  attribute types, regulations, governance bodies, policies) without workflow, starts the Rule review workflow and reworks rejected rules. Loads
  the initial corpus (SEED) through the REST API. Cannot delete a rule (rules are retired through the Rule review workflow).
integrationWsRole: true
allowDataQualityDocumentation: true
allowEnrichmentDocumentation: true
entityPrivGrants:
- _type: EntityPrivGrant
  _name: GovernanceRule
  entity: GovernanceRules.entities.GovernanceRule.GovernanceRule
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: GovernancePolicy
  entity: GovernanceRules.entities.GovernancePolicy.GovernancePolicy
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: RuleScope
  entity: GovernanceRules.entities.RuleScope.RuleScope
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: RuleCitation
  entity: GovernanceRules.entities.RuleCitation.RuleCitation
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: Regulation
  entity: GovernanceRules.entities.Regulation.Regulation
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: DataDomain
  entity: GovernanceRules.entities.DataDomain.DataDomain
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: DataClassification
  entity: GovernanceRules.entities.DataClassification.DataClassification
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: BusinessAttributeType
  entity: GovernanceRules.entities.BusinessAttributeType.BusinessAttributeType
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: GovernanceBody
  entity: GovernanceRules.entities.GovernanceBody.GovernanceBody
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  exportAllowed: true
