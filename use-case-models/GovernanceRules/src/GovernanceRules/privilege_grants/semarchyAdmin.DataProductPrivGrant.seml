# semarchyAdmin: privilege grant of the GovernanceRules accelerator. Platform administrator of the accelerators tenant: full data access and REST loads, so demo data can be loaded during a release.
_package: GovernanceRules.privilege_grants
_type: DataProductPrivGrant
_name: semarchyAdmin
roleName: semarchyAdmin
label: semarchy Admin
description: Platform administrator of the accelerators tenant. Data administrator in the application and full read, write, create and delete rights on every entity through the REST API, so the release process can load the demo data. Remove this grant if your platform has no such role.
dataAdminRole: true
integrationWsRole: true
allowApiPublishingAsUser: true
entityPrivGrants:
- _type: EntityPrivGrant
  _name: GovernanceRule
  entity: GovernanceRules.entities.GovernanceRule.GovernanceRule
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  deleteAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: RuleScope
  entity: GovernanceRules.entities.RuleScope.RuleScope
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  deleteAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: RuleCitation
  entity: GovernanceRules.entities.RuleCitation.RuleCitation
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  deleteAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: GovernancePolicy
  entity: GovernanceRules.entities.GovernancePolicy.GovernancePolicy
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  deleteAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: Regulation
  entity: GovernanceRules.entities.Regulation.Regulation
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  deleteAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: DataDomain
  entity: GovernanceRules.entities.DataDomain.DataDomain
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  deleteAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: DataClassification
  entity: GovernanceRules.entities.DataClassification.DataClassification
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  deleteAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: BusinessAttributeType
  entity: GovernanceRules.entities.BusinessAttributeType.BusinessAttributeType
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  deleteAllowed: true
  exportAllowed: true
- _type: EntityPrivGrant
  _name: GovernanceBody
  entity: GovernanceRules.entities.GovernanceBody.GovernanceBody
  defaultAccessType: READ_WRITE
  createAllowed: true
  checkoutAllowed: true
  removeAllowed: true
  deleteAllowed: true
  exportAllowed: true
