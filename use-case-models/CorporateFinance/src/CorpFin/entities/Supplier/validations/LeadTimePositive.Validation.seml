_package: CorpFin.entities.Supplier.validations
_name: LeadTimePositive
_type: SemQLValidation
entity: CorpFin.entities.Supplier.Supplier
label: Lead time must be positive
validationScope: PRE_CONSO
description: "Ensures supplier lead time is either blank or greater than zero before consolidation."

condition: LeadTimeDays IS NULL OR LeadTimeDays > 0
