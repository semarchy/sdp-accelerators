_package: CorpFin.entities.OrgUnitCoAAssignment.enrichers
_name: NormalizeOrgUnitCoAAssignment
_type: SemQLEnricher
entity: CorpFin.entities.OrgUnitCoAAssignment.OrgUnitCoAAssignment
label: Normalize Org Unit CoA Assignment
enricherExecutionScope: PRE_CONSO
description: "Normalizes usage scope values for organizational unit chart of accounts assignments."

semQlEnricherExpressions:
  - attributeName: NormalizedUsageScope
    expression: "RTRIM(LTRIM(UPPER(UsageScope)))"
