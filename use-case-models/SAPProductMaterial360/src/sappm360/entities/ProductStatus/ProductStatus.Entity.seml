_type: Entity
primaryKey: sappm360.entities.ProductStatus.ProductStatus.ProductStatusID
sourceIdGeneration:
  mode: SEMQL
  idExpression: ProductStatusCode
label: Product Status
documentation: Product Status reference data used by the SAP Product / Material 360 model.
description: Product Status reference data used by the SAP Product / Material 360 model.
enableDelete: true
entityType: BASIC
iconUrl: images://mdi/book-open-page-variant-outline.svg
pluralLabel: Product Statuses
