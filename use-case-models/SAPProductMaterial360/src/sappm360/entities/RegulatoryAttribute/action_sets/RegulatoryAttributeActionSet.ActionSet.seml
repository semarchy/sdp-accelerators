_name: RegulatoryAttributeActionSet
_package: sappm360.entities.RegulatoryAttribute.action_sets
_type: ActionSet
entity: sappm360.entities.RegulatoryAttribute.RegulatoryAttribute
label: Regulatory Attribute Action Set
description: Action set for managing regulatory attributes in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorRegulatoryAttributes
    label: Create
    description: Create a new Regulatory Attribute record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.RegulatoryAttribute.steppers.AuthorRegulatoryAttributes
  - _name: EditAuthorRegulatoryAttributes
    label: Edit
    description: Edit Regulatory Attribute records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.RegulatoryAttribute.steppers.AuthorRegulatoryAttributes
  - _name: MassUpdateAuthorRegulatoryAttributes
    label: Mass Update
    description: Mass update Regulatory Attribute records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.RegulatoryAttribute.steppers.AuthorRegulatoryAttributes
  - _name: Delete
    label: Delete
    description: Delete selected Regulatory Attribute records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorRegulatoryAttributes
    label: Import
    description: Import Regulatory Attribute records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.RegulatoryAttribute.steppers.RegulatoryAttributeImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
