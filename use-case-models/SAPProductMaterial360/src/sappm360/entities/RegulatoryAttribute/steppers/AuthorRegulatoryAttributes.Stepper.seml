_name: AuthorRegulatoryAttributes
_package: sappm360.entities.RegulatoryAttribute.steppers
_type: Stepper
entity: sappm360.entities.RegulatoryAttribute.RegulatoryAttribute
description: Stepper for authoring regulatory attributes.
rootStep:
  _name: RegulatoryAttributes
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: sappm360.entities.RegulatoryAttribute.collection_views.RegulatoryAttributeCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Regulatory Attributes
  description: Manage Regulatory Attribute data.
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.RegulatoryProduct.Product
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.RegulatoryCountry.Country
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.RegulatoryComplianceStatus.ComplianceStatus
  stepTriggers: []
  childSteps:
    - _name: Main
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Main
      description: Main form for Regulatory Attribute.
      formTab: sappm360.entities.RegulatoryAttribute.forms.RegulatoryAttributeDataEntryForm.Main
      formStepEnrichers: []
      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.RegulatoryAttribute.forms.RegulatoryAttributeDataEntryForm.Main.Details.DetailsContainer.Container3.FDN_Product
          referencePickerCollectionView: sappm360.entities.Product.collection_views.ProductCollection
          referencePickerSearchTypeConfigs: []
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.RegulatoryAttribute.forms.RegulatoryAttributeDataEntryForm.Main.Details.DetailsContainer.Container2.FDN_Country
          referencePickerCollectionView: sappm360.entities.Country.collection_views.CountryCollection
          referencePickerSearchTypeConfigs: []
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.RegulatoryAttribute.forms.RegulatoryAttributeDataEntryForm.Main.Details.DetailsContainer.Container3.FDN_ComplianceStatus
          referencePickerCollectionView: sappm360.entities.ComplianceStatus.collection_views.ComplianceStatusCollection
          referencePickerSearchTypeConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: sappm360.references.RegulatoryProduct.Product
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: sappm360.references.RegulatoryCountry.Country
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: sappm360.references.RegulatoryComplianceStatus.ComplianceStatus
          executedOnDataChange: false
          executedOnFormOpen: false
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.RegulatoryProduct.Product
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.RegulatoryCountry.Country
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.RegulatoryComplianceStatus.ComplianceStatus
      stepTriggers: []
label: Author Regulatory Attributes
stepperFinishValidations:
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.RegulatoryProduct.Product
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.RegulatoryCountry.Country
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.RegulatoryComplianceStatus.ComplianceStatus
triggers: []
