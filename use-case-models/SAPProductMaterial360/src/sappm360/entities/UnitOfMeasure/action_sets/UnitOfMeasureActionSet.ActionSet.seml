_name: UnitOfMeasureActionSet
_package: sappm360.entities.UnitOfMeasure.action_sets
_type: ActionSet
entity: sappm360.entities.UnitOfMeasure.UnitOfMeasure
label: Unit of Measure Action Set
description: Action set for managing units of measure in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorUnitsOfMeasure
    label: Create
    description: Create a new Unit of Measure record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.UnitOfMeasure.steppers.AuthorUnitsOfMeasure
  - _name: EditAuthorUnitsOfMeasure
    label: Edit
    description: Edit Unit of Measure records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.UnitOfMeasure.steppers.AuthorUnitsOfMeasure
  - _name: MassUpdateAuthorUnitsOfMeasure
    label: Mass Update
    description: Mass update Unit of Measure records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.UnitOfMeasure.steppers.AuthorUnitsOfMeasure
  - _name: Delete
    label: Delete
    description: Delete selected Unit of Measure records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorUnitsOfMeasure
    label: Import
    description: Import Unit of Measure records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.UnitOfMeasure.steppers.UnitOfMeasureImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
