      - _type: FormSection
        _name: Map
        label: Map
        layoutDirection: COLUMN
        documentationInterpreter: LITERAL
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: MapContainer
            layoutDirection: ROW
            content:
              - _type: FormContainer
                _name: MapColumn1
                layoutDirection: COLUMN
                content:
                  - _name: StorageLocationGoogleMap
                    label: Google Map
                    value: >-
                      '<!DOCTYPE html>
    
                      <html>
                        <head>
                          <meta charset="utf-8">
                          <script src="https://maps.googleapis.com/maps/api/js?key=INSERT_YOUR_API_KEY"></script>
                          <script>
                      var address = "' || SEM_CONCAT(' ', '1', GeoStreetNumber, GeoStreetName, GeoLocality, GeoState, GeoPostalCode, GeoCountry) || '";
                      var inputAddress = "' || SEM_CONCAT(' ', '1', InpAddressLine, InpCity, InpState, InpPostalCode, InpCountry) || '";
                      var latitudeValue = "' || COALESCE(GeoLatitude, '') || '";
                      var longitudeValue = "' || COALESCE(GeoLongitude, '') || '";
                      var title = "' || SEM_CONCAT(' - ', '1', StorageLocationName, StorageLocationCode) || '";
                      var zoom = 14;
                      var mapType = google.maps.MapTypeId.ROADMAP;
                      var map;
    
                      function initialize() {
                        var lat = parseFloat(latitudeValue);
                        var lng = parseFloat(longitudeValue);
                        if (!isNaN(lat) && !isNaN(lng)) {
                          displayMap(new google.maps.LatLng(lat, lng));
                          return;
                        }
                        var geocoder = new google.maps.Geocoder();
                        geocoder.geocode({ "address": address || inputAddress }, function(results, status) {
                          if (status == google.maps.GeocoderStatus.OK) {
                            displayMap(results[0].geometry.location);
                          }
                        });
                        window.onresize = resize;
                      }
    
                      function displayMap(latlng) {
                        var mapOptions = {
                          zoom: zoom,
                          center: latlng,
                          mapTypeId: mapType
                        };
                        map = new google.maps.Map(document.getElementById("storage_location_map_canvas"), mapOptions);
                        new google.maps.Marker({
                          map: map,
                          position: latlng,
                          opacity: 0.85,
                          title: title
                        });
                        resize();
                      }
    
                      function resize() {
                        if (!map) { return; }
                        var center = map.getCenter();
                        map.getDiv().style.height = window.innerHeight + "px";
                        map.getDiv().style.width = window.innerWidth + "px";
                        google.maps.event.trigger(map, "resize");
                        map.setCenter(center);
                      }
    
                      google.maps.event.addDomListener(window, "load", initialize);
                          </script>
                        </head>
                        <body style="margin:0px;">
                          <div id="storage_location_map_canvas" style="margin:0px;"></div>
                        </body>
                      </html>'
                    dataType: STRING
                    useCustomLabel: true
                    documentationInterpreter: LITERAL
                    visibleValue: "1"
                    visibleValueInterpreter: LITERAL
                    _type: ObjectField
                    authoringMode: auto
                    authoringModeValueInterpreter: LITERAL
                    componentProperties:
                      textTypography: body-1
