_name: StorageLocationActionSet
_package: sappm360.entities.StorageLocation.action_sets
_type: ActionSet
entity: sappm360.entities.StorageLocation.StorageLocation
label: Storage Location Action Set
description: Action set for managing storage locations in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorStorageLocations
    label: Create
    description: Create a new Storage Location record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.StorageLocation.steppers.AuthorStorageLocations
  - _name: EditAuthorStorageLocations
    label: Edit
    description: Edit Storage Location records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.StorageLocation.steppers.AuthorStorageLocations
  - _name: MassUpdateAuthorStorageLocations
    label: Mass Update
    description: Mass update Storage Location records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.StorageLocation.steppers.AuthorStorageLocations
  - _name: Delete
    label: Delete
    description: Delete selected Storage Location records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorStorageLocations
    label: Import
    description: Import Storage Location records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.StorageLocation.steppers.StorageLocationImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
