_name: AuthorProductRelationships
_package: sappm360.entities.ProductRelationship.steppers
_type: Stepper
entity: sappm360.entities.ProductRelationship.ProductRelationship
description: Stepper for authoring product relationships.
rootStep:
  _name: ProductRelationships
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: sappm360.entities.ProductRelationship.collection_views.ProductRelationshipCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Product Relationships
  description: Manage Product Relationship data.
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.RelationshipFromProduct.FromProduct
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.RelationshipToProduct.ToProduct
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.RelationshipTypeRef.RelationshipType
    - onStepExit: SKIP
      validationType: CHECK
      validator: sappm360.entities.ProductRelationship.validations.RelationshipDates
  stepTriggers: []
  childSteps:
    - _name: Main
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Main
      description: Main form for Product Relationship.
      formTab: sappm360.entities.ProductRelationship.forms.ProductRelationshipDataEntryForm.Main
      formStepEnrichers: []
      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.ProductRelationship.forms.ProductRelationshipDataEntryForm.Main.Details.DetailsContainer.Container2.FDN_FromProduct
          referencePickerCollectionView: sappm360.entities.Product.collection_views.ProductCollection
          referencePickerSearchTypeConfigs: []
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.ProductRelationship.forms.ProductRelationshipDataEntryForm.Main.Details.DetailsContainer.Container3.FDN_ToProduct
          referencePickerCollectionView: sappm360.entities.Product.collection_views.ProductCollection
          referencePickerSearchTypeConfigs: []
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.ProductRelationship.forms.ProductRelationshipDataEntryForm.Main.Details.DetailsContainer.Container2.FDN_RelationshipType
          referencePickerCollectionView: sappm360.entities.RelationshipType.collection_views.RelationshipTypeCollection
          referencePickerSearchTypeConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: sappm360.references.RelationshipFromProduct.FromProduct
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: sappm360.references.RelationshipToProduct.ToProduct
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: sappm360.references.RelationshipTypeRef.RelationshipType
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: CHECK
          validator: sappm360.entities.ProductRelationship.validations.RelationshipDates
          executedOnDataChange: false
          executedOnFormOpen: false
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.RelationshipFromProduct.FromProduct
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.RelationshipToProduct.ToProduct
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.RelationshipTypeRef.RelationshipType
        - onStepExit: SKIP
          validationType: CHECK
          validator: sappm360.entities.ProductRelationship.validations.RelationshipDates
      stepTriggers: []
label: Author Product Relationships
stepperFinishValidations:
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.RelationshipFromProduct.FromProduct
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.RelationshipToProduct.ToProduct
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.RelationshipTypeRef.RelationshipType
  - onStepperFinish: SKIP
    validationType: CHECK
    validator: sappm360.entities.ProductRelationship.validations.RelationshipDates
triggers: []
