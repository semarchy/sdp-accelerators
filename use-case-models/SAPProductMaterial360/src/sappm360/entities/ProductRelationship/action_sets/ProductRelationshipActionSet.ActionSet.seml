_name: ProductRelationshipActionSet
_package: sappm360.entities.ProductRelationship.action_sets
_type: ActionSet
entity: sappm360.entities.ProductRelationship.ProductRelationship
label: Product Relationship Action Set
description: Action set for managing product relationships in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorProductRelationships
    label: Create
    description: Create a new Product Relationship record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.ProductRelationship.steppers.AuthorProductRelationships
  - _name: EditAuthorProductRelationships
    label: Edit
    description: Edit Product Relationship records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.ProductRelationship.steppers.AuthorProductRelationships
  - _name: MassUpdateAuthorProductRelationships
    label: Mass Update
    description: Mass update Product Relationship records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.ProductRelationship.steppers.AuthorProductRelationships
  - _name: Delete
    label: Delete
    description: Delete selected Product Relationship records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorProductRelationships
    label: Import
    description: Import Product Relationship records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.ProductRelationship.steppers.ProductRelationshipImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
