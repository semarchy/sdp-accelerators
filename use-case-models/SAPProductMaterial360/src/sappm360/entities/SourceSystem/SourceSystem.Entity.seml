# Source System entity for the SAP Product / Material 360 accelerator.
_name: SourceSystem
_package: sappm360.entities.SourceSystem
_type: Entity
primaryKey: sappm360.entities.SourceSystem.SourceSystem.SourceSystemID
sourceIdGeneration:
  mode: SEMQL
  idExpression: SystemCode
label: Source System
documentation: SAP or downstream system participating in product data synchronization.
description: SAP or downstream system participating in product data synchronization.
enableDelete: true
entityType: BASIC
iconUrl: images://mdi/database-cog-outline.svg
pluralLabel: Source Systems
historizeGolden: true
historizeMaster: false
physicalTableName: SOURCE_SYSTEM
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: SourceSystemID
    physicalName: SRC_SYSTEM_ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Source System ID
    documentation: Unique identifier for the source or target system.
    description: Unique identifier for the source or target system.
    mandatory: true
    length: 128
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: SystemCode
    physicalName: SYSTEM_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: System Code
    documentation: Code that identifies the SAP or downstream system.
    description: Code that identifies the SAP or downstream system.
    mandatory: true
    length: 40
    mandatoryValidationLabel: System Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: SystemName
    physicalName: SYSTEM_NAME
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: System Name
    documentation: Business name of the system.
    description: Business name of the system.
    mandatory: true
    length: 255
    mandatoryValidationLabel: System Name is mandatory
    mandatoryValidationScope: PRE_CONSO
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: SystemType
    physicalName: SYSTEM_TYPE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: System Type
    documentation: Type such as S/4HANA, ECC, MDG, PLM, PIM, or eCommerce.
    description: Type such as S/4HANA, ECC, MDG, PLM, PIM, or eCommerce.
    mandatory: false
    length: 80
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: Landscape
    physicalName: LANDSCAPE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Landscape
    documentation: Landscape, region, or business unit where the system operates.
    description: Landscape, region, or business unit where the system operates.
    mandatory: false
    length: 80
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: Active
    physicalName: ACTIVE
    dataType: Boolean
    goldenAttribute: true
    i18ned: false
    label: Active
    documentation: Indicates whether the system is active.
    description: Indicates whether the system is active.
    mandatory: false
    length: 1
    multiValued: false
    searchable: true
    valueSeparator: ","
