    _name: PlantID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PlantID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: PlantCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PlantCode
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: PlantName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PlantName
    visibleByDefault: true
    defaultWidth: 220
