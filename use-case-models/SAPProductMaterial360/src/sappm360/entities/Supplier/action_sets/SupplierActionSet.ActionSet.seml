_name: SupplierActionSet
_package: sappm360.entities.Supplier.action_sets
_type: ActionSet
entity: sappm360.entities.Supplier.Supplier
label: Supplier Action Set
description: Action set for managing suppliers in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorSuppliers
    label: Create
    description: Create a new Supplier record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.Supplier.steppers.AuthorSuppliers
  - _name: EditAuthorSuppliers
    label: Edit
    description: Edit Supplier records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.Supplier.steppers.AuthorSuppliers
  - _name: MassUpdateAuthorSuppliers
    label: Mass Update
    description: Mass update Supplier records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.Supplier.steppers.AuthorSuppliers
  - _name: Delete
    label: Delete
    description: Delete selected Supplier records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorSuppliers
    label: Import
    description: Import Supplier records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.Supplier.steppers.SupplierImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
