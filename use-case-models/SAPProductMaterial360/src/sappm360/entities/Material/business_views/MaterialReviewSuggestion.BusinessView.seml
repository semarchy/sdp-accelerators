rootPluralLabel: SAP Material Review Suggestions
useHierarchyOnOpen: false
label: SAP Material Review Suggestion
description: Business view for reviewing duplicate materials.
rootBusinessViewEntity:
  _name: Material
  _type: BusinessViewEntity
  collection: sappm360.entities.Material.collection_views.MaterialCollection
