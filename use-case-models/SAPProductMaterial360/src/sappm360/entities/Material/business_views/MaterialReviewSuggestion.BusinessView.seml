      navigationMode: MODAL_FORM
    - formField: sappm360.entities.Material.forms.MaterialBrowsingForm.Main.Relationships.RelationshipsContainer.Container13.FDN_MaterialType
      navigationMode: MODAL_FORM
    - formField: sappm360.entities.Material.forms.MaterialBrowsingForm.Main.Relationships.RelationshipsContainer.Container20.FDN_IndustrySector
      navigationMode: MODAL_FORM
    - formField: sappm360.entities.Material.forms.MaterialBrowsingForm.Main.Relationships.RelationshipsContainer.Container12.FDN_MaterialGroup
      navigationMode: MODAL_FORM
    - formField: sappm360.entities.Material.forms.MaterialBrowsingForm.Main.Relationships.RelationshipsContainer.Container13.FDN_BaseUOM
      navigationMode: MODAL_FORM
    - formField: sappm360.entities.Material.forms.MaterialBrowsingForm.Main.Relationships.RelationshipsContainer.Container20.FDN_ProcurementType
      navigationMode: MODAL_FORM
    - formField: sappm360.entities.Material.forms.MaterialBrowsingForm.Main.Relationships.RelationshipsContainer.Container12.FDN_ValuationClass
