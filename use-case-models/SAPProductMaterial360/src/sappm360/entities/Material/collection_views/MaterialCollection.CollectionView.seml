tableRowLines: 2
tableDisplayCardColumnLabel: SAP Material
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 350
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: MaterialStatus
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: MaterialStatus
    visibleByDefault: true
    defaultWidth: 220
