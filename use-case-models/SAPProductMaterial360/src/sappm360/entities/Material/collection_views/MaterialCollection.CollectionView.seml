    _name: FDN_Product
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Product
    value: FDN_Product
    visibleByDefault: true
    referencedEntity: sappm360.entities.Product.Product
    defaultWidth: 220
  - _type: ReferenceColumn
    _name: FDN_MaterialType
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Material Type
    value: FDN_MaterialType
    visibleByDefault: true
    referencedEntity: sappm360.entities.MaterialType.MaterialType
    defaultWidth: 220
  - _type: ReferenceColumn
    _name: FDN_IndustrySector
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Industry Sector
    value: FDN_IndustrySector
    visibleByDefault: true
    referencedEntity: sappm360.entities.IndustrySector.IndustrySector
    defaultWidth: 220
  - _type: ReferenceColumn
    _name: FDN_MaterialGroup
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Material Group
    value: FDN_MaterialGroup
    visibleByDefault: true
