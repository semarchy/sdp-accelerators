_name: PlantProductActionSet
_package: sappm360.entities.PlantProduct.action_sets
_type: ActionSet
entity: sappm360.entities.PlantProduct.PlantProduct
label: Plant Product Action Set
description: Action set for managing plant products in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: StartPlantExtensionReadinessWorkflow
    _type: StartWorkflowEntityAction
    label: Start Plant Extension
    description: Start a governed workflow for extending a product to a plant.
    useCustomLabel: true
    waitDialogEnabled: false
    startEvent: sappm360.workflows.PlantExtensionReadiness.StartFromScratch
  - _name: StartSelectedPlantExtensionReadinessWorkflow
    _type: StartWorkflowEntityAction
    label: Review Selected Plant Extension
    description: Start a governed workflow for reviewing a selected plant product extension.
    useCustomLabel: true
    waitDialogEnabled: false
    startEvent: sappm360.workflows.PlantExtensionReadiness.StartFromExistingPlantProduct
  - _name: CreateAuthorPlantProducts
    label: Create
    description: Create a new Plant Product record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.PlantProduct.steppers.AuthorPlantProducts
  - _name: EditAuthorPlantProducts
    label: Edit
    description: Edit Plant Product records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.PlantProduct.steppers.AuthorPlantProducts
  - _name: MassUpdateAuthorPlantProducts
    label: Mass Update
    description: Mass update Plant Product records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.PlantProduct.steppers.AuthorPlantProducts
  - _name: Delete
    label: Delete
    description: Delete selected Plant Product records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorPlantProducts
    label: Import
    description: Import Plant Product records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.PlantProduct.steppers.PlantProductImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
