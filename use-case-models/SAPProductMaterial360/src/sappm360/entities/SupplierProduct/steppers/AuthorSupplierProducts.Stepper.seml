_name: AuthorSupplierProducts
_package: sappm360.entities.SupplierProduct.steppers
_type: Stepper
entity: sappm360.entities.SupplierProduct.SupplierProduct
description: Stepper for authoring supplier products.
rootStep:
  _name: SupplierProducts
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: sappm360.entities.SupplierProduct.collection_views.SupplierProductCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Supplier Products
  description: Manage Supplier Product data.
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.SupplierProductProduct.Product
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.SupplierProductSupplier.Supplier
  stepTriggers: []
  childSteps:
    - _name: Main
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Main
      description: Main form for Supplier Product.
      formTab: sappm360.entities.SupplierProduct.forms.SupplierProductDataEntryForm.Main
      formStepEnrichers: []
      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.SupplierProduct.forms.SupplierProductDataEntryForm.Main.Details.DetailsContainer.Container2.FDN_Product
          referencePickerCollectionView: sappm360.entities.Product.collection_views.ProductCollection
          referencePickerSearchTypeConfigs: []
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.SupplierProduct.forms.SupplierProductDataEntryForm.Main.Details.DetailsContainer.Container3.FDN_Supplier
          referencePickerCollectionView: sappm360.entities.Supplier.collection_views.SupplierCollection
          referencePickerSearchTypeConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: sappm360.references.SupplierProductProduct.Product
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: sappm360.references.SupplierProductSupplier.Supplier
          executedOnDataChange: false
          executedOnFormOpen: false
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.SupplierProductProduct.Product
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.SupplierProductSupplier.Supplier
      stepTriggers: []
label: Author Supplier Products
stepperFinishValidations:
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.SupplierProductProduct.Product
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.SupplierProductSupplier.Supplier
triggers: []
