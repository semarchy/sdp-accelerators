_package: sappm360.entities.SupplierProduct.collection_views
_name: SupplierProductCollection
_type: CollectionView
entity: sappm360.entities.SupplierProduct.SupplierProduct
default: true
displayCard: sappm360.entities.SupplierProduct.display_cards.SupplierProductDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Supplier Product
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: SupplierProductID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierProductID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: SupplierProductNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierProductNumber
    visibleByDefault: true
    defaultWidth: 220
  - _type: ReferenceColumn
    _name: FDN_Product
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Product
    value: FDN_Product
    visibleByDefault: true
    referencedEntity: sappm360.entities.Product.Product
    defaultWidth: 220
  - _type: ReferenceColumn
    _name: FDN_Supplier
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Supplier
    value: FDN_Supplier
    visibleByDefault: true
    referencedEntity: sappm360.entities.Supplier.Supplier
    defaultWidth: 220
