_name: AuthorProductSpecifications
_package: sappm360.entities.ProductSpecification.steppers
_type: Stepper
entity: sappm360.entities.ProductSpecification.ProductSpecification
description: Stepper for authoring product specifications.
rootStep:
  _name: ProductSpecifications
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: sappm360.entities.ProductSpecification.collection_views.ProductSpecificationCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Product Specifications
  description: Manage Product Specification data.
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.ProductSpecProduct.Product
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.ProductSpecUOM.UnitOfMeasure
  stepTriggers: []
  childSteps:
    - _name: Main
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Main
      description: Main form for Product Specification.
      formTab: sappm360.entities.ProductSpecification.forms.ProductSpecificationDataEntryForm.Main
      formStepEnrichers: []
      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.ProductSpecification.forms.ProductSpecificationDataEntryForm.Main.Details.DetailsContainer.Container3.FDN_Product
          referencePickerCollectionView: sappm360.entities.Product.collection_views.ProductCollection
          referencePickerSearchTypeConfigs: []
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.ProductSpecification.forms.ProductSpecificationDataEntryForm.Main.Details.DetailsContainer.Container2.FDN_UnitOfMeasure
          referencePickerCollectionView: sappm360.entities.UnitOfMeasure.collection_views.UnitOfMeasureCollection
          referencePickerSearchTypeConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: sappm360.references.ProductSpecProduct.Product
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: sappm360.references.ProductSpecUOM.UnitOfMeasure
          executedOnDataChange: false
          executedOnFormOpen: false
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.ProductSpecProduct.Product
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.ProductSpecUOM.UnitOfMeasure
      stepTriggers: []
label: Author Product Specifications
stepperFinishValidations:
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.ProductSpecProduct.Product
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.ProductSpecUOM.UnitOfMeasure
triggers: []
