_name: ClassificationSchemeActionSet
_package: sappm360.entities.ClassificationScheme.action_sets
_type: ActionSet
entity: sappm360.entities.ClassificationScheme.ClassificationScheme
label: Classification Scheme Action Set
description: Action set for managing classification schemes in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorClassificationSchemes
    label: Create
    description: Create a new Classification Scheme record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.ClassificationScheme.steppers.AuthorClassificationSchemes
  - _name: EditAuthorClassificationSchemes
    label: Edit
    description: Edit Classification Scheme records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.ClassificationScheme.steppers.AuthorClassificationSchemes
  - _name: MassUpdateAuthorClassificationSchemes
    label: Mass Update
    description: Mass update Classification Scheme records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.ClassificationScheme.steppers.AuthorClassificationSchemes
  - _name: Delete
    label: Delete
    description: Delete selected Classification Scheme records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorClassificationSchemes
    label: Import
    description: Import Classification Scheme records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.ClassificationScheme.steppers.ClassificationSchemeImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
