_name: ProductVariantActionSet
_package: sappm360.entities.ProductVariant.action_sets
_type: ActionSet
entity: sappm360.entities.ProductVariant.ProductVariant
label: Product Variant Action Set
description: Action set for managing product variants in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorProductVariants
    label: Create
    description: Create a new Product Variant record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.ProductVariant.steppers.AuthorProductVariants
  - _name: EditAuthorProductVariants
    label: Edit
    description: Edit Product Variant records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.ProductVariant.steppers.AuthorProductVariants
  - _name: MassUpdateAuthorProductVariants
    label: Mass Update
    description: Mass update Product Variant records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.ProductVariant.steppers.AuthorProductVariants
  - _name: Delete
    label: Delete
    description: Delete selected Product Variant records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorProductVariants
    label: Import
    description: Import Product Variant records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.ProductVariant.steppers.ProductVariantImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
