# Product Variant entity for the SAP Product / Material 360 accelerator.
_name: ProductVariant
_package: sappm360.entities.ProductVariant
_type: Entity
primaryKey: sappm360.entities.ProductVariant.ProductVariant.ProductVariantID
sourceIdGeneration:
  mode: MANUAL
label: Product Variant
documentation: Configurable or regional variant of a product golden record.
description: Configurable or regional variant of a product golden record.
enableDelete: true
entityType: BASIC
iconUrl: images://mdi/palette-swatch-outline.svg
pluralLabel: Product Variants
historizeGolden: true
historizeMaster: false
physicalTableName: PRODUCT_VARIANT
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: ProductVariantID
    physicalName: PROD_VARIANT_ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Product Variant ID
    documentation: Unique identifier for a product variant.
    description: Unique identifier for a product variant.
    mandatory: true
    length: 128
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: VariantCode
    physicalName: VARIANT_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Variant Code
    documentation: Code that identifies the product variant.
    description: Code that identifies the product variant.
    mandatory: true
    length: 80
    mandatoryValidationLabel: Variant Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: VariantName
    physicalName: VARIANT_NAME
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Variant Name
    documentation: Business name for the product variant.
    description: Business name for the product variant.
    mandatory: true
    length: 255
    mandatoryValidationLabel: Variant Name is mandatory
    mandatoryValidationScope: PRE_CONSO
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: Size
    physicalName: SIZE_VALUE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Size
    documentation: Size option for configurable products.
    description: Size option for configurable products.
    mandatory: false
    length: 80
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: Color
    physicalName: COLOR_VALUE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Color
    documentation: Color option for configurable products.
    description: Color option for configurable products.
    mandatory: false
    length: 80
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: PackagingType
    physicalName: PACKAGING_TYPE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Packaging Type
    documentation: Packaging option for the product variant.
    description: Packaging option for the product variant.
    mandatory: false
    length: 80
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: Region
    physicalName: REGION
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Region
    documentation: Region where the variant is offered or controlled.
    description: Region where the variant is offered or controlled.
    mandatory: false
    length: 80
    multiValued: false
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: Active
    physicalName: ACTIVE
    dataType: Boolean
    goldenAttribute: true
    i18ned: false
    label: Active
    documentation: Indicates whether the variant is active.
    description: Indicates whether the variant is active.
    mandatory: false
    length: 1
    multiValued: false
    searchable: true
    valueSeparator: ","
