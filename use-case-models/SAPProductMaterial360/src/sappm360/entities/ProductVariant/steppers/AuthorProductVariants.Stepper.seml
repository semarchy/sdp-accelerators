_name: AuthorProductVariants
_package: sappm360.entities.ProductVariant.steppers
_type: Stepper
entity: sappm360.entities.ProductVariant.ProductVariant
description: Stepper for authoring product variants.
rootStep:
  _name: ProductVariants
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: sappm360.entities.ProductVariant.collection_views.ProductVariantCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Product Variants
  description: Manage Product Variant data.
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.VariantProduct.Product
  stepTriggers: []
  childSteps:
    - _name: Main
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Main
      description: Main form for Product Variant.
      formTab: sappm360.entities.ProductVariant.forms.ProductVariantDataEntryForm.Main
      formStepEnrichers: []
      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.ProductVariant.forms.ProductVariantDataEntryForm.Main.Details.DetailsContainer.Container2.FDN_Product
          referencePickerCollectionView: sappm360.entities.Product.collection_views.ProductCollection
          referencePickerSearchTypeConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: sappm360.references.VariantProduct.Product
          executedOnDataChange: false
          executedOnFormOpen: false
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.VariantProduct.Product
      stepTriggers: []
label: Author Product Variants
stepperFinishValidations:
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.VariantProduct.Product
triggers: []
