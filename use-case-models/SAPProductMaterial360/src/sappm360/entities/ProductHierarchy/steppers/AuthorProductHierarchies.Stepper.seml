_name: AuthorProductHierarchies
_package: sappm360.entities.ProductHierarchy.steppers
_type: Stepper
entity: sappm360.entities.ProductHierarchy.ProductHierarchy
description: Stepper for authoring product hierarchies.
rootStep:
  _name: ProductHierarchies
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: sappm360.entities.ProductHierarchy.collection_views.ProductHierarchyCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Product Hierarchies
  description: Manage Product Hierarchy data.
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sappm360.references.HierarchyParent.ParentHierarchy
  stepTriggers: []
  childSteps:
    - _name: Main
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Main
      description: Main form for Product Hierarchy.
      formTab: sappm360.entities.ProductHierarchy.forms.ProductHierarchyDataEntryForm.Main
      formStepEnrichers: []
      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sappm360.entities.ProductHierarchy.forms.ProductHierarchyDataEntryForm.Main.Details.DetailsContainer.Container3.FDN_ParentHierarchy
          referencePickerCollectionView: sappm360.entities.ProductHierarchy.collection_views.ProductHierarchyCollection
          referencePickerSearchTypeConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: sappm360.references.HierarchyParent.ParentHierarchy
          executedOnDataChange: false
          executedOnFormOpen: false
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: sappm360.references.HierarchyParent.ParentHierarchy
      stepTriggers: []
label: Author Product Hierarchies
stepperFinishValidations:
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sappm360.references.HierarchyParent.ParentHierarchy
triggers: []
