_type: StandardSurvivorshipRule
entity: sappm360.entities.Product.Product
_package: sappm360.entities.Product.survivorship_rules
defaultRule: true
_name: DefaultRule
consolidationOrderByExpression: CreationDate ASC
consolidationSkipNulls: false
consolidationStrategy: PREFERRED_PUBLISHER
label: Default Rule
description: Default survivorship rule for Product Golden Record using SAP-first publisher rankings.
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: sappm360.publishers.SAPMDG
  - _type: ConsoPublisherRanking
    publisher: sappm360.publishers.S4HANA
  - _type: ConsoPublisherRanking
    publisher: sappm360.publishers.SAPECC
  - _type: ConsoPublisherRanking
    publisher: sappm360.publishers.PLM
  - _type: ConsoPublisherRanking
    publisher: sappm360.publishers.PIM
overrideDecayTimeDuration: 1
overrideDecayTimeUnit: DAYS
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes: []
