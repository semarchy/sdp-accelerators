      label: Main
      description: Main form for Product Golden Record.
      formTab: sappm360.entities.Product.forms.ProductBrowsingForm.Main
      formStepEnrichers: []
      referenceFormFieldConfigs: []
      formStepValidations: []
      stepTransitionValidations: []
      stepTriggers: []
label: Import Products
stepperFinishValidations: []
triggers: []
