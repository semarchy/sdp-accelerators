_name: MaterialGroupActionSet
_package: sappm360.entities.MaterialGroup.action_sets
_type: ActionSet
entity: sappm360.entities.MaterialGroup.MaterialGroup
label: Material Group Action Set
description: Action set for managing material groups in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorMaterialGroups
    label: Create
    description: Create a new Material Group record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.MaterialGroup.steppers.AuthorMaterialGroups
  - _name: EditAuthorMaterialGroups
    label: Edit
    description: Edit Material Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.MaterialGroup.steppers.AuthorMaterialGroups
  - _name: MassUpdateAuthorMaterialGroups
    label: Mass Update
    description: Mass update Material Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.MaterialGroup.steppers.AuthorMaterialGroups
  - _name: Delete
    label: Delete
    description: Delete selected Material Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorMaterialGroups
    label: Import
    description: Import Material Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.MaterialGroup.steppers.MaterialGroupImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
