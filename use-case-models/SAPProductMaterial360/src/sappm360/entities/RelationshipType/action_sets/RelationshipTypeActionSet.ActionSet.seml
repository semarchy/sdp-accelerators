_name: RelationshipTypeActionSet
_package: sappm360.entities.RelationshipType.action_sets
_type: ActionSet
entity: sappm360.entities.RelationshipType.RelationshipType
label: Relationship Type Action Set
description: Action set for managing relationship types in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorRelationshipTypes
    label: Create
    description: Create a new Relationship Type record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.RelationshipType.steppers.AuthorRelationshipTypes
  - _name: EditAuthorRelationshipTypes
    label: Edit
    description: Edit Relationship Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.RelationshipType.steppers.AuthorRelationshipTypes
  - _name: MassUpdateAuthorRelationshipTypes
    label: Mass Update
    description: Mass update Relationship Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.RelationshipType.steppers.AuthorRelationshipTypes
  - _name: Delete
    label: Delete
    description: Delete selected Relationship Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorRelationshipTypes
    label: Import
    description: Import Relationship Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.RelationshipType.steppers.RelationshipTypeImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
