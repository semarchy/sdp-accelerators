_name: ValuationClassActionSet
_package: sappm360.entities.ValuationClass.action_sets
_type: ActionSet
entity: sappm360.entities.ValuationClass.ValuationClass
label: Valuation Class Action Set
description: Action set for managing valuation classes in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorValuationClasses
    label: Create
    description: Create a new Valuation Class record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.ValuationClass.steppers.AuthorValuationClasses
  - _name: EditAuthorValuationClasses
    label: Edit
    description: Edit Valuation Class records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.ValuationClass.steppers.AuthorValuationClasses
  - _name: MassUpdateAuthorValuationClasses
    label: Mass Update
    description: Mass update Valuation Class records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.ValuationClass.steppers.AuthorValuationClasses
  - _name: Delete
    label: Delete
    description: Delete selected Valuation Class records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorValuationClasses
    label: Import
    description: Import Valuation Class records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.ValuationClass.steppers.ValuationClassImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
