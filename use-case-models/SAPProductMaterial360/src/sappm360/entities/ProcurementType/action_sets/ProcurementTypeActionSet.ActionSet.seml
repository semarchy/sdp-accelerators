_name: ProcurementTypeActionSet
_package: sappm360.entities.ProcurementType.action_sets
_type: ActionSet
entity: sappm360.entities.ProcurementType.ProcurementType
label: Procurement Type Action Set
description: Action set for managing procurement types in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorProcurementTypes
    label: Create
    description: Create a new Procurement Type record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.ProcurementType.steppers.AuthorProcurementTypes
  - _name: EditAuthorProcurementTypes
    label: Edit
    description: Edit Procurement Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.ProcurementType.steppers.AuthorProcurementTypes
  - _name: MassUpdateAuthorProcurementTypes
    label: Mass Update
    description: Mass update Procurement Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.ProcurementType.steppers.AuthorProcurementTypes
  - _name: Delete
    label: Delete
    description: Delete selected Procurement Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorProcurementTypes
    label: Import
    description: Import Procurement Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.ProcurementType.steppers.ProcurementTypeImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
