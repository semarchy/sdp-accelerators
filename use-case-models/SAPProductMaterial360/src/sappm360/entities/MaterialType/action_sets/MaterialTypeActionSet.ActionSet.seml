_name: MaterialTypeActionSet
_package: sappm360.entities.MaterialType.action_sets
_type: ActionSet
entity: sappm360.entities.MaterialType.MaterialType
label: Material Type Action Set
description: Action set for managing material types in SAP Product / Material 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorMaterialTypes
    label: Create
    description: Create a new Material Type record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sappm360.entities.MaterialType.steppers.AuthorMaterialTypes
  - _name: EditAuthorMaterialTypes
    label: Edit
    description: Edit Material Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sappm360.entities.MaterialType.steppers.AuthorMaterialTypes
  - _name: MassUpdateAuthorMaterialTypes
    label: Mass Update
    description: Mass update Material Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sappm360.entities.MaterialType.steppers.AuthorMaterialTypes
  - _name: Delete
    label: Delete
    description: Delete selected Material Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorMaterialTypes
    label: Import
    description: Import Material Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: sappm360.entities.MaterialType.steppers.MaterialTypeImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
