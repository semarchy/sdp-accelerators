_type: ModelDiagram
_package: sappm360.model_diagrams
_name: GovernanceReference
attributeNameFormat: NAME
description: Governance Reference diagram for SAP Product / Material 360 with plant, supplier, regulatory, cross-reference, and source-system links.
entityNameFormat: NAME
label: Governance Reference
referenceRoleNameFormat: NAME
referenceNameFormat: LABEL
showAttributeDataType: false
showForeignAttribute: true
showInheritedAttributes: false
showInheritLinkName: true
showReferenceCardinality: true
showReferenceName: true
showReferenceRoles: false
