_package: sappm360.workflows
_type: Workflow
_name: NewProductIntroduction
label: New Product / Material Introduction
workflowAdminRole: semarchyAdmin
notifications:
  workflowAdminOnDueDate: false
generalProperties:
  attachmentMaxFileCount: 5
  attachmentMaxFileSize: 10000
  attachmentMimeTypes: "*"
retentionPolicy:
  retentionTimeUnit: DAYS
  retentionType: FOREVER
dataScope:
  - entity: sappm360.entities.Product.Product
    _type: RootEntity
    _name: Product
    cardinality: SINGLE_RECORD
    displayCard: sappm360.entities.Product.display_cards.ProductDisplayCard
    childEntities:
      - ref: sappm360.references.MaterialsProduct
      - ref: sappm360.references.ClassificationProduct
      - ref: sappm360.references.ProductSpecProduct
      - ref: sappm360.references.VariantProduct
      - ref: sappm360.references.RegulatoryProduct
      - ref: sappm360.references.SupplierProductProduct
steps:
  - _type: StartFromSelectionEvent
    _name: StartFromExistingProduct
    position:
      x: -520
      y: -30
    label: Start From Product
#    initiatorRequiredRole: productSteward
    defaultPriority: NORMAL
    authoredEntity: sappm360.entities.Product.Product
    selectionSourceType: GOLDEN_DATA
    startupParameters:
      attachmentParamRequired: false
      attachmentParamSupported: false
      commentParamRequired: false
      commentParamSupported: false
      descriptionParamSupported: false
      dueDateParamRequired: false
      dueDateParamSupported: false
      nextTaskAssigneeRequired: false
      nextTaskAssigneeSupported: false
      priorityParamSupported: false
      showWaitDialog: true
    transition:
      _type: StartEventTransition
      _name: outgoing
      toStep: sappm360.workflows.NewProductIntroduction.CaptureProductRequest
      bendPoints: []
  - _type: StartFromEmptySelectionEvent
    _name: StartFromScratch
    position:
      x: -520
      y: -100
    label: Start From Scratch
#    initiatorRequiredRole: productSteward
    defaultPriority: NORMAL
    startupParameters:
      attachmentParamRequired: false
      attachmentParamSupported: false
      commentParamRequired: false
      commentParamSupported: false
      descriptionParamSupported: false
      dueDateParamRequired: false
      dueDateParamSupported: false
      nextTaskAssigneeRequired: false
      nextTaskAssigneeSupported: false
      priorityParamSupported: false
      showWaitDialog: true
    transition:
      _type: StartEventTransition
      _name: outgoing
      toStep: sappm360.workflows.NewProductIntroduction.CaptureProductRequest
      bendPoints: []
  - _type: UserTask
    _name: CaptureProductRequest
    label: Capture Product Request
    icon: images://mdi/package-variant-closed.svg
    position:
      x: -320
      y: -75
    application: sappm360.applications.ProductMaterial360Hub
#    assigneeRequiredRole: productSteward
    assigneeCanRelease: true
    notificationsOnTaskAssignment:
      toAssignee: true
      toCandidates: true
    notificationsOnTaskExpiration:
      taskMaxDuration: 0
      toAdmin: false
      toCandidatesOrAssignee: false
      toRole: ""
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    taskType: DATA_AUTHORING
    entity: sappm360.entities.Product.Product
    stepper: sappm360.entities.Product.steppers.AuthorProducts
    myTasksConfiguration:
      collection: sappm360.entities.Product.collection_views.ProductCollection
    transitions:
      - _type: UserTaskTransition
        _name: ToDataQualityReview
        label: Proceed
        toStep: sappm360.workflows.NewProductIntroduction.DataQualityReview
        userTaskCompletionRequired: true
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          nextTaskAssigneeSupported: false
          nextTaskAssigneeRequired: false
          descriptionParamSupported: true
          commentParamSupported: true
          commentParamRequired: false
          priorityParamSupported: true
          dueDateParamSupported: false
          dueDateParamRequired: false
          attachmentParamSupported: true
          attachmentParamRequired: false
        bendPoints: []
  - _type: UserTask
    _name: DataQualityReview
    label: Data Quality Review
    icon: images://mdi/check-decagram.svg
    position:
      x: -80
      y: -75
    application: sappm360.applications.ProductMaterial360Hub
#    assigneeRequiredRole: productSteward
    assigneeCanRelease: true
    notificationsOnTaskAssignment:
      toAssignee: true
      toCandidates: true
    notificationsOnTaskExpiration:
      taskMaxDuration: 0
      toAdmin: false
      toCandidatesOrAssignee: false
      toRole: ""
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    taskType: DATA_AUTHORING
    entity: sappm360.entities.Product.Product
    stepper: sappm360.entities.Product.steppers.AuthorProducts
    myTasksConfiguration:
      collection: sappm360.entities.Product.collection_views.ProductCollection
    transitions:
      - _type: UserTaskTransition
        _name: ToComplianceReview
        label: Proceed
        toStep: sappm360.workflows.NewProductIntroduction.ComplianceReview
        userTaskCompletionRequired: true
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          nextTaskAssigneeSupported: false
          nextTaskAssigneeRequired: false
          descriptionParamSupported: true
          commentParamSupported: true
          commentParamRequired: false
          priorityParamSupported: true
          dueDateParamSupported: false
          dueDateParamRequired: false
          attachmentParamSupported: true
          attachmentParamRequired: false
        bendPoints: []
  - _type: UserTask
    _name: ComplianceReview
    label: Compliance Review
    icon: images://mdi/shield-check.svg
    position:
      x: 160
      y: -75
    application: sappm360.applications.ProductMaterial360Hub
#    assigneeRequiredRole: productSteward
    assigneeCanRelease: true
    notificationsOnTaskAssignment:
      toAssignee: true
      toCandidates: true
    notificationsOnTaskExpiration:
      taskMaxDuration: 0
      toAdmin: false
      toCandidatesOrAssignee: false
      toRole: ""
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    taskType: DATA_AUTHORING
    entity: sappm360.entities.Product.Product
    stepper: sappm360.entities.Product.steppers.AuthorProducts
    myTasksConfiguration:
      collection: sappm360.entities.Product.collection_views.ProductCollection
    transitions:
      - _type: UserTaskTransition
        _name: ToFinalApproval
        label: Proceed
        toStep: sappm360.workflows.NewProductIntroduction.FinalApproval
        userTaskCompletionRequired: true
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          nextTaskAssigneeSupported: false
          nextTaskAssigneeRequired: false
          descriptionParamSupported: true
          commentParamSupported: true
          commentParamRequired: false
          priorityParamSupported: true
          dueDateParamSupported: false
          dueDateParamRequired: false
          attachmentParamSupported: true
          attachmentParamRequired: false
        bendPoints: []
  - _type: UserTask
    _name: FinalApproval
    label: Final Approval
    icon: images://mdi/check-circle.svg
    position:
      x: 400
      y: -75
    application: sappm360.applications.ProductMaterial360Hub
#    assigneeRequiredRole: productSteward
    assigneeCanRelease: true
    notificationsOnTaskAssignment:
      toAssignee: true
      toCandidates: true
    notificationsOnTaskExpiration:
      taskMaxDuration: 0
      toAdmin: false
      toCandidatesOrAssignee: false
      toRole: ""
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    taskType: DATA_AUTHORING
    entity: sappm360.entities.Product.Product
    stepper: sappm360.entities.Product.steppers.AuthorProducts
    myTasksConfiguration:
      collection: sappm360.entities.Product.collection_views.ProductCollection
    transitions:
      - _type: UserTaskTransition
        _name: ToSubmitData
        label: Approve and Submit
        toStep: sappm360.workflows.NewProductIntroduction.SubmitData
        userTaskCompletionRequired: true
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          nextTaskAssigneeSupported: false
          nextTaskAssigneeRequired: false
          descriptionParamSupported: true
          commentParamSupported: true
          commentParamRequired: false
          priorityParamSupported: true
          dueDateParamSupported: false
          dueDateParamRequired: false
          attachmentParamSupported: true
          attachmentParamRequired: false
        bendPoints: []
  - _type: SubmitAutomation
    _name: SubmitData
    label: Submit Data
    position:
      x: 640
      y: -75
    integrationJob: sappm360.model_jobs.INTEGRATE_ALL
    submitUserExpression: WorkflowInstance.InitiatorName
    transition:
      _type: AutomationTransition
      _name: outgoing
      label: Outgoing
      toStep: sappm360.workflows.NewProductIntroduction.End
      bendPoints: []
  - _type: EndEvent
    _name: End
    position:
      x: 860
      y: -75
