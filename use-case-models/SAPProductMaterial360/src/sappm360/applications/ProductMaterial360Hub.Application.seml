_package: sappm360.applications
_name: ProductMaterial360Hub
_type: Application
applicationTitle: SAP Product / Material 360
avatarImageUrl: images://sap-product-material-360/avatar-sap-premium.png
coverImageUrl: images://sap-product-material-360/cover-sap-premium.png
favIcon: images://sap-product-material-360/avatar-sap-premium.png
historyBrowsingEnabled: true
historyBrowsingRequiredRole: ""
logoUrl: images://sap-product-material-360/logo-sap-premium.png
visibility: VISIBLE
description: Trusted product and material data hub for SAP landscape consolidation.
documentationConfig:
  documentationConfigDiagrams:
    - _name: CoreProductMaterial
      _type: DocumentationConfigDiagram
      modelDiagram: sappm360.model_diagrams.CoreProductMaterial
      label: Core Product Material
    - _name: GovernanceReference
      _type: DocumentationConfigDiagram
      modelDiagram: sappm360.model_diagrams.GovernanceReference
      label: Governance Reference
label: SAP Product / Material 360
sortStrategy: POSITION
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: true
  globalSearchBusinessViews:
    - _name: Products
      _type: GlobalSearchBoView
      viewType: GD
      businessView: sappm360.entities.Product.business_views.Product
      label: Products
      maxResults: 5
      searchTypeConfig: sappm360.entities.Product.business_views.Product.Product.TextConfig
    - _name: Materials
      _type: GlobalSearchBoView
      viewType: GD
      businessView: sappm360.entities.Material.business_views.Material
      label: Materials
      maxResults: 5
      searchTypeConfig: sappm360.entities.Material.business_views.Material.Material.TextConfig
    - _name: ProductHierarchies
      _type: GlobalSearchBoView
      viewType: GD
      businessView: sappm360.entities.ProductHierarchy.business_views.ProductHierarchy
      label: Product Hierarchies
      maxResults: 5
      searchTypeConfig: sappm360.entities.ProductHierarchy.business_views.ProductHierarchy.ProductHierarchy.TextConfig
    - _name: Suppliers
      _type: GlobalSearchBoView
      viewType: GD
      businessView: sappm360.entities.Supplier.business_views.Supplier
      label: Suppliers
      maxResults: 5
      searchTypeConfig: sappm360.entities.Supplier.business_views.Supplier.Supplier.TextConfig
    - _name: Plants
      _type: GlobalSearchBoView
      viewType: GD
      businessView: sappm360.entities.Plant.business_views.Plant
      label: Plants
      maxResults: 5
      searchTypeConfig: sappm360.entities.Plant.business_views.Plant.Plant.TextConfig
defaultAction: sappm360.applications.ProductMaterial360Hub.Root.GlobalSearch
navDrawer:
  - _name: RootFolder
    _type: NavigationGroup
    dividerVisible: false
    label: Root Folder
    labelVisible: false
    actions:
      - appAction: sappm360.applications.ProductMaterial360Hub.Root.MyTasks
      - appAction: sappm360.applications.ProductMaterial360Hub.Root.GlobalSearch
  - _name: ProductGovernance
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sappm360.applications.ProductMaterial360Hub.Root.ProductGovernance
  - _name: MaterialManagement
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sappm360.applications.ProductMaterial360Hub.Root.MaterialManagement
  - _name: SupplyChainOperations
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sappm360.applications.ProductMaterial360Hub.Root.SupplyChainOperations
  - _name: ComplianceAndQuality
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sappm360.applications.ProductMaterial360Hub.Root.ComplianceAndQuality
  - _name: IntegrationEcosystem
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sappm360.applications.ProductMaterial360Hub.Root.IntegrationEcosystem
  - _name: Administration
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sappm360.applications.ProductMaterial360Hub.Root.Administration
rootFolder:
  _type: FolderAction
  _name: Root
  label: Root Folder
  image: images://mdi/folder.svg
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  appActions:
    - _type: MyTasksAction
      _name: MyTasks
      label: "Inbox"
      iconColor: "#08243d"
      labelColor: "#08243d"
      image: images://sap-product-material-360/action-inbox.png
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      badgeVisible: false
    - _type: GlobalSearchAction
      _name: GlobalSearch
      description: "Search products, materials, hierarchies, suppliers, and plants."
      label: "Global Search"
      iconColor: "#08243d"
      labelColor: "#08243d"
      image: images://sap-product-material-360/action-global-search.png
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
    - _type: FolderAction
      _name: ProductGovernance
      icon: images://mdi/package-variant-closed.svg
      description: "Manage products, hierarchies, brand taxonomy, classifications, and product reference data."
      label: "Product Governance"
      iconColor: "#006f68"
      labelColor: "#006f68"
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      appActions:
        - _type: BrowseBusinessViewAction
          _name: BrowseProduct
          description: "Browse governed Product golden records."
          label: "Products"
          iconColor: "#006f68"
          labelColor: "#006f68"
          image: images://sap-product-material-360/action-product.png
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          businessView: sappm360.entities.Product.business_views.Product
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          viewType: GD
        - _type: BrowseBusinessViewAction
          _name: BrowseProductHierarchy
          description: "Browse product taxonomy and hierarchy nodes."
          label: "Product Hierarchies"
          iconColor: "#006f68"
          labelColor: "#006f68"
          image: images://sap-product-material-360/action-product-hierarchy.png
          icon: images://mdi/family-tree.svg
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          businessView: sappm360.entities.ProductHierarchy.business_views.ProductHierarchy
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          viewType: GD
        - _type: BrowseBusinessViewAction
          _name: BrowseBrand
          description: "Browse brand reference records."
          label: "Brands"
          iconColor: "#006f68"
          labelColor: "#006f68"
          image: images://sap-product-material-360/action-brand.png
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          businessView: sappm360.entities.Brand.business_views.Brand
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          viewType: GD
        - _type: FolderAction
