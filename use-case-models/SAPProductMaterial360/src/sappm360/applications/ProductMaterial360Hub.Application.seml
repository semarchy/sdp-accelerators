          _name: BrowseSourceSystem
          description: "Browse Source Systems records."
          label: "Source Systems"
          iconColor: "#174a8b"
          labelColor: "#174a8b"
          image: images://sap-product-material-360/action-source-system.png
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          businessView: sappm360.entities.SourceSystem.business_views.SourceSystem
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          viewType: GD
        - _type: BrowseBusinessViewAction
          _name: BrowseProductCrossReference
          description: "Browse Product Cross References records."
          label: "Product Cross References"
          iconColor: "#174a8b"
          labelColor: "#174a8b"
          image: images://sap-product-material-360/action-product-cross-reference.png
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          businessView: sappm360.entities.ProductCrossReference.business_views.ProductCrossReference
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          viewType: GD
        - _type: FolderAction
          _name: IntegrationMonitoring
          icon: images://mdi/database-alert-outline.svg
          description: "Monitor cross-system identifier and load issues."
          label: "Integration Monitoring"
          iconColor: "#174a8b"
          labelColor: "#174a8b"
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          appActions:
            - _type: BrowseBusinessViewAction
              _name: BrowseProductCrossReferenceErrors
              description: "Browse Source Errors in Product Cross References records."
              label: "Source Errors in Product Cross References"
              iconColor: "#174a8b"
              labelColor: "#174a8b"
              image: images://sap-product-material-360/action-quality.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
              businessView: sappm360.entities.ProductCrossReference.business_views.ProductCrossReference
              nbRecordsBadgeVisible: true
              nbRecordsBadgeBackgroundColor: md:green 500
              useSearchOnOpen: false
              viewType: SAWE
