_name: SupplierText
_package: sapbp360.entities.SupplierText.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
entity: sapbp360.entities.SupplierText.SupplierText
rootLabel: Supplier Text
rootPluralLabel: Supplier Texts
useHierarchyOnOpen: false
label: Supplier Text
description: Business view for Supplier Text.
rootBusinessViewEntity:
  _name: SupplierText
  _type: BusinessViewEntity
  collection: sapbp360.entities.SupplierText.collection_views.SupplierTextCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: sapbp360.entities.SupplierText.SupplierText
  form: sapbp360.entities.SupplierText.forms.SupplierTextBrowsingForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  tableAllowed: true
  actionSet: sapbp360.entities.SupplierText.action_sets.SupplierTextActionSet
  displayCard: sapbp360.entities.SupplierText.display_cards.SupplierTextDisplayCard
  sortExpression: TextID
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs:
    - formField: sapbp360.entities.SupplierText.forms.SupplierTextBrowsingForm.Main.MainRow.Col2.Col2Body.FDN_TextLanguage
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.SupplierText.forms.SupplierTextBrowsingForm.Main.MainRow.Col2.Col2Body.FDN_LongTextID
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.SupplierText.forms.SupplierTextBrowsingForm.Main.MainRow.Col2.Col2Body.FDN_Supplier
      navigationMode: MODAL_FORM
  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: sapbp360.entities.SupplierText.business_views.SupplierText.SupplierText
rootIconUrl: images://mdi/text-box-outline.svg
