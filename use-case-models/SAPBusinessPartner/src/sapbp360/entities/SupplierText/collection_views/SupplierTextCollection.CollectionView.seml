_package: sapbp360.entities.SupplierText.collection_views
_name: SupplierTextCollection
_type: CollectionView
entity: sapbp360.entities.SupplierText.SupplierText
default: true
displayCard: sapbp360.entities.SupplierText.display_cards.SupplierTextDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Supplier Text
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: TextID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: TextID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: LongText
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LongText
    visibleByDefault: true
    defaultWidth: 220
