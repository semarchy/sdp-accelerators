_name: SupplierTextActionSet
_package: sapbp360.entities.SupplierText.action_sets
_type: ActionSet
entity: sapbp360.entities.SupplierText.SupplierText
label: Supplier Text Action Set
description: Action set for managing Supplier Texts in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorSupplierTexts
    label: Create
    description: Create a new Supplier Text record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.SupplierText.steppers.AuthorSupplierTexts
  - _name: EditAuthorSupplierTexts
    label: Edit
    description: Edit Supplier Text records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.SupplierText.steppers.AuthorSupplierTexts
  - _name: MassUpdateAuthorSupplierTexts
    label: Mass Update
    description: Mass update Supplier Text records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.SupplierText.steppers.AuthorSupplierTexts
  - _name: Delete
    label: Delete
    description: Delete selected Supplier Text records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorSupplierTexts
    label: Import
    description: Import Supplier Text records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.SupplierText.steppers.SupplierTextImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
