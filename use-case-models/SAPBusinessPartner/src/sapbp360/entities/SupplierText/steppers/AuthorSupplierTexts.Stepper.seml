_name: AuthorSupplierTexts
_package: sapbp360.entities.SupplierText.steppers
_type: Stepper
entity: sapbp360.entities.SupplierText.SupplierText
description: Stepper for authoring Supplier Texts.
rootStep:
  _name: SupplierTexts
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: sapbp360.entities.SupplierText.collection_views.SupplierTextCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Supplier Texts
  description: Manage Supplier Text data.
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations: &a1
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sapbp360.references.SupplierText_TextLanguage.TextLanguage
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sapbp360.references.SupplierText_LongTextID.LongTextID
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sapbp360.references.SupplierText_Supplier.Supplier
  stepTriggers: []
  childSteps:
    - _name: Main
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Main
      description: Main form for Supplier Text.
      formTab: sapbp360.entities.SupplierText.forms.SupplierTextDataEntryForm.Main
      formStepEnrichers: []
      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sapbp360.entities.SupplierText.forms.SupplierTextDataEntryForm.Main.MainRow.Col2.Col2Body.FDN_TextLanguage
          referencePickerCollectionView: sapbp360.entities.Language.collection_views.LanguageCollection
          referencePickerSearchTypeConfigs: []
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sapbp360.entities.SupplierText.forms.SupplierTextDataEntryForm.Main.MainRow.Col2.Col2Body.FDN_LongTextID
          referencePickerCollectionView: sapbp360.entities.LongTextID.collection_views.LongTextIDCollection
          referencePickerSearchTypeConfigs: []
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: sapbp360.entities.SupplierText.forms.SupplierTextDataEntryForm.Main.MainRow.Col2.Col2Body.FDN_Supplier
          referencePickerCollectionView: sapbp360.entities.Supplier.collection_views.SupplierCollection
          referencePickerSearchTypeConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: sapbp360.references.SupplierText_TextLanguage.TextLanguage
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: sapbp360.references.SupplierText_LongTextID.LongTextID
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: sapbp360.references.SupplierText_Supplier.Supplier
          executedOnDataChange: false
          executedOnFormOpen: false
      stepTransitionValidations: *a1
      stepTriggers: []
label: Author Supplier Texts
stepperFinishValidations:
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sapbp360.references.SupplierText_TextLanguage.TextLanguage
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sapbp360.references.SupplierText_LongTextID.LongTextID
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: sapbp360.references.SupplierText_Supplier.Supplier
triggers: []
