_name: PaymentTermsActionSet
_package: sapbp360.entities.PaymentTerms.action_sets
_type: ActionSet
entity: sapbp360.entities.PaymentTerms.PaymentTerms
label: Payment Terms Action Set
description: Action set for managing Payment Terms in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorPaymentTerms
    label: Create
    description: Create a new Payment Terms record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.PaymentTerms.steppers.AuthorPaymentTerms
  - _name: EditAuthorPaymentTerms
    label: Edit
    description: Edit Payment Terms records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.PaymentTerms.steppers.AuthorPaymentTerms
  - _name: MassUpdateAuthorPaymentTerms
    label: Mass Update
    description: Mass update Payment Terms records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.PaymentTerms.steppers.AuthorPaymentTerms
  - _name: Delete
    label: Delete
    description: Delete selected Payment Terms records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorPaymentTerms
    label: Import
    description: Import Payment Terms records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.PaymentTerms.steppers.PaymentTermsImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
