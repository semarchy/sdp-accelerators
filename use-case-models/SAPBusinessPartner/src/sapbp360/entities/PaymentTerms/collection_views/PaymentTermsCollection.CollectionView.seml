_package: sapbp360.entities.PaymentTerms.collection_views
_name: PaymentTermsCollection
_type: CollectionView
entity: sapbp360.entities.PaymentTerms.PaymentTerms
default: true
displayCard: sapbp360.entities.PaymentTerms.display_cards.PaymentTermsDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Payment Terms
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: PaymentTermsID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PaymentTermsID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: PaymentTermsCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PaymentTermsCode
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: PaymentTermsName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PaymentTermsName
    visibleByDefault: true
    defaultWidth: 220
