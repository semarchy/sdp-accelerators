_name: SupplierPartnerFuncActionSet
_package: sapbp360.entities.SupplierPartnerFunc.action_sets
_type: ActionSet
entity: sapbp360.entities.SupplierPartnerFunc.SupplierPartnerFunc
label: Supplier Partner Function Action Set
description: Action set for managing Supplier Partner Functions in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorSupplierPartnerFunctions
    label: Create
    description: Create a new Supplier Partner Function record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.SupplierPartnerFunc.steppers.AuthorSupplierPartnerFunctions
  - _name: EditAuthorSupplierPartnerFunctions
    label: Edit
    description: Edit Supplier Partner Function records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.SupplierPartnerFunc.steppers.AuthorSupplierPartnerFunctions
  - _name: MassUpdateAuthorSupplierPartnerFunctions
    label: Mass Update
    description: Mass update Supplier Partner Function records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.SupplierPartnerFunc.steppers.AuthorSupplierPartnerFunctions
  - _name: Delete
    label: Delete
    description: Delete selected Supplier Partner Function records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorSupplierPartnerFunctions
    label: Import
    description: Import Supplier Partner Function records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.SupplierPartnerFunc.steppers.SupplierPartnerFuncImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
