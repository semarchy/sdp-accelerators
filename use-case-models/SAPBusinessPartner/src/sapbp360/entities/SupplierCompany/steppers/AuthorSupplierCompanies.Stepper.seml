_name: AuthorSupplierCompanies
_package: sapbp360.entities.SupplierCompany.steppers
_type: Stepper
entity: sapbp360.entities.SupplierCompany.SupplierCompany
description: Stepper for authoring Supplier Companies.
rootStep:
  _name: SupplierCompanies
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: sapbp360.entities.SupplierCompany.collection_views.SupplierCompanyCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Supplier Companies
  description: Manage Supplier Company data.
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations: &a1
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sapbp360.references.SupplierCompany_CompanyCode.CompanyCode
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sapbp360.references.SupplierCompany_PaymentTerms.PaymentTerms
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sapbp360.references.SupplierCompany_ReconciliationAccount.ReconciliationAccount
    - onStepExit: SKIP
