      attribute: sapbp360.references.SupplierCompany_WithholdingTaxCountry.WithholdingTaxCountry
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: sapbp360.references.SupplierCompany_Supplier.Supplier
