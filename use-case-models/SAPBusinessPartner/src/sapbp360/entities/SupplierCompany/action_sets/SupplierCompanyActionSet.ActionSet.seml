_name: SupplierCompanyActionSet
_package: sapbp360.entities.SupplierCompany.action_sets
_type: ActionSet
entity: sapbp360.entities.SupplierCompany.SupplierCompany
label: Supplier Company Action Set
description: Action set for managing Supplier Companies in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorSupplierCompanies
    label: Create
    description: Create a new Supplier Company record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.SupplierCompany.steppers.AuthorSupplierCompanies
  - _name: EditAuthorSupplierCompanies
    label: Edit
    description: Edit Supplier Company records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.SupplierCompany.steppers.AuthorSupplierCompanies
  - _name: MassUpdateAuthorSupplierCompanies
    label: Mass Update
    description: Mass update Supplier Company records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.SupplierCompany.steppers.AuthorSupplierCompanies
  - _name: Delete
    label: Delete
    description: Delete selected Supplier Company records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorSupplierCompanies
    label: Import
    description: Import Supplier Company records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.SupplierCompany.steppers.SupplierCompanyImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
