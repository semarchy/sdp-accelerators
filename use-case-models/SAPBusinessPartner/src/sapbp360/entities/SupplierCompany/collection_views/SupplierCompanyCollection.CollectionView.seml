_package: sapbp360.entities.SupplierCompany.collection_views
_name: SupplierCompanyCollection
_type: CollectionView
entity: sapbp360.entities.SupplierCompany.SupplierCompany
default: true
displayCard: sapbp360.entities.SupplierCompany.display_cards.SupplierCompanyDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Supplier Company
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: SupplierCompanyID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierCompanyID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: SupplierAccountNote
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierAccountNote
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: PaymentMethodsList
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PaymentMethodsList
    visibleByDefault: true
    defaultWidth: 220
  - _type: CheckboxColumn
    _name: PostingIsBlocked
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: PostingIsBlocked
    visibleByDefault: true
    componentProperties:
      useSwitch: "1"
      useSwitchValueInterpreter: LITERAL
