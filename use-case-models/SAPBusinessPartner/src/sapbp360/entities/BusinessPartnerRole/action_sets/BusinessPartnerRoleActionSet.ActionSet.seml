_name: BusinessPartnerRoleActionSet
_package: sapbp360.entities.BusinessPartnerRole.action_sets
_type: ActionSet
entity: sapbp360.entities.BusinessPartnerRole.BusinessPartnerRole
label: Business Partner Role Action Set
description: Action set for managing Business Partner Roles in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBusinessPartnerRoles
    label: Create
    description: Create a new Business Partner Role record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BusinessPartnerRole.steppers.AuthorBusinessPartnerRoles
  - _name: EditAuthorBusinessPartnerRoles
    label: Edit
    description: Edit Business Partner Role records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BusinessPartnerRole.steppers.AuthorBusinessPartnerRoles
  - _name: MassUpdateAuthorBusinessPartnerRoles
    label: Mass Update
    description: Mass update Business Partner Role records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BusinessPartnerRole.steppers.AuthorBusinessPartnerRoles
  - _name: Delete
    label: Delete
    description: Delete selected Business Partner Role records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBusinessPartnerRoles
    label: Import
    description: Import Business Partner Role records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BusinessPartnerRole.steppers.BusinessPartnerRoleImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
