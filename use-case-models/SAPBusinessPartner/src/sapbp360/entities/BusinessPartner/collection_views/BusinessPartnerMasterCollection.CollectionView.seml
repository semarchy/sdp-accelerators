# Master records collection view for Business Partner.
# Displays the contributing master (source) records with their publisher and source identifiers.
_package: sapbp360.entities.BusinessPartner.collection_views
_name: BusinessPartnerMasterCollection
_type: CollectionView
entity: sapbp360.entities.BusinessPartner.BusinessPartner
default: false
displayCard: sapbp360.entities.BusinessPartner.display_cards.BusinessPartnerDisplayCard
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: false
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: PublisherID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PublisherID
    visibleByDefault: true
  - _type: TextColumn
    _name: SourceID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SourceID
    visibleByDefault: true
  - _type: TextColumn
    _name: BusinessPartner
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: BusinessPartner
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: BusinessPartnerFullName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: BusinessPartnerFullName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: OrganizationBPName1
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: OrganizationBPName1
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: LastName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: LastName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: FirstName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FirstName
    visibleByDefault: true
    defaultWidth: 220
  - _type: DateColumn
    _name: BirthDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: BirthDate
    visibleByDefault: true
    defaultWidth: 180
  - _type: CheckboxColumn
    _name: IsNaturalPerson
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: IsNaturalPerson
    visibleByDefault: true
    componentProperties:
      useSwitch: "1"
      useSwitchValueInterpreter: LITERAL
