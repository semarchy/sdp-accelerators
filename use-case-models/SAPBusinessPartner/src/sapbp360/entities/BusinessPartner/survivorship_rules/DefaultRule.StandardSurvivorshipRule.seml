_type: StandardSurvivorshipRule
entity: sapbp360.entities.BusinessPartner.BusinessPartner
_package: sapbp360.entities.BusinessPartner.survivorship_rules
defaultRule: true
_name: DefaultRule
consolidationOrderByExpression: CreationDate ASC
consolidationSkipNulls: false
consolidationStrategy: PREFERRED_PUBLISHER
