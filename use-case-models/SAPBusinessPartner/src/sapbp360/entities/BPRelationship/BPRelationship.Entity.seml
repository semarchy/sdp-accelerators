# BP Relationship entity for the SAP Business Partner 360 accelerator.
_name: BPRelationship
_package: sapbp360.entities.BPRelationship
_type: Entity
primaryKey: sapbp360.entities.BPRelationship.BPRelationship.RelationshipID
sourceIdGeneration:
  mode: MANUAL
label: BP Relationship
documentation: Relationship between two business partners such as parent, headquarter, or affiliate.
description: Relationship between two business partners such as parent, headquarter, or affiliate.
enableDelete: true
entityType: BASIC
iconUrl: images://sapbusinesspartner/BPRelationship.svg
pluralLabel: BP Relationships
historizeGolden: true
historizeMaster: false
physicalTableName: BP_RELATIONSHIP
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: RelationshipID
    physicalName: REL_ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Relationship ID
    documentation: Unique identifier for the relationship.
    description: Unique identifier for the relationship.
    mandatory: true
    length: 128
    mandatoryValidationLabel: Relationship ID is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: ValidFrom
    physicalName: VALID_FROM
    dataType: Date
    goldenAttribute: true
    label: Valid From
    documentation: Relationship validity start date.
    description: Relationship validity start date.
    mandatory: false
    searchable: true
  - _type: EntityAttribute
    _name: ValidTo
    physicalName: VALID_TO
    dataType: Date
    goldenAttribute: true
    label: Valid To
    documentation: Relationship validity end date.
    description: Relationship validity end date.
    mandatory: false
    searchable: true
