_name: BPRelationshipActionSet
_package: sapbp360.entities.BPRelationship.action_sets
_type: ActionSet
entity: sapbp360.entities.BPRelationship.BPRelationship
label: BP Relationship Action Set
description: Action set for managing BP Relationships in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPRelationships
    label: Create
    description: Create a new BP Relationship record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPRelationship.steppers.AuthorBPRelationships
  - _name: EditAuthorBPRelationships
    label: Edit
    description: Edit BP Relationship records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPRelationship.steppers.AuthorBPRelationships
  - _name: MassUpdateAuthorBPRelationships
    label: Mass Update
    description: Mass update BP Relationship records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BPRelationship.steppers.AuthorBPRelationships
  - _name: Delete
    label: Delete
    description: Delete selected BP Relationship records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPRelationships
    label: Import
    description: Import BP Relationship records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPRelationship.steppers.BPRelationshipImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
