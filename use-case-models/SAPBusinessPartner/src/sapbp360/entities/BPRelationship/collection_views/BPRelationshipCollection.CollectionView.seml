_package: sapbp360.entities.BPRelationship.collection_views
_name: BPRelationshipCollection
_type: CollectionView
entity: sapbp360.entities.BPRelationship.BPRelationship
default: true
displayCard: sapbp360.entities.BPRelationship.display_cards.BPRelationshipDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: BP Relationship
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: RelationshipID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: RelationshipID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: ValidFrom
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: ValidFrom
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: ValidTo
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: ValidTo
    visibleByDefault: true
    defaultWidth: 220

  - _type: TextColumn
    _name: RelationshipCategory
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: true
    label: Relationship Category
    value: RelationshipCategory.RelationshipCategoryName
    visibleByDefault: true
    defaultWidth: 220