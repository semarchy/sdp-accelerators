# BPRelationshipDataEntryForm form for BP Relationship.
_package: sapbp360.entities.BPRelationship.forms
_type: Form
_name: BPRelationshipDataEntryForm
entity: sapbp360.entities.BPRelationship.BPRelationship
default: false
