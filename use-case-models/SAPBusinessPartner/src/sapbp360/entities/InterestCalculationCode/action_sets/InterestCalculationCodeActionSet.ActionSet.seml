_name: InterestCalculationCodeActionSet
_package: sapbp360.entities.InterestCalculationCode.action_sets
_type: ActionSet
entity: sapbp360.entities.InterestCalculationCode.InterestCalculationCode
label: Interest Calculation Code Action Set
description: Action set for managing Interest Calculation Codes in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorInterestCalculationCodes
    label: Create
    description: Create a new Interest Calculation Code record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.InterestCalculationCode.steppers.AuthorInterestCalculationCodes
  - _name: EditAuthorInterestCalculationCodes
    label: Edit
    description: Edit Interest Calculation Code records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.InterestCalculationCode.steppers.AuthorInterestCalculationCodes
  - _name: MassUpdateAuthorInterestCalculationCodes
    label: Mass Update
    description: Mass update Interest Calculation Code records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.InterestCalculationCode.steppers.AuthorInterestCalculationCodes
  - _name: Delete
    label: Delete
    description: Delete selected Interest Calculation Code records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorInterestCalculationCodes
    label: Import
    description: Import Interest Calculation Code records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.InterestCalculationCode.steppers.InterestCalculationCodeImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
