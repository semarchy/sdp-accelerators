_name: BusinessPartnerCategoryActionSet
_package: sapbp360.entities.BusinessPartnerCategory.action_sets
_type: ActionSet
entity: sapbp360.entities.BusinessPartnerCategory.BusinessPartnerCategory
label: Business Partner Category Action Set
description: Action set for managing Business Partner Categories in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBusinessPartnerCategories
    label: Create
    description: Create a new Business Partner Category record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BusinessPartnerCategory.steppers.AuthorBusinessPartnerCategories
  - _name: EditAuthorBusinessPartnerCategories
    label: Edit
    description: Edit Business Partner Category records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BusinessPartnerCategory.steppers.AuthorBusinessPartnerCategories
  - _name: MassUpdateAuthorBusinessPartnerCategories
    label: Mass Update
    description: Mass update Business Partner Category records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BusinessPartnerCategory.steppers.AuthorBusinessPartnerCategories
  - _name: Delete
    label: Delete
    description: Delete selected Business Partner Category records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBusinessPartnerCategories
    label: Import
    description: Import Business Partner Category records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BusinessPartnerCategory.steppers.BusinessPartnerCategoryImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
