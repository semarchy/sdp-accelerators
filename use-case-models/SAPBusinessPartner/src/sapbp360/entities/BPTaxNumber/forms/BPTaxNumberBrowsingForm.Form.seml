# BPTaxNumberBrowsingForm form for BP Tax Number.
_package: sapbp360.entities.BPTaxNumber.forms
_type: Form
_name: BPTaxNumberBrowsingForm
entity: sapbp360.entities.BPTaxNumber.BPTaxNumber
default: true
formTabs:
  - _name: Main
    _type: FormTab
    documentationInterpreter: LITERAL
    visibleValue: "1"
