_package: sapbp360.entities.BPTaxNumber.collection_views
_name: BPTaxNumberCollection
_type: CollectionView
entity: sapbp360.entities.BPTaxNumber.BPTaxNumber
default: true
displayCard: sapbp360.entities.BPTaxNumber.display_cards.BPTaxNumberDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: BP Tax Number
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: TaxID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: TaxID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: BPTaxNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: BPTaxNumber
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: TaxNumberIsCanceled
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: TaxNumberIsCanceled
    visibleByDefault: true
    defaultWidth: 220
