_name: BPAddressEmailActionSet
_package: sapbp360.entities.BPAddressEmail.action_sets
_type: ActionSet
entity: sapbp360.entities.BPAddressEmail.BPAddressEmail
label: BP Address Email Action Set
description: Action set for managing BP Address Emails in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPAddressEmails
    label: Create
    description: Create a new BP Address Email record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPAddressEmail.steppers.AuthorBPAddressEmails
  - _name: EditAuthorBPAddressEmails
    label: Edit
    description: Edit BP Address Email records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPAddressEmail.steppers.AuthorBPAddressEmails
  - _name: MassUpdateAuthorBPAddressEmails
    label: Mass Update
    description: Mass update BP Address Email records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BPAddressEmail.steppers.AuthorBPAddressEmails
  - _name: Delete
    label: Delete
    description: Delete selected BP Address Email records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPAddressEmails
    label: Import
    description: Import BP Address Email records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPAddressEmail.steppers.BPAddressEmailImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
