_name: ToleranceGroupActionSet
_package: sapbp360.entities.ToleranceGroup.action_sets
_type: ActionSet
entity: sapbp360.entities.ToleranceGroup.ToleranceGroup
label: Tolerance Group Action Set
description: Action set for managing Tolerance Groups in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorToleranceGroups
    label: Create
    description: Create a new Tolerance Group record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.ToleranceGroup.steppers.AuthorToleranceGroups
  - _name: EditAuthorToleranceGroups
    label: Edit
    description: Edit Tolerance Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.ToleranceGroup.steppers.AuthorToleranceGroups
  - _name: MassUpdateAuthorToleranceGroups
    label: Mass Update
    description: Mass update Tolerance Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.ToleranceGroup.steppers.AuthorToleranceGroups
  - _name: Delete
    label: Delete
    description: Delete selected Tolerance Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorToleranceGroups
    label: Import
    description: Import Tolerance Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.ToleranceGroup.steppers.ToleranceGroupImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
