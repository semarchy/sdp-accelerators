_name: LanguageActionSet
_package: sapbp360.entities.Language.action_sets
_type: ActionSet
entity: sapbp360.entities.Language.Language
label: Language Action Set
description: Action set for managing Languages in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorLanguages
    label: Create
    description: Create a new Language record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.Language.steppers.AuthorLanguages
  - _name: EditAuthorLanguages
    label: Edit
    description: Edit Language records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.Language.steppers.AuthorLanguages
  - _name: MassUpdateAuthorLanguages
    label: Mass Update
    description: Mass update Language records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.Language.steppers.AuthorLanguages
  - _name: Delete
    label: Delete
    description: Delete selected Language records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorLanguages
    label: Import
    description: Import Language records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.Language.steppers.LanguageImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
