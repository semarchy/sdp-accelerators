_name: PlanningCycleActionSet
_package: sapbp360.entities.PlanningCycle.action_sets
_type: ActionSet
entity: sapbp360.entities.PlanningCycle.PlanningCycle
label: Planning Cycle Action Set
description: Action set for managing Planning Cycles in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorPlanningCycles
    label: Create
    description: Create a new Planning Cycle record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.PlanningCycle.steppers.AuthorPlanningCycles
  - _name: EditAuthorPlanningCycles
    label: Edit
    description: Edit Planning Cycle records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.PlanningCycle.steppers.AuthorPlanningCycles
  - _name: MassUpdateAuthorPlanningCycles
    label: Mass Update
    description: Mass update Planning Cycle records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.PlanningCycle.steppers.AuthorPlanningCycles
  - _name: Delete
    label: Delete
    description: Delete selected Planning Cycle records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorPlanningCycles
    label: Import
    description: Import Planning Cycle records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.PlanningCycle.steppers.PlanningCycleImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
