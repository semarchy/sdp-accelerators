_package: sapbp360.entities.PlanningCycle.collection_views
_name: PlanningCycleCollection
_type: CollectionView
entity: sapbp360.entities.PlanningCycle.PlanningCycle
default: true
displayCard: sapbp360.entities.PlanningCycle.display_cards.PlanningCycleDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Planning Cycle
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: PlanningCycleID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PlanningCycleID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: PlanningCycleCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PlanningCycleCode
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: PlanningCycleName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PlanningCycleName
    visibleByDefault: true
    defaultWidth: 220
