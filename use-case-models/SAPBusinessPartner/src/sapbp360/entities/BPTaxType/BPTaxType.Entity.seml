    physicalName: BP_TAX_TYPE_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: BP Tax Type Code
    documentation: Code for the bp tax type.
    description: Code for the bp tax type.
    mandatory: true
    length: 80
    mandatoryValidationLabel: BP Tax Type Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
