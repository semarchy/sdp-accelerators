    physicalName: BP_TAX_TYPE_NAME
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: BP Tax Type Name
    documentation: Name of the bp tax type.
    description: Name of the bp tax type.
    mandatory: true
    length: 255
    mandatoryValidationLabel: BP Tax Type Name is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: Description
    physicalName: DESC_X
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Description
    documentation: Description for the bp tax type.
    description: Description for the bp tax type.
    mandatory: false
    length: 512
