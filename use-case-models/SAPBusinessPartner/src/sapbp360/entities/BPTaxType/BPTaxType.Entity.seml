    documentation: Unique identifier for the bp tax type.
    description: Unique identifier for the bp tax type.
    mandatory: true
    length: 128
    mandatoryValidationLabel: BP Tax Type ID is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
