displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
entity: sapbp360.entities.Region.Region
rootLabel: Region
rootPluralLabel: Regions
useHierarchyOnOpen: false
label: Region
description: Business view for Region.
rootBusinessViewEntity:
  _name: Region
  _type: BusinessViewEntity
  collection: sapbp360.entities.Region.collection_views.RegionCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: sapbp360.entities.Region.Region
  form: sapbp360.entities.Region.forms.RegionBrowsingForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  tableAllowed: true
  actionSet: sapbp360.entities.Region.action_sets.RegionActionSet
  displayCard: sapbp360.entities.Region.display_cards.RegionDisplayCard
  sortExpression: RegionName
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs: []
  transitions:
