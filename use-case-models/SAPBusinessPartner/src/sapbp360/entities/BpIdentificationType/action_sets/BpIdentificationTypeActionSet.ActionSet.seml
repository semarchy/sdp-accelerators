_name: BpIdentificationTypeActionSet
_package: sapbp360.entities.BpIdentificationType.action_sets
_type: ActionSet
entity: sapbp360.entities.BpIdentificationType.BpIdentificationType
label: BP Identification Type Action Set
description: Action set for managing BP Identification Types in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPIdentificationTypes
    label: Create
    description: Create a new BP Identification Type record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BpIdentificationType.steppers.AuthorBPIdentificationTypes
  - _name: EditAuthorBPIdentificationTypes
    label: Edit
    description: Edit BP Identification Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BpIdentificationType.steppers.AuthorBPIdentificationTypes
  - _name: MassUpdateAuthorBPIdentificationTypes
    label: Mass Update
    description: Mass update BP Identification Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BpIdentificationType.steppers.AuthorBPIdentificationTypes
  - _name: Delete
    label: Delete
    description: Delete selected BP Identification Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPIdentificationTypes
    label: Import
    description: Import BP Identification Type records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BpIdentificationType.steppers.BpIdentificationTypeImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
