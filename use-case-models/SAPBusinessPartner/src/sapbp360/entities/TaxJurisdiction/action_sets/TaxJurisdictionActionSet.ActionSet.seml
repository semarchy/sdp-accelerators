_name: TaxJurisdictionActionSet
_package: sapbp360.entities.TaxJurisdiction.action_sets
_type: ActionSet
entity: sapbp360.entities.TaxJurisdiction.TaxJurisdiction
label: Tax Jurisdiction Action Set
description: Action set for managing Tax Jurisdictions in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorTaxJurisdictions
    label: Create
    description: Create a new Tax Jurisdiction record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.TaxJurisdiction.steppers.AuthorTaxJurisdictions
  - _name: EditAuthorTaxJurisdictions
    label: Edit
    description: Edit Tax Jurisdiction records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.TaxJurisdiction.steppers.AuthorTaxJurisdictions
  - _name: MassUpdateAuthorTaxJurisdictions
    label: Mass Update
    description: Mass update Tax Jurisdiction records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.TaxJurisdiction.steppers.AuthorTaxJurisdictions
  - _name: Delete
    label: Delete
    description: Delete selected Tax Jurisdiction records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorTaxJurisdictions
    label: Import
    description: Import Tax Jurisdiction records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.TaxJurisdiction.steppers.TaxJurisdictionImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
