# Tax Jurisdiction entity for the SAP Business Partner 360 accelerator.
_name: TaxJurisdiction
_package: sapbp360.entities.TaxJurisdiction
_type: Entity
primaryKey: sapbp360.entities.TaxJurisdiction.TaxJurisdiction.TaxJurisdictionID
sourceIdGeneration:
  mode: SEMQL
  idExpression: TaxJurisdictionCode
label: Tax Jurisdiction
documentation: Tax Jurisdiction reference data used by the SAP Business Partner 360 model.
description: Tax Jurisdiction reference data used by the SAP Business Partner 360 model.
enableDelete: true
entityType: BASIC
iconUrl: images://sapbusinesspartner/TaxJurisdiction.svg
pluralLabel: Tax Jurisdictions
historizeGolden: true
historizeMaster: false
physicalTableName: TAX_JURIS
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: TaxJurisdictionID
    physicalName: TAX_JURIS_ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Tax Jurisdiction ID
    documentation: Unique identifier for the tax jurisdiction.
    description: Unique identifier for the tax jurisdiction.
    mandatory: true
    length: 128
    mandatoryValidationLabel: Tax Jurisdiction ID is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: TaxJurisdictionCode
    physicalName: TAX_JURIS_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Tax Jurisdiction Code
    documentation: Code for the tax jurisdiction.
    description: Code for the tax jurisdiction.
    mandatory: true
    length: 80
    mandatoryValidationLabel: Tax Jurisdiction Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: TaxJurisdictionName
    physicalName: TAX_JURIS_NAME
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Tax Jurisdiction Name
    documentation: Name of the tax jurisdiction.
    description: Name of the tax jurisdiction.
    mandatory: true
    length: 255
    mandatoryValidationLabel: Tax Jurisdiction Name is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: Description
    physicalName: DESC_X
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Description
    documentation: Description for the tax jurisdiction.
    description: Description for the tax jurisdiction.
    mandatory: false
    length: 512
    searchable: true
  - _type: EntityAttribute
    _name: Active
    physicalName: ACTIVE
    dataType: Boolean
    goldenAttribute: true
    label: Active
    documentation: Indicates whether the tax jurisdiction is active.
    description: Indicates whether the tax jurisdiction is active.
    mandatory: false
    length: 1
    searchable: true
