# Long Text ID entity for the SAP Business Partner 360 accelerator.
_name: LongTextID
_package: sapbp360.entities.LongTextID
_type: Entity
primaryKey: sapbp360.entities.LongTextID.LongTextID.LongTextIDID
sourceIdGeneration:
  mode: SEMQL
  idExpression: LongTextIDCode
label: Long Text ID
documentation: Long Text ID reference data used by the SAP Business Partner 360 model.
description: Long Text ID reference data used by the SAP Business Partner 360 model.
enableDelete: true
entityType: BASIC
iconUrl: images://sapbusinesspartner/LongTextID.svg
pluralLabel: Long Text IDs
historizeGolden: true
historizeMaster: false
physicalTableName: LONG_TEXT_ID
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: LongTextIDID
    physicalName: LONG_TEXT_IDID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Long Text ID ID
    documentation: Unique identifier for the long text id.
    description: Unique identifier for the long text id.
    mandatory: true
    length: 128
    mandatoryValidationLabel: Long Text ID ID is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: LongTextIDCode
    physicalName: LONG_TEXT_ID_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Long Text ID Code
    documentation: Code for the long text id.
    description: Code for the long text id.
    mandatory: true
    length: 80
    mandatoryValidationLabel: Long Text ID Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: LongTextIDName
    physicalName: LONG_TEXT_ID_NAME
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Long Text ID Name
    documentation: Name of the long text id.
    description: Name of the long text id.
    mandatory: true
    length: 255
    mandatoryValidationLabel: Long Text ID Name is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: Description
    physicalName: DESC_X
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Description
    documentation: Description for the long text id.
    description: Description for the long text id.
    mandatory: false
    length: 512
    searchable: true
  - _type: EntityAttribute
    _name: Active
    physicalName: ACTIVE
    dataType: Boolean
    goldenAttribute: true
    label: Active
    documentation: Indicates whether the long text id is active.
    description: Indicates whether the long text id is active.
    mandatory: false
    length: 1
    searchable: true
