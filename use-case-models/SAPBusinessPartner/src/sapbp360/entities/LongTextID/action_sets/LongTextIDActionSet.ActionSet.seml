_name: LongTextIDActionSet
_package: sapbp360.entities.LongTextID.action_sets
_type: ActionSet
entity: sapbp360.entities.LongTextID.LongTextID
label: Long Text ID Action Set
description: Action set for managing Long Text IDs in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorLongTextIDs
    label: Create
    description: Create a new Long Text ID record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.LongTextID.steppers.AuthorLongTextIDs
  - _name: EditAuthorLongTextIDs
    label: Edit
    description: Edit Long Text ID records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.LongTextID.steppers.AuthorLongTextIDs
  - _name: MassUpdateAuthorLongTextIDs
    label: Mass Update
    description: Mass update Long Text ID records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.LongTextID.steppers.AuthorLongTextIDs
  - _name: Delete
    label: Delete
    description: Delete selected Long Text ID records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorLongTextIDs
    label: Import
    description: Import Long Text ID records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.LongTextID.steppers.LongTextIDImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
