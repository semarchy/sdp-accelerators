# Responsible Type entity for the SAP Business Partner 360 accelerator.
_name: ResponsibleType
_package: sapbp360.entities.ResponsibleType
_type: Entity
primaryKey: sapbp360.entities.ResponsibleType.ResponsibleType.ResponsibleTypeID
sourceIdGeneration:
  mode: SEMQL
  idExpression: ResponsibleTypeCode
label: Responsible Type
documentation: Responsible Type reference data used by the SAP Business Partner 360 model.
description: Responsible Type reference data used by the SAP Business Partner 360 model.
enableDelete: true
entityType: BASIC
iconUrl: images://sapbusinesspartner/ResponsibleType.svg
pluralLabel: Responsible Types
historizeGolden: true
historizeMaster: false
physicalTableName: RESP_TYPE
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: ResponsibleTypeID
    physicalName: RESP_TYPE_ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Responsible Type ID
    documentation: Unique identifier for the responsible type.
    description: Unique identifier for the responsible type.
    mandatory: true
    length: 128
    mandatoryValidationLabel: Responsible Type ID is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: ResponsibleTypeCode
    physicalName: RESP_TYPE_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Responsible Type Code
    documentation: Code for the responsible type.
    description: Code for the responsible type.
    mandatory: true
    length: 80
    mandatoryValidationLabel: Responsible Type Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: ResponsibleTypeName
    physicalName: RESP_TYPE_NAME
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Responsible Type Name
    documentation: Name of the responsible type.
    description: Name of the responsible type.
    mandatory: true
    length: 255
    mandatoryValidationLabel: Responsible Type Name is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: Description
    physicalName: DESC_X
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Description
    documentation: Description for the responsible type.
    description: Description for the responsible type.
    mandatory: false
    length: 512
    searchable: true
  - _type: EntityAttribute
    _name: Active
    physicalName: ACTIVE
    dataType: Boolean
    goldenAttribute: true
    label: Active
    documentation: Indicates whether the responsible type is active.
    description: Indicates whether the responsible type is active.
    mandatory: false
    length: 1
    searchable: true
