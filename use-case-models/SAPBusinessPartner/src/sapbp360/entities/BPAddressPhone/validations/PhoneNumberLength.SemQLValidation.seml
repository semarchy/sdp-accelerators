_type: SemQLValidation
entity: sapbp360.entities.BPAddressPhone.BPAddressPhone
_package: sapbp360.entities.BPAddressPhone.validations
_name: PhoneNumberLength
validationScope: PRE_CONSO
validationLabel: Phone Number must be between 5 and 30 characters.
condition: PhoneNumber is null or (length(PhoneNumber) >= 5 and length(PhoneNumber) <= 30)
label: Phone Number must be between 5 and 30 characters.
