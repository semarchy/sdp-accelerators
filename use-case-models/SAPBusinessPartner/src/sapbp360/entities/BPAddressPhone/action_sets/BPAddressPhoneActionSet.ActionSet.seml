_name: BPAddressPhoneActionSet
_package: sapbp360.entities.BPAddressPhone.action_sets
_type: ActionSet
entity: sapbp360.entities.BPAddressPhone.BPAddressPhone
label: BP Address Phone Action Set
description: Action set for managing BP Address Phones in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPAddressPhones
    label: Create
    description: Create a new BP Address Phone record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPAddressPhone.steppers.AuthorBPAddressPhones
  - _name: EditAuthorBPAddressPhones
    label: Edit
    description: Edit BP Address Phone records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPAddressPhone.steppers.AuthorBPAddressPhones
  - _name: MassUpdateAuthorBPAddressPhones
    label: Mass Update
    description: Mass update BP Address Phone records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BPAddressPhone.steppers.AuthorBPAddressPhones
  - _name: Delete
    label: Delete
    description: Delete selected BP Address Phone records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPAddressPhones
    label: Import
    description: Import BP Address Phone records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPAddressPhone.steppers.BPAddressPhoneImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
