# ABC Classification entity for the SAP Business Partner 360 accelerator.
_name: ABCClassification
_package: sapbp360.entities.ABCClassification
_type: Entity
primaryKey: sapbp360.entities.ABCClassification.ABCClassification.ABCClassificationID
sourceIdGeneration:
  mode: SEMQL
  idExpression: ABCClassificationCode
label: ABC Classification
documentation: ABC Classification reference data used by the SAP Business Partner 360 model.
description: ABC Classification reference data used by the SAP Business Partner 360 model.
enableDelete: true
entityType: BASIC
iconUrl: images://sapbusinesspartner/ABCClassification.svg
pluralLabel: ABC Classifications
historizeGolden: true
historizeMaster: false
physicalTableName: ABC_CLASS
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: ABCClassificationID
    physicalName: ABC_CLASS_ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: ABC Classification ID
    documentation: Unique identifier for the abc classification.
    description: Unique identifier for the abc classification.
    mandatory: true
    length: 128
    mandatoryValidationLabel: ABC Classification ID is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: ABCClassificationCode
    physicalName: ABC_CLASS_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: ABC Classification Code
    documentation: Code for the abc classification.
    description: Code for the abc classification.
    mandatory: true
    length: 80
    mandatoryValidationLabel: ABC Classification Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: ABCClassificationName
    physicalName: ABC_CLASS_NAME
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: ABC Classification Name
    documentation: Name of the abc classification.
    description: Name of the abc classification.
    mandatory: true
    length: 255
    mandatoryValidationLabel: ABC Classification Name is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: Description
    physicalName: DESC_X
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Description
    documentation: Description for the abc classification.
    description: Description for the abc classification.
    mandatory: false
    length: 512
    searchable: true
  - _type: EntityAttribute
    _name: Active
    physicalName: ACTIVE
    dataType: Boolean
    goldenAttribute: true
    label: Active
    documentation: Indicates whether the abc classification is active.
    description: Indicates whether the abc classification is active.
    mandatory: false
    length: 1
    searchable: true
