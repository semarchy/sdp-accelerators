_name: ReconciliationAccountActionSet
_package: sapbp360.entities.ReconciliationAccount.action_sets
_type: ActionSet
entity: sapbp360.entities.ReconciliationAccount.ReconciliationAccount
label: Reconciliation Account Action Set
description: Action set for managing Reconciliation Accounts in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorReconciliationAccounts
    label: Create
    description: Create a new Reconciliation Account record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.ReconciliationAccount.steppers.AuthorReconciliationAccounts
  - _name: EditAuthorReconciliationAccounts
    label: Edit
    description: Edit Reconciliation Account records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.ReconciliationAccount.steppers.AuthorReconciliationAccounts
  - _name: MassUpdateAuthorReconciliationAccounts
    label: Mass Update
    description: Mass update Reconciliation Account records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.ReconciliationAccount.steppers.AuthorReconciliationAccounts
  - _name: Delete
    label: Delete
    description: Delete selected Reconciliation Account records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorReconciliationAccounts
    label: Import
    description: Import Reconciliation Account records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.ReconciliationAccount.steppers.ReconciliationAccountImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
