_name: TradingPartnerActionSet
_package: sapbp360.entities.TradingPartner.action_sets
_type: ActionSet
entity: sapbp360.entities.TradingPartner.TradingPartner
label: Trading Partner Action Set
description: Action set for managing Trading Partners in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorTradingPartners
    label: Create
    description: Create a new Trading Partner record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.TradingPartner.steppers.AuthorTradingPartners
  - _name: EditAuthorTradingPartners
    label: Edit
    description: Edit Trading Partner records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.TradingPartner.steppers.AuthorTradingPartners
  - _name: MassUpdateAuthorTradingPartners
    label: Mass Update
    description: Mass update Trading Partner records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.TradingPartner.steppers.AuthorTradingPartners
  - _name: Delete
    label: Delete
    description: Delete selected Trading Partner records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorTradingPartners
    label: Import
    description: Import Trading Partner records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.TradingPartner.steppers.TradingPartnerImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
