_name: CashPlanningGroupActionSet
_package: sapbp360.entities.CashPlanningGroup.action_sets
_type: ActionSet
entity: sapbp360.entities.CashPlanningGroup.CashPlanningGroup
label: Cash Planning Group Action Set
description: Action set for managing Cash Planning Groups in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorCashPlanningGroups
    label: Create
    description: Create a new Cash Planning Group record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.CashPlanningGroup.steppers.AuthorCashPlanningGroups
  - _name: EditAuthorCashPlanningGroups
    label: Edit
    description: Edit Cash Planning Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.CashPlanningGroup.steppers.AuthorCashPlanningGroups
  - _name: MassUpdateAuthorCashPlanningGroups
    label: Mass Update
    description: Mass update Cash Planning Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.CashPlanningGroup.steppers.AuthorCashPlanningGroups
  - _name: Delete
    label: Delete
    description: Delete selected Cash Planning Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorCashPlanningGroups
    label: Import
    description: Import Cash Planning Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.CashPlanningGroup.steppers.CashPlanningGroupImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
