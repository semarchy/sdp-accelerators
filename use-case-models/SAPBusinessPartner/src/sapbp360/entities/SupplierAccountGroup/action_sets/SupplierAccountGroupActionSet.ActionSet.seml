_name: SupplierAccountGroupActionSet
_package: sapbp360.entities.SupplierAccountGroup.action_sets
_type: ActionSet
entity: sapbp360.entities.SupplierAccountGroup.SupplierAccountGroup
label: Supplier Account Group Action Set
description: Action set for managing Supplier Account Groups in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorSupplierAccountGroups
    label: Create
    description: Create a new Supplier Account Group record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.SupplierAccountGroup.steppers.AuthorSupplierAccountGroups
  - _name: EditAuthorSupplierAccountGroups
    label: Edit
    description: Edit Supplier Account Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.SupplierAccountGroup.steppers.AuthorSupplierAccountGroups
  - _name: MassUpdateAuthorSupplierAccountGroups
    label: Mass Update
    description: Mass update Supplier Account Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.SupplierAccountGroup.steppers.AuthorSupplierAccountGroups
  - _name: Delete
    label: Delete
    description: Delete selected Supplier Account Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorSupplierAccountGroups
    label: Import
    description: Import Supplier Account Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.SupplierAccountGroup.steppers.SupplierAccountGroupImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
