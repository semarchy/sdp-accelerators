# Alternative Payee entity for the SAP Business Partner 360 accelerator.
_name: AlternativePayee
_package: sapbp360.entities.AlternativePayee
_type: Entity
primaryKey: sapbp360.entities.AlternativePayee.AlternativePayee.AlternativePayeeID
sourceIdGeneration:
  mode: SEMQL
  idExpression: AlternativePayeeCode
label: Alternative Payee
documentation: Alternative Payee reference data used by the SAP Business Partner 360 model.
description: Alternative Payee reference data used by the SAP Business Partner 360 model.
enableDelete: true
entityType: BASIC
iconUrl: images://sapbusinesspartner/AlternativePayee.svg
pluralLabel: Alternative Payees
historizeGolden: true
historizeMaster: false
physicalTableName: ALT_PAYEE
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: AlternativePayeeID
    physicalName: ALT_PAYEE_ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Alternative Payee ID
    documentation: Unique identifier for the alternative payee.
    description: Unique identifier for the alternative payee.
    mandatory: true
    length: 128
    mandatoryValidationLabel: Alternative Payee ID is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: AlternativePayeeCode
    physicalName: ALT_PAYEE_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Alternative Payee Code
    documentation: Code for the alternative payee.
    description: Code for the alternative payee.
    mandatory: true
    length: 80
    mandatoryValidationLabel: Alternative Payee Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: AlternativePayeeName
    physicalName: ALT_PAYEE_NAME
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Alternative Payee Name
    documentation: Name of the alternative payee.
    description: Name of the alternative payee.
    mandatory: true
    length: 255
    mandatoryValidationLabel: Alternative Payee Name is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: Description
    physicalName: DESC_X
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Description
    documentation: Description for the alternative payee.
    description: Description for the alternative payee.
    mandatory: false
    length: 512
    searchable: true
  - _type: EntityAttribute
    _name: Active
    physicalName: ACTIVE
    dataType: Boolean
    goldenAttribute: true
    label: Active
