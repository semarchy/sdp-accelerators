_name: AlternativePayeeActionSet
_package: sapbp360.entities.AlternativePayee.action_sets
_type: ActionSet
entity: sapbp360.entities.AlternativePayee.AlternativePayee
label: Alternative Payee Action Set
description: Action set for managing Alternative Payees in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorAlternativePayees
    label: Create
    description: Create a new Alternative Payee record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.AlternativePayee.steppers.AuthorAlternativePayees
  - _name: EditAuthorAlternativePayees
    label: Edit
    description: Edit Alternative Payee records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.AlternativePayee.steppers.AuthorAlternativePayees
  - _name: MassUpdateAuthorAlternativePayees
    label: Mass Update
    description: Mass update Alternative Payee records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.AlternativePayee.steppers.AuthorAlternativePayees
  - _name: Delete
    label: Delete
    description: Delete selected Alternative Payee records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorAlternativePayees
    label: Import
    description: Import Alternative Payee records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.AlternativePayee.steppers.AlternativePayeeImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
