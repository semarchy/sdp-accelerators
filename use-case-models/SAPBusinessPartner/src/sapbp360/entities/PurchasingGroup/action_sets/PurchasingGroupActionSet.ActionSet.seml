_name: PurchasingGroupActionSet
_package: sapbp360.entities.PurchasingGroup.action_sets
_type: ActionSet
entity: sapbp360.entities.PurchasingGroup.PurchasingGroup
label: Purchasing Group Action Set
description: Action set for managing Purchasing Groups in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorPurchasingGroups
    label: Create
    description: Create a new Purchasing Group record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.PurchasingGroup.steppers.AuthorPurchasingGroups
  - _name: EditAuthorPurchasingGroups
    label: Edit
    description: Edit Purchasing Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.PurchasingGroup.steppers.AuthorPurchasingGroups
  - _name: MassUpdateAuthorPurchasingGroups
    label: Mass Update
    description: Mass update Purchasing Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.PurchasingGroup.steppers.AuthorPurchasingGroups
  - _name: Delete
    label: Delete
    description: Delete selected Purchasing Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorPurchasingGroups
    label: Import
    description: Import Purchasing Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.PurchasingGroup.steppers.PurchasingGroupImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
