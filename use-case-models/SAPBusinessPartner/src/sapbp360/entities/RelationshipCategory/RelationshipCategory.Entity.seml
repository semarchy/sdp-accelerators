    length: 80
    mandatoryValidationLabel: Relationship Category Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: RelationshipCategoryName
    physicalName: REL_CAT_NAME
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Relationship Category Name
