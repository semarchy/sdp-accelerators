physicalTableName: REL_CAT
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: RelationshipCategoryID
    physicalName: REL_CAT_ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Relationship Category ID
    documentation: Unique identifier for the relationship category.
    description: Unique identifier for the relationship category.
    mandatory: true
    length: 128
    mandatoryValidationLabel: Relationship Category ID is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: RelationshipCategoryCode
    physicalName: REL_CAT_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
