_name: RelationshipCategoryActionSet
_package: sapbp360.entities.RelationshipCategory.action_sets
_type: ActionSet
entity: sapbp360.entities.RelationshipCategory.RelationshipCategory
label: Relationship Category Action Set
description: Action set for managing Relationship Categories in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorRelationshipCategories
    label: Create
    description: Create a new Relationship Category record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.RelationshipCategory.steppers.AuthorRelationshipCategories
  - _name: EditAuthorRelationshipCategories
    label: Edit
    description: Edit Relationship Category records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.RelationshipCategory.steppers.AuthorRelationshipCategories
  - _name: MassUpdateAuthorRelationshipCategories
    label: Mass Update
    description: Mass update Relationship Category records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.RelationshipCategory.steppers.AuthorRelationshipCategories
  - _name: Delete
    label: Delete
    description: Delete selected Relationship Category records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorRelationshipCategories
    label: Import
    description: Import Relationship Category records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.RelationshipCategory.steppers.RelationshipCategoryImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
