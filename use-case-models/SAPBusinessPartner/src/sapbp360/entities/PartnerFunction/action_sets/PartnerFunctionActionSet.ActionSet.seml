_name: PartnerFunctionActionSet
_package: sapbp360.entities.PartnerFunction.action_sets
_type: ActionSet
entity: sapbp360.entities.PartnerFunction.PartnerFunction
label: Partner Function Action Set
description: Action set for managing Partner Functions in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorPartnerFunctions
    label: Create
    description: Create a new Partner Function record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.PartnerFunction.steppers.AuthorPartnerFunctions
  - _name: EditAuthorPartnerFunctions
    label: Edit
    description: Edit Partner Function records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.PartnerFunction.steppers.AuthorPartnerFunctions
  - _name: MassUpdateAuthorPartnerFunctions
    label: Mass Update
    description: Mass update Partner Function records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.PartnerFunction.steppers.AuthorPartnerFunctions
  - _name: Delete
    label: Delete
    description: Delete selected Partner Function records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorPartnerFunctions
    label: Import
    description: Import Partner Function records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.PartnerFunction.steppers.PartnerFunctionImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
