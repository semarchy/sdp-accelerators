    physicalName: ADDR_USAGE_CODE
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Address Usage Code
    documentation: Code for the address usage.
    description: Code for the address usage.
    mandatory: true
    length: 80
    mandatoryValidationLabel: Address Usage Code is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
