_name: AddressUsageActionSet
_package: sapbp360.entities.AddressUsage.action_sets
_type: ActionSet
entity: sapbp360.entities.AddressUsage.AddressUsage
label: Address Usage Action Set
description: Action set for managing Address Usages in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorAddressUsages
    label: Create
    description: Create a new Address Usage record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.AddressUsage.steppers.AuthorAddressUsages
  - _name: EditAuthorAddressUsages
    label: Edit
    description: Edit Address Usage records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.AddressUsage.steppers.AuthorAddressUsages
  - _name: MassUpdateAuthorAddressUsages
    label: Mass Update
    description: Mass update Address Usage records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.AddressUsage.steppers.AuthorAddressUsages
  - _name: Delete
    label: Delete
    description: Delete selected Address Usage records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorAddressUsages
    label: Import
    description: Import Address Usage records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.AddressUsage.steppers.AddressUsageImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
