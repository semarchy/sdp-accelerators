# Master records collection view for Supplier Purchasing Org.
# Displays the contributing master (source) records with their publisher and source identifiers.
_package: sapbp360.entities.SupplierPurchasingOrg.collection_views
_name: SupplierPurchasingOrgMasterCollection
_type: CollectionView
entity: sapbp360.entities.SupplierPurchasingOrg.SupplierPurchasingOrg
default: false
displayCard: sapbp360.entities.SupplierPurchasingOrg.display_cards.SupplierPurchasingOrgDisplayCard
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: false
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: PublisherID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PublisherID
    visibleByDefault: true
  - _type: TextColumn
    _name: SourceID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SourceID
    visibleByDefault: true
  - _type: TextColumn
    _name: SupplierRespSalesPersonName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierRespSalesPersonName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: SupplierPhoneNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierPhoneNumber
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: IncotermsLocation1
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: IncotermsLocation1
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: MinimumOrderAmount
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: MinimumOrderAmount
    visibleByDefault: true
    defaultWidth: 160
  - _type: CheckboxColumn
    _name: SupplierIsBlockedForPurchasing
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: SupplierIsBlockedForPurchasing
    visibleByDefault: true
    componentProperties:
      useSwitch: "1"
      useSwitchValueInterpreter: LITERAL
