_name: BPRoleActionSet
_package: sapbp360.entities.BPRole.action_sets
_type: ActionSet
entity: sapbp360.entities.BPRole.BPRole
label: BP Role Action Set
description: Action set for managing BP Roles in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPRoles
    label: Create
    description: Create a new BP Role record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPRole.steppers.AuthorBPRoles
  - _name: EditAuthorBPRoles
    label: Edit
    description: Edit BP Role records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPRole.steppers.AuthorBPRoles
  - _name: MassUpdateAuthorBPRoles
    label: Mass Update
    description: Mass update BP Role records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BPRole.steppers.AuthorBPRoles
  - _name: Delete
    label: Delete
    description: Delete selected BP Role records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPRoles
    label: Import
    description: Import BP Role records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPRole.steppers.BPRoleImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction