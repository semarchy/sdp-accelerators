description: Business view for BP Address Usage.
rootBusinessViewEntity:
  _name: BPAddressUsage
  _type: BusinessViewEntity
  collection: sapbp360.entities.BPAddressUsage.collection_views.BPAddressUsageCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: sapbp360.entities.BPAddressUsage.BPAddressUsage
  form: sapbp360.entities.BPAddressUsage.forms.BPAddressUsageBrowsingForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
