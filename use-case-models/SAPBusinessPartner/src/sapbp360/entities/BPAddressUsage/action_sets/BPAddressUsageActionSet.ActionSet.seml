_name: BPAddressUsageActionSet
_package: sapbp360.entities.BPAddressUsage.action_sets
_type: ActionSet
entity: sapbp360.entities.BPAddressUsage.BPAddressUsage
label: BP Address Usage Action Set
description: Action set for managing BP Address Usages in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPAddressUsages
    label: Create
    description: Create a new BP Address Usage record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPAddressUsage.steppers.AuthorBPAddressUsages
  - _name: EditAuthorBPAddressUsages
    label: Edit
    description: Edit BP Address Usage records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPAddressUsage.steppers.AuthorBPAddressUsages
  - _name: MassUpdateAuthorBPAddressUsages
    label: Mass Update
    description: Mass update BP Address Usage records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BPAddressUsage.steppers.AuthorBPAddressUsages
  - _name: Delete
    label: Delete
    description: Delete selected BP Address Usage records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPAddressUsages
    label: Import
    description: Import BP Address Usage records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPAddressUsage.steppers.BPAddressUsageImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
