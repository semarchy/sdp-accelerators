_name: BPContactActionSet
_package: sapbp360.entities.BPContact.action_sets
_type: ActionSet
entity: sapbp360.entities.BPContact.BPContact
label: BP Contact Action Set
description: Action set for managing BP Contacts in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPContacts
    label: Create
    description: Create a new BP Contact record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPContact.steppers.AuthorBPContacts
  - _name: EditAuthorBPContacts
    label: Edit
    description: Edit BP Contact records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPContact.steppers.AuthorBPContacts
  - _name: MassUpdateAuthorBPContacts
    label: Mass Update
    description: Mass update BP Contact records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: true
    availableForGoldenData: true
    availableForMasterData: true
    stepper: sapbp360.entities.BPContact.steppers.AuthorBPContacts
  - _name: Delete
    label: Delete
    description: Delete selected BP Contact records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPContacts
    label: Import
    description: Import BP Contact records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: MASTER
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPContact.steppers.BPContactImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
  - _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    description: Directly confirm duplicates.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DirectConfirmDupsAction
  - _name: ReviewAndConfirmDuplicatesManageDuplicatesOnBPContact
    label: Review And Confirm Duplicates
    description: Review and confirm duplicate records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewAndConfirm
    dupsManager: sapbp360.entities.BPContact.dups_managers.ManageDuplicatesOnBPContact
    enableEdit: true
    mandateConfirmAll: false
  - _name: MergeOrSplitDuplicatesManageDuplicatesOnBPContact
    label: Merge Or Split Duplicates
    description: Merge or split duplicate records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MergeOrSplit
    dupsManager: sapbp360.entities.BPContact.dups_managers.ManageDuplicatesOnBPContact
    enableEdit: true
  - _name: ReviewSuggestionsDuplicatesManageDuplicatesOnBPContact
    label: Review Duplicate Suggestions
    description: Review duplicate suggestions.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewSuggestions
    dupsManager: sapbp360.entities.BPContact.dups_managers.ManageDuplicatesOnBPContact
    enableEdit: true
    mandateResolveAllSuggestions: false
    onAcceptPromptGoldenId: false
  - _name: ExplainRecord
    label: Explain Record
    description: Explain record details.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExplainRecordAction
    displayCard: sapbp360.entities.BPContact.display_cards.BPContactDisplayCard
    formTab: sapbp360.entities.BPContact.forms.BPContactBrowsingForm.Main
