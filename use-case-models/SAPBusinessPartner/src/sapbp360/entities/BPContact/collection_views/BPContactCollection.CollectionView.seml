_package: sapbp360.entities.BPContact.collection_views
_name: BPContactCollection
_type: CollectionView
entity: sapbp360.entities.BPContact.BPContact
default: true
displayCard: sapbp360.entities.BPContact.display_cards.BPContactDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: BP Contact
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: ContactFullName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: ContactFullName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: ValidityEndDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: ValidityEndDate
    visibleByDefault: true
    defaultWidth: 220
