# Master records collection view for BP Contact.
# Displays the contributing master (source) records with their publisher and source identifiers.
_package: sapbp360.entities.BPContact.collection_views
_name: BPContactMasterCollection
_type: CollectionView
entity: sapbp360.entities.BPContact.BPContact
default: false
displayCard: sapbp360.entities.BPContact.display_cards.BPContactDisplayCard
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: false
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: PublisherID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PublisherID
    visibleByDefault: true
  - _type: TextColumn
    _name: SourceID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SourceID
    visibleByDefault: true
  - _type: TextColumn
    _name: ContactFullName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: ContactFullName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: ValidityEndDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: ValidityEndDate
    visibleByDefault: true
    defaultWidth: 220
