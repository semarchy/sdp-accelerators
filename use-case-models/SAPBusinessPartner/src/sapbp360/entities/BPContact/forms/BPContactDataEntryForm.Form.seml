# BPContactDataEntryForm form for BP Contact.
# Laid out like the BUSINESS_PARTNER forms: labelled sections, each holding a ROW
# container of COLUMN containers.
_package: sapbp360.entities.BPContact.forms
_type: Form
_name: BPContactDataEntryForm
entity: sapbp360.entities.BPContact.BPContact
default: false
formTabs:
