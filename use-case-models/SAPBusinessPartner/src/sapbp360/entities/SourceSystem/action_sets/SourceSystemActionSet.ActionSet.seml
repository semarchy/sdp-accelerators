_name: SourceSystemActionSet
_package: sapbp360.entities.SourceSystem.action_sets
_type: ActionSet
entity: sapbp360.entities.SourceSystem.SourceSystem
label: Source System Action Set
description: Action set for managing Source Systems in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorSourceSystems
    label: Create
    description: Create a new Source System record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.SourceSystem.steppers.AuthorSourceSystems
  - _name: EditAuthorSourceSystems
    label: Edit
    description: Edit Source System records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.SourceSystem.steppers.AuthorSourceSystems
  - _name: MassUpdateAuthorSourceSystems
    label: Mass Update
    description: Mass update Source System records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.SourceSystem.steppers.AuthorSourceSystems
  - _name: Delete
    label: Delete
    description: Delete selected Source System records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorSourceSystems
    label: Import
    description: Import Source System records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.SourceSystem.steppers.SourceSystemImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
