_name: PaymentBlockingReasonActionSet
_package: sapbp360.entities.PaymentBlockingReason.action_sets
_type: ActionSet
entity: sapbp360.entities.PaymentBlockingReason.PaymentBlockingReason
label: Payment Blocking Reason Action Set
description: Action set for managing Payment Blocking Reasons in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorPaymentBlockingReasons
    label: Create
    description: Create a new Payment Blocking Reason record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.PaymentBlockingReason.steppers.AuthorPaymentBlockingReasons
  - _name: EditAuthorPaymentBlockingReasons
    label: Edit
    description: Edit Payment Blocking Reason records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.PaymentBlockingReason.steppers.AuthorPaymentBlockingReasons
  - _name: MassUpdateAuthorPaymentBlockingReasons
    label: Mass Update
    description: Mass update Payment Blocking Reason records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.PaymentBlockingReason.steppers.AuthorPaymentBlockingReasons
  - _name: Delete
    label: Delete
    description: Delete selected Payment Blocking Reason records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorPaymentBlockingReasons
    label: Import
    description: Import Payment Blocking Reason records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.PaymentBlockingReason.steppers.PaymentBlockingReasonImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
