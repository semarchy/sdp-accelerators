description: Business view for reviewing duplicate Suppliers.
rootBusinessViewEntity:
  _name: Supplier
  _type: BusinessViewEntity
  collection: sapbp360.entities.Supplier.collection_views.SupplierCollection
  displayRecordCount: ALWAYS
