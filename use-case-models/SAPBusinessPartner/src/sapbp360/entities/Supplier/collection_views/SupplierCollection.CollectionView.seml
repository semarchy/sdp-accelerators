_package: sapbp360.entities.Supplier.collection_views
_name: SupplierCollection
_type: CollectionView
entity: sapbp360.entities.Supplier.Supplier
default: true
displayCard: sapbp360.entities.Supplier.display_cards.SupplierDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Supplier
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: Supplier
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Supplier
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: SupplierName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: VATRegistration
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: VATRegistration
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: SupplierFullName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierFullName
    visibleByDefault: true
    defaultWidth: 220
  - _type: CheckboxColumn
    _name: PurchasingIsBlocked
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: PurchasingIsBlocked
    visibleByDefault: true
    componentProperties:
      useSwitch: "1"
      useSwitchValueInterpreter: LITERAL