# Master records collection view for Supplier.
# Displays the contributing master (source) records with their publisher and source identifiers.
_package: sapbp360.entities.Supplier.collection_views
_name: SupplierMasterCollection
_type: CollectionView
entity: sapbp360.entities.Supplier.Supplier
default: false
displayCard: sapbp360.entities.Supplier.display_cards.SupplierDisplayCard
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: false
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: PublisherID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PublisherID
    visibleByDefault: true
  - _type: TextColumn
    _name: SourceID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SourceID
    visibleByDefault: true
  - _type: TextColumn
    _name: Supplier
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Supplier
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: SupplierName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: VATRegistration
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: VATRegistration
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: SupplierFullName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SupplierFullName
    visibleByDefault: true
    defaultWidth: 220
  - _type: CheckboxColumn
    _name: PurchasingIsBlocked
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: PurchasingIsBlocked
    visibleByDefault: true
    componentProperties:
      useSwitch: "1"
      useSwitchValueInterpreter: LITERAL