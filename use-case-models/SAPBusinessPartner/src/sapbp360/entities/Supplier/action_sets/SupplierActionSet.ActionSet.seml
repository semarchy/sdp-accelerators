_name: SupplierActionSet
_package: sapbp360.entities.Supplier.action_sets
_type: ActionSet
entity: sapbp360.entities.Supplier.Supplier
label: Supplier Action Set
description: Action set for managing Suppliers in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: StartSupplierExtensionApprovalWorkflow
    _type: StartWorkflowEntityAction
    label: Start Supplier Extension
    description: Start Supplier Extension
    useCustomLabel: true
    waitDialogEnabled: false
    startEvent: sapbp360.workflows.SupplierExtensionApproval.StartFromScratch
  - _name: CreateAuthorSuppliers
    label: Create
    description: Create a new Supplier record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.Supplier.steppers.AuthorSuppliers
  - _name: EditAuthorSuppliers
    label: Edit
    description: Edit Supplier records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.Supplier.steppers.AuthorSuppliers
  - _name: MassUpdateAuthorSuppliers
    label: Mass Update
    description: Mass update Supplier records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: true
    availableForGoldenData: true
    availableForMasterData: true
    stepper: sapbp360.entities.Supplier.steppers.AuthorSuppliers
  - _name: Delete
    label: Delete
    description: Delete selected Supplier records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorSuppliers
    label: Import
    description: Import Supplier records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: MASTER
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.Supplier.steppers.SupplierImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
  - _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    description: Directly confirm duplicates.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DirectConfirmDupsAction
  - _name: ReviewAndConfirmDuplicatesManageDuplicatesOnSupplier
    label: Review And Confirm Duplicates
    description: Review and confirm duplicate records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewAndConfirm
    dupsManager: sapbp360.entities.Supplier.dups_managers.ManageDuplicatesOnSupplier
    enableEdit: true
    mandateConfirmAll: false
  - _name: MergeOrSplitDuplicatesManageDuplicatesOnSupplier
    label: Merge Or Split Duplicates
    description: Merge or split duplicate records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MergeOrSplit
    dupsManager: sapbp360.entities.Supplier.dups_managers.ManageDuplicatesOnSupplier
    enableEdit: true
  - _name: ReviewSuggestionsDuplicatesManageDuplicatesOnSupplier
    label: Review Duplicate Suggestions
    description: Review duplicate suggestions.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewSuggestions
    dupsManager: sapbp360.entities.Supplier.dups_managers.ManageDuplicatesOnSupplier
    enableEdit: true
    mandateResolveAllSuggestions: false
    onAcceptPromptGoldenId: false
  - _name: ExplainRecord
    label: Explain Record
    description: Explain record details.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExplainRecordAction
    displayCard: sapbp360.entities.Supplier.display_cards.SupplierDisplayCard
    formTab: sapbp360.entities.Supplier.forms.SupplierBrowsingForm.Main