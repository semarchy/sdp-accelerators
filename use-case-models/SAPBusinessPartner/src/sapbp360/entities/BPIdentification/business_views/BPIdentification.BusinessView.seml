_name: BPIdentification
_package: sapbp360.entities.BPIdentification.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
entity: sapbp360.entities.BPIdentification.BPIdentification
rootLabel: BP Identification
rootPluralLabel: BP Identifications
useHierarchyOnOpen: false
label: BP Identification
description: Business view for BP Identification.
rootBusinessViewEntity:
  _name: BPIdentification
  _type: BusinessViewEntity
  collection: sapbp360.entities.BPIdentification.collection_views.BPIdentificationCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: sapbp360.entities.BPIdentification.BPIdentification
  form: sapbp360.entities.BPIdentification.forms.BPIdentificationBrowsingForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  tableAllowed: true
  actionSet: sapbp360.entities.BPIdentification.action_sets.BPIdentificationActionSet
  displayCard: sapbp360.entities.BPIdentification.display_cards.BPIdentificationDisplayCard
  sortExpression: BpIdentificationNumber
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs:
    - formField: sapbp360.entities.BPIdentification.forms.BPIdentificationBrowsingForm.Main.MainRow.Col2.Col2Body.FDN_BpIdentificationType
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.BPIdentification.forms.BPIdentificationBrowsingForm.Main.MainRow.Col2.Col2Body.FDN_IssuingCountry
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.BPIdentification.forms.BPIdentificationBrowsingForm.Main.MainRow.Col2.Col2Body.FDN_BusinessPartner
      navigationMode: MODAL_FORM
  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
