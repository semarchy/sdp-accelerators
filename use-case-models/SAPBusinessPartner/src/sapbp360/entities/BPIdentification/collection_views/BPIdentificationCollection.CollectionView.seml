_package: sapbp360.entities.BPIdentification.collection_views
_name: BPIdentificationCollection
_type: CollectionView
entity: sapbp360.entities.BPIdentification.BPIdentification
default: true
displayCard: sapbp360.entities.BPIdentification.display_cards.BPIdentificationDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: BP Identification
tableShowDisplayCard: true
tableDisplayCardColumnWidth: 260
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: false
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: IdentificationID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: IdentificationID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: BpIdentificationNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: BpIdentificationNumber
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: InstitutionName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: InstitutionName
    visibleByDefault: true
    defaultWidth: 220
