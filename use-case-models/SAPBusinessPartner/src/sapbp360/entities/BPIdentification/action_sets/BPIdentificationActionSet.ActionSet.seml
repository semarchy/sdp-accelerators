_name: BPIdentificationActionSet
_package: sapbp360.entities.BPIdentification.action_sets
_type: ActionSet
entity: sapbp360.entities.BPIdentification.BPIdentification
label: BP Identification Action Set
description: Action set for managing BP Identifications in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPIdentifications
    label: Create
    description: Create a new BP Identification record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPIdentification.steppers.AuthorBPIdentifications
  - _name: EditAuthorBPIdentifications
    label: Edit
    description: Edit BP Identification records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPIdentification.steppers.AuthorBPIdentifications
  - _name: MassUpdateAuthorBPIdentifications
    label: Mass Update
    description: Mass update BP Identification records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BPIdentification.steppers.AuthorBPIdentifications
  - _name: Delete
    label: Delete
    description: Delete selected BP Identification records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPIdentifications
    label: Import
    description: Import BP Identification records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPIdentification.steppers.BPIdentificationImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
