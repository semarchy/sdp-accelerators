# BPBankBrowsingForm form for BP Bank.
# Laid out like the BUSINESS_PARTNER forms: labelled sections, each holding a ROW
# container of COLUMN containers.
_package: sapbp360.entities.BPBank.forms
_type: Form
_name: BPBankBrowsingForm
entity: sapbp360.entities.BPBank.BPBank
default: true
formTabs:
  - _name: Main
    _type: FormTab
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    iconUrl: images://mdi/bank-outline.svg
    label: Bank Account
    displayFormTabAs: ICON_LABEL
    content:
