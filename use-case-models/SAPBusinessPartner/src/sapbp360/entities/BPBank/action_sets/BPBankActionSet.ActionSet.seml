_name: BPBankActionSet
_package: sapbp360.entities.BPBank.action_sets
_type: ActionSet
entity: sapbp360.entities.BPBank.BPBank
label: BP Bank Action Set
description: Action set for managing BP Banks in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPBanks
    label: Create
    description: Create a new BP Bank record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPBank.steppers.AuthorBPBanks
  - _name: EditAuthorBPBanks
    label: Edit
    description: Edit BP Bank records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPBank.steppers.AuthorBPBanks
  - _name: MassUpdateAuthorBPBanks
    label: Mass Update
    description: Mass update BP Bank records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: true
    availableForGoldenData: true
    availableForMasterData: true
    stepper: sapbp360.entities.BPBank.steppers.AuthorBPBanks
  - _name: Delete
    label: Delete
    description: Delete selected BP Bank records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPBanks
    label: Import
    description: Import BP Bank records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: MASTER
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPBank.steppers.BPBankImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
  - _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    description: Directly confirm duplicates.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DirectConfirmDupsAction
  - _name: ReviewAndConfirmDuplicatesManageDuplicatesOnBPBank
    label: Review And Confirm Duplicates
    description: Review and confirm duplicate records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewAndConfirm
    dupsManager: sapbp360.entities.BPBank.dups_managers.ManageDuplicatesOnBPBank
    enableEdit: true
    mandateConfirmAll: false
  - _name: MergeOrSplitDuplicatesManageDuplicatesOnBPBank
    label: Merge Or Split Duplicates
    description: Merge or split duplicate records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MergeOrSplit
    dupsManager: sapbp360.entities.BPBank.dups_managers.ManageDuplicatesOnBPBank
    enableEdit: true
  - _name: ReviewSuggestionsDuplicatesManageDuplicatesOnBPBank
    label: Review Duplicate Suggestions
    description: Review duplicate suggestions.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewSuggestions
    dupsManager: sapbp360.entities.BPBank.dups_managers.ManageDuplicatesOnBPBank
    enableEdit: true
    mandateResolveAllSuggestions: false
    onAcceptPromptGoldenId: false
  - _name: ExplainRecord
    label: Explain Record
    description: Explain record details.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExplainRecordAction
    displayCard: sapbp360.entities.BPBank.display_cards.BPBankDisplayCard
    formTab: sapbp360.entities.BPBank.forms.BPBankBrowsingForm.Main
