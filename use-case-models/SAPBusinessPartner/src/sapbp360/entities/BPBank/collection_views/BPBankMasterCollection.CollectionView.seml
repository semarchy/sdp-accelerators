# Master records collection view for BP Bank.
# Displays the contributing master (source) records with their publisher and source identifiers.
_package: sapbp360.entities.BPBank.collection_views
_name: BPBankMasterCollection
_type: CollectionView
entity: sapbp360.entities.BPBank.BPBank
default: false
displayCard: sapbp360.entities.BPBank.display_cards.BPBankDisplayCard
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: false
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: PublisherID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PublisherID
    visibleByDefault: true
  - _type: TextColumn
    _name: SourceID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SourceID
    visibleByDefault: true
  - _type: TextColumn
    _name: BankIdentification
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: BankIdentification
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: BankAccount
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: BankAccount
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: IBAN
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: IBAN
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: BankAccountHolderName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: BankAccountHolderName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: SWIFTCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SWIFTCode
    visibleByDefault: true
    defaultWidth: 220
  - _type: DateColumn
    _name: ValidityStartDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: ValidityStartDate
    visibleByDefault: true
    defaultWidth: 180
