# BP Industry entity for the SAP Business Partner 360 accelerator.
_name: BPIndustry
_package: sapbp360.entities.BPIndustry
_type: Entity
primaryKey: sapbp360.entities.BPIndustry.BPIndustry.IndustryID
sourceIdGeneration:
  mode: MANUAL
label: BP Industry
documentation: Industry classifications assigned to a business partner.
description: Industry classifications assigned to a business partner.
enableDelete: true
entityType: BASIC
iconUrl: images://sapbusinesspartner/BPIndustry.svg
pluralLabel: BP Industries
historizeGolden: true
historizeMaster: false
physicalTableName: BP_INDUSTRY
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: IndustryID
    physicalName: INDUSTRY_ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: Industry ID
    documentation: Unique identifier for the industry assignment.
    description: Unique identifier for the industry assignment.
    mandatory: true
    length: 128
    mandatoryValidationLabel: Industry ID is mandatory
    mandatoryValidationScope: PRE_CONSO
    searchable: true
  - _type: EntityAttribute
    _name: IsStandardIndustry
    physicalName: IS_STD_INDUSTRY
    dataType: Boolean
    goldenAttribute: true
    label: Is Standard Industry
    documentation: Indicates whether this is the standard industry.
    description: Indicates whether this is the standard industry.
    mandatory: false
    length: 1
    searchable: true
