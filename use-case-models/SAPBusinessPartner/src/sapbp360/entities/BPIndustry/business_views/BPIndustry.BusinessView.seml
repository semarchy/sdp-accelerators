_name: BPIndustry
_package: sapbp360.entities.BPIndustry.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
entity: sapbp360.entities.BPIndustry.BPIndustry
rootLabel: BP Industry
rootPluralLabel: BP Industries
useHierarchyOnOpen: false
label: BP Industry
description: Business view for BP Industry.
rootBusinessViewEntity:
  _name: BPIndustry
  _type: BusinessViewEntity
  collection: sapbp360.entities.BPIndustry.collection_views.BPIndustryCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: sapbp360.entities.BPIndustry.BPIndustry
  form: sapbp360.entities.BPIndustry.forms.BPIndustryBrowsingForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  tableAllowed: true
  actionSet: sapbp360.entities.BPIndustry.action_sets.BPIndustryActionSet
  displayCard: sapbp360.entities.BPIndustry.display_cards.BPIndustryDisplayCard
  sortExpression: IndustryID
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs:
    - formField: sapbp360.entities.BPIndustry.forms.BPIndustryBrowsingForm.Main.MainRow.Col2.Col2Body.FDN_Industry
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.BPIndustry.forms.BPIndustryBrowsingForm.Main.MainRow.Col2.Col2Body.FDN_IndustrySector
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.BPIndustry.forms.BPIndustryBrowsingForm.Main.MainRow.Col2.Col2Body.FDN_BusinessPartner
      navigationMode: MODAL_FORM
  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: sapbp360.entities.BPIndustry.business_views.BPIndustry.BPIndustry
rootIconUrl: images://mdi/factory.svg
