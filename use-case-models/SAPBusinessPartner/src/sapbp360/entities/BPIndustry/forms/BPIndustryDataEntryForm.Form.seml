# BPIndustryDataEntryForm form for BP Industry.
_package: sapbp360.entities.BPIndustry.forms
_type: Form
_name: BPIndustryDataEntryForm
entity: sapbp360.entities.BPIndustry.BPIndustry
default: false
formTabs:
  - _name: Main
    _type: FormTab
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    iconUrl: images://mdi/format-list-checkbox.svg
    label: Main
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: MainRow
        layoutDirection: COLUMN
        content:
          - _type: FormSection
            _name: Col1
            label: "Identity"
            layoutDirection: COLUMN
            documentationInterpreter: LITERAL
            visibleValue: "1"
            visibleValueInterpreter: LITERAL
            content:
              - _type: FormContainer
                _name: Col1Body
                layoutDirection: COLUMN
                content:
                  - _name: IndustryID
                    value: IndustryID
                    dataType: STRING
                    useCustomLabel: false
                    documentationInterpreter: LITERAL
                    visibleValue: "1"
                    visibleValueInterpreter: LITERAL
                    _type: IdField
                    authoringMode: auto
                    authoringModeValueInterpreter: LITERAL
                    componentProperties:
                      textAlign: left
                      textAlignValueInterpreter: LITERAL
                      textTypography: body-1
                      textTypographyValueInterpreter: LITERAL
                    labelProperties:
                      position: top
                      positionValueInterpreter: LITERAL
                      alignment: left
                      alignmentValueInterpreter: LITERAL
                      typography: caption
                      typographyValueInterpreter: LITERAL
                      isVisible: "1"
                      isVisibleValueInterpreter: LITERAL
          - _type: FormSection
            _name: Col2
            label: "References"
            layoutDirection: COLUMN
            documentationInterpreter: LITERAL
            visibleValue: "1"
            visibleValueInterpreter: LITERAL
            content:
