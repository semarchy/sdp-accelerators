_name: BPIndustryActionSet
_package: sapbp360.entities.BPIndustry.action_sets
_type: ActionSet
entity: sapbp360.entities.BPIndustry.BPIndustry
label: BP Industry Action Set
description: Action set for managing BP Industries in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPIndustries
    label: Create
    description: Create a new BP Industry record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPIndustry.steppers.AuthorBPIndustries
  - _name: EditAuthorBPIndustries
    label: Edit
    description: Edit BP Industry records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPIndustry.steppers.AuthorBPIndustries
  - _name: MassUpdateAuthorBPIndustries
    label: Mass Update
    description: Mass update BP Industry records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BPIndustry.steppers.AuthorBPIndustries
  - _name: Delete
    label: Delete
    description: Delete selected BP Industry records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPIndustries
    label: Import
    description: Import BP Industry records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPIndustry.steppers.BPIndustryImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
