_name: PurchasingOrganizationActionSet
_package: sapbp360.entities.PurchasingOrganization.action_sets
_type: ActionSet
entity: sapbp360.entities.PurchasingOrganization.PurchasingOrganization
label: Purchasing Organization Action Set
description: Action set for managing Purchasing Organizations in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorPurchasingOrganizations
    label: Create
    description: Create a new Purchasing Organization record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.PurchasingOrganization.steppers.AuthorPurchasingOrganizations
  - _name: EditAuthorPurchasingOrganizations
    label: Edit
    description: Edit Purchasing Organization records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.PurchasingOrganization.steppers.AuthorPurchasingOrganizations
  - _name: MassUpdateAuthorPurchasingOrganizations
    label: Mass Update
    description: Mass update Purchasing Organization records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.PurchasingOrganization.steppers.AuthorPurchasingOrganizations
  - _name: Delete
    label: Delete
    description: Delete selected Purchasing Organization records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorPurchasingOrganizations
    label: Import
    description: Import Purchasing Organization records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.PurchasingOrganization.steppers.PurchasingOrganizationImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
