_name: AuthorizationGroupActionSet
_package: sapbp360.entities.AuthorizationGroup.action_sets
_type: ActionSet
entity: sapbp360.entities.AuthorizationGroup.AuthorizationGroup
label: Authorization Group Action Set
description: Action set for managing Authorization Groups in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorAuthorizationGroups
    label: Create
    description: Create a new Authorization Group record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.AuthorizationGroup.steppers.AuthorAuthorizationGroups
  - _name: EditAuthorAuthorizationGroups
    label: Edit
    description: Edit Authorization Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.AuthorizationGroup.steppers.AuthorAuthorizationGroups
  - _name: MassUpdateAuthorAuthorizationGroups
    label: Mass Update
    description: Mass update Authorization Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.AuthorizationGroup.steppers.AuthorAuthorizationGroups
  - _name: Delete
    label: Delete
    description: Delete selected Authorization Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorAuthorizationGroups
    label: Import
    description: Import Authorization Group records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.AuthorizationGroup.steppers.AuthorizationGroupImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
