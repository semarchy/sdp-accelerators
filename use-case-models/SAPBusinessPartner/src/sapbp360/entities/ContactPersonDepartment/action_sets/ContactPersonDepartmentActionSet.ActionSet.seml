_name: ContactPersonDepartmentActionSet
_package: sapbp360.entities.ContactPersonDepartment.action_sets
_type: ActionSet
entity: sapbp360.entities.ContactPersonDepartment.ContactPersonDepartment
label: Contact Person Department Action Set
description: Action set for managing Contact Person Departments in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorContactPersonDepartments
    label: Create
    description: Create a new Contact Person Department record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.ContactPersonDepartment.steppers.AuthorContactPersonDepartments
  - _name: EditAuthorContactPersonDepartments
    label: Edit
    description: Edit Contact Person Department records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.ContactPersonDepartment.steppers.AuthorContactPersonDepartments
  - _name: MassUpdateAuthorContactPersonDepartments
    label: Mass Update
    description: Mass update Contact Person Department records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.ContactPersonDepartment.steppers.AuthorContactPersonDepartments
  - _name: Delete
    label: Delete
    description: Delete selected Contact Person Department records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorContactPersonDepartments
    label: Import
    description: Import Contact Person Department records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.ContactPersonDepartment.steppers.ContactPersonDepartmentImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
