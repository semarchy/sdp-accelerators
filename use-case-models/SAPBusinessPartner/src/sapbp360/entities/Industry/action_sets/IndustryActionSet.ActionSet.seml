_name: IndustryActionSet
_package: sapbp360.entities.Industry.action_sets
_type: ActionSet
entity: sapbp360.entities.Industry.Industry
label: Industry Action Set
description: Action set for managing Industries in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorIndustries
    label: Create
    description: Create a new Industry record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.Industry.steppers.AuthorIndustries
  - _name: EditAuthorIndustries
    label: Edit
    description: Edit Industry records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.Industry.steppers.AuthorIndustries
  - _name: MassUpdateAuthorIndustries
    label: Mass Update
    description: Mass update Industry records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.Industry.steppers.AuthorIndustries
  - _name: Delete
    label: Delete
    description: Delete selected Industry records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorIndustries
    label: Import
    description: Import Industry records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.Industry.steppers.IndustryImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
