_name: SortKeyActionSet
_package: sapbp360.entities.SortKey.action_sets
_type: ActionSet
entity: sapbp360.entities.SortKey.SortKey
label: Sort Key Action Set
description: Action set for managing Sort Keys in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorSortKeys
    label: Create
    description: Create a new Sort Key record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.SortKey.steppers.AuthorSortKeys
  - _name: EditAuthorSortKeys
    label: Edit
    description: Edit Sort Key records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.SortKey.steppers.AuthorSortKeys
  - _name: MassUpdateAuthorSortKeys
    label: Mass Update
    description: Mass update Sort Key records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.SortKey.steppers.AuthorSortKeys
  - _name: Delete
    label: Delete
    description: Delete selected Sort Key records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorSortKeys
    label: Import
    description: Import Sort Key records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.SortKey.steppers.SortKeyImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
