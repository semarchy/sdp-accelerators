  - _name: MassUpdateAuthorBusinessPartnerGroupings
    label: Mass Update
    description: Mass update Business Partner Grouping records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BusinessPartnerGrouping.steppers.AuthorBusinessPartnerGroupings
  - _name: Delete
    label: Delete
    description: Delete selected Business Partner Grouping records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBusinessPartnerGroupings
    label: Import
    description: Import Business Partner Grouping records.
