description: Action set for managing Business Partner Groupings in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBusinessPartnerGroupings
    label: Create
    description: Create a new Business Partner Grouping record.
    useCustomLabel: true
    waitDialogEnabled: false
