_name: BPStatusActionSet
_package: sapbp360.entities.BPStatus.action_sets
_type: ActionSet
entity: sapbp360.entities.BPStatus.BPStatus
label: BP Status Action Set
description: Action set for managing BP Statuses in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPStatuses
    label: Create
    description: Create a new BP Status record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPStatus.steppers.AuthorBPStatuses
  - _name: EditAuthorBPStatuses
    label: Edit
    description: Edit BP Status records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPStatus.steppers.AuthorBPStatuses
  - _name: MassUpdateAuthorBPStatuses
    label: Mass Update
    description: Mass update BP Status records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.BPStatus.steppers.AuthorBPStatuses
  - _name: Delete
    label: Delete
    description: Delete selected BP Status records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPStatuses
    label: Import
    description: Import BP Status records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPStatus.steppers.BPStatusImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
