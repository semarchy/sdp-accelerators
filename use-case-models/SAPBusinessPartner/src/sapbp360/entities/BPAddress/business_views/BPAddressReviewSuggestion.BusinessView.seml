_name: BPAddressReviewSuggestion
_package: sapbp360.entities.BPAddress.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: false
entity: sapbp360.entities.BPAddress.BPAddress
rootLabel: BP Address Review Suggestion
rootPluralLabel: BP Address Review Suggestions
useHierarchyOnOpen: false
label: BP Address Review Suggestion
description: Business view for reviewing duplicate BP Addresses.
rootBusinessViewEntity:
  _name: BPAddress
  _type: BusinessViewEntity
  collection: sapbp360.entities.BPAddress.collection_views.BPAddressCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: sapbp360.entities.BPAddress.BPAddress
  form: sapbp360.entities.BPAddress.forms.BPAddressBrowsingForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  tableAllowed: true
  actionSet: sapbp360.entities.BPAddress.action_sets.BPAddressReviewSuggestionsActionSet
  displayCard: sapbp360.entities.BPAddress.display_cards.BPAddressDisplayCard
  sortExpression: CityName
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs:
    - formField: sapbp360.entities.BPAddress.forms.BPAddressBrowsingForm.Main.GeographyReferences.GeographyReferencesRow.GeographyReferencesCol2.FDN_Region
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.BPAddress.forms.BPAddressBrowsingForm.Main.GeographyReferences.GeographyReferencesRow.GeographyReferencesCol1.FDN_Country
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.BPAddress.forms.BPAddressBrowsingForm.Main.GeographyReferences.GeographyReferencesRow.GeographyReferencesCol2.FDN_AddressLanguage
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.BPAddress.forms.BPAddressBrowsingForm.Main.GeographyReferences.GeographyReferencesRow.GeographyReferencesCol3.FDN_TaxJurisdiction
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.BPAddress.forms.BPAddressBrowsingForm.Main.GeographyReferences.GeographyReferencesRow.GeographyReferencesCol1.FDN_TransportZone
      navigationMode: MODAL_FORM
    - formField: sapbp360.entities.BPAddress.forms.BPAddressBrowsingForm.Main.Identification.IdentificationRow.IdentificationCol1.FDN_BusinessPartner
      navigationMode: MODAL_FORM
  transitions: []
rootIconUrl: images://mdi/map-marker-outline.svg
rootFilter: HasSuggestedMerge = '1'
