# Master records collection view for BP Address.
# Displays the contributing master (source) records with their publisher and source identifiers.
_package: sapbp360.entities.BPAddress.collection_views
_name: BPAddressMasterCollection
_type: CollectionView
entity: sapbp360.entities.BPAddress.BPAddress
default: false
displayCard: sapbp360.entities.BPAddress.display_cards.BPAddressDisplayCard
tableAllowed: true
tableRowLines: 1
tableShowDisplayCard: false
listAllowed: false
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: false
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: TextColumn
    _name: PublisherID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PublisherID
    visibleByDefault: true
  - _type: TextColumn
    _name: SourceID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SourceID
    visibleByDefault: true
  - _type: TextColumn
    _name: AddressID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: AddressID
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: StreetName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: StreetName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: CityName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: CityName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: PostalCode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PostalCode
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: CareOfName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: CareOfName
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: HouseNumber
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: HouseNumber
    visibleByDefault: true
    defaultWidth: 220
  - _type: TextColumn
    _name: District
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: District
    visibleByDefault: true
    defaultWidth: 220
  - _type: DateColumn
    _name: ValidityStartDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: ValidityStartDate
    visibleByDefault: true
    defaultWidth: 180
