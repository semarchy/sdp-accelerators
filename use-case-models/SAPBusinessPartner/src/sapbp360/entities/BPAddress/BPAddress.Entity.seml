# BP Address entity for the SAP Business Partner 360 accelerator.
_name: BPAddress
_package: sapbp360.entities.BPAddress
_type: Entity
primaryKey: sapbp360.entities.BPAddress.BPAddress.AddressGoldenID
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1001
sourceIdGeneration:
  mode: UUID
label: BP Address
documentation: Postal address golden record for a business partner with geocoding enrichment.
description: Postal address golden record for a business partner with geocoding enrichment.
enableDelete: true
entityType: FUZZY_MATCHED
iconUrl: images://sapbusinesspartner/BPAddress.svg
pluralLabel: BP Addresses
historizeGolden: true
historizeMaster: true
physicalTableName: BP_ADDRESS
dataEntryAllowed: true
attributes:
