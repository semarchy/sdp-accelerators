matcher:
  _name: SemQLMatcherBPADDRESS
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 94
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 85
  mergeThresholdMergingConfirmedWithNewMasters: 80
  mergeThresholdMergingConfirmedWithUnconfirmed: 80
  mergeThresholdMergingUnconfirmed: 80
  mergeThresholdMergingUnconfirmedWithNewMasters: 80
  mergeThresholdNewGroup: 80
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: true
  useTransitiveMatchScore: true
  description: BP Address matching rules for golden record consolidation.
  matchRules:
    - _type: SemQLMatchRule
      _name: SameFullAddress
      condition: Record1.StreetName is not null and COALESCE(Record1.StreetName,'')=COALESCE(Record2.StreetName,'') and COALESCE(Record1.HouseNumber,'')=COALESCE(Record2.HouseNumber,'') and COALESCE(Record1.CityName,'')=COALESCE(Record2.CityName,'') and COALESCE(Record1.PostalCode,'')=COALESCE(Record2.PostalCode,'')
      label: Same Full Address
      documentation: Same Full Address matching rule.
      description: Same Full Address matching rule.
      matchScore: 90
      color: md:teal 800
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: SameCityAndPostal
      condition: COALESCE(Record1.CityName,'')=COALESCE(Record2.CityName,'') and COALESCE(Record1.PostalCode,'')=COALESCE(Record2.PostalCode,'')
      label: Same City And Postal Code
      documentation: Same City And Postal Code matching rule.
      description: Same City And Postal Code matching rule.
      matchScore: 82
      color: md:amber 700
      usingMatchOn: false
