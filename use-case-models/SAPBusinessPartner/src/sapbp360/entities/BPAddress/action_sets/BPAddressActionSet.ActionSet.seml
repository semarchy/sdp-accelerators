_name: BPAddressActionSet
_package: sapbp360.entities.BPAddress.action_sets
_type: ActionSet
entity: sapbp360.entities.BPAddress.BPAddress
label: BP Address Action Set
description: Action set for managing BP Addresses in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorBPAddresses
    label: Create
    description: Create a new BP Address record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.BPAddress.steppers.AuthorBPAddresses
  - _name: EditAuthorBPAddresses
    label: Edit
    description: Edit BP Address records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.BPAddress.steppers.AuthorBPAddresses
  - _name: MassUpdateAuthorBPAddresses
    label: Mass Update
    description: Mass update BP Address records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: true
    availableForGoldenData: true
    availableForMasterData: true
    stepper: sapbp360.entities.BPAddress.steppers.AuthorBPAddresses
  - _name: Delete
    label: Delete
    description: Delete selected BP Address records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorBPAddresses
    label: Import
    description: Import BP Address records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: MASTER
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.BPAddress.steppers.BPAddressImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
  - _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    description: Directly confirm duplicates.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DirectConfirmDupsAction
  - _name: ReviewAndConfirmDuplicatesManageDuplicatesOnBPAddress
    label: Review And Confirm Duplicates
    description: Review and confirm duplicate records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewAndConfirm
    dupsManager: sapbp360.entities.BPAddress.dups_managers.ManageDuplicatesOnBPAddress
    enableEdit: true
    mandateConfirmAll: false
  - _name: MergeOrSplitDuplicatesManageDuplicatesOnBPAddress
    label: Merge Or Split Duplicates
    description: Merge or split duplicate records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MergeOrSplit
    dupsManager: sapbp360.entities.BPAddress.dups_managers.ManageDuplicatesOnBPAddress
    enableEdit: true
  - _name: ReviewSuggestionsDuplicatesManageDuplicatesOnBPAddress
    label: Review Duplicate Suggestions
    description: Review duplicate suggestions.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewSuggestions
    dupsManager: sapbp360.entities.BPAddress.dups_managers.ManageDuplicatesOnBPAddress
    enableEdit: true
    mandateResolveAllSuggestions: false
    onAcceptPromptGoldenId: false
  - _name: ExplainRecord
    label: Explain Record
    description: Explain record details.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExplainRecordAction
    displayCard: sapbp360.entities.BPAddress.display_cards.BPAddressDisplayCard
    formTab: sapbp360.entities.BPAddress.forms.BPAddressBrowsingForm.Main
