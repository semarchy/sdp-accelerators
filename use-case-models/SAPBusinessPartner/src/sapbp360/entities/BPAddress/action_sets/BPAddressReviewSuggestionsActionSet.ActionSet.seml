_name: BPAddressReviewSuggestionsActionSet
_package: sapbp360.entities.BPAddress.action_sets
_type: ActionSet
entity: sapbp360.entities.BPAddress.BPAddress
label: BP Address Review Suggestions Action Set
description: Action set for reviewing BP Address duplicate suggestions.
defaultActionSet: false
actions:
  - _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    description: Directly confirm duplicates.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DirectConfirmDupsAction
  - _name: ReviewSuggestionsDuplicatesManageDuplicatesOnBPAddress
    label: Review Duplicate Suggestions
    description: Review duplicate suggestions.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewSuggestions
    dupsManager: sapbp360.entities.BPAddress.dups_managers.ManageDuplicatesOnBPAddress
    enableEdit: true
    mandateResolveAllSuggestions: false
    onAcceptPromptGoldenId: false
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
