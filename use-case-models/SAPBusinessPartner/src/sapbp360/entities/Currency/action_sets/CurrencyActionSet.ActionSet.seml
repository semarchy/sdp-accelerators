_name: CurrencyActionSet
_package: sapbp360.entities.Currency.action_sets
_type: ActionSet
entity: sapbp360.entities.Currency.Currency
label: Currency Action Set
description: Action set for managing Currencies in SAP Business Partner 360.
defaultActionSet: true
actions:
  - _name: CreateAuthorCurrencies
    label: Create
    description: Create a new Currency record.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: sapbp360.entities.Currency.steppers.AuthorCurrencies
  - _name: EditAuthorCurrencies
    label: Edit
    description: Edit Currency records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: sapbp360.entities.Currency.steppers.AuthorCurrencies
  - _name: MassUpdateAuthorCurrencies
    label: Mass Update
    description: Mass update Currency records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: sapbp360.entities.Currency.steppers.AuthorCurrencies
  - _name: Delete
    label: Delete
    description: Delete selected Currency records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorCurrencies
    label: Import
    description: Import Currency records.
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    defaultPublisher: sapbp360.publishers.DataEntry
    stepper: sapbp360.entities.Currency.steppers.CurrencyImportStepper
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
