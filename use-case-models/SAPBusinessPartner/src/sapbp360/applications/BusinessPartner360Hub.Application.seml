_package: sapbp360.applications
_name: BusinessPartner360Hub
_type: Application
applicationTitle: SAP Business Partner 360
avatarImageUrl: images://sapbusinesspartner/logo.svg
coverImageUrl: images://sapbusinesspartner/logo.svg
favIcon: images://sapbusinesspartner/logo.svg
historyBrowsingEnabled: true
historyBrowsingRequiredRole: ""
logoUrl: images://sapbusinesspartner/logo.svg
visibility: VISIBLE
description: Trusted business partner data hub for SAP landscape consolidation.
documentationConfig:
  documentationConfigDiagrams:
    - _name: BPCore
      _type: DocumentationConfigDiagram
      modelDiagram: sapbp360.model_diagrams.BPCore
      label: Business Partner Core
    - _name: FinancialRelationships
      _type: DocumentationConfigDiagram
      modelDiagram: sapbp360.model_diagrams.FinancialRelationships
      label: Financial & Relationships
    - _name: SupplierBranch
      _type: DocumentationConfigDiagram
      modelDiagram: sapbp360.model_diagrams.SupplierBranch
      label: Supplier Branch
label: SAP Business Partner 360
sortStrategy: POSITION
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: true
  globalSearchBusinessViews:
    - _name: BusinessPartners
      _type: GlobalSearchBoView
      viewType: GD
      businessView: sapbp360.entities.BusinessPartner.business_views.BusinessPartner
      label: Business Partners
      maxResults: 5
      searchTypeConfig: sapbp360.entities.BusinessPartner.business_views.BusinessPartner.BusinessPartner.TextConfig
    - _name: Suppliers
      _type: GlobalSearchBoView
      viewType: GD
      businessView: sapbp360.entities.Supplier.business_views.Supplier
      label: Suppliers
      maxResults: 5
      searchTypeConfig: sapbp360.entities.Supplier.business_views.Supplier.Supplier.TextConfig
    - _name: BPAddresses
      _type: GlobalSearchBoView
      viewType: GD
      businessView: sapbp360.entities.BPAddress.business_views.BPAddress
      label: BP Addresses
      maxResults: 5
      searchTypeConfig: sapbp360.entities.BPAddress.business_views.BPAddress.BPAddress.TextConfig
    - _name: BPContacts
      _type: GlobalSearchBoView
      viewType: GD
      businessView: sapbp360.entities.BPContact.business_views.BPContact
      label: BP Contacts
      maxResults: 5
      searchTypeConfig: sapbp360.entities.BPContact.business_views.BPContact.BPContact.TextConfig
defaultAction: sapbp360.applications.BusinessPartner360Hub.Root.GlobalSearch
navDrawer:
  - _name: PlatformActions
    _type: NavigationGroup
    dividerVisible: true
    label: Platform Actions
    labelVisible: true
    actions:
      - appAction: sapbp360.applications.BusinessPartner360Hub.Root.MyTasks
      - appAction: sapbp360.applications.BusinessPartner360Hub.Root.GlobalSearch
      - appAction: sapbp360.applications.BusinessPartner360Hub.Root.StartHere
  - _name: BusinessPartnerCore
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sapbp360.applications.BusinessPartner360Hub.Root.BusinessPartnerCore
  - _name: AddressCommunication
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sapbp360.applications.BusinessPartner360Hub.Root.AddressCommunication
  - _name: FinancialArea
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sapbp360.applications.BusinessPartner360Hub.Root.FinancialArea
  - _name: SupplierManagement
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sapbp360.applications.BusinessPartner360Hub.Root.SupplierManagement
  - _name: ReferenceData
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sapbp360.applications.BusinessPartner360Hub.Root.ReferenceData
  - _name: Manage
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sapbp360.applications.BusinessPartner360Hub.Root.Manage
  - _name: Administration
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sapbp360.applications.BusinessPartner360Hub.Root.Administration
  - _name: Documentation
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: sapbp360.applications.BusinessPartner360Hub.Root.Documentation
rootFolder:
  _type: FolderAction
  _name: Root
  label: Root Folder
  image: images://mdi/folder.svg
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  appActions:
    - _type: MyTasksAction
      _name: MyTasks
      label: Inbox
      iconColor: "#04342C"
      labelColor: "#04342C"
      image: images://mdi/inbox-outline.svg
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      badgeVisible: false
    - _type: GlobalSearchAction
      _name: GlobalSearch
      description: Search business partners, suppliers, addresses, and contacts.
      label: Global Search
      iconColor: "#04342C"
      labelColor: "#04342C"
      image: images://mdi/magnify.svg
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
    - _type: FolderAction
      _name: StartHere
      icon: images://mdi/rocket-launch-outline.svg
      description: Import data into the fuzzy-matched entities in the recommended load sequence.
      label: Start Here
      iconColor: "#0F6E56"
      labelColor: "#0F6E56"
      image: images://mdi/rocket-launch-outline.svg
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      appActions:
        - _type: ImportDataAppAction
          _name: ImportBusinessPartners
          description: Import Business Partners, the parent golden record all other entities reference.
          label: Import Business Partners
          icon: images://mdi/arrow-right.svg
          image: images://mdi/arrow-right.svg
          iconColor: "#0F6E56"
          labelColor: "#0F6E56"
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          importAction: sapbp360.entities.BusinessPartner.action_sets.BusinessPartnerActionSet.ImportAuthorBusinessPartners
        - _type: ImportDataAppAction
          _name: ImportBPAddresses
          description: Import BP Addresses (references Business Partner).
          label: Import BP Addresses
          icon: images://mdi/arrow-right.svg
          image: images://mdi/arrow-right.svg
          iconColor: "#0F6E56"
          labelColor: "#0F6E56"
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          importAction: sapbp360.entities.BPAddress.action_sets.BPAddressActionSet.ImportAuthorBPAddresses
        - _type: ImportDataAppAction
          _name: ImportBPBanks
          description: Import BP Banks (references Business Partner).
          label: Import BP Banks
          icon: images://mdi/arrow-right.svg
          image: images://mdi/arrow-right.svg
          iconColor: "#0F6E56"
          labelColor: "#0F6E56"
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          importAction: sapbp360.entities.BPBank.action_sets.BPBankActionSet.ImportAuthorBPBanks
        - _type: ImportDataAppAction
          _name: ImportBPContacts
          description: Import BP Contacts (references Business Partner).
          label: Import BP Contacts
          icon: images://mdi/arrow-right.svg
          image: images://mdi/arrow-right.svg
          iconColor: "#0F6E56"
          labelColor: "#0F6E56"
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          importAction: sapbp360.entities.BPContact.action_sets.BPContactActionSet.ImportAuthorBPContacts
        - _type: ImportDataAppAction
          _name: ImportSuppliers
          description: Import Suppliers (references Business Partner).
          label: Import Suppliers
          icon: images://mdi/arrow-right.svg
          image: images://mdi/arrow-right.svg
          iconColor: "#0F6E56"
          labelColor: "#0F6E56"
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          importAction: sapbp360.entities.Supplier.action_sets.SupplierActionSet.ImportAuthorSuppliers
        - _type: ImportDataAppAction
          _name: ImportSupplierPurchasingOrgs
          description: Import Supplier Purchasing Orgs (references Supplier, imported last).
          label: Import Supplier Purchasing Orgs
          icon: images://mdi/arrow-right.svg
          image: images://mdi/arrow-right.svg
          iconColor: "#0F6E56"
          labelColor: "#0F6E56"
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          importAction: sapbp360.entities.SupplierPurchasingOrg.action_sets.SupplierPurchasingOrgActionSet.ImportAuthorSupplierPurchasingOrgs
    - _type: FolderAction
      _name: BusinessPartnerCore
      icon: images://mdi/account-group.svg
      description: Business Partner Core
      label: Business Partner Core
      iconColor: "#0F6E56"
      labelColor: "#0F6E56"
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      appActions:
        - _type: BrowseBusinessViewAction
          _name: BrowseBUSINESSPARTNER
          description: Browse Business Partner records.
          label: Business Partners
          iconColor: "#0F6E56"
          labelColor: "#0F6E56"
          image: images://sapbusinesspartner/BusinessPartner.svg
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          businessView: sapbp360.entities.BusinessPartner.business_views.BusinessPartner
          nbRecordsBadgeVisible: true
          useSearchOnOpen: false
          viewType: GD
