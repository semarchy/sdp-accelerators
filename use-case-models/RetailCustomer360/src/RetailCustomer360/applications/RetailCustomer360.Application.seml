_package: RetailCustomer360.applications
_type: Application
_name: RetailCustomer360
label: Retail Customer 360 Platform
visibility: VISIBLE
applicationTitle: Retail Customer 360 Platform
avatarImageUrl: images://RetailCustomer360/logo.png
logoUrl: images://RetailCustomer360/b2c360_cover_320x128_2.png
coverImageUrl: images://RetailCustomer360/b2c360_cover_avatar_solid_0D1B2A_320x128.gif
favIcon: https://api.iconify.design/mdi/account-circle.svg?color=%232563EB&width=64
primaryColor: "#1B263B"
secondaryColor: "#1B263B"
errorColor: "#DC2626"
titleColor: "#F4F6FB"
titleBarDefaultColor: "#0D1B2A"
titleBarDefaultContrastColor: "#FFFFFF"
titleBarAuthoringColor: "#1B263B"
titleBarAuthoringContrastColor: "#FFFFFF"
titleNavBarDefaultColor: "#1B263B"
titleNavBarDefaultContrastColor: "#F4F6FB"
titleNavBarAuthoringColor: "#1B263B"
titleNavBarAuthoringContrastColor: "#FFFFFF"
titleNavBarErrorColor: "#DC2626"
titleNavBarErrorContrastColor: "#FFFFFF"
sortStrategy: POSITION
historyBrowsingEnabled: true
historyBrowsingRequiredRole: ""
defaultAction: RetailCustomer360.applications.RetailCustomer360.Root.Analytics.BrowseRevenueSnapshotDashboard
documentationConfig:
  documentation: |
    # Heading test
  documentationConfigDiagrams:
    - _type: DocumentationConfigDiagram
      _name: CustomerMaster
      label: Customer Master Data
      modelDiagram: RetailCustomer360.model_diagrams.CustomerMaster
    - _type: DocumentationConfigDiagram
      _name: AccountManagement
      label: Account Management & Opportunities
      modelDiagram: RetailCustomer360.model_diagrams.AccountManagement
    - _type: DocumentationConfigDiagram
      _name: ContactProfile
      label: Contact & Profile
      modelDiagram: RetailCustomer360.model_diagrams.ContactProfile
    - _type: DocumentationConfigDiagram
      _name: Commerce
      label: Products & Commerce
      modelDiagram: RetailCustomer360.model_diagrams.Commerce
    - _type: DocumentationConfigDiagram
      _name: Engagement
      label: Engagement & Campaigns
      modelDiagram: RetailCustomer360.model_diagrams.Engagement
    - _type: DocumentationConfigDiagram
      _name: Loyalty
      label: Loyalty & Rewards
      modelDiagram: RetailCustomer360.model_diagrams.Loyalty
    - _type: DocumentationConfigDiagram
      _name: Governance
      label: Governance & Compliance
      modelDiagram: RetailCustomer360.model_diagrams.Governance
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: true
  globalSearchBusinessViews:
    - _type: GlobalSearchBoView
      _name: Customers
      businessView: RetailCustomer360.entities.Customer.business_views.CustomerBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.Customer.business_views.CustomerBusinessView.Customer.TextConfig
    - _type: GlobalSearchBoView
      _name: Accounts
      businessView: RetailCustomer360.entities.Account.business_views.AccountBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.Account.business_views.AccountBusinessView.Account.TextConfig
    - _type: GlobalSearchBoView
      _name: EmailAddresses
      businessView: RetailCustomer360.entities.ContactPointEmail.business_views.ContactPointEmailBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.ContactPointEmail.business_views.ContactPointEmailBusinessView.ContactPointEmail.TextConfig
    - _type: GlobalSearchBoView
      _name: PhoneNumbers
      businessView: RetailCustomer360.entities.ContactPointPhone.business_views.ContactPointPhoneBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.ContactPointPhone.business_views.ContactPointPhoneBusinessView.ContactPointPhone.TextConfig
    - _type: GlobalSearchBoView
      _name: Addresses
      businessView: RetailCustomer360.entities.ContactPointAddress.business_views.ContactPointAddressBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.ContactPointAddress.business_views.ContactPointAddressBusinessView.ContactPointAddress.TextConfig
    - _type: GlobalSearchBoView
      _name: Campaigns
      businessView: RetailCustomer360.entities.Campaign.business_views.CampaignBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.Campaign.business_views.CampaignBusinessView.Campaign.TextConfig
    - _type: GlobalSearchBoView
      _name: Consents
      businessView: RetailCustomer360.entities.Consent.business_views.ConsentBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.Consent.business_views.ConsentBusinessView.Consent.TextConfig
    - _type: GlobalSearchBoView
      _name: LoyaltyPrograms
      businessView: RetailCustomer360.entities.LoyaltyProgram.business_views.LoyaltyProgramBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.LoyaltyProgram.business_views.LoyaltyProgramBusinessView.LoyaltyProgram.TextConfig
    - _type: GlobalSearchBoView
      _name: LoyaltyMembers
      businessView: RetailCustomer360.entities.LoyaltyProgramMember.business_views.LoyaltyProgramMemberBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.LoyaltyProgramMember.business_views.LoyaltyProgramMemberBusinessView.LoyaltyProgramMember.TextConfig
    - _type: GlobalSearchBoView
      _name: Orders
      businessView: RetailCustomer360.entities.SalesOrder.business_views.SalesOrderBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.SalesOrder.business_views.SalesOrderBusinessView.SalesOrder.TextConfig
    - _type: GlobalSearchBoView
      _name: OrderItems
      businessView: RetailCustomer360.entities.SalesOrderItem.business_views.SalesOrderItemBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.SalesOrderItem.business_views.SalesOrderItemBusinessView.SalesOrderItem.TextConfig
    - _type: GlobalSearchBoView
      _name: Products
      businessView: RetailCustomer360.entities.Product.business_views.ProductBusinessView
      viewType: GD
      searchTypeConfig: RetailCustomer360.entities.Product.business_views.ProductBusinessView.Product.TextConfig
navDrawer:
  - _type: FolderNavGroup
    _name: QuickActionsNav
    dividerVisible: false
    labelVisible: false
    linkedFolder: RetailCustomer360.applications.RetailCustomer360.Root.QuickActions
  - _type: NavigationGroup
    _name: CustomerNav
    dividerVisible: false
    labelVisible: true
    label: Customers
    actions:
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.CustomerMaster.BrowseCustomer
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.CustomerMaster.BrowseAccount
  - _type: NavigationGroup
    _name: EngagementDrawerNav
    dividerVisible: false
    labelVisible: true
    label: Engagement
    actions:
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.CustomerEngagement.BrowseCampaign
  - _type: NavigationGroup
    _name: LoyaltyDrawerNav
    dividerVisible: false
    labelVisible: false
    label: Loyalty
    actions:
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.Loyalty.BrowseLoyaltyProgram
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.Loyalty.BrowseLoyaltyProgramMember
  - _type: NavigationGroup
    _name: CommerceDrawerNav
    dividerVisible: false
    labelVisible: true
    label: Commerce
    actions:
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.Commerce.BrowseSalesOrder
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.Commerce.BrowseOpportunity
  - _type: NavigationGroup
    _name: GovernanceDrawerNav
    dividerVisible: false
    labelVisible: false
    label: Governance
    actions:
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.Governance.BrowseConsent
  - _type: NavigationGroup
    _name: DuplicateManagementNav
    dividerVisible: true
    labelVisible: false
    label: Duplicate Management
    actions:
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.DuplicateManagement
  - _type: NavigationGroup
    _name: AnalyticsNav
    dividerVisible: true
    labelVisible: true
    label: Analytics
    actions:
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.Analytics
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.Documentation.ModelDocumentation
  - _type: NavigationGroup
    _name: BrowseAllNav
    dividerVisible: true
    labelVisible: true
    label: Browse All
    actions:
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.BrowseAll
  - _type: NavigationGroup
    _name: SetupNav
    dividerVisible: true
    labelVisible: true
    label: Setup
    actions:
      - appAction: RetailCustomer360.applications.RetailCustomer360.Root.ImportData.Import
rootFolder:
  _type: FolderAction
  _name: Root
  label: Retail Customer 360
  image: https://api.iconify.design/mdi/home.svg?color=%230D1B2A&width=512
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  appActions:
    - _type: FolderAction
      _name: QuickActions
      label: Quick Access
      image: https://api.iconify.design/mdi/flash.svg?color=%230D1B2A&width=256
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      appActions:
        - _type: MyTasksAction
          _name: MyTasks
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          badgeVisible: false
        - _type: GlobalSearchAction
          _name: GlobalSearch
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
    - _type: FolderAction
      _name: ImportData
      label: Import Data
      image: https://api.iconify.design/mdi/database-import.svg?color=%230D1B2A&width=512
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      appActions:
        - _type: FolderAction
          _name: Import
          label: Import Data
          image: https://api.iconify.design/mdi/database-import.svg?color=%230D1B2A&width=512
          icon: https://api.iconify.design/mdi/database-import.svg?color=%230D1B2A&width=512
          appActions:
            - _type: ImportDataAppAction
              _name: ImportCountry
              label: 00-Countries
              importAction: RetailCustomer360.entities.Country.action_sets.CountryActionSet.ImportAuthorCountries
              image: https://api.iconify.design/mdi/earth.svg?color=%230D1B2A&width=512
              icon: https://api.iconify.design/mdi/earth.svg?color=%230D1B2A&width=512
            - _type: ImportDataAppAction
              _name: ImportCurrency
              label: 01-Currencies
              importAction: RetailCustomer360.entities.Currency.action_sets.CurrencyActionSet.ImportAuthorCurrencies
              image: https://api.iconify.design/mdi/cash-multiple.svg?color=%230D1B2A&width=512
              icon: https://api.iconify.design/mdi/cash-multiple.svg?color=%230D1B2A&width=512
            - _type: ImportDataAppAction
              _name: ImportUnitOfMeasure
              label: 02-Units of Measure
              importAction: RetailCustomer360.entities.UnitOfMeasure.action_sets.UnitOfMeasureActionSet.ImportUnitOfMeasure
              image: https://api.iconify.design/mdi/ruler.svg?color=%230D1B2A&width=512
              icon: https://api.iconify.design/mdi/ruler.svg?color=%230D1B2A&width=512
            - _type: ImportDataAppAction
              _name: ImportSoftwareApplication
              label: 03-Software Applications
              importAction: RetailCustomer360.entities.SoftwareApplication.action_sets.SoftwareApplicationActionSet.ImportSoftwareApplication
              image: https://api.iconify.design/mdi/application.svg?color=%230D1B2A&width=512
              icon: https://api.iconify.design/mdi/application.svg?color=%230D1B2A&width=512
            - _type: ImportDataAppAction
              _name: ImportOrderDeliveryMethod
              label: 04-Delivery Methods
              importAction: RetailCustomer360.entities.OrderDeliveryMethod.action_sets.OrderDeliveryMethodActionSet.ImportOrderDeliveryMethod
              image: https://api.iconify.design/mdi/truck-delivery.svg?color=%230D1B2A&width=512
              icon: https://api.iconify.design/mdi/truck-delivery.svg?color=%230D1B2A&width=512
            - _type: ImportDataAppAction
              _name: ImportDataUseLegalBasis
              label: 05-Legal Bases
              importAction: RetailCustomer360.entities.DataUseLegalBasis.action_sets.DataUseLegalBasisActionSet.ImportDataUseLegalBasis
              image: https://api.iconify.design/mdi/scale-balance.svg?color=%230D1B2A&width=512
              icon: https://api.iconify.design/mdi/scale-balance.svg?color=%230D1B2A&width=512
            - _type: ImportDataAppAction
              _name: ImportDataUsePurpose
