_package: RetailCustomer360.entities.OrderDeliveryMethod.action_sets
_type: ActionSet
_name: OrderDeliveryMethodActionSet
entity: RetailCustomer360.entities.OrderDeliveryMethod.OrderDeliveryMethod
label: OrderDeliveryMethod Action Set
description: "Actions available to stewards on Delivery Methods."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateOrderDeliveryMethod
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.OrderDeliveryMethod.steppers.AuthorOrderDeliveryMethod
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditOrderDeliveryMethod
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.OrderDeliveryMethod.steppers.AuthorOrderDeliveryMethod
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateOrderDeliveryMethod
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.OrderDeliveryMethod.steppers.AuthorOrderDeliveryMethod
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteOrderDeliveryMethod
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportOrderDeliveryMethod
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportOrderDeliveryMethod
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.OrderDeliveryMethod.steppers.AuthorOrderDeliveryMethod
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphOrderDeliveryMethod
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
