_package: RetailCustomer360.entities.OrderDeliveryMethod.forms
_type: Form
_name: OrderDeliveryMethodForm
entity: RetailCustomer360.entities.OrderDeliveryMethod.OrderDeliveryMethod
default: true

formTabs:
  - _type: FormTab
    _name: Overview
    label: Overview
    iconUrl: https://api.iconify.design/mdi/view-dashboard-outline.svg?color=%230D1B2A&width=64
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: OverviewRow
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: OverviewCol1
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrDeliveryMethod
                label: Delivery Method
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrDeliveryMethodRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrDeliveryMethodCode
                        value: DeliveryMethodCode
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrDeliveryMethodName
                        value: DeliveryMethodName
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrDeliveryMethodType
                        value: DeliveryMethodType
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrCarrier
                        value: Carrier
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrDescription
                        value: Description
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
          - _type: FormContainer
            _name: OverviewCol2
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrService
                label: Service
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrServiceRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrEstimatedDays
                        value: EstimatedDays
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrBaseCost
                        value: BaseCost
                        useCustomLabel: false
                        dataType: DECIMAL
                        componentProperties:
                          textAlign: left
                          displayFormat: '$ #,###,###.##'
                          displayFormatValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: CheckboxField
                        _name: OvrIsActive
                        value: IsActive
                        useCustomLabel: false
                        dataType: BOOLEAN
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: CheckboxField
                        _name: OvrRequiresSignature
                        value: RequiresSignature
                        useCustomLabel: false
                        dataType: BOOLEAN
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: CheckboxField
                        _name: OvrIsTrackable
                        value: IsTrackable
                        useCustomLabel: false
                        dataType: BOOLEAN
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
              - _type: FormSection
                _name: OvrIdentifiers
                label: Identifiers
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrIdentifiersRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrDeliveryMethodId
                        value: DeliveryMethodId
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
