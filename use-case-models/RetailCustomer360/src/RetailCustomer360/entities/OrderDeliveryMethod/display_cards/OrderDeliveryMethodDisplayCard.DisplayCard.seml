_package: RetailCustomer360.entities.OrderDeliveryMethod.display_cards
_type: DisplayCard
_name: OrderDeliveryMethodDisplayCard
entity: RetailCustomer360.entities.OrderDeliveryMethod.OrderDeliveryMethod
default: true
primaryTextExpression: "CASE WHEN DeliveryMethodName IS NOT NULL THEN DeliveryMethodName ELSE 'Unnamed Method' END"
secondaryTextExpression: "CASE WHEN Carrier IS NOT NULL THEN Carrier ELSE 'Carrier unknown' END || CASE WHEN EstimatedDays IS NOT NULL THEN ' - ' || EstimatedDays || ' days' ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/truck-delivery.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/truck-delivery.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/truck-delivery.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
