_package: RetailCustomer360.entities.LoyaltyTier.display_cards
_type: DisplayCard
_name: LoyaltyTierDisplayCard
entity: RetailCustomer360.entities.LoyaltyTier.LoyaltyTier
default: true
primaryTextExpression: "CASE WHEN TierName IS NOT NULL THEN TierName ELSE 'Unnamed Tier' END"
secondaryTextExpression: "CASE WHEN TierLevel IS NOT NULL THEN TierLevel ELSE 'Level unknown' END || CASE WHEN QualifyingPoints IS NOT NULL THEN ' - from ' || QualifyingPoints || ' points' ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/medal.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/medal.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/medal.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
