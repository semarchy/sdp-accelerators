_package: RetailCustomer360.entities.LoyaltyTier.action_sets
_type: ActionSet
_name: LoyaltyTierActionSet
entity: RetailCustomer360.entities.LoyaltyTier.LoyaltyTier
label: LoyaltyTier Action Set
description: "Actions available to stewards on Loyalty Tiers."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateLoyaltyTier
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.LoyaltyTier.steppers.AuthorLoyaltyTier
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditLoyaltyTier
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.LoyaltyTier.steppers.AuthorLoyaltyTier
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateLoyaltyTier
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.LoyaltyTier.steppers.AuthorLoyaltyTier
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteLoyaltyTier
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportLoyaltyTier
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportLoyaltyTier
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.LoyaltyTier.steppers.AuthorLoyaltyTier
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphLoyaltyTier
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
