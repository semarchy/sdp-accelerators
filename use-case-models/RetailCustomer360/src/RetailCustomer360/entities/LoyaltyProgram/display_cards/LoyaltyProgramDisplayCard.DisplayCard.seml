_name: LoyaltyProgramDisplayCard
_package: RetailCustomer360.entities.LoyaltyProgram.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.LoyaltyProgram.LoyaltyProgram
default: true
primaryTextExpression: "CASE WHEN ProgramName IS NOT NULL THEN ProgramName ELSE ProgramCode END"
secondaryTextExpression: "CASE WHEN Status IS NOT NULL THEN Status ELSE 'Unknown' END || CASE WHEN ProgramType IS NOT NULL THEN ' • ' || ProgramType ELSE '' END || CASE WHEN FDN_Currency IS NOT NULL THEN ' • ' || FDN_Currency ELSE '' END || CASE WHEN ProgramWindowStatus IS NOT NULL THEN ' • ' || ProgramWindowStatus ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN ProgramHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/star-check.svg?color=%230D1B2A&width=128' WHEN ProgramHealthStatus IN ('Inactive', 'Expired') THEN 'https://api.iconify.design/mdi/star-off.svg?color=%230D1B2A&width=128' WHEN ProgramHealthStatus = 'Scheduled' THEN 'https://api.iconify.design/mdi/star-cog.svg?color=%230D1B2A&width=128' ELSE 'https://api.iconify.design/mdi/star-circle.svg?color=%230D1B2A&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/star-circle.svg?color=%230D1B2A&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN ProgramHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/star-check.svg?color=%230D1B2A&width=128' WHEN ProgramHealthStatus IN ('Inactive', 'Expired') THEN 'https://api.iconify.design/mdi/star-off.svg?color=%230D1B2A&width=128' WHEN ProgramHealthStatus = 'Scheduled' THEN 'https://api.iconify.design/mdi/star-cog.svg?color=%230D1B2A&width=128' ELSE 'https://api.iconify.design/mdi/star-circle.svg?color=%230D1B2A&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

