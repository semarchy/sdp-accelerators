_package: RetailCustomer360.entities.LoyaltyProgram.validations
_type: SemQLValidation
_name: EndDateMustNotBeBeforeStartDate
entity: RetailCustomer360.entities.LoyaltyProgram.LoyaltyProgram
label: End Date Must Not Be Before Start Date
validationScope: PRE_CONSO
description: "Ensures End Date is on or after Start Date when both dates are provided."
condition: StartDate IS NULL OR EndDate IS NULL OR EndDate >= StartDate

