_package: RetailCustomer360.entities.LoyaltyProgram.action_sets
_type: ActionSet
_name: LoyaltyProgramActionSet
entity: RetailCustomer360.entities.LoyaltyProgram.LoyaltyProgram
label: Loyalty Program Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateLoyaltyPrograms
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.LoyaltyProgram.steppers.AuthorLoyaltyPrograms
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditLoyaltyPrograms
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.LoyaltyProgram.steppers.AuthorLoyaltyPrograms
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateLoyaltyPrograms
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.LoyaltyProgram.steppers.AuthorLoyaltyPrograms
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportLoyaltyPrograms
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.LoyaltyProgram.steppers.AuthorLoyaltyPrograms
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

