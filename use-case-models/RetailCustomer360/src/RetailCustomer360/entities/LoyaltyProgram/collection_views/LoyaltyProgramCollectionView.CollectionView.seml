_package: RetailCustomer360.entities.LoyaltyProgram.collection_views
_type: CollectionView
_name: LoyaltyProgramCollectionView
entity: RetailCustomer360.entities.LoyaltyProgram.LoyaltyProgram
default: true
displayCard: RetailCustomer360.entities.LoyaltyProgram.display_cards.LoyaltyProgramDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Loyalty Program
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: ProgramCode
    value: ProgramCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: ProgramName
    value: ProgramName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: ProgramType
    value: ProgramType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Brand
    value: FDN_Brand
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: Status
    value: Status
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: Currency
    value: FDN_Currency
    useCustomLabel: true
    label: Currency
    referencedEntity: RetailCustomer360.entities.Currency.Currency
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "1"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: DateColumn
    _name: StartDate
    value: StartDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: false
  - _type: DateColumn
    _name: EndDate
    value: EndDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: PointsExpiryMonths
    value: PointsExpiryMonths
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: false
  - _type: TextColumn
    _name: Description
    value: Description
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: ProgramOwner
    value: ProgramOwner
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: EnrollmentFee
    value: EnrollmentFee
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: PointAccrualRate
    value: PointAccrualRate
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
  - _type: TextColumn
    _name: PointRedemptionRate
    value: PointRedemptionRate
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
  - _type: TextColumn
    _name: MinimumRedeemPoints
    value: MinimumRedeemPoints
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: false
  - _type: TextColumn
    _name: ProgramHealthStatus
    value: ProgramHealthStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: ProgramWindowStatus
    value: ProgramWindowStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false




