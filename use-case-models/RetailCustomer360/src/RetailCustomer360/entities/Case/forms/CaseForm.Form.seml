                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrCaseOrigin
                        value: CaseOrigin
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
