_package: RetailCustomer360.entities.Case.steppers
_type: Stepper
_name: AuthorCase
entity: RetailCustomer360.entities.Case.Case
label: Cases
description: "Guided authoring flow for Cases."
rootStep:
  _type: CollectionStep
  _name: CaseCollection
  label: Cases
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: RetailCustomer360.entities.Case.collection_views.CaseCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Details
      label: Details
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: RetailCustomer360.entities.Case.forms.CaseForm.Overview
