_package: RetailCustomer360.entities.AccountCustomerRelationship.enrichers
_name: AccountCustomerRelationshipDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.AccountCustomerRelationship.AccountCustomerRelationship
label: AccountCustomerRelationship Data Quality Enricher
description: "Computes standard completeness enrichment fields for AccountCustomerRelationship."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN AccountCustomerRelationshipId IS NULL AND RelationshipType IS NULL AND RelationshipRole IS NULL THEN 0
        ELSE (
          CASE WHEN AccountCustomerRelationshipId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN RelationshipType IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN RelationshipRole IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN AccountCustomerRelationshipId IS NULL AND RelationshipType IS NULL AND RelationshipRole IS NULL THEN 'Low'
        WHEN (
          CASE WHEN AccountCustomerRelationshipId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN RelationshipType IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN RelationshipRole IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
