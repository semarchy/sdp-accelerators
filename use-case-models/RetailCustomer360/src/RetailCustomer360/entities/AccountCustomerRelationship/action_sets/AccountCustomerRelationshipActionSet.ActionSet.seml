_package: RetailCustomer360.entities.AccountCustomerRelationship.action_sets
_type: ActionSet
_name: AccountCustomerRelationshipActionSet
entity: RetailCustomer360.entities.AccountCustomerRelationship.AccountCustomerRelationship
label: Account Customer Relationship Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAccountCustomerRelationships
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.AccountCustomerRelationship.steppers.AuthorAccountCustomerRelationships
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAccountCustomerRelationships
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.AccountCustomerRelationship.steppers.AuthorAccountCustomerRelationships
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAccountCustomerRelationships
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.AccountCustomerRelationship.steppers.AuthorAccountCustomerRelationships
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAccountCustomerRelationships
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.AccountCustomerRelationship.steppers.AuthorAccountCustomerRelationships
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
