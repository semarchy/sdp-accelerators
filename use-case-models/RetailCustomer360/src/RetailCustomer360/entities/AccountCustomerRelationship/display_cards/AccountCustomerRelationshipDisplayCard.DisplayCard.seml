_name: AccountCustomerRelationshipDisplayCard
_package: RetailCustomer360.entities.AccountCustomerRelationship.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.AccountCustomerRelationship.AccountCustomerRelationship
default: true
primaryTextExpression: "CASE WHEN FDN_Customer IS NOT NULL AND FDN_Account IS NOT NULL THEN FDN_Customer || ' @ ' || FDN_Account WHEN FDN_Customer IS NOT NULL THEN FDN_Customer WHEN FDN_Account IS NOT NULL THEN FDN_Account ELSE 'Account-Customer Link' END"
secondaryTextExpression: "CASE WHEN RelationshipRole IS NOT NULL THEN RelationshipRole ELSE RelationshipType END || CASE WHEN RelationshipStatus IS NOT NULL THEN ' • ' || RelationshipStatus ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/link-variant.svg?color=%230D1B2A&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

