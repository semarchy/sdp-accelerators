_package: RetailCustomer360.entities.Campaign.collection_views
_type: CollectionView
_name: CampaignCollectionView
entity: RetailCustomer360.entities.Campaign.Campaign
default: true
displayCard: RetailCustomer360.entities.Campaign.display_cards.CampaignDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Campaign
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: CampaignCode
    value: CampaignCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: CampaignName
    value: CampaignName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: CampaignType
    value: CampaignType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
