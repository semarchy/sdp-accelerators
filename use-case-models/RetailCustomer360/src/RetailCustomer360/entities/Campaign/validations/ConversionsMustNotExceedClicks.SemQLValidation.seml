_package: RetailCustomer360.entities.Campaign.validations
_name: ConversionsMustNotExceedClicks
_type: SemQLValidation
entity: RetailCustomer360.entities.Campaign.Campaign
label: Conversions Must Not Exceed Clicks
validationScope: PRE_CONSO
description: "Ensures conversions are less than or equal to clicks when both are provided."
condition: Conversions IS NULL OR Clicks IS NULL OR Conversions <= Clicks

