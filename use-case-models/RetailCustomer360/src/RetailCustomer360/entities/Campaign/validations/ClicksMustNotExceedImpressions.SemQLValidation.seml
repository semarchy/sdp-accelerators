_package: RetailCustomer360.entities.Campaign.validations
_name: ClicksMustNotExceedImpressions
_type: SemQLValidation
entity: RetailCustomer360.entities.Campaign.Campaign
label: Clicks Must Not Exceed Impressions
validationScope: PRE_CONSO
description: "Ensures clicks are less than or equal to impressions when both are provided."
condition: Clicks IS NULL OR Impressions IS NULL OR Clicks <= Impressions

