_package: RetailCustomer360.entities.Campaign.forms
_type: Form
_name: CampaignForm
entity: RetailCustomer360.entities.Campaign.Campaign
default: true

formTabs:
  - _type: FormTab
    _name: Overview
    label: Overview
    iconUrl: https://api.iconify.design/mdi/view-dashboard-outline.svg?color=%230D1B2A&width=64
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: OverviewRow
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: OverviewCol1
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrCampaignDetails
                label: Campaign Details
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrCampaignDetailsRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrCampaignCode
                        value: CampaignCode
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrCampaignName
                        value: CampaignName
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrCampaignType
                        value: CampaignType
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrChannel
                        value: Channel
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrStatus
                        value: Status
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrObjective
                        value: Objective
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrTargetSegment
                        value: TargetSegment
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrOwnerName
                        value: OwnerName
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
              - _type: FormSection
                _name: OvrSchedule
                label: Schedule
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrScheduleRow
                    layoutDirection: COLUMN
                    content:
                      - _type: DateField
                        _name: OvrStartDate
                        value: StartDate
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrEndDate
                        value: EndDate
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
          - _type: FormContainer
            _name: OverviewCol2
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrBudgetSpend
                label: Budget & Spend
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrBudgetSpendRow
                    layoutDirection: COLUMN
                    content:
                      - _type: ReferenceField
                        _name: OvrFDN_Currency
                        value: FDN_Currency
                        useCustomLabel: true
                        label: Currency
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                        referencedEntity: RetailCustomer360.entities.Currency.Currency
                        componentProperties:
                          displayType: chip
                          useAvatarInChip: '1'
                          useSecondaryTextInChip: '1'
                      - _type: TextField
                        _name: OvrBudget
                        value: Budget
                        useCustomLabel: false
                        dataType: DECIMAL
                        componentProperties:
                          textAlign: left
                          displayFormat: '$ #,###,###.##'
                          displayFormatValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrActualSpend
                        value: ActualSpend
                        useCustomLabel: false
                        dataType: DECIMAL
                        componentProperties:
                          textAlign: left
                          displayFormat: '$ #,###,###.##'
                          displayFormatValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrAttributedRevenue
                        value: AttributedRevenue
                        useCustomLabel: false
                        dataType: DECIMAL
                        componentProperties:
                          textAlign: left
                          displayFormat: '$ #,###,###.##'
                          displayFormatValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEnrichmentROIBand
                        value: EnrichmentROIBand
                        useCustomLabel: true
                        label: ROI Band
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
              - _type: FormSection
                _name: OvrReachResponse
                label: Reach & Response
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrReachResponseRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrPlannedAudienceSize
                        value: PlannedAudienceSize
                        useCustomLabel: false
                        dataType: INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrActualReach
                        value: ActualReach
                        useCustomLabel: false
                        dataType: INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrImpressions
                        value: Impressions
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrClicks
                        value: Clicks
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrConversions
                        value: Conversions
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
          - _type: FormContainer
            _name: OverviewCol3
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrPerformanceHealth
                label: Performance & Health
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrPerformanceHealthRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrEnrichmentPerformanceScore
                        value: EnrichmentPerformanceScore
                        useCustomLabel: true
                        label: Performance Score
                        dataType: DECIMAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEnrichmentPacingStatus
                        value: EnrichmentPacingStatus
                        useCustomLabel: true
                        label: Pacing Status
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEnrichmentHealthStatus
                        value: EnrichmentHealthStatus
                        useCustomLabel: true
                        label: Health Status
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrNotes
                        value: Notes
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
              - _type: FormSection
                _name: OvrSourceDataQuality
                label: Source & Data Quality
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrSourceDataQualityRow
                    layoutDirection: COLUMN
                    content:
                      - _type: MenuField
                        _name: OvrSourceSystem
                        value: SourceSystem
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrSourceCampaignKey
                        value: SourceCampaignKey
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrCampaignId
                        value: CampaignId
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEnrichmentCompletenessScore
                        value: EnrichmentCompletenessScore
                        useCustomLabel: true
                        label: Completeness Score
                        dataType: DECIMAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEnrichmentCompletenessBand
                        value: EnrichmentCompletenessBand
                        useCustomLabel: true
                        label: Completeness Band
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrEnrichmentUpdatedOn
                        value: EnrichmentUpdatedOn
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
      - _type: FormSection
        _name: EngagementAnalyticsSection
        label: Campaign Performance
        layoutDirection: COLUMN
        documentationInterpreter: LITERAL
        content:
          - _type: FormChart
            _name: CampFinancialKPIsChart
            chart: CampFinancialKPIs
            dashboardApplication: RetailCustomer360
            documentationInterpreter: LITERAL
            embeddedMode: CONTENT
            height: 200
            showDivider: false
            titlePlacement: NONE
            useCustomLabel: false
            queryAttributes:
              - _type: FormChartParameter
                _name: CampaignID
                value: CampaignId
                valueInterpreter: SEMQL
          - _type: FormChart
            _name: CampPerformanceMetricsChart
            chart: CampPerformanceMetrics
            dashboardApplication: RetailCustomer360
            documentationInterpreter: LITERAL
            embeddedMode: CARD
            height: 340
            showDivider: true
            titlePlacement: TOP
            useCustomLabel: false
            queryAttributes:
              - _type: FormChartParameter
                _name: CampaignID
                value: CampaignId
                valueInterpreter: SEMQL
