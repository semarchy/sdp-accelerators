_package: RetailCustomer360.entities.Campaign.enrichers
_name: CampaignDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.Campaign.Campaign
label: Campaign Data Quality Enricher
description: "Computes standard completeness enrichment fields for Campaign."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN CampaignId IS NULL AND CampaignCode IS NULL AND CampaignName IS NULL THEN 0
        ELSE (
          CASE WHEN CampaignId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN CampaignCode IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN CampaignName IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN CampaignId IS NULL AND CampaignCode IS NULL AND CampaignName IS NULL THEN 'Low'
        WHEN (
          CASE WHEN CampaignId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN CampaignCode IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN CampaignName IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
