_name: CampaignDisplayCard
_package: RetailCustomer360.entities.Campaign.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.Campaign.Campaign
default: true
primaryTextExpression: "CASE WHEN CampaignName IS NOT NULL THEN CampaignName ELSE CampaignCode END"
secondaryTextExpression: "'Health: ' || CASE WHEN EnrichmentHealthStatus IS NOT NULL THEN EnrichmentHealthStatus ELSE 'Unknown' END || ' | Status: ' || CASE WHEN Status IS NOT NULL THEN Status ELSE 'Unknown' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN EnrichmentHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/check-decagram.svg?color=%23059669&width=128' WHEN EnrichmentHealthStatus = 'Monitor' THEN 'https://api.iconify.design/mdi/alert-circle.svg?color=%23D97706&width=128' WHEN EnrichmentHealthStatus = 'At Risk' THEN 'https://api.iconify.design/mdi/alert-octagon.svg?color=%23DC2626&width=128' ELSE 'https://api.iconify.design/mdi/bullhorn.svg?color=%232563EB&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/bullhorn.svg?color=%230D1B2A&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN EnrichmentHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/check-decagram.svg?color=%23059669&width=128' WHEN EnrichmentHealthStatus = 'Monitor' THEN 'https://api.iconify.design/mdi/alert-circle.svg?color=%23D97706&width=128' WHEN EnrichmentHealthStatus = 'At Risk' THEN 'https://api.iconify.design/mdi/alert-octagon.svg?color=%23DC2626&width=128' ELSE 'https://api.iconify.design/mdi/bullhorn.svg?color=%232563EB&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

