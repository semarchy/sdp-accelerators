_package: RetailCustomer360.entities.Campaign.search_forms
_type: SearchForm
_name: CampaignHealthQuickFilters
label: Campaign Health Quick Filters
entity: RetailCustomer360.entities.Campaign.Campaign
semQlCondition: 1=1
searchParameters:
  - _name: CampaignStatus
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_CAMPAIGN_STATUS
    label: Campaign Status
    dataType: String
    length: 64
    displayType: VALUE_PICKER
    boundSelectExpression: Status
    primaryTextExpression: Status
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.Campaign.Campaign
  - _name: HealthStatus
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_HEALTH_STATUS
    label: Health Status
    dataType: String
    length: 64
    displayType: VALUE_PICKER
    boundSelectExpression: EnrichmentHealthStatus
    primaryTextExpression: EnrichmentHealthStatus
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.Campaign.Campaign
  - _name: PacingStatus
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_PACING_STATUS
    label: Pacing Status
    dataType: String
    length: 64
    displayType: VALUE_PICKER
    boundSelectExpression: EnrichmentPacingStatus
    primaryTextExpression: EnrichmentPacingStatus
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.Campaign.Campaign
  - _name: RoiBand
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_ROI_BAND
    label: ROI Band
    dataType: String
    length: 64
    displayType: VALUE_PICKER
    boundSelectExpression: EnrichmentROIBand
    primaryTextExpression: EnrichmentROIBand
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.Campaign.Campaign

