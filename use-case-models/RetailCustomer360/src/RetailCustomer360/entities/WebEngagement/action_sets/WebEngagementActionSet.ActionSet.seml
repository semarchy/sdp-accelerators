_package: RetailCustomer360.entities.WebEngagement.action_sets
_type: ActionSet
_name: WebEngagementActionSet
entity: RetailCustomer360.entities.WebEngagement.WebEngagement
label: Web Engagement Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateWebEngagements
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.WebEngagement.steppers.AuthorWebEngagements
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditWebEngagements
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.WebEngagement.steppers.AuthorWebEngagements
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateWebEngagements
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.WebEngagement.steppers.AuthorWebEngagements
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportWebEngagements
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.WebEngagement.steppers.AuthorWebEngagements
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

