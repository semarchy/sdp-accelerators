_package: RetailCustomer360.entities.WebEngagement.validations
_name: PageUrlRequiredForPageAndProductViews
_type: SemQLValidation
entity: RetailCustomer360.entities.WebEngagement.WebEngagement
label: Page URL Required For Page And Product Views
validationScope: PRE_CONSO
description: "Ensures page URL is present for page-oriented events."
condition: EventType NOT IN ('Page View', 'Product View') OR PageUrl IS NOT NULL

