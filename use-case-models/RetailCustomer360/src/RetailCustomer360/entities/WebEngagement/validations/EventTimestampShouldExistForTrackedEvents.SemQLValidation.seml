_package: RetailCustomer360.entities.WebEngagement.validations
_name: EventTimestampShouldExistForTrackedEvents
_type: SemQLValidation
entity: RetailCustomer360.entities.WebEngagement.WebEngagement
label: Event Timestamp Should Exist For Tracked Events
validationScope: PRE_CONSO
description: "Ensures tracked events carry a timestamp."
condition: EventType IS NULL OR EventTimestamp IS NOT NULL

