_name: WebEngagementDisplayCard
_package: RetailCustomer360.entities.WebEngagement.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.WebEngagement.WebEngagement
default: true
primaryTextExpression: "CASE WHEN FDN_Customer IS NOT NULL THEN FDN_Customer ELSE 'Anonymous Visitor' END || CASE WHEN EventType IS NOT NULL THEN ' • ' || EventType ELSE '' END"
secondaryTextExpression: "CASE WHEN PageTitle IS NOT NULL THEN PageTitle ELSE CASE WHEN PageUrl IS NOT NULL THEN PageUrl ELSE 'Web Activity' END END || CASE WHEN ChannelIntentSignal IS NOT NULL THEN ' • ' || ChannelIntentSignal ELSE '' END || CASE WHEN TrafficAttributionStatus IS NOT NULL THEN ' • ' || TrafficAttributionStatus ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN ChannelIntentSignal = 'Purchase Intent' THEN 'https://api.iconify.design/mdi/web-check.svg?color=%23059669&width=128' WHEN TrafficAttributionStatus = 'Direct/Unknown' THEN 'https://api.iconify.design/mdi/web-alert.svg?color=%23D97706&width=128' WHEN ChannelIntentSignal = 'Unknown' THEN 'https://api.iconify.design/mdi/web-off.svg?color=%23DC2626&width=128' ELSE 'https://api.iconify.design/mdi/web.svg?color=%232563EB&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/web.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN ChannelIntentSignal = 'Purchase Intent' THEN 'https://api.iconify.design/mdi/web-check.svg?color=%23059669&width=128' WHEN TrafficAttributionStatus = 'Direct/Unknown' THEN 'https://api.iconify.design/mdi/web-alert.svg?color=%23D97706&width=128' WHEN ChannelIntentSignal = 'Unknown' THEN 'https://api.iconify.design/mdi/web-off.svg?color=%23DC2626&width=128' ELSE 'https://api.iconify.design/mdi/web.svg?color=%232563EB&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

