_package: RetailCustomer360.entities.DataUseLegalBasis.display_cards
_type: DisplayCard
_name: DataUseLegalBasisDisplayCard
entity: RetailCustomer360.entities.DataUseLegalBasis.DataUseLegalBasis
default: true
primaryTextExpression: "CASE WHEN LegalBasisName IS NOT NULL THEN LegalBasisName ELSE 'Unnamed Legal Basis' END"
secondaryTextExpression: "CASE WHEN LegalBasisType IS NOT NULL THEN LegalBasisType ELSE 'Type unknown' END || CASE WHEN Jurisdiction IS NOT NULL THEN ' - ' || Jurisdiction ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/gavel.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/gavel.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/gavel.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
