_package: RetailCustomer360.entities.Opportunity.survivorship_rules
_type: StandardSurvivorshipRule
_name: AmountLargest
entity: RetailCustomer360.entities.Opportunity.Opportunity
label: Amount (largest value)
description: "Keeps the highest quoted opportunity value."
defaultRule: false
consolidationStrategy: LARGEST_VALUE
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: Probability
