_package: RetailCustomer360.entities.Opportunity.display_cards
_type: DisplayCard
_name: OpportunityDisplayCard
entity: RetailCustomer360.entities.Opportunity.Opportunity
default: true
primaryTextExpression: "CASE WHEN OpportunityName IS NOT NULL THEN OpportunityName ELSE OpportunityNumber END"
secondaryTextExpression: "CASE WHEN OpportunityStage IS NOT NULL THEN OpportunityStage ELSE 'Stage unknown' END || CASE WHEN Amount.Amount IS NOT NULL THEN ' - ' || Amount.Amount ELSE '' END || CASE WHEN CloseDate IS NOT NULL THEN ' - closes ' || TO_CHAR(CloseDate, 'YYYY-MM-DD') ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/trending-up.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/trending-up.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/trending-up.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
