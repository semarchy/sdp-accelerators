_package: RetailCustomer360.entities.Opportunity.action_sets
_type: ActionSet
_name: OpportunityActionSet
entity: RetailCustomer360.entities.Opportunity.Opportunity
label: Opportunity Action Set
description: "Actions available to stewards on Opportunities."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateOpportunity
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Opportunity.steppers.AuthorOpportunity
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditOpportunity
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Opportunity.steppers.AuthorOpportunity
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateOpportunity
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Opportunity.steppers.AuthorOpportunity
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteOpportunity
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportOpportunity
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportOpportunity
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.Opportunity.steppers.ImportOpportunity
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphOpportunity
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
