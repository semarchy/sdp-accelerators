_package: RetailCustomer360.entities.Opportunity.collection_views
_type: CollectionView
_name: OpportunityCollectionView
entity: RetailCustomer360.entities.Opportunity.Opportunity
default: true
description: "Default list of Opportunities records."
displayCard: RetailCustomer360.entities.Opportunity.display_cards.OpportunityDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Opportunity
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: OpportunityNumber
    value: OpportunityNumber
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: OpportunityName
    value: OpportunityName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: OpportunityStage
    value: OpportunityStage
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: MenuColumn
    _name: ForecastCategory
    value: ForecastCategory
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
