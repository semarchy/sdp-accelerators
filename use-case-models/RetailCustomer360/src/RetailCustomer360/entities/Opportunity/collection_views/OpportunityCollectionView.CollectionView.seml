    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: NextStep
    value: NextStep
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: OwnerName
    value: OwnerName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: CheckboxColumn
    _name: IsClosed
    value: IsClosed
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: false
  - _type: CheckboxColumn
    _name: IsWon
    value: IsWon
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: false
  - _type: MenuColumn
    _name: SourceSystem
    value: SourceSystem
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      useAvatarInMenu: '1'
