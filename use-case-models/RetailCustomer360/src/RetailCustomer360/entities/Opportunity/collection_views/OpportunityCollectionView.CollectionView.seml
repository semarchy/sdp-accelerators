      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Probability
    value: Probability
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: true
  - _type: DateColumn
    _name: OpenDate
    value: OpenDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: DateColumn
    _name: CloseDate
    value: CloseDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: false
  - _type: MenuColumn
    _name: SalesChannel
    value: SalesChannel
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
