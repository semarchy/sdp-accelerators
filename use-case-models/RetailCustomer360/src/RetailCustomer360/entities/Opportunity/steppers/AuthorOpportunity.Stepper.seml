_package: RetailCustomer360.entities.Opportunity.steppers
_type: Stepper
_name: AuthorOpportunity
entity: RetailCustomer360.entities.Opportunity.Opportunity
label: Opportunities
description: "Guided authoring flow for Opportunities."
