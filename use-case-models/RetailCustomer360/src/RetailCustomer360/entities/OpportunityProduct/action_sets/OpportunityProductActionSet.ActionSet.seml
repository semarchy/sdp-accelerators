_package: RetailCustomer360.entities.OpportunityProduct.action_sets
_type: ActionSet
_name: OpportunityProductActionSet
entity: RetailCustomer360.entities.OpportunityProduct.OpportunityProduct
label: OpportunityProduct Action Set
description: "Actions available to stewards on Opportunity Products."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateOpportunityProduct
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.OpportunityProduct.steppers.AuthorOpportunityProduct
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditOpportunityProduct
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.OpportunityProduct.steppers.AuthorOpportunityProduct
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateOpportunityProduct
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.OpportunityProduct.steppers.AuthorOpportunityProduct
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteOpportunityProduct
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportOpportunityProduct
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportOpportunityProduct
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.OpportunityProduct.steppers.AuthorOpportunityProduct
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphOpportunityProduct
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
