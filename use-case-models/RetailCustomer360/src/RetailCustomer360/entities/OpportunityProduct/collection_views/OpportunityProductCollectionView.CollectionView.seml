_package: RetailCustomer360.entities.OpportunityProduct.collection_views
_type: CollectionView
_name: OpportunityProductCollectionView
entity: RetailCustomer360.entities.OpportunityProduct.OpportunityProduct
default: true
description: "Default list of Opportunity Products records."
displayCard: RetailCustomer360.entities.OpportunityProduct.display_cards.OpportunityProductDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: OpportunityProduct
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: OpportunityProductId
    value: OpportunityProductId
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: true
  - _type: TextColumn
    _name: LineNumber
    value: LineNumber
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: true
  - _type: TextColumn
    _name: Quantity
    value: Quantity
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: true
  - _type: TextColumn
    _name: UnitPrice
    value: UnitPrice
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: TotalPrice
    value: TotalPrice
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: DiscountAmount
    value: DiscountAmount
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: DateColumn
    _name: ExpectedDeliveryDate
    value: ExpectedDeliveryDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: false
  - _type: CheckboxColumn
    _name: IsPrimaryLine
    value: IsPrimaryLine
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: Notes
    value: Notes
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: MenuColumn
    _name: SourceSystem
    value: SourceSystem
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: Opportunity
    value: FDN_Opportunity
    useCustomLabel: true
    label: Opportunity
    referencedEntity: RetailCustomer360.entities.Opportunity.Opportunity
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "1"
  - _type: ReferenceColumn
    _name: Product
    value: FDN_Product
    useCustomLabel: true
    label: Product
    referencedEntity: RetailCustomer360.entities.Product.Product
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "1"
