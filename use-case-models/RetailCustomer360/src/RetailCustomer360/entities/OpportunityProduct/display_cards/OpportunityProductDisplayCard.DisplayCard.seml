_package: RetailCustomer360.entities.OpportunityProduct.display_cards
_type: DisplayCard
_name: OpportunityProductDisplayCard
entity: RetailCustomer360.entities.OpportunityProduct.OpportunityProduct
default: true
primaryTextExpression: "CASE WHEN LineNumber IS NOT NULL THEN 'Line ' || TO_CHAR(LineNumber, 'FM999') ELSE 'Opportunity line' END"
secondaryTextExpression: "CASE WHEN Quantity IS NOT NULL THEN RTRIM(TO_CHAR(Quantity, 'FM999999990.99'), '.') || ' x ' ELSE '' END || CASE WHEN UnitPrice IS NOT NULL THEN RTRIM(TO_CHAR(UnitPrice, 'FM999999990.99'), '.') ELSE '' END || CASE WHEN TotalPrice IS NOT NULL THEN ' = ' || RTRIM(TO_CHAR(TotalPrice, 'FM999999990.99'), '.') ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/playlist-plus.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/playlist-plus.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/playlist-plus.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
