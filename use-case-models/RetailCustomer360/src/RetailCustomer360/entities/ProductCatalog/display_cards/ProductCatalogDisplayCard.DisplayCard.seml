_package: RetailCustomer360.entities.ProductCatalog.display_cards
_type: DisplayCard
_name: ProductCatalogDisplayCard
entity: RetailCustomer360.entities.ProductCatalog.ProductCatalog
default: true
primaryTextExpression: "CASE WHEN CatalogName IS NOT NULL THEN CatalogName ELSE 'Unnamed Catalog' END"
secondaryTextExpression: "CASE WHEN CatalogStatus IS NOT NULL THEN CatalogStatus ELSE 'Status unknown' END || CASE WHEN SalesChannel IS NOT NULL THEN ' - ' || SalesChannel ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/book-open-variant.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/book-open-variant.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/book-open-variant.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
