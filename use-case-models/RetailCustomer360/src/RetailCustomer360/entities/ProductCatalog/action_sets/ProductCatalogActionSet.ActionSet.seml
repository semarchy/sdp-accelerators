_package: RetailCustomer360.entities.ProductCatalog.action_sets
_type: ActionSet
_name: ProductCatalogActionSet
entity: RetailCustomer360.entities.ProductCatalog.ProductCatalog
label: ProductCatalog Action Set
description: "Actions available to stewards on Product Catalogs."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateProductCatalog
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ProductCatalog.steppers.AuthorProductCatalog
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditProductCatalog
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ProductCatalog.steppers.AuthorProductCatalog
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateProductCatalog
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ProductCatalog.steppers.AuthorProductCatalog
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteProductCatalog
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportProductCatalog
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportProductCatalog
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ProductCatalog.steppers.AuthorProductCatalog
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphProductCatalog
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
