_package: RetailCustomer360.entities.ContactPointAddress.action_sets
_type: ActionSet
_name: ContactPointAddressActionSet
entity: RetailCustomer360.entities.ContactPointAddress.ContactPointAddress
label: Contact Point Address Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateContactPointAddresses
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointAddress.steppers.AuthorContactPointAddresses
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditContactPointAddresses
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointAddress.steppers.AuthorContactPointAddresses
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateContactPointAddresses
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointAddress.steppers.AuthorContactPointAddresses
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportContactPointAddresses
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ContactPointAddress.steppers.ImportContactPointAddress
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

