_name: ContactPointAddress
_package: RetailCustomer360.entities.ContactPointAddress.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.ContactPointAddress.ContactPointAddress
default: true
primaryTextExpression: "CASE WHEN FDN_Customer IS NOT NULL AND AddressLine1 IS NOT NULL THEN FDN_Customer || ' - ' || AddressLine1 WHEN AddressLine1 IS NOT NULL THEN AddressLine1 WHEN FDN_Customer IS NOT NULL THEN FDN_Customer ELSE 'Customer Address' END"
secondaryTextExpression: "CASE WHEN City IS NOT NULL THEN City ELSE '' END || CASE WHEN StateProvince IS NOT NULL THEN CASE WHEN City IS NOT NULL THEN ', ' ELSE '' END || StateProvince ELSE '' END || CASE WHEN PostalCode IS NOT NULL THEN ' ' || PostalCode ELSE '' END || CASE WHEN FDN_Country IS NOT NULL THEN ' • ' || FDN_Country ELSE '' END || CASE WHEN AddressType IS NOT NULL THEN ' • ' || AddressType ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN IsVerified = 'Yes' THEN 'https://api.iconify.design/mdi/map-marker-check.svg?color=%23059669&width=128' WHEN IsPrimary = 'Yes' THEN 'https://api.iconify.design/mdi/home-map-marker.svg?color=%232563EB&width=128' ELSE 'https://api.iconify.design/mdi/map-marker.svg?color=%232563EB&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/map-marker.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN IsVerified = 'Yes' THEN 'https://api.iconify.design/mdi/map-marker-check.svg?color=%23059669&width=128' WHEN IsPrimary = 'Yes' THEN 'https://api.iconify.design/mdi/home-map-marker.svg?color=%232563EB&width=128' ELSE 'https://api.iconify.design/mdi/map-marker.svg?color=%232563EB&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

