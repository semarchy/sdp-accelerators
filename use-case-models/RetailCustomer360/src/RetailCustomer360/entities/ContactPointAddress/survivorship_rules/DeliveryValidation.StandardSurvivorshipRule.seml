_package: RetailCustomer360.entities.ContactPointAddress.survivorship_rules
_type: StandardSurvivorshipRule
_name: DeliveryValidation
entity: RetailCustomer360.entities.ContactPointAddress.ContactPointAddress
label: Address Delivery Validation Rule
description: "When merging address records, prefer the address that has been verified against a postal authority or delivery service. A validated deliverable address is the highest-quality physical contact point. Verified addresses from ECOMMERCE checkout are trusted first as they are validated at point of purchase, preventing failed deliveries."
documentation: "Address quality is critical for physical fulfilment and regulatory compliance. ECOMMERCE checkout typically validates addresses through postal service APIs at time of purchase, giving it higher accuracy than CRM manual entry. MANUAL source is ranked last as it has no systematic validation. This rule applies to the quality/status metadata, not the raw address fields which are governed by the DefaultRule."
defaultRule: false
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: IsVerified
  - attributeName: IsPrimary
  - attributeName: AddressType
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.ECOMMERCE
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.CRM
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.LOYALTY
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.POS
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.API
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.MANUAL
