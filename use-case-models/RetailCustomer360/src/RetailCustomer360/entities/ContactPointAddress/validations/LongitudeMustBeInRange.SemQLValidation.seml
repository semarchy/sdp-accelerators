_package: RetailCustomer360.entities.ContactPointAddress.validations
_name: LongitudeMustBeInRange
_type: SemQLValidation
entity: RetailCustomer360.entities.ContactPointAddress.ContactPointAddress
label: Longitude Must Be In Range
validationScope: PRE_CONSO
description: "Ensures Longitude is between -180 and 180 when provided."
condition: Longitude IS NULL OR (Longitude >= -180 AND Longitude <= 180)

