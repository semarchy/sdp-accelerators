_package: RetailCustomer360.entities.ContactPointAddress.validations
_name: CustomerMustExist
_type: SemQLValidation
entity: RetailCustomer360.entities.ContactPointAddress.ContactPointAddress
label: Customer Must Exist
validationScope: POST_CONSO
description: "Ensures that a Contact Point Address record cannot be created or updated without an existing associated Customer record."
condition: FID_Customer IS NOT NULL

