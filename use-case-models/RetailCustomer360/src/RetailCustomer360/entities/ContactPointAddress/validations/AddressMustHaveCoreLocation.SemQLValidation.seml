_package: RetailCustomer360.entities.ContactPointAddress.validations
_name: AddressMustHaveCoreLocation
_type: SemQLValidation
entity: RetailCustomer360.entities.ContactPointAddress.ContactPointAddress
label: Address Must Have Core Location
validationScope: PRE_CONSO
description: "Ensures at least one core location element is provided (Address Line 1, City, or Postal Code)."
condition: AddressLine1 IS NOT NULL OR City IS NOT NULL OR PostalCode IS NOT NULL

