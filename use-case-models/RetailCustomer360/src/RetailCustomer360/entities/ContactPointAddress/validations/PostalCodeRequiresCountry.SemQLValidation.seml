_package: RetailCustomer360.entities.ContactPointAddress.validations
_name: PostalCodeRequiresCountry
_type: SemQLValidation
entity: RetailCustomer360.entities.ContactPointAddress.ContactPointAddress
label: Postal Code Requires Country
validationScope: PRE_CONSO
description: "Ensures Country is provided when Postal Code is present."
condition: PostalCode IS NULL OR FID_Country IS NOT NULL

