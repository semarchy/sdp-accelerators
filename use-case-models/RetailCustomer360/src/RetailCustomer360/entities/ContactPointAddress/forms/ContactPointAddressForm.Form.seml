_package: RetailCustomer360.entities.ContactPointAddress.forms
_type: Form
_name: ContactPointAddressForm
entity: RetailCustomer360.entities.ContactPointAddress.ContactPointAddress
default: true

formTabs:
  - _type: FormTab
