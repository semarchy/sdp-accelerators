_package: RetailCustomer360.entities.ContactPointAddress.enrichers
_name: ContactPointAddressDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.ContactPointAddress.ContactPointAddress
label: ContactPointAddress Data Quality Enricher
description: "Computes standard completeness enrichment fields for ContactPointAddress."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN AddressId IS NULL AND AddressLine1 IS NULL AND AddressLine2 IS NULL THEN 0
        ELSE (
          CASE WHEN AddressId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN AddressLine1 IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN AddressLine2 IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN AddressId IS NULL AND AddressLine1 IS NULL AND AddressLine2 IS NULL THEN 'Low'
        WHEN (
          CASE WHEN AddressId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN AddressLine1 IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN AddressLine2 IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
