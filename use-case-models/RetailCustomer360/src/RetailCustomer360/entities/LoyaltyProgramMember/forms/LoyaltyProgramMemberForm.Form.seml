_package: RetailCustomer360.entities.LoyaltyProgramMember.forms
_type: Form
_name: LoyaltyProgramMemberForm
entity: RetailCustomer360.entities.LoyaltyProgramMember.LoyaltyProgramMember
default: true

formTabs:
