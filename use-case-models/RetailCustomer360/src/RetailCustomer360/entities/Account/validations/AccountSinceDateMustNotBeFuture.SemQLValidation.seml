_package: RetailCustomer360.entities.Account.validations
_name: AccountSinceDateMustNotBeFuture
_type: SemQLValidation
entity: RetailCustomer360.entities.Account.Account
label: Account Since Date Must Not Be Future
validationScope: PRE_CONSO
description: "Ensures Account Since Date is not in the future when provided."
condition: AccountSinceDate IS NULL OR AccountSinceDate <= CURRENT_DATE()

