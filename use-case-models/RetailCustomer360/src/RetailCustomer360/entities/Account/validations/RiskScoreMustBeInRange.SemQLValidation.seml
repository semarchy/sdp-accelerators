_package: RetailCustomer360.entities.Account.validations
_name: RiskScoreMustBeInRange
_type: SemQLValidation
entity: RetailCustomer360.entities.Account.Account
label: Risk Score Must Be In Range
validationScope: PRE_CONSO
description: "Ensures Risk Score is between 0 and 100 when provided."
condition: RiskScore IS NULL OR (RiskScore >= 0 AND RiskScore <= 100)

