_package: RetailCustomer360.entities.Account.validations
_name: CreditLimitMustBeNonNegative
_type: SemQLValidation
entity: RetailCustomer360.entities.Account.Account
label: Credit Limit Must Be Non Negative
validationScope: PRE_CONSO
description: "Ensures Credit Limit is not negative when provided."
condition: CreditLimit IS NULL OR CreditLimit >= 0

