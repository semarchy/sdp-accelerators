_package: RetailCustomer360.entities.Account.business_views
_type: BusinessView
_name: AccountBusinessView
label: Accounts
entity: RetailCustomer360.entities.Account.Account

rootLabel: Accounts
rootPluralLabel: Accounts
displayRootNodeAs: ICON_LABEL

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Account
  displayCard: RetailCustomer360.entities.Account.display_cards.Account
  entity: RetailCustomer360.entities.Account.Account
  actionSet: RetailCustomer360.entities.Account.action_sets.AccountActionSet
  collection: RetailCustomer360.entities.Account.collection_views.AccountCollectionView
