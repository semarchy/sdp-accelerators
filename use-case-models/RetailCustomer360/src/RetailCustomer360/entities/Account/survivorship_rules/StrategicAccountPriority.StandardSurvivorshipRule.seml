_package: RetailCustomer360.entities.Account.survivorship_rules
_type: StandardSurvivorshipRule
_name: StrategicAccountPriority
entity: RetailCustomer360.entities.Account.Account
label: Strategic Account Priority Rule
description: "Prioritizes strategic accounts during consolidation by ranking CRM and ECOMMERCE sources highest, reflecting trust in authoritative customer-managed systems. When merging account records where one is a strategic account (IsStrategicAccount = true), that account's relationship and risk attributes take precedence. This rule recognizes that strategic accounts often have dedicated relationship managers and special handling requirements, protecting their defined business terms and credit arrangements."
documentation: "Strategic accounts in enterprise settings require special governance. This rule implements a trusted-source ranking strategy that prioritizes CRM systems (where relationship managers maintain strategic account data) and ECOMMERCE (where negotiated contracts reside). For core business attributes like CreditLimit, RiskScore, and PaymentTermDays, this ensures that strategic account terms are not inadvertently overwritten by less authoritative sources. When both records represent strategic accounts or both are non-strategic, the CRM source is trusted first because relationship managers maintain the source of truth for account status and terms."
defaultRule: false
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_NEXT_USER_CHANGE
attributes:
  - attributeName: AccountName
  - attributeName: AccountStatus
  - attributeName: CreditLimit
  - attributeName: PaymentTermDays
  - attributeName: PreferredContactChannel
  - attributeName: IsStrategicAccount
  - attributeName: RiskScore
  - attributeName: AccountSinceDate
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.CRM
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.ECOMMERCE
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.MANUAL
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.API

