_package: RetailCustomer360.entities.Account.collection_views
_name: AccountImportCollectionView
_type: CollectionView
entity: RetailCustomer360.entities.Account.Account
default: false
displayCard: RetailCustomer360.entities.Account.display_cards.Account
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Account
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: SourceID
    value: SourceID
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: PublisherID
    value: PublisherID
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: AccountNumber
    value: AccountNumber
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: AccountName
    value: AccountName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: AccountType
    value: AccountType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: MenuColumn
    _name: AccountStatus
    value: AccountStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: MenuColumn
    _name: Industry
