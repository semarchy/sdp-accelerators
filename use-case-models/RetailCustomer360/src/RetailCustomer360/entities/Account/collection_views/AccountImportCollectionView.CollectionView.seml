      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Revenue
    value: Revenue
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: Currency
    value: FDN_Currency
