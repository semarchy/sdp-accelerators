_package: RetailCustomer360.entities.ContactPointConsent.display_cards
_type: DisplayCard
_name: ContactPointConsentDisplayCard
entity: RetailCustomer360.entities.ContactPointConsent.ContactPointConsent
default: true
primaryTextExpression: "CASE WHEN EngagementChannelType IS NOT NULL THEN EngagementChannelType || ' consent' ELSE 'Contact point consent' END"
secondaryTextExpression: "CASE WHEN ConsentStatus IS NOT NULL THEN ConsentStatus ELSE 'Status unknown' END || CASE WHEN FDN_ConsentAction IS NOT NULL THEN ' - ' || FDN_ConsentAction ELSE '' END || CASE WHEN Jurisdiction IS NOT NULL THEN ' - ' || Jurisdiction ELSE '' END"
