_package: RetailCustomer360.entities.ContactPointConsent.action_sets
_type: ActionSet
_name: ContactPointConsentActionSet
entity: RetailCustomer360.entities.ContactPointConsent.ContactPointConsent
label: ContactPointConsent Action Set
description: "Actions available to stewards on Contact Point Consents."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateContactPointConsent
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointConsent.steppers.AuthorContactPointConsent
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditContactPointConsent
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointConsent.steppers.AuthorContactPointConsent
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateContactPointConsent
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointConsent.steppers.AuthorContactPointConsent
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteContactPointConsent
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportContactPointConsent
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportContactPointConsent
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ContactPointConsent.steppers.AuthorContactPointConsent
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphContactPointConsent
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
