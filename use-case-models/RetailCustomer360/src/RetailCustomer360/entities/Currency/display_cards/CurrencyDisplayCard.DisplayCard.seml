_package: RetailCustomer360.entities.Currency.display_cards
_type: DisplayCard
_name: CurrencyDisplayCard
entity: RetailCustomer360.entities.Currency.Currency
default: true
primaryTextExpression: "CASE WHEN CurrencyName IS NOT NULL AND CurrencyCode IS NOT NULL THEN CurrencyName || ' (' || CurrencyCode || ')' WHEN CurrencyName IS NOT NULL THEN CurrencyName ELSE CurrencyCode END"
secondaryTextExpression: "CASE WHEN CurrencySymbol IS NOT NULL THEN CurrencySymbol ELSE '' END || CASE WHEN FDN_Country IS NOT NULL THEN ' • ' || FDN_Country ELSE '' END || CASE WHEN MinorUnit IS NOT NULL THEN ' • Minor Unit: ' || MinorUnit ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/cash-multiple.svg?color=%230D1B2A&width=256
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/cash-multiple.svg?color=%230D1B2A&width=256
primaryImageSourceType: URL
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/cash-multiple.svg?color=%230D1B2A&width=256
avatarImageAlign: MIDDLE_CENTER
avatarImageSourceType: URL
avatarImageMode: FIT

