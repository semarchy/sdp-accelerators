_package: RetailCustomer360.entities.Device.display_cards
_type: DisplayCard
_name: DeviceDisplayCard
entity: RetailCustomer360.entities.Device.Device
default: true
primaryTextExpression: "CASE WHEN Manufacturer IS NOT NULL AND DeviceModel IS NOT NULL THEN Manufacturer || ' ' || DeviceModel ELSE DeviceIdentifier END"
secondaryTextExpression: "CASE WHEN DeviceType IS NOT NULL THEN DeviceType ELSE 'Type unknown' END || CASE WHEN OperatingSystem IS NOT NULL THEN ' - ' || OperatingSystem ELSE '' END || CASE WHEN OsVersion IS NOT NULL THEN ' ' || OsVersion ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/devices.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/devices.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/devices.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
