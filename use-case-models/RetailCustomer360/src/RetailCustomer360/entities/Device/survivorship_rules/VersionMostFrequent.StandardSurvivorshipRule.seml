_package: RetailCustomer360.entities.Device.survivorship_rules
_type: StandardSurvivorshipRule
_name: VersionMostFrequent
entity: RetailCustomer360.entities.Device.Device
label: OS version (most frequent)
description: "Keeps the operating system version reported most often."
defaultRule: false
consolidationStrategy: MOST_FREQUENT_VALUE
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: OsVersion
  - attributeName: Locale
  - attributeName: TimeZone
