_package: RetailCustomer360.entities.Device.steppers
_type: Stepper
_name: AuthorDevice
entity: RetailCustomer360.entities.Device.Device
label: Devices
description: "Guided authoring flow for Devices."
rootStep:
  _type: CollectionStep
  _name: DeviceCollection
  label: Devices
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: RetailCustomer360.entities.Device.collection_views.DeviceCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Details
      label: Details
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: RetailCustomer360.entities.Device.forms.DeviceForm.Overview
