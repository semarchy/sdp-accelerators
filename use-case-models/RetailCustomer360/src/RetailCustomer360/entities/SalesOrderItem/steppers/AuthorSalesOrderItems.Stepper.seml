_package: RetailCustomer360.entities.SalesOrderItem.steppers
_type: Stepper
_name: AuthorSalesOrderItems
entity: RetailCustomer360.entities.SalesOrderItem.SalesOrderItem
label: Sales Order Items

rootStep:
  _type: CollectionStep
  _name: SalesOrderItems
  label: Sales Order Items
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: RetailCustomer360.entities.SalesOrderItem.collection_views.SalesOrderItemCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Details
      label: Details
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: RetailCustomer360.entities.SalesOrderItem.forms.SalesOrderItemForm.Overview
stepperFinishValidations:
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: RetailCustomer360.entities.SalesOrderItem.validations.MustHaveProduct
