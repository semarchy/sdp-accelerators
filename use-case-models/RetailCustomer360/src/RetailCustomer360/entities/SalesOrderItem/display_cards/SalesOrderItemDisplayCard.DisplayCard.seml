_name: SalesOrderItemDisplayCard
_package: RetailCustomer360.entities.SalesOrderItem.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.SalesOrderItem.SalesOrderItem
default: true
primaryTextExpression: "CASE WHEN FDN_Product IS NOT NULL THEN FDN_Product ELSE CASE WHEN ItemType IS NOT NULL THEN ItemType ELSE 'Order Item' END END || CASE WHEN FDN_SalesOrder IS NOT NULL THEN ' • ' || FDN_SalesOrder ELSE '' END"
secondaryTextExpression: "CASE WHEN FulfillmentStatus IS NOT NULL THEN FulfillmentStatus ELSE 'Status Unknown' END || CASE WHEN ReturnStatus IS NOT NULL THEN ' • ' || ReturnStatus ELSE '' END || CASE WHEN ItemLifecycleStatus IS NOT NULL THEN ' • ' || ItemLifecycleStatus ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN ItemLifecycleStatus = 'Completed' AND ItemFinancialHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/package-check.svg?color=%23059669&width=128' WHEN ItemLifecycleStatus = 'Closed' THEN 'https://api.iconify.design/mdi/package-variant-closed-remove.svg?color=%23DC2626&width=128' WHEN ItemFinancialHealthStatus IN ('Invalid', 'Over List Price') THEN 'https://api.iconify.design/mdi/package-variant-closed-alert.svg?color=%23D97706&width=128' ELSE 'https://api.iconify.design/mdi/package.svg?color=%232563EB&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/package.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN ItemLifecycleStatus = 'Completed' AND ItemFinancialHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/package-check.svg?color=%23059669&width=128' WHEN ItemLifecycleStatus = 'Closed' THEN 'https://api.iconify.design/mdi/package-variant-closed-remove.svg?color=%23DC2626&width=128' WHEN ItemFinancialHealthStatus IN ('Invalid', 'Over List Price') THEN 'https://api.iconify.design/mdi/package-variant-closed-alert.svg?color=%23D97706&width=128' ELSE 'https://api.iconify.design/mdi/package.svg?color=%232563EB&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

