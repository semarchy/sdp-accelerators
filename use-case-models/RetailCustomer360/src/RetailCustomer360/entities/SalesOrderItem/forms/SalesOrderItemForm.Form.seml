                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                        referencedEntity: RetailCustomer360.entities.SalesOrder.SalesOrder
                        componentProperties:
                          displayType: chip
                          useAvatarInChip: '1'
                          useSecondaryTextInChip: '1'
                      - _type: TextField
                        _name: OvrLineNumber
                        value: LineNumber
                        useCustomLabel: false
