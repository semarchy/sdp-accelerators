_package: RetailCustomer360.entities.SalesOrderItem.forms
_type: Form
_name: SalesOrderItemForm
entity: RetailCustomer360.entities.SalesOrderItem.SalesOrderItem
default: true

formTabs:
  - _type: FormTab
    _name: Overview
    label: Overview
    iconUrl: https://api.iconify.design/mdi/view-dashboard-outline.svg?color=%230D1B2A&width=64
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
