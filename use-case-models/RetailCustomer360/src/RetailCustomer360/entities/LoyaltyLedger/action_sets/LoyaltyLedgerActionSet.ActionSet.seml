_package: RetailCustomer360.entities.LoyaltyLedger.action_sets
_type: ActionSet
_name: LoyaltyLedgerActionSet
entity: RetailCustomer360.entities.LoyaltyLedger.LoyaltyLedger
label: LoyaltyLedger Action Set
description: "Actions available to stewards on Loyalty Ledger Entries."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateLoyaltyLedger
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.LoyaltyLedger.steppers.AuthorLoyaltyLedger
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditLoyaltyLedger
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.LoyaltyLedger.steppers.AuthorLoyaltyLedger
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateLoyaltyLedger
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.LoyaltyLedger.steppers.AuthorLoyaltyLedger
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteLoyaltyLedger
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportLoyaltyLedger
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportLoyaltyLedger
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.LoyaltyLedger.steppers.AuthorLoyaltyLedger
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphLoyaltyLedger
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
