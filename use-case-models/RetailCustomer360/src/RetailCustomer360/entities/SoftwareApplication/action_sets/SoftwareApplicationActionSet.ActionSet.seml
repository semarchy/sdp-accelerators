_package: RetailCustomer360.entities.SoftwareApplication.action_sets
_type: ActionSet
_name: SoftwareApplicationActionSet
entity: RetailCustomer360.entities.SoftwareApplication.SoftwareApplication
label: SoftwareApplication Action Set
description: "Actions available to stewards on Software Applications."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateSoftwareApplication
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SoftwareApplication.steppers.AuthorSoftwareApplication
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditSoftwareApplication
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SoftwareApplication.steppers.AuthorSoftwareApplication
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateSoftwareApplication
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SoftwareApplication.steppers.AuthorSoftwareApplication
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteSoftwareApplication
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportSoftwareApplication
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportSoftwareApplication
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.SoftwareApplication.steppers.AuthorSoftwareApplication
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphSoftwareApplication
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
