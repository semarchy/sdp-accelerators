_package: RetailCustomer360.entities.SoftwareApplication.display_cards
_type: DisplayCard
_name: SoftwareApplicationDisplayCard
entity: RetailCustomer360.entities.SoftwareApplication.SoftwareApplication
default: true
primaryTextExpression: "CASE WHEN ApplicationName IS NOT NULL THEN ApplicationName ELSE 'Unnamed Application' END"
secondaryTextExpression: "CASE WHEN AppPlatform IS NOT NULL THEN AppPlatform ELSE 'Platform unknown' END || CASE WHEN AppVersion IS NOT NULL THEN ' - v' || AppVersion ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/application-cog.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/application-cog.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/application-cog.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
