_package: RetailCustomer360.entities.ContactPointEmail.survivorship_rules
_type: StandardSurvivorshipRule
_name: DeliverabilityStatus
entity: RetailCustomer360.entities.ContactPointEmail.ContactPointEmail
label: Email Deliverability and Verification Status
description: "When merging email contact points, prefer the record that has been verified and confirmed deliverable. An email marked as verified and not bounced is more valuable than an unverified address from a different source. Consent status should also be sourced from the system that last processed it."
documentation: "Email deliverability is a critical data quality attribute. CRM and ECOMMERCE systems that perform real-time verification (double opt-in, bounce tracking) have more accurate status than systems that import emails without validation. This rule ensures verified/active email metadata is not overwritten by unvalidated data from POS or MANUAL entry."
defaultRule: false
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: IsVerified
  - attributeName: VerificationDate
  - attributeName: ConsentStatus
  - attributeName: EmailDeliverabilityStatus
  - attributeName: BounceReason
  - attributeName: IsPrimary
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.ECOMMERCE
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.CRM
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.LOYALTY
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.API
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.POS
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.MANUAL
