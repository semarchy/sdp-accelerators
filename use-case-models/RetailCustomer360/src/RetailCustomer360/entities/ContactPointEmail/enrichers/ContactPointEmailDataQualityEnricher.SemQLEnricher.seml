_package: RetailCustomer360.entities.ContactPointEmail.enrichers
_name: ContactPointEmailDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.ContactPointEmail.ContactPointEmail
label: ContactPointEmail Data Quality Enricher
description: "Computes standard completeness enrichment fields for ContactPointEmail."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN EmailId IS NULL AND EmailAddress IS NULL AND EmailType IS NULL THEN 0
        ELSE (
          CASE WHEN EmailId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN EmailAddress IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN EmailType IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN EmailId IS NULL AND EmailAddress IS NULL AND EmailType IS NULL THEN 'Low'
        WHEN (
          CASE WHEN EmailId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN EmailAddress IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN EmailType IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
