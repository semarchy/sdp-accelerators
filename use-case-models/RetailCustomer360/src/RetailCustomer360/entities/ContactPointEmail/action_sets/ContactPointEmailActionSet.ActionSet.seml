_package: RetailCustomer360.entities.ContactPointEmail.action_sets
_type: ActionSet
_name: ContactPointEmailActionSet
entity: RetailCustomer360.entities.ContactPointEmail.ContactPointEmail
label: Contact Point Email Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateContactPointEmails
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointEmail.steppers.AuthorContactPointEmails
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditContactPointEmails
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointEmail.steppers.AuthorContactPointEmails
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateContactPointEmails
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointEmail.steppers.AuthorContactPointEmails
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportContactPointEmails
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ContactPointEmail.steppers.ImportContactPointEmail
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

