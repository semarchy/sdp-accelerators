_name: ContactPointEmail
_package: RetailCustomer360.entities.ContactPointEmail.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.ContactPointEmail.ContactPointEmail
default: true
primaryTextExpression: "CASE WHEN FDN_Customer IS NOT NULL AND EmailAddress IS NOT NULL THEN FDN_Customer || ' - ' || EmailAddress WHEN EmailAddress IS NOT NULL THEN EmailAddress ELSE 'Customer Email' END"
secondaryTextExpression: "CASE WHEN EmailDeliverabilityStatus IS NOT NULL THEN EmailDeliverabilityStatus ELSE 'Deliverability Unknown' END || CASE WHEN ConsentStatus IS NOT NULL THEN ' • ' || ConsentStatus ELSE '' END || CASE WHEN IsPrimary = 'Yes' THEN ' • Primary' ELSE '' END || CASE WHEN IsVerified = 'Yes' THEN ' • Verified' ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN EmailDeliverabilityStatus = 'Deliverable' THEN 'https://api.iconify.design/mdi/email-check.svg?color=%23059669&width=128' WHEN EmailDeliverabilityStatus IN ('Bounced', 'Invalid', 'Suppressed') THEN 'https://api.iconify.design/mdi/email-remove.svg?color=%23DC2626&width=128' ELSE 'https://api.iconify.design/mdi/email.svg?color=%232563EB&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/email.svg?color=%230D1B2A&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN EmailDeliverabilityStatus = 'Deliverable' THEN 'https://api.iconify.design/mdi/email-check.svg?color=%23059669&width=128' WHEN EmailDeliverabilityStatus IN ('Bounced', 'Invalid', 'Suppressed') THEN 'https://api.iconify.design/mdi/email-remove.svg?color=%23DC2626&width=128' ELSE 'https://api.iconify.design/mdi/email.svg?color=%232563EB&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

