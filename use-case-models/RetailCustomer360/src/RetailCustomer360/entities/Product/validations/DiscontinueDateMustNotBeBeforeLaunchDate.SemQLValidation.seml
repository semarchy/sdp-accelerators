_package: RetailCustomer360.entities.Product.validations
_name: DiscontinueDateMustNotBeBeforeLaunchDate
_type: SemQLValidation
entity: RetailCustomer360.entities.Product.Product
label: Discontinue Date Must Not Be Before Launch Date
validationScope: PRE_CONSO
description: "Ensures discontinue date is on or after launch date when both dates are provided."
condition: LaunchDate IS NULL OR DiscontinueDate IS NULL OR DiscontinueDate >= LaunchDate

