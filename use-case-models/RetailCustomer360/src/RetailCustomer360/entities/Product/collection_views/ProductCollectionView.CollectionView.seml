_package: RetailCustomer360.entities.Product.collection_views
_type: CollectionView
_name: ProductCollectionView
entity: RetailCustomer360.entities.Product.Product
default: true
displayCard: RetailCustomer360.entities.Product.display_cards.ProductDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Product
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: ProductCode
    value: ProductCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: ProductName
    value: ProductName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: Brand
    value: FDN_Brand
    useCustomLabel: true
    label: Brand
    referencedEntity: RetailCustomer360.entities.Brand.Brand
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "1"
  - _type: TextColumn
    _name: SKU
    value: SKU
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: ProductStatus
    value: ProductStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Price
    value: Price
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: Currency
    value: FDN_Currency
    useCustomLabel: true
    label: Currency
    referencedEntity: RetailCustomer360.entities.Currency.Currency
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "1"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: PricingHealthStatus
    value: PricingHealthStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: ProductLifecycleStatus
    value: ProductLifecycleStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: MarginAmount
    value: MarginAmount
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: MarginPercent
    value: MarginPercent
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
  - _type: MenuColumn
    _name: ProductType
    value: ProductType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: ProductDescription
    value: ProductDescription
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: Barcode
    value: Barcode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: ListPrice
    value: ListPrice
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: DateColumn
    _name: LaunchDate
    value: LaunchDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: false
  - _type: DateColumn
    _name: DiscontinueDate
    value: DiscontinueDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: false




