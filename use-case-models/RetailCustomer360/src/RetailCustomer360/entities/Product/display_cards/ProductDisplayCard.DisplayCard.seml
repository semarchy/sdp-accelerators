_name: ProductDisplayCard
_package: RetailCustomer360.entities.Product.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.Product.Product
default: true
primaryTextExpression: "CASE WHEN ProductName IS NOT NULL THEN ProductName ELSE ProductCode END"
secondaryTextExpression: "CASE WHEN ProductCode IS NOT NULL THEN ProductCode ELSE '' END || CASE WHEN FDN_Brand IS NOT NULL THEN ' • ' || FDN_Brand ELSE '' END || CASE WHEN ProductLifecycleStatus IS NOT NULL THEN ' • ' || ProductLifecycleStatus ELSE '' END || CASE WHEN PricingHealthStatus IS NOT NULL THEN ' • ' || PricingHealthStatus ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN ProductLifecycleStatus = 'Active' AND PricingHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/package-check.svg?color=%23059669&width=128' WHEN ProductLifecycleStatus = 'Discontinued' THEN 'https://api.iconify.design/mdi/package-variant-closed-remove.svg?color=%23DC2626&width=128' WHEN PricingHealthStatus IN ('Invalid', 'Below Cost') THEN 'https://api.iconify.design/mdi/package-variant-closed-alert.svg?color=%23D97706&width=128' ELSE 'https://api.iconify.design/mdi/package-variant.svg?color=%232563EB&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/package-variant.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN ProductLifecycleStatus = 'Active' AND PricingHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/package-check.svg?color=%23059669&width=128' WHEN ProductLifecycleStatus = 'Discontinued' THEN 'https://api.iconify.design/mdi/package-variant-closed-remove.svg?color=%23DC2626&width=128' WHEN PricingHealthStatus IN ('Invalid', 'Below Cost') THEN 'https://api.iconify.design/mdi/package-variant-closed-alert.svg?color=%23D97706&width=128' ELSE 'https://api.iconify.design/mdi/package-variant.svg?color=%232563EB&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
