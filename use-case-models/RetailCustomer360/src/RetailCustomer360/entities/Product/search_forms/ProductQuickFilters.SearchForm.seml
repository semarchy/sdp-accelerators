_package: RetailCustomer360.entities.Product.search_forms
_type: SearchForm
_name: ProductQuickFilters
label: Product Quick Filters
entity: RetailCustomer360.entities.Product.Product
semQlCondition: 1=1
searchParameters:
  - _name: Brand
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_BRAND
    label: Brand
    dataType: String
    length: 64
    displayType: VALUE_PICKER
    boundSelectExpression: FDN_Brand
    primaryTextExpression: FDN_Brand
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.Product.Product
  - _name: ProductStatus
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_STATUS
    label: Product Status
    dataType: String
    length: 64
    displayType: VALUE_PICKER
    boundSelectExpression: ProductStatus
    primaryTextExpression: ProductStatus
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.Product.Product
  - _name: ProductLifecycleStatus
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_LIFECYCLE
    label: Lifecycle Status
    dataType: String
    length: 32
    displayType: VALUE_PICKER
    boundSelectExpression: ProductLifecycleStatus
    primaryTextExpression: ProductLifecycleStatus
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.Product.Product
  - _name: PricingHealthStatus
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_PRICING_HEALTH
    label: Pricing Health
    dataType: String
    length: 32
    displayType: VALUE_PICKER
    boundSelectExpression: PricingHealthStatus
    primaryTextExpression: PricingHealthStatus
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.Product.Product

