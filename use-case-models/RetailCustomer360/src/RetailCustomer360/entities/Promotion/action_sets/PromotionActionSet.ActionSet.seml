_package: RetailCustomer360.entities.Promotion.action_sets
_type: ActionSet
_name: PromotionActionSet
entity: RetailCustomer360.entities.Promotion.Promotion
label: Promotion Action Set
description: "Actions available to stewards on Promotions."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreatePromotion
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Promotion.steppers.AuthorPromotion
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditPromotion
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Promotion.steppers.AuthorPromotion
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdatePromotion
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Promotion.steppers.AuthorPromotion
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeletePromotion
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportPromotion
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportPromotion
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.Promotion.steppers.AuthorPromotion
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphPromotion
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
