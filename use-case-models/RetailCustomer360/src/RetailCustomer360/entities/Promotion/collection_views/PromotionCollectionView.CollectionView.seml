_package: RetailCustomer360.entities.Promotion.collection_views
_type: CollectionView
_name: PromotionCollectionView
entity: RetailCustomer360.entities.Promotion.Promotion
default: true
description: "Default list of Promotions records."
displayCard: RetailCustomer360.entities.Promotion.display_cards.PromotionDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Promotion
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: PromotionId
    value: PromotionId
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: true
  - _type: TextColumn
    _name: PromotionCode
    value: PromotionCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: PromotionName
    value: PromotionName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: PromotionType
    value: PromotionType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: MenuColumn
    _name: PromotionStatus
    value: PromotionStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: DateColumn
    _name: StartDate
    value: StartDate
    useCustomLabel: false
    dataType: TIMESTAMP
    columnAlign: LEFT
    visibleByDefault: true
  - _type: DateColumn
    _name: EndDate
    value: EndDate
    useCustomLabel: false
    dataType: TIMESTAMP
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: DiscountValue
    value: DiscountValue
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
  - _type: TextColumn
    _name: MinimumSpend
    value: MinimumSpend
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: MaxRedemptions
    value: MaxRedemptions
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: false
  - _type: TextColumn
    _name: RedemptionCount
    value: RedemptionCount
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: false
  - _type: MenuColumn
    _name: TargetSegment
    value: TargetSegment
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: TermsAndConditions
    value: TermsAndConditions
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: CheckboxColumn
    _name: IsStackable
    value: IsStackable
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: PromotionWindowStatus
    value: PromotionWindowStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
  - _type: MenuColumn
    _name: SourceSystem
    value: SourceSystem
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: Campaign
    value: FDN_Campaign
    useCustomLabel: true
