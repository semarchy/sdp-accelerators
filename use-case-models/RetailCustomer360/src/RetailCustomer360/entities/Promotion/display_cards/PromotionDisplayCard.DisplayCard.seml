_package: RetailCustomer360.entities.Promotion.display_cards
_type: DisplayCard
_name: PromotionDisplayCard
entity: RetailCustomer360.entities.Promotion.Promotion
default: true
primaryTextExpression: "CASE WHEN PromotionName IS NOT NULL THEN PromotionName ELSE PromotionCode END"
secondaryTextExpression: "CASE WHEN PromotionStatus IS NOT NULL THEN PromotionStatus ELSE 'Status unknown' END || CASE WHEN PromotionType IS NOT NULL THEN ' - ' || PromotionType ELSE '' END || CASE WHEN PromotionWindowStatus IS NOT NULL THEN ' - ' || PromotionWindowStatus ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/sale.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/sale.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/sale.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
