_package: RetailCustomer360.entities.PartyIdentification.action_sets
_type: ActionSet
_name: PartyIdentificationActionSet
entity: RetailCustomer360.entities.PartyIdentification.PartyIdentification
label: Party Identification Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreatePartyIdentifications
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.PartyIdentification.steppers.AuthorPartyIdentifications
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditPartyIdentifications
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.PartyIdentification.steppers.AuthorPartyIdentifications
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdatePartyIdentifications
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.PartyIdentification.steppers.AuthorPartyIdentifications
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportPartyIdentifications
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.PartyIdentification.steppers.ImportPartyIdentification
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

