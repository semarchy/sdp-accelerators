_package: RetailCustomer360.entities.PartyIdentification.validations
_name: ExpiryDateMustNotBeBeforeIssueDate
_type: SemQLValidation
entity: RetailCustomer360.entities.PartyIdentification.PartyIdentification
label: Expiry Date Must Not Be Before Issue Date
validationScope: PRE_CONSO
description: "Ensures expiry date is on or after issue date when both are present."
condition: IssueDate IS NULL OR ExpiryDate IS NULL OR ExpiryDate >= IssueDate

