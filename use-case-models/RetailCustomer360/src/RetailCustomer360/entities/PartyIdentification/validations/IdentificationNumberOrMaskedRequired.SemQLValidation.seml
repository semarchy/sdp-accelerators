_package: RetailCustomer360.entities.PartyIdentification.validations
_name: IdentificationNumberOrMaskedRequired
_type: SemQLValidation
entity: RetailCustomer360.entities.PartyIdentification.PartyIdentification
label: Identification Number Or Masked Value Required
validationScope: PRE_CONSO
description: "Ensures at least one identification value is present."
condition: IdentificationNumber IS NOT NULL OR MaskedIdentificationNumber IS NOT NULL

