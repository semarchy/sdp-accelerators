_package: RetailCustomer360.entities.PartyIdentification.survivorship_rules
_type: StandardSurvivorshipRule
_name: SourceSystemPriority
entity: RetailCustomer360.entities.PartyIdentification.PartyIdentification
label: Source System Priority Rule - Authoritative ID Source
description: "Consolidates core identification attributes by trusting government and regulated systems above commercial sources. PAN and national ID data from government-linked integration APIs is more authoritative than the same data entered manually in a CRM. This rule ensures the identification number and type are sourced from the most trustworthy integration channel."
documentation: "In retail banking and loyalty contexts, identification numbers can arrive from multiple channels: point-of-sale at onboarding, e-commerce self-service, CRM agents, or direct API integration with verification bureaus. This rule ranks API integrations (typically bureau feeds) and ECOMMERCE (customer self-service with documented proof) as most trusted for the raw identification values, while CRM and MANUAL are trusted only for lifecycle management attributes captured in the verification rule."
defaultRule: false
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: IdentificationType
  - attributeName: IdentificationNumber
  - attributeName: MaskedIdentificationNumber
  - attributeName: IssueDate
  - attributeName: SourceIdentificationKey
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.API
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.ECOMMERCE
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.POS
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.CRM
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.MANUAL
