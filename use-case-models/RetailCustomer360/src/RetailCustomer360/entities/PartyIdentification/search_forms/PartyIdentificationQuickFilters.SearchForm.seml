_package: RetailCustomer360.entities.PartyIdentification.search_forms
_type: SearchForm
_name: PartyIdentificationQuickFilters
label: Party Identification Quick Filters
entity: RetailCustomer360.entities.PartyIdentification.PartyIdentification
semQlCondition: 1=1
searchParameters:
  - _name: Customer
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_CUSTOMER
    label: Customer
    dataType: String
    length: 100
    displayType: VALUE_PICKER
    boundSelectExpression: FDN_Customer
    primaryTextExpression: FDN_Customer
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.PartyIdentification.PartyIdentification
  - _name: IdentificationType
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_ID_TYPE
    label: Identification Type
    dataType: String
    length: 64
    displayType: VALUE_PICKER
    boundSelectExpression: IdentificationType
    primaryTextExpression: IdentificationType
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.PartyIdentification.PartyIdentification
  - _name: IdentificationStatus
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_ID_STATUS
    label: Identification Status
    dataType: String
    length: 64
    displayType: VALUE_PICKER
    boundSelectExpression: IdentificationStatus
    primaryTextExpression: IdentificationStatus
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.PartyIdentification.PartyIdentification
  - _name: IdentificationLifecycleStatus
    _type: SearchParameter
    bindVariableName: SEARCH_PARAM_LIFECYCLE
    label: Lifecycle Status
    dataType: String
    length: 32
    displayType: VALUE_PICKER
    boundSelectExpression: IdentificationLifecycleStatus
    primaryTextExpression: IdentificationLifecycleStatus
    useDistinct: true
    displayCount: false
    lookupEntity: RetailCustomer360.entities.PartyIdentification.PartyIdentification
  - _name: VerificationConfidenceStatus
