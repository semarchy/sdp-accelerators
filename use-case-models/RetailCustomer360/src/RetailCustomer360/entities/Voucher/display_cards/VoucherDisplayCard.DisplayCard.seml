_package: RetailCustomer360.entities.Voucher.display_cards
_type: DisplayCard
_name: VoucherDisplayCard
entity: RetailCustomer360.entities.Voucher.Voucher
default: true
primaryTextExpression: "VoucherCode"
secondaryTextExpression: "CASE WHEN VoucherStatus IS NOT NULL THEN VoucherStatus ELSE 'Status unknown' END || CASE WHEN RemainingValue IS NOT NULL THEN ' - ' || RemainingValue || ' remaining' ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/ticket-percent.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/ticket-percent.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/ticket-percent.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
