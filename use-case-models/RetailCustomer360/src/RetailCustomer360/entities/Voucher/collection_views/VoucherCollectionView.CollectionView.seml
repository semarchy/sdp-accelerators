    columnAlign: LEFT
    visibleByDefault: false
  - _type: MenuColumn
    _name: SourceSystem
    value: SourceSystem
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: EnrichmentCompletenessScore
    value: EnrichmentCompletenessScore
