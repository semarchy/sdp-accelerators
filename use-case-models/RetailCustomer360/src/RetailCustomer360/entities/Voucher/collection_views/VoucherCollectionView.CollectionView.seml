_package: RetailCustomer360.entities.Voucher.collection_views
_type: CollectionView
_name: VoucherCollectionView
entity: RetailCustomer360.entities.Voucher.Voucher
default: true
description: "Default list of Vouchers records."
displayCard: RetailCustomer360.entities.Voucher.display_cards.VoucherDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Voucher
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: VoucherCode
    value: VoucherCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: VoucherType
    value: VoucherType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: MenuColumn
    _name: VoucherStatus
    value: VoucherStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: FaceValue
    value: FaceValue
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: RemainingValue
    value: RemainingValue
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: CurrencyCode
    value: CurrencyCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: DateColumn
    _name: IssuedDate
    value: IssuedDate
    useCustomLabel: false
    dataType: TIMESTAMP
    columnAlign: LEFT
    visibleByDefault: false
  - _type: DateColumn
    _name: ExpirationDate
    value: ExpirationDate
    useCustomLabel: false
    dataType: TIMESTAMP
    columnAlign: LEFT
    visibleByDefault: false
  - _type: DateColumn
    _name: RedeemedDate
    value: RedeemedDate
    useCustomLabel: false
    dataType: TIMESTAMP
    columnAlign: LEFT
    visibleByDefault: false
  - _type: TextColumn
    _name: MinimumSpend
    value: MinimumSpend
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: false
    componentProperties:
      displayFormat: '$ #,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: CheckboxColumn
    _name: IsTransferable
    value: IsTransferable
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: false
  - _type: CheckboxColumn
    _name: IsPartialRedeemAllowed
