_package: RetailCustomer360.entities.ContactPointSocial.forms
_type: Form
_name: ContactPointSocialForm
entity: RetailCustomer360.entities.ContactPointSocial.ContactPointSocial
default: true

formTabs:
  - _type: FormTab
    _name: Overview
    label: Overview
    iconUrl: https://api.iconify.design/mdi/view-dashboard-outline.svg?color=%230D1B2A&width=64
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: OverviewRow
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: OverviewCol1
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrSocialProfile
                label: Social Profile
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrSocialProfileRow
                    layoutDirection: COLUMN
                    content:
                      - _type: MenuField
                        _name: OvrSocialNetwork
                        value: SocialNetwork
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrSocialHandle
                        value: SocialHandle
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: HyperlinkField
                        _name: OvrProfileUrl
                        value: ProfileUrl
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrStatus
                        value: Status
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: CheckboxField
                        _name: OvrIsPrimary
                        value: IsPrimary
                        useCustomLabel: false
                        dataType: BOOLEAN
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
          - _type: FormContainer
            _name: OverviewCol2
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrReachActivity
                label: Reach & Activity
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrReachActivityRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrFollowerCount
                        value: FollowerCount
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEngagementScore
                        value: EngagementScore
                        useCustomLabel: false
                        dataType: DECIMAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrLastActivityDate
                        value: LastActivityDate
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
              - _type: FormSection
                _name: OvrVerification
                label: Verification
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrVerificationRow
                    layoutDirection: COLUMN
                    content:
                      - _type: CheckboxField
                        _name: OvrIsVerified
                        value: IsVerified
                        useCustomLabel: false
                        dataType: BOOLEAN
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
          - _type: FormContainer
            _name: OverviewCol3
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrCustomer
                label: Customer
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrCustomerRow
                    layoutDirection: COLUMN
                    content:
                      - _type: ReferenceField
                        _name: OvrFDN_Customer
                        value: FDN_Customer
                        useCustomLabel: true
                        label: Customer
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                        referencedEntity: RetailCustomer360.entities.Customer.Customer
                        componentProperties:
                          displayType: chip
                          useAvatarInChip: '1'
                          useSecondaryTextInChip: '1'
              - _type: FormSection
                _name: OvrSourceDataQuality
                label: Source & Data Quality
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrSourceDataQualityRow
                    layoutDirection: COLUMN
                    content:
                      - _type: MenuField
                        _name: OvrSourceSystem
                        value: SourceSystem
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrSourceSocialKey
                        value: SourceSocialKey
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrHandleNormalized
                        value: HandleNormalized
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrSocialId
                        value: SocialId
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEnrichmentCompletenessScore
                        value: EnrichmentCompletenessScore
                        useCustomLabel: true
                        label: Completeness Score
                        dataType: DECIMAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEnrichmentCompletenessBand
                        value: EnrichmentCompletenessBand
                        useCustomLabel: true
                        label: Completeness Band
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrEnrichmentUpdatedOn
                        value: EnrichmentUpdatedOn
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
