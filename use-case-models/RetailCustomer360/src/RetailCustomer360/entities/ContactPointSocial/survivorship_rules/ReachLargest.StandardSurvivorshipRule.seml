_package: RetailCustomer360.entities.ContactPointSocial.survivorship_rules
_type: StandardSurvivorshipRule
_name: ReachLargest
entity: RetailCustomer360.entities.ContactPointSocial.ContactPointSocial
label: Follower count (largest value)
description: "Keeps the highest observed follower count."
defaultRule: false
consolidationStrategy: LARGEST_VALUE
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: FollowerCount
