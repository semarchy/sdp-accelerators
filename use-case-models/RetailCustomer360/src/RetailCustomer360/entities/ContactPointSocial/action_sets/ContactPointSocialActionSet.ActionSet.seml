_package: RetailCustomer360.entities.ContactPointSocial.action_sets
_type: ActionSet
_name: ContactPointSocialActionSet
entity: RetailCustomer360.entities.ContactPointSocial.ContactPointSocial
label: ContactPointSocial Action Set
description: "Actions available to stewards on Social Contact Points."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateContactPointSocial
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointSocial.steppers.AuthorContactPointSocial
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditContactPointSocial
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointSocial.steppers.AuthorContactPointSocial
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateContactPointSocial
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointSocial.steppers.AuthorContactPointSocial
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteContactPointSocial
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportContactPointSocial
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportContactPointSocial
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ContactPointSocial.steppers.ImportContactPointSocial
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphContactPointSocial
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
