_package: RetailCustomer360.entities.ContactPointSocial.enrichers
_name: ContactPointSocialDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.ContactPointSocial.ContactPointSocial
label: ContactPointSocial Data Quality Enricher
description: "Computes standard completeness enrichment fields for ContactPointSocial."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN SocialId IS NULL AND SocialNetwork IS NULL AND SocialHandle IS NULL THEN 0
        ELSE (
          CASE WHEN SocialId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN SocialNetwork IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN SocialHandle IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN SocialId IS NULL AND SocialNetwork IS NULL AND SocialHandle IS NULL THEN 'Low'
        WHEN (
          CASE WHEN SocialId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN SocialNetwork IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN SocialHandle IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()