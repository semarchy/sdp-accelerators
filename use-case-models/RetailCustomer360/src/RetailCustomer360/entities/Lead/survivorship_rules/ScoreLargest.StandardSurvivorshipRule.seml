_package: RetailCustomer360.entities.Lead.survivorship_rules
_type: StandardSurvivorshipRule
_name: ScoreLargest
entity: RetailCustomer360.entities.Lead.Lead
label: Lead score (largest value)
description: "Keeps the highest behavioural score observed across sources."
defaultRule: false
consolidationStrategy: LARGEST_VALUE
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: LeadScore
