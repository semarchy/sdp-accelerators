_package: RetailCustomer360.entities.Lead.display_cards
_type: DisplayCard
_name: LeadDisplayCard
entity: RetailCustomer360.entities.Lead.Lead
default: true
primaryTextExpression: "CASE WHEN FullName IS NOT NULL THEN FullName WHEN CompanyName IS NOT NULL THEN CompanyName ELSE 'Unnamed Lead' END"
secondaryTextExpression: "CASE WHEN LeadStatus IS NOT NULL THEN LeadStatus ELSE 'Status unknown' END || CASE WHEN LeadRating IS NOT NULL THEN ' - ' || LeadRating ELSE '' END || CASE WHEN CompanyName IS NOT NULL THEN ' - ' || CompanyName ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/account-star.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/account-star.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/account-star.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
