_package: RetailCustomer360.entities.Lead.enrichers
_name: LeadDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.Lead.Lead
label: Lead Data Quality Enricher
description: "Computes standard completeness enrichment fields for Lead."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN LeadId IS NULL AND FirstName IS NULL AND LastName IS NULL THEN 0
        ELSE (
          CASE WHEN LeadId IS NOT NULL THEN 20 ELSE 0 END
          + CASE WHEN FirstName IS NOT NULL THEN 15 ELSE 0 END
          + CASE WHEN LastName IS NOT NULL THEN 15 ELSE 0 END
          + CASE WHEN EmailAddress IS NOT NULL THEN 20 ELSE 0 END
          + CASE WHEN PhoneNumber IS NOT NULL THEN 15 ELSE 0 END
          + CASE WHEN CompanyName IS NOT NULL THEN 15 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN LeadId IS NULL AND FirstName IS NULL AND LastName IS NULL THEN 'Low'
        WHEN (
          CASE WHEN LeadId IS NOT NULL THEN 20 ELSE 0 END
          + CASE WHEN FirstName IS NOT NULL THEN 15 ELSE 0 END
          + CASE WHEN LastName IS NOT NULL THEN 15 ELSE 0 END
          + CASE WHEN EmailAddress IS NOT NULL THEN 20 ELSE 0 END
          + CASE WHEN PhoneNumber IS NOT NULL THEN 15 ELSE 0 END
          + CASE WHEN CompanyName IS NOT NULL THEN 15 ELSE 0 END
        ) < 65 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
