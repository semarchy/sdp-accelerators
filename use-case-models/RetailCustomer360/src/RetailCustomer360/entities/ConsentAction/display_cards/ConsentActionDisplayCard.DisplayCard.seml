_package: RetailCustomer360.entities.ConsentAction.display_cards
_type: DisplayCard
_name: ConsentActionDisplayCard
entity: RetailCustomer360.entities.ConsentAction.ConsentAction
default: true
primaryTextExpression: "CASE WHEN ActionName IS NOT NULL THEN ActionName ELSE 'Unnamed Action' END"
secondaryTextExpression: "CASE WHEN ActionType IS NOT NULL THEN ActionType ELSE 'Type unknown' END || CASE WHEN IsRestrictive = '1' THEN ' - Restrictive' ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/check-decagram.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/check-decagram.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
