_package: RetailCustomer360.entities.ConsentAction.action_sets
_type: ActionSet
_name: ConsentActionActionSet
entity: RetailCustomer360.entities.ConsentAction.ConsentAction
label: ConsentAction Action Set
description: "Actions available to stewards on Consent Actions."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateConsentAction
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ConsentAction.steppers.AuthorConsentAction
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditConsentAction
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ConsentAction.steppers.AuthorConsentAction
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateConsentAction
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ConsentAction.steppers.AuthorConsentAction
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteConsentAction
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportConsentAction
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportConsentAction
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ConsentAction.steppers.AuthorConsentAction
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphConsentAction
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
