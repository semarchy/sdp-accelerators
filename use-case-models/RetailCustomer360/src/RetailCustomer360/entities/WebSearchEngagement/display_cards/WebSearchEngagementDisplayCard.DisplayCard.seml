_package: RetailCustomer360.entities.WebSearchEngagement.display_cards
_type: DisplayCard
_name: WebSearchEngagementDisplayCard
entity: RetailCustomer360.entities.WebSearchEngagement.WebSearchEngagement
default: true
primaryTextExpression: "CASE WHEN SearchTerm IS NOT NULL THEN SearchTerm ELSE 'Web search' END"
secondaryTextExpression: "CASE WHEN SearchEngine IS NOT NULL THEN SearchEngine ELSE 'Engine unknown' END || CASE WHEN ResultCount IS NOT NULL THEN ' - ' || ResultCount || ' results' ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/magnify.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/magnify.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/magnify.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
