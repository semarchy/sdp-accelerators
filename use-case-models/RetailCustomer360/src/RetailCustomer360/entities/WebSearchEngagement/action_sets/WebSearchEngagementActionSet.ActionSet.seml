_package: RetailCustomer360.entities.WebSearchEngagement.action_sets
_type: ActionSet
_name: WebSearchEngagementActionSet
entity: RetailCustomer360.entities.WebSearchEngagement.WebSearchEngagement
label: WebSearchEngagement Action Set
description: "Actions available to stewards on Web Search Engagements."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateWebSearchEngagement
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.WebSearchEngagement.steppers.AuthorWebSearchEngagement
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditWebSearchEngagement
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.WebSearchEngagement.steppers.AuthorWebSearchEngagement
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateWebSearchEngagement
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.WebSearchEngagement.steppers.AuthorWebSearchEngagement
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteWebSearchEngagement
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportWebSearchEngagement
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportWebSearchEngagement
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.WebSearchEngagement.steppers.AuthorWebSearchEngagement
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphWebSearchEngagement
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
