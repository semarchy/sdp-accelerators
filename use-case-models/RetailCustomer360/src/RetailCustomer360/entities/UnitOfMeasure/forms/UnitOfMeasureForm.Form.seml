_package: RetailCustomer360.entities.UnitOfMeasure.forms
_type: Form
_name: UnitOfMeasureForm
entity: RetailCustomer360.entities.UnitOfMeasure.UnitOfMeasure
default: true

formTabs:
  - _type: FormTab
    _name: Overview
    label: Overview
    iconUrl: https://api.iconify.design/mdi/view-dashboard-outline.svg?color=%230D1B2A&width=64
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: OverviewRow
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: OverviewCol1
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrUnit
                label: Unit
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrUnitRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrUomCode
                        value: UomCode
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrUomName
                        value: UomName
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrUomType
                        value: UomType
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrBaseUnitCode
                        value: BaseUnitCode
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
          - _type: FormContainer
            _name: OverviewCol2
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrConversion
                label: Conversion
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrConversionRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrConversionFactor
                        value: ConversionFactor
                        useCustomLabel: false
                        dataType: DECIMAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrDecimalPrecision
                        value: DecimalPrecision
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: CheckboxField
                        _name: OvrIsBaseUnit
                        value: IsBaseUnit
                        useCustomLabel: false
                        dataType: BOOLEAN
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: CheckboxField
                        _name: OvrIsActive
                        value: IsActive
                        useCustomLabel: false
                        dataType: BOOLEAN
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
              - _type: FormSection
                _name: OvrIdentifiers
                label: Identifiers
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrIdentifiersRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrUomId
                        value: UomId
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
