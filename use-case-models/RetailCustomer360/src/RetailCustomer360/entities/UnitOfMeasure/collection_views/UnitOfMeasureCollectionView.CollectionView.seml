_package: RetailCustomer360.entities.UnitOfMeasure.collection_views
_type: CollectionView
_name: UnitOfMeasureCollectionView
entity: RetailCustomer360.entities.UnitOfMeasure.UnitOfMeasure
default: true
description: "Default list of Units Of Measure records."
displayCard: RetailCustomer360.entities.UnitOfMeasure.display_cards.UnitOfMeasureDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: UnitOfMeasure
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: UomId
    value: UomId
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: true
  - _type: TextColumn
    _name: UomCode
    value: UomCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: UomName
    value: UomName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: UomType
    value: UomType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: BaseUnitCode
    value: BaseUnitCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: ConversionFactor
    value: ConversionFactor
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: RIGHT
    visibleByDefault: true
  - _type: TextColumn
    _name: DecimalPrecision
    value: DecimalPrecision
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: RIGHT
    visibleByDefault: false
  - _type: CheckboxColumn
    _name: IsBaseUnit
    value: IsBaseUnit
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: false
  - _type: CheckboxColumn
    _name: IsActive
    value: IsActive
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: false
