_package: RetailCustomer360.entities.UnitOfMeasure.display_cards
_type: DisplayCard
_name: UnitOfMeasureDisplayCard
entity: RetailCustomer360.entities.UnitOfMeasure.UnitOfMeasure
default: true
primaryTextExpression: "CASE WHEN UomName IS NOT NULL THEN UomName ELSE UomCode END"
secondaryTextExpression: "CASE WHEN UomType IS NOT NULL THEN UomType ELSE 'Type unknown' END || CASE WHEN IsBaseUnit = '1' THEN ' - Base unit' ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/scale-balance.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/scale-balance.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/scale-balance.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
