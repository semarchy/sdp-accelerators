_package: RetailCustomer360.entities.UnitOfMeasure.action_sets
_type: ActionSet
_name: UnitOfMeasureActionSet
entity: RetailCustomer360.entities.UnitOfMeasure.UnitOfMeasure
label: UnitOfMeasure Action Set
description: "Actions available to stewards on Units Of Measure."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateUnitOfMeasure
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.UnitOfMeasure.steppers.AuthorUnitOfMeasure
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditUnitOfMeasure
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.UnitOfMeasure.steppers.AuthorUnitOfMeasure
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateUnitOfMeasure
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.UnitOfMeasure.steppers.AuthorUnitOfMeasure
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteUnitOfMeasure
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportUnitOfMeasure
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportUnitOfMeasure
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.UnitOfMeasure.steppers.AuthorUnitOfMeasure
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphUnitOfMeasure
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
