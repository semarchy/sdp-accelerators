                content:
                  - _type: FormContainer
                    _name: OvrChannelRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrChannelCode
                        value: ChannelCode
                        useCustomLabel: false
                        dataType: STRING
