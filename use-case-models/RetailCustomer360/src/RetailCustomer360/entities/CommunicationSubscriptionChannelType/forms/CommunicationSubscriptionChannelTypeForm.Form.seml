                content:
                  - _type: FormContainer
                    _name: OvrBehaviourRow
                    layoutDirection: COLUMN
                    content:
                      - _type: CheckboxField
                        _name: OvrIsActive
                        value: IsActive
                        useCustomLabel: false
                        dataType: BOOLEAN
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: CheckboxField
                        _name: OvrRequiresDoubleOptIn
                        value: RequiresDoubleOptIn
                        useCustomLabel: false
