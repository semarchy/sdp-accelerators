_package: RetailCustomer360.entities.AccountContact
_type: Entity
_name: AccountContact
label: Account Contact
pluralLabel: Account Contacts
entityType: FUZZY_MATCHED
physicalTableName: ACCOUNT_CONTACT
iconUrl: https://api.iconify.design/mdi/account-tie.svg?color=%230D1B2A&width=64

description: "A person acting within a business account, with a defined role in that account."
documentation: ""
historizeGolden: true
historizeMaster: false
enableDelete: true

attributes:
  - _type: EntityAttribute
    _name: AccountContactId
    label: Account Contact Id
    physicalName: ACCOUNT_CONTACT_ID
    dataType: LongInteger
    precision: 38
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Primary identifier of the account contact."

  - _type: EntityAttribute
    _name: FirstName
    label: First Name
    physicalName: FIRST_NAME
    dataType: String
    length: 100
    searchable: true
    description: "Given name of the contact."

  - _type: EntityAttribute
    _name: LastName
    label: Last Name
    physicalName: LAST_NAME
    dataType: String
    length: 100
    searchable: true
    description: "Family name of the contact."

  - _type: EntityAttribute
    _name: JobTitle
    label: Job Title
    physicalName: JOB_TITLE
    dataType: String
    length: 120
    searchable: true
    description: "Professional title held by the contact."

  - _type: EntityAttribute
    _name: Department
    label: Department
    physicalName: DEPARTMENT
    dataType: String
    length: 120
    searchable: true
    description: "Department the contact belongs to within the account."

  - _type: EntityAttribute
    _name: ContactRole
    label: Contact Role
    physicalName: CONTACT_ROLE
    dataType: RetailCustomer360.list_of_values.ContactRole
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Role the contact plays in decisions for the account."

  - _type: EntityAttribute
    _name: EmailAddress
    label: Email Address
    physicalName: EMAIL_ADDRESS
    dataType: String
    length: 255
    searchable: true
    description: "Business email address of the contact."

  - _type: EntityAttribute
    _name: PhoneNumber
    label: Phone Number
    physicalName: PHONE_NUMBER
    dataType: String
    length: 50
    searchable: true
    description: "Business phone number of the contact."

  - _type: EntityAttribute
    _name: IsPrimaryContact
    label: Is Primary Contact
    physicalName: IS_PRIMARY_CONTACT
    dataType: Boolean
    length: 1
    searchable: true
    description: "Whether this contact is the main point of contact for the account."

  - _type: EntityAttribute
    _name: PreferredChannel
    label: Preferred Channel
    physicalName: PREFERRED_CHANNEL
    dataType: RetailCustomer360.list_of_values.PreferredChannel
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Channel the contact prefers to be reached on."

  - _type: EntityAttribute
    _name: StartDate
    label: Start Date
    physicalName: START_DATE
    dataType: Date
    searchable: true
    description: "Date the contact became active on the account."

  - _type: EntityAttribute
    _name: EndDate
    label: End Date
    physicalName: END_DATE
    dataType: Date
    searchable: true
    description: "Date the contact ceased to be active on the account."

  - _type: EntityAttribute
    _name: Status
    label: Status
    physicalName: CONTACT_STATUS
    dataType: RetailCustomer360.list_of_values.AccountStatus
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Lifecycle status of the account contact."

  - _type: EntityAttribute
    _name: SourceSystem
    label: Source System
    physicalName: SOURCE_SYSTEM
    dataType: RetailCustomer360.list_of_values.SourceSystem
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "System the contact record originates from."

  - _type: EntityAttribute
    _name: SourceContactKey
    label: Source Contact Key
    physicalName: SOURCE_CONTACT_KEY
    dataType: String
    length: 100
    searchable: true
    description: "Natural key of the contact in the source system."

  - _type: EntityAttribute
    _name: FullName
    label: Full Name
    physicalName: FULL_NAME
    dataType: String
    length: 220
    searchable: true
    description: "Derived full name of the contact."

  - _type: EntityAttribute
    _name: FullNameNormalized
    label: Full Name Normalized
    physicalName: FULL_NAME_NORM
    dataType: String
    length: 220
    searchable: true
    description: "Uppercased and trimmed full name used for matching."

  - _type: EntityAttribute
    _name: EnrichmentCompletenessScore
    label: Enrichment Completeness Score
    physicalName: ENRICH_COMPLETENESS_SCORE
    dataType: Decimal
    precision: 5
    scale: 2
    searchable: true
    description: "Derived completeness score based on key business attributes."

  - _type: EntityAttribute
    _name: EnrichmentCompletenessBand
    label: Enrichment Completeness Band
    physicalName: ENRICH_COMPLETENESS_BAND
    dataType: String
    length: 16
    searchable: true
    description: "Derived completeness band (Low, Medium, High)."

  - _type: EntityAttribute
    _name: EnrichmentUpdatedOn
    label: Enrichment Updated On
    physicalName: ENRICH_UPDATED_ON
    dataType: Date
    searchable: true
    description: "Date when enrichment was last calculated."

primaryKey: RetailCustomer360.entities.AccountContact.AccountContact.AccountContactId

sourceIdGeneration:
  mode: MANUAL

goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1

matcher:
  _type: SemQLMatcher
  _name: Matcher
  description: "Matching strategy for AccountContact records."
  matchRules:
    - _type: SemQLMatchRule
      _name: EmailExact
      label: Business email exact match
      matchScore: 100
      condition: Record1.EmailAddress IS NOT NULL AND Record2.EmailAddress IS NOT NULL AND LOWER(Record1.EmailAddress) = LOWER(Record2.EmailAddress)
      usingMatchOn: false
      binningExpressions:
        - expression: EmailAddress
    - _type: SemQLMatchRule
      _name: NameAndRole
      label: Similar name and same role
      matchScore: 85
      condition: Record1.FullNameNormalized IS NOT NULL AND Record2.FullNameNormalized IS NOT NULL AND SEM_EDIT_DISTANCE_SIMILARITY(Record1.FullNameNormalized, Record2.FullNameNormalized) >= 92
      usingMatchOn: false
      binningExpressions:
        - expression: ContactRole

  useTransitiveMatchScore: true
  useMultiIterationGrouping: true
  mergeThresholdNewGroup: 85
  mergeThresholdMergingUnconfirmed: 95
  mergeThresholdMergingConfirmed: 98
  mergeThresholdMergingConfirmedWithUnconfirmed: 99
  mergeThresholdMergingUnconfirmedWithNewMasters: 95
  mergeThresholdMergingConfirmedWithNewMasters: 99
  mergeThresholdRemergingPreviouslySplit: 100
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: false
