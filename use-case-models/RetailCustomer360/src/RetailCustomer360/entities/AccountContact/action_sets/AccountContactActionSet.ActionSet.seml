_package: RetailCustomer360.entities.AccountContact.action_sets
_type: ActionSet
_name: AccountContactActionSet
entity: RetailCustomer360.entities.AccountContact.AccountContact
label: AccountContact Action Set
description: "Actions available to stewards on Account Contacts."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAccountContact
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.AccountContact.steppers.AuthorAccountContact
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAccountContact
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.AccountContact.steppers.AuthorAccountContact
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAccountContact
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.AccountContact.steppers.AuthorAccountContact
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteAccountContact
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportAccountContact
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAccountContacts
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.AccountContact.steppers.ImportAccountContact
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphAccountContact
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
