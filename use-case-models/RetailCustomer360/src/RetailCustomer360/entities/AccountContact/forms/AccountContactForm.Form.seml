_package: RetailCustomer360.entities.AccountContact.forms
_type: Form
_name: AccountContactForm
entity: RetailCustomer360.entities.AccountContact.AccountContact
default: true

formTabs:
  - _type: FormTab
    _name: Overview
    label: Overview
    iconUrl: https://api.iconify.design/mdi/view-dashboard-outline.svg?color=%230D1B2A&width=64
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: OverviewRow
        layoutDirection: ROW
        content:
