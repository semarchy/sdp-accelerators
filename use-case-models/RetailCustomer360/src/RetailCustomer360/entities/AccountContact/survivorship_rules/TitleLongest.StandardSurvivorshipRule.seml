_package: RetailCustomer360.entities.AccountContact.survivorship_rules
_type: StandardSurvivorshipRule
_name: TitleLongest
entity: RetailCustomer360.entities.AccountContact.AccountContact
label: Job title (longest value)
description: "Keeps the most descriptive job title."
defaultRule: false
consolidationStrategy: LONGEST_VALUE
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: JobTitle
