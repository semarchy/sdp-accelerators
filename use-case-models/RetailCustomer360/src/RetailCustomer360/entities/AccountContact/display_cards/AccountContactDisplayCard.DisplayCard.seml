_package: RetailCustomer360.entities.AccountContact.display_cards
_type: DisplayCard
_name: AccountContactDisplayCard
entity: RetailCustomer360.entities.AccountContact.AccountContact
default: true
primaryTextExpression: "CASE WHEN FullName IS NOT NULL AND BTRIM(FullName) <> '' THEN FullName WHEN FirstName IS NOT NULL AND LastName IS NOT NULL THEN INITCAP(FirstName) || ' ' || INITCAP(LastName) WHEN FirstName IS NOT NULL THEN INITCAP(FirstName) WHEN LastName IS NOT NULL THEN INITCAP(LastName) ELSE 'Unnamed Contact' END"
secondaryTextExpression: "CASE WHEN JobTitle IS NOT NULL THEN JobTitle ELSE '' END || CASE WHEN ContactRole IS NOT NULL AND JobTitle IS NOT NULL THEN ' • ' || ContactRole WHEN ContactRole IS NOT NULL THEN ContactRole ELSE '' END || CASE WHEN EmailAddress IS NOT NULL THEN ' • ' || EmailAddress ELSE '' END || CASE WHEN IsPrimaryContact = '1' THEN ' ★' ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN Status = 'INACTIVE' THEN 'https://api.iconify.design/mdi/account-off.svg?color=%236B7280&width=128' WHEN IsPrimaryContact = '1' THEN 'https://api.iconify.design/mdi/account-star.svg?color=%232563EB&width=128' ELSE 'https://api.iconify.design/mdi/account-tie.svg?color=%230D1B2A&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/account-tie.svg?color=%230D1B2A&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN Status = 'INACTIVE' THEN 'https://api.iconify.design/mdi/account-off.svg?color=%236B7280&width=128' WHEN IsPrimaryContact = '1' THEN 'https://api.iconify.design/mdi/account-star.svg?color=%232563EB&width=128' ELSE 'https://api.iconify.design/mdi/account-tie.svg?color=%230D1B2A&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
