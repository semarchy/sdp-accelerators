_package: RetailCustomer360.entities.MobileAppEngagement.enrichers
_name: MobileAppEngagementDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.MobileAppEngagement.MobileAppEngagement
label: MobileAppEngagement Data Quality Enricher
description: "Computes standard completeness enrichment fields for MobileAppEngagement."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN AppEventId IS NULL AND AppSessionId IS NULL AND DeviceId IS NULL THEN 0
        ELSE (
          CASE WHEN AppEventId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN AppSessionId IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN DeviceId IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN AppEventId IS NULL AND AppSessionId IS NULL AND DeviceId IS NULL THEN 'Low'
        WHEN (
          CASE WHEN AppEventId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN AppSessionId IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN DeviceId IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
  - attributeName: EngagementRecencyBand
    expression: CASE
        WHEN EventTimestamp IS NULL THEN 'Unknown'
        WHEN EventTimestamp >= CURRENT_DATE() THEN 'Current'
        ELSE 'Historical'
      END
  - attributeName: MobilePlatformFamily
    expression: CASE
        WHEN OperatingSystem IN ('iOS', 'Android') THEN OperatingSystem
        WHEN OperatingSystem IS NULL THEN 'Unknown'
        ELSE 'Other'
      END
  - attributeName: EngagementQualityStatus
    expression: CASE
        WHEN EventType IS NULL OR ScreenName IS NULL THEN 'Incomplete'
        WHEN PushOptInStatus = 'Opted Out' THEN 'Reachability Limited'
        ELSE 'Actionable'
      END
