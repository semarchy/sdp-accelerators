_package: RetailCustomer360.entities.MobileAppEngagement.action_sets
_type: ActionSet
_name: MobileAppEngagementActionSet
entity: RetailCustomer360.entities.MobileAppEngagement.MobileAppEngagement
label: Mobile App Engagement Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateMobileAppEngagements
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.MobileAppEngagement.steppers.AuthorMobileAppEngagements
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditMobileAppEngagements
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.MobileAppEngagement.steppers.AuthorMobileAppEngagements
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateMobileAppEngagements
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.MobileAppEngagement.steppers.AuthorMobileAppEngagements
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportMobileAppEngagements
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.MobileAppEngagement.steppers.AuthorMobileAppEngagements
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

