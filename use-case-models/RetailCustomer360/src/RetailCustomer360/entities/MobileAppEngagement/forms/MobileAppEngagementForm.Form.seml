                _name: OvrEvent
                label: Event
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrEventRow
                    layoutDirection: COLUMN
                    content:
                      - _type: MenuField
                        _name: OvrEventType
                        value: EventType
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrEventTimestamp
                        value: EventTimestamp
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrScreenName
                        value: ScreenName
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
