_package: RetailCustomer360.entities.MobileAppEngagement.validations
_name: ScreenNameRequiredForInteractiveEvents
_type: SemQLValidation
entity: RetailCustomer360.entities.MobileAppEngagement.MobileAppEngagement
label: Screen Name Required For Interactive Events
validationScope: PRE_CONSO
description: "Ensures interactive event types carry a screen name."
condition: EventType NOT IN ('Product View', 'Search', 'Add to Cart', 'Purchase') OR ScreenName IS NOT NULL

