_package: RetailCustomer360.entities.MobileAppEngagement.validations
_name: SessionOrDeviceMustExist
_type: SemQLValidation
entity: RetailCustomer360.entities.MobileAppEngagement.MobileAppEngagement
label: Session Or Device Must Exist
validationScope: PRE_CONSO
description: "Ensures at least one technical identifier is present."
condition: AppSessionId IS NOT NULL OR DeviceId IS NOT NULL

