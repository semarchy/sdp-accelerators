_package: RetailCustomer360.entities.Brand.display_cards
_type: DisplayCard
_name: BrandDisplayCard
entity: RetailCustomer360.entities.Brand.Brand
default: true
primaryTextExpression: "CASE WHEN BrandName IS NOT NULL THEN BrandName ELSE 'Unnamed Brand' END"
secondaryTextExpression: "CASE WHEN BrandOwner IS NOT NULL THEN BrandOwner ELSE 'Owner unknown' END || CASE WHEN CountryOfOrigin IS NOT NULL THEN ' - ' || CountryOfOrigin ELSE '' END || CASE WHEN IsPrivateLabel = '1' THEN ' - Private label' ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/tag-heart.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/tag-heart.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/tag-heart.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
