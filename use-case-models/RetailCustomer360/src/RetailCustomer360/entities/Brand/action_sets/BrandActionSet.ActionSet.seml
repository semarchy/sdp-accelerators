_package: RetailCustomer360.entities.Brand.action_sets
_type: ActionSet
_name: BrandActionSet
entity: RetailCustomer360.entities.Brand.Brand
label: Brand Action Set
description: "Actions available to stewards on Brands."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateBrand
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Brand.steppers.AuthorBrand
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditBrand
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Brand.steppers.AuthorBrand
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateBrand
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Brand.steppers.AuthorBrand
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteBrand
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportBrand
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportBrands
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.Brand.steppers.ImportBrands
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphBrand
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
