_package: RetailCustomer360.entities.SMSEngagement.action_sets
_type: ActionSet
_name: SMSEngagementActionSet
entity: RetailCustomer360.entities.SMSEngagement.SMSEngagement
label: SMSEngagement Action Set
description: "Actions available to stewards on SMS Engagements."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateSMSEngagement
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SMSEngagement.steppers.AuthorSMSEngagement
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditSMSEngagement
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SMSEngagement.steppers.AuthorSMSEngagement
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateSMSEngagement
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SMSEngagement.steppers.AuthorSMSEngagement
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteSMSEngagement
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportSMSEngagement
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportSMSEngagement
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.SMSEngagement.steppers.AuthorSMSEngagement
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphSMSEngagement
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
