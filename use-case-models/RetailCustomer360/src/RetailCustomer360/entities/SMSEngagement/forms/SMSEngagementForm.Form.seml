_package: RetailCustomer360.entities.SMSEngagement.forms
_type: Form
_name: SMSEngagementForm
entity: RetailCustomer360.entities.SMSEngagement.SMSEngagement
default: true

formTabs:
  - _type: FormTab
    _name: Overview
    label: Overview
    iconUrl: https://api.iconify.design/mdi/view-dashboard-outline.svg?color=%230D1B2A&width=64
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: OverviewRow
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: OverviewCol1
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrEvent
                label: Event
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrEventRow
                    layoutDirection: COLUMN
                    content:
                      - _type: MenuField
                        _name: OvrEventType
                        value: EventType
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrEventTimestamp
                        value: EventTimestamp
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrMessageId
                        value: MessageId
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrShortCode
                        value: ShortCode
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
