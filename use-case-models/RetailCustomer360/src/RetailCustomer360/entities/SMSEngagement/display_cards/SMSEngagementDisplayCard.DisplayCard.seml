_package: RetailCustomer360.entities.SMSEngagement.display_cards
_type: DisplayCard
_name: SMSEngagementDisplayCard
entity: RetailCustomer360.entities.SMSEngagement.SMSEngagement
default: true
primaryTextExpression: "COALESCE(FDN_Customer, 'Unknown Customer') || CASE WHEN PhoneNumber IS NOT NULL THEN ' • ' || PhoneNumber ELSE '' END"
secondaryTextExpression: "COALESCE(EventType, 'Unknown Event') || ' • ' || COALESCE(DeliveryStatus, 'Unknown Status') || CASE WHEN FDN_Campaign IS NOT NULL THEN ' • ' || FDN_Campaign ELSE '' END || CASE WHEN EventTimestamp IS NOT NULL THEN ' • ' || TO_CHAR(EventTimestamp, 'YYYY-MM-DD') ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/message-text.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/message-text.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/message-text.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
