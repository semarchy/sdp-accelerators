_package: RetailCustomer360.entities.DataUsePurpose.display_cards
_type: DisplayCard
_name: DataUsePurposeDisplayCard
entity: RetailCustomer360.entities.DataUsePurpose.DataUsePurpose
default: true
primaryTextExpression: "CASE WHEN PurposeName IS NOT NULL THEN PurposeName ELSE 'Unnamed Purpose' END"
secondaryTextExpression: "CASE WHEN PurposeType IS NOT NULL THEN PurposeType ELSE 'Type unknown' END || CASE WHEN RetentionMonths IS NOT NULL THEN ' - retained ' || RetentionMonths || ' months' ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/target-account.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/target-account.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/target-account.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
