_package: RetailCustomer360.entities.DataUsePurpose.action_sets
_type: ActionSet
_name: DataUsePurposeActionSet
entity: RetailCustomer360.entities.DataUsePurpose.DataUsePurpose
label: DataUsePurpose Action Set
description: "Actions available to stewards on Data Use Purposes."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateDataUsePurpose
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.DataUsePurpose.steppers.AuthorDataUsePurpose
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditDataUsePurpose
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.DataUsePurpose.steppers.AuthorDataUsePurpose
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateDataUsePurpose
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.DataUsePurpose.steppers.AuthorDataUsePurpose
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteDataUsePurpose
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportDataUsePurpose
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportDataUsePurpose
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.DataUsePurpose.steppers.AuthorDataUsePurpose
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphDataUsePurpose
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
