_package: RetailCustomer360.entities.ShoppingCartEngagement.display_cards
_type: DisplayCard
_name: ShoppingCartEngagementDisplayCard
entity: RetailCustomer360.entities.ShoppingCartEngagement.ShoppingCartEngagement
default: true
primaryTextExpression: "CASE WHEN SessionId IS NOT NULL THEN 'Cart ' || SessionId ELSE 'Shopping cart' END"
secondaryTextExpression: "CASE WHEN CartStatus IS NOT NULL THEN CartStatus ELSE 'Status unknown' END || CASE WHEN ItemCount IS NOT NULL THEN ' - ' || ItemCount || ' items' ELSE '' END || CASE WHEN CartValue IS NOT NULL THEN ' - ' || CartValue ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/cart-outline.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/cart-outline.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/cart-outline.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
