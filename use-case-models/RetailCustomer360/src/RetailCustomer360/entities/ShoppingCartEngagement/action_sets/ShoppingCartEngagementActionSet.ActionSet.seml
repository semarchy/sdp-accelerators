_package: RetailCustomer360.entities.ShoppingCartEngagement.action_sets
_type: ActionSet
_name: ShoppingCartEngagementActionSet
entity: RetailCustomer360.entities.ShoppingCartEngagement.ShoppingCartEngagement
label: ShoppingCartEngagement Action Set
description: "Actions available to stewards on Shopping Cart Engagements."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateShoppingCartEngagement
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ShoppingCartEngagement.steppers.AuthorShoppingCartEngagement
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditShoppingCartEngagement
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ShoppingCartEngagement.steppers.AuthorShoppingCartEngagement
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateShoppingCartEngagement
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ShoppingCartEngagement.steppers.AuthorShoppingCartEngagement
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteShoppingCartEngagement
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportShoppingCartEngagement
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportShoppingCartEngagement
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ShoppingCartEngagement.steppers.AuthorShoppingCartEngagement
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphShoppingCartEngagement
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
