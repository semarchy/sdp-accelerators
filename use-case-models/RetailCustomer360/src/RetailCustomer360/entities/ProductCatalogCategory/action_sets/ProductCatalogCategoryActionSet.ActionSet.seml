_package: RetailCustomer360.entities.ProductCatalogCategory.action_sets
_type: ActionSet
_name: ProductCatalogCategoryActionSet
entity: RetailCustomer360.entities.ProductCatalogCategory.ProductCatalogCategory
label: ProductCatalogCategory Action Set
description: "Actions available to stewards on Catalog Categories."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateProductCatalogCategory
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ProductCatalogCategory.steppers.AuthorProductCatalogCategory
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditProductCatalogCategory
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ProductCatalogCategory.steppers.AuthorProductCatalogCategory
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateProductCatalogCategory
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ProductCatalogCategory.steppers.AuthorProductCatalogCategory
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteProductCatalogCategory
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportProductCatalogCategory
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportProductCatalogCategory
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ProductCatalogCategory.steppers.AuthorProductCatalogCategory
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphProductCatalogCategory
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
