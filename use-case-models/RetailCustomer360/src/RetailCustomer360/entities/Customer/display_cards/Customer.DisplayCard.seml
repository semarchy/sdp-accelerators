_name: Customer
_package: RetailCustomer360.entities.Customer.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.Customer.Customer
default: true
primaryTextExpression: "CASE WHEN FullName IS NOT NULL THEN FullName ELSE BTRIM(CONCAT_WS(' ', FirstName, LastName)) END"
secondaryTextExpression: "CASE WHEN CustomerType IS NOT NULL THEN CustomerType ELSE 'Customer' END || CASE WHEN CustomerValueBand IS NOT NULL THEN ' • ' || CustomerValueBand ELSE '' END || CASE WHEN Status IS NOT NULL THEN ' • ' || Status ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN CustomerValueBand = 'High' THEN 'https://api.iconify.design/mdi/account-star.svg?color=%232563EB&width=128' WHEN Status = 'Active' THEN 'https://api.iconify.design/mdi/account-check.svg?color=%23059669&width=128' ELSE 'https://api.iconify.design/mdi/account-circle.svg?color=%232563EB&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/account-circle.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN CustomerValueBand = 'High' THEN 'https://api.iconify.design/mdi/account-star.svg?color=%232563EB&width=128' WHEN Status = 'Active' THEN 'https://api.iconify.design/mdi/account-check.svg?color=%23059669&width=128' ELSE 'https://api.iconify.design/mdi/account-circle.svg?color=%232563EB&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

