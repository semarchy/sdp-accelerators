_package: RetailCustomer360.entities.Customer.survivorship_rules
_type: StandardSurvivorshipRule
_name: DemographicChannelPreference
entity: RetailCustomer360.entities.Customer.Customer
label: Demographic and Channel Preference Rule
description: "Consolidates customer demographic and preference attributes by trusting self-registered data first. Customers who register directly via ECOMMERCE provide their own data, making it more accurate than CRM agent-entered values. For channel and language preferences, self-service data reflects the customer's actual intent."
documentation: "In B2C retail, customers who register or update their own profile are the most authoritative source for personal preferences. This rule prioritizes ECOMMERCE (self-service) over CRM (agent-managed), and CRM over LOYALTY (often partial registration data). POS data is the least trusted for demographics as it is typically entered quickly at checkout."
defaultRule: false
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_NEXT_USER_CHANGE
attributes:
  - attributeName: FirstName
  - attributeName: LastName
  - attributeName: MiddleName
  - attributeName: BirthDate
  - attributeName: Gender
  - attributeName: PreferredLanguage
  - attributeName: PreferredChannel
  - attributeName: Occupation
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.ECOMMERCE
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.CRM
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.LOYALTY
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.POS
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.API
