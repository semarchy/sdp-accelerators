_package: RetailCustomer360.entities.Customer.survivorship_rules
_type: StandardSurvivorshipRule
_name: LifecycleAndSegment
entity: RetailCustomer360.entities.Customer.Customer
label: Lifecycle Status and Segment Rule
description: "Consolidates customer lifecycle and segmentation attributes by trusting CRM as the system of record for customer status management. CRM owns the customer relationship lifecycle - when a customer is marked Inactive, Churned, or VIP in CRM, that designation must win over segment assignments from transactional systems."
documentation: "Customer status and segmentation are managed by marketing and customer success teams in CRM. A customer's Status, Segment, and CustomerType are intentional business classifications, not derived from transactions. This rule ensures CRM-assigned classifications are not overwritten by LOYALTY or POS systems that may assign default segments during onboarding. AnnualIncome and CustomerSinceDate are trusted from ECOMMERCE as the original registration source."
defaultRule: false
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: Status
  - attributeName: CustomerSegment
  - attributeName: CustomerType
  - attributeName: AnnualIncome
  - attributeName: CustomerSinceDate
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.CRM
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.ECOMMERCE
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.LOYALTY
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.API
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.POS
