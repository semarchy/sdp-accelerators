# Description: Name-related enrichments for the Customer entity.
# Contains: SemQL expressions to compute FullName, FullNameNormalized, and Initials.
# Role: Provides consistent display/search forms of the customer name for UI and matching.
_package: RetailCustomer360.entities.Customer.enrichers
_name: NameEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.Customer.Customer
label: Customer Name Enricher
description: "Computes FullName, normalized full name, and initials from first/middle/last name."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: FullName
    expression: BTRIM(CONCAT_WS(' ', INITCAP(FirstName), INITCAP(MiddleName), INITCAP(LastName)))
  - attributeName: FullNameNormalized
    expression: UPPER(BTRIM(CONCAT_WS(' ', FirstName, LastName)))
  - attributeName: Initials
    expression: UPPER(CONCAT(COALESCE(SUBSTR(FirstName, 1, 1), ''), COALESCE(SUBSTR(LastName, 1, 1), '')))

