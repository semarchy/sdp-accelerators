_package: RetailCustomer360.entities.Customer.enrichers
_name: CustomerDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.Customer.Customer
label: Customer Data Quality Enricher
description: "Computes standard completeness enrichment fields for Customer."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN CustomerId IS NULL AND FirstName IS NULL AND LastName IS NULL THEN 0
        ELSE (
          CASE WHEN CustomerId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN FirstName IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN LastName IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN CustomerId IS NULL AND FirstName IS NULL AND LastName IS NULL THEN 'Low'
        WHEN (
          CASE WHEN CustomerId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN FirstName IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN LastName IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
