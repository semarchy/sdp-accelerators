_package: RetailCustomer360.entities.Customer.forms
_type: Form
_name: CustomerForm
entity: RetailCustomer360.entities.Customer.Customer
default: true

formTabs:
  - _type: FormTab
    _name: Overview
    label: Overview
    iconUrl: https://api.iconify.design/mdi/view-dashboard-outline.svg?color=%230D1B2A&width=64
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: OverviewRow
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: OverviewCol1
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrIdentity
                label: Identity
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrIdentityRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrFirstName
                        value: FirstName
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrMiddleName
                        value: MiddleName
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrLastName
                        value: LastName
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrFullName
                        value: FullName
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrInitials
                        value: Initials
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrGender
                        value: Gender
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrBirthDate
                        value: BirthDate
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrAge
                        value: Age
                        useCustomLabel: false
                        dataType: INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrAgeGroup
                        value: AgeGroup
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
          - _type: FormContainer
            _name: OverviewCol2
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrRelationship
                label: Relationship
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrRelationshipRow
                    layoutDirection: COLUMN
                    content:
                      - _type: MenuField
                        _name: OvrCustomerSegment
                        value: CustomerSegment
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrCustomerType
                        value: CustomerType
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: MenuField
                        _name: OvrStatus
                        value: Status
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrCustomerSinceDate
                        value: CustomerSinceDate
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrTenureYears
                        value: TenureYears
                        useCustomLabel: false
                        dataType: INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrTenureSegment
                        value: TenureSegment
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrCustomerValueBand
                        value: CustomerValueBand
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
              - _type: FormSection
                _name: OvrPreferences
                label: Preferences
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrPreferencesRow
                    layoutDirection: COLUMN
                    content:
                      - _type: MenuField
                        _name: OvrPreferredChannel
                        value: PreferredChannel
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrPreferredLanguage
                        value: PreferredLanguage
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
          - _type: FormContainer
            _name: OverviewCol3
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrProfile
                label: Profile
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrProfileRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrOccupation
                        value: Occupation
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrAnnualIncome
                        value: AnnualIncome
                        useCustomLabel: false
                        dataType: DECIMAL
                        componentProperties:
                          textAlign: left
                          displayFormat: '$ #,###,###.##'
                          displayFormatValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: ReferenceField
                        _name: OvrFDN_Country
                        value: FDN_Country
                        useCustomLabel: true
                        label: Country of Residence
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                        referencedEntity: RetailCustomer360.entities.Country.Country
                        componentProperties:
                          displayType: chip
                          useAvatarInChip: '1'
                          useSecondaryTextInChip: '1'
              - _type: FormSection
                _name: OvrSourceDataQuality
                label: Source & Data Quality
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrSourceDataQualityRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrSourceCustomerKey
                        value: SourceCustomerKey
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrCreatedDate
                        value: CreatedDate
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrCustomerId
                        value: CustomerId
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrFullNameNormalized
                        value: FullNameNormalized
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEnrichmentCompletenessScore
                        value: EnrichmentCompletenessScore
                        useCustomLabel: true
                        label: Completeness Score
                        dataType: DECIMAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrEnrichmentCompletenessBand
                        value: EnrichmentCompletenessBand
                        useCustomLabel: true
                        label: Completeness Band
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrEnrichmentUpdatedOn
                        value: EnrichmentUpdatedOn
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
  - _type: FormTab
    _name: Analytics
    label: Analytics
    iconUrl: https://api.iconify.design/mdi/chart-bar.svg?color=%230D1B2A&width=64
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormDashboard
        _name: CustomerInsightsDashboard
        dashboard: CustomerInsights
        dashboardApplication: RetailCustomer360
        tab: Overview
        height: 900
        relativeWidth: 100
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        parameters:
          - _type: FormDashboardParameter
            _name: CustomerID
            value: CustomerId
            valueInterpreter: SEMQL
