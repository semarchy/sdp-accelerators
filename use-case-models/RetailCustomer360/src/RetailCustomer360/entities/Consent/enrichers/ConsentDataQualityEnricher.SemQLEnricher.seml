_package: RetailCustomer360.entities.Consent.enrichers
_name: ConsentDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.Consent.Consent
label: Consent Data Quality Enricher
description: "Computes standard completeness enrichment fields for Consent."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN ConsentId IS NULL AND ConsentType IS NULL AND ConsentChannel IS NULL THEN 0
        ELSE (
          CASE WHEN ConsentId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN ConsentType IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN ConsentChannel IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN ConsentId IS NULL AND ConsentType IS NULL AND ConsentChannel IS NULL THEN 'Low'
        WHEN (
          CASE WHEN ConsentId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN ConsentType IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN ConsentChannel IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
