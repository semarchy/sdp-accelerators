_package: RetailCustomer360.entities.Consent
_type: Entity
_name: Consent
label: Consent
pluralLabel: Consents
entityType: BASIC
physicalTableName: CONSENT
iconUrl: https://api.iconify.design/mdi/shield-lock.svg?color=%230D1B2A&width=64

description: "Consent data for Customer 360."
documentation: ""
historizeGolden: false
historizeMaster: false
enableDelete: true

attributes:
  - _type: EntityAttribute
    _name: ConsentId
    label: Consent Id
    physicalName: CONSENT_ID
    dataType: LongInteger
    precision: 38
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Primary identifier"

  - _type: EntityAttribute
    _name: ConsentType
    label: Consent Type
    physicalName: CONSENT_TYPE
    dataType: RetailCustomer360.list_of_values.ConsentType
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Marketing, Profiling, Personalization, Data Sharing, Cookies"

  - _type: EntityAttribute
    _name: ConsentChannel
    label: Consent Channel
    physicalName: CONSENT_CHANNEL
    dataType: RetailCustomer360.list_of_values.ConsentChannel
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Email, SMS, Phone, Push, Web, Store"

  - _type: EntityAttribute
    _name: ConsentStatus
    label: Consent Status
    physicalName: CONSENT_STATUS
    dataType: RetailCustomer360.list_of_values.ConsentStatus
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Opted In, Opted Out, Withdrawn, Pending, Unknown"

  - _type: EntityAttribute
    _name: ConsentSource
    label: Consent Source
    physicalName: CONSENT_SOURCE
    dataType: RetailCustomer360.list_of_values.ConsentSource
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Website, Mobile App, POS, Call Center, CRM"

  - _type: EntityAttribute
    _name: ConsentCaptureMethod
    label: Consent Capture Method
    physicalName: CONSENT_CAPTURE_METHOD
    dataType: RetailCustomer360.list_of_values.ConsentCaptureMethod
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Checkbox, Form, Verbal, Imported, Preference Center"

  - _type: EntityAttribute
    _name: ConsentVersion
    label: Consent Version
    physicalName: CONSENT_VERSION
    dataType: String
    length: 50
    searchable: true
    description: "Consent policy/version accepted"

  - _type: EntityAttribute
    _name: EffectiveDate
    label: Effective Date
    physicalName: EFFECTIVE_DATE
    dataType: Timestamp
    precision: 0
    searchable: true
    description: "Consent effective date/time"

  - _type: EntityAttribute
    _name: ExpiryDate
    label: Expiry Date
    physicalName: EXPIRY_DATE
    dataType: Timestamp
    precision: 0
    searchable: true
    description: "Consent expiry date/time"

  - _type: EntityAttribute
    _name: WithdrawalDate
    label: Withdrawal Date
    physicalName: WITHDRAWAL_DATE
    dataType: Timestamp
    precision: 0
    searchable: true
    description: "Date/time consent was withdrawn"

  - _type: EntityAttribute
    _name: LegalBasis
    label: Legal Basis
    physicalName: LEGAL_BASIS
    dataType: RetailCustomer360.list_of_values.LegalBasis
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Consent, Contract, Legitimate Interest, Legal Obligation"

  - _type: EntityAttribute
    _name: Jurisdiction
    label: Jurisdiction
    physicalName: JURISDICTION
    dataType: RetailCustomer360.list_of_values.Jurisdiction
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "GDPR, CCPA, DPDP, Other"

  - _type: EntityAttribute
    _name: ProofText
    label: Proof Text
    physicalName: PROOF_TEXT
    dataType: String
    length: 1000
    searchable: true
    description: "Consent evidence text or statement"

  - _type: EntityAttribute
    _name: SourceSystem
    label: Source System
    physicalName: SOURCE_SYSTEM
    dataType: RetailCustomer360.list_of_values.SourceSystem
    lovValidationScope: PRE_CONSO
    searchable: true
    description: "Source system"

## Standard enrichment attributes
  - _type: EntityAttribute
    _name: EnrichmentCompletenessScore
    label: Enrichment Completeness Score
    physicalName: ENRICH_COMPLETENESS_SCORE
    dataType: Decimal
    precision: 5
    scale: 2
    searchable: true
    description: "Derived completeness score based on key business attributes"

  - _type: EntityAttribute
    _name: EnrichmentCompletenessBand
    label: Enrichment Completeness Band
    physicalName: ENRICH_COMPLETENESS_BAND
    dataType: String
    length: 16
    searchable: true
    description: "Derived completeness band (Low, Medium, High)"

  - _type: EntityAttribute
    _name: EnrichmentUpdatedOn
    label: Enrichment Updated On
    physicalName: ENRICH_UPDATED_ON
    dataType: Date
    searchable: true
    description: "Date when enrichment was last calculated"
sourceIdGeneration:
  mode: SEQUENCE
  startWith: 1

primaryKey: RetailCustomer360.entities.Consent.Consent.ConsentId

