_name: ConsentDisplayCard
_package: RetailCustomer360.entities.Consent.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.Consent.Consent
default: true
primaryTextExpression: "CASE WHEN FDN_Customer IS NOT NULL THEN FDN_Customer ELSE 'Customer Consent' END"
secondaryTextExpression: "CASE WHEN ConsentStatus IS NOT NULL THEN ConsentStatus ELSE 'Unknown' END || CASE WHEN ConsentType IS NOT NULL THEN ' • ' || ConsentType ELSE '' END || CASE WHEN ConsentChannel IS NOT NULL THEN ' • ' || ConsentChannel ELSE '' END || CASE WHEN EffectiveDate IS NOT NULL THEN ' • ' || TO_CHAR(EffectiveDate, 'YYYY-MM-DD') ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN ConsentStatus = 'Opted In' THEN 'https://api.iconify.design/mdi/shield-check.svg?color=%23059669&width=128' WHEN ConsentStatus IN ('Opted Out', 'Withdrawn') THEN 'https://api.iconify.design/mdi/shield-off.svg?color=%23DC2626&width=128' WHEN ConsentStatus = 'Pending' THEN 'https://api.iconify.design/mdi/shield-alert.svg?color=%23D97706&width=128' ELSE 'https://api.iconify.design/mdi/shield-lock.svg?color=%232563EB&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/shield-lock.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN ConsentStatus = 'Opted In' THEN 'https://api.iconify.design/mdi/shield-check.svg?color=%23059669&width=128' WHEN ConsentStatus IN ('Opted Out', 'Withdrawn') THEN 'https://api.iconify.design/mdi/shield-off.svg?color=%23DC2626&width=128' WHEN ConsentStatus = 'Pending' THEN 'https://api.iconify.design/mdi/shield-alert.svg?color=%23D97706&width=128' ELSE 'https://api.iconify.design/mdi/shield-lock.svg?color=%232563EB&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

