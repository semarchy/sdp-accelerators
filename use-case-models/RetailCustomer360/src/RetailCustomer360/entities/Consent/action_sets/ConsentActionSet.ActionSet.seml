_package: RetailCustomer360.entities.Consent.action_sets
_type: ActionSet
_name: ConsentActionSet
entity: RetailCustomer360.entities.Consent.Consent
label: Consent Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateConsents
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Consent.steppers.AuthorConsents
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditConsents
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Consent.steppers.AuthorConsents
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateConsents
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.Consent.steppers.AuthorConsents
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportConsents
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.Consent.steppers.AuthorConsents
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

