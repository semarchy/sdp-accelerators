_package: RetailCustomer360.entities.ContactPointPhone.action_sets
_type: ActionSet
_name: ContactPointPhoneActionSet
entity: RetailCustomer360.entities.ContactPointPhone.ContactPointPhone
label: Contact Point Phone Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateContactPointPhones
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointPhone.steppers.AuthorContactPointPhones
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditContactPointPhones
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointPhone.steppers.AuthorContactPointPhones
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateContactPointPhones
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointPhone.steppers.AuthorContactPointPhones
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportContactPointPhones
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ContactPointPhone.steppers.ImportContactPointPhone
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

