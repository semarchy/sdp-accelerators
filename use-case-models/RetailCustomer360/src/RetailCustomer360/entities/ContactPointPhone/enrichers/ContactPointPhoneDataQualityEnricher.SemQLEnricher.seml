_package: RetailCustomer360.entities.ContactPointPhone.enrichers
_name: ContactPointPhoneDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.ContactPointPhone.ContactPointPhone
label: ContactPointPhone Data Quality Enricher
description: "Computes standard completeness enrichment fields for ContactPointPhone."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN PhoneId IS NULL AND PhoneNumber IS NULL AND CountryCode IS NULL THEN 0
        ELSE (
          CASE WHEN PhoneId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN PhoneNumber IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN CountryCode IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN PhoneId IS NULL AND PhoneNumber IS NULL AND CountryCode IS NULL THEN 'Low'
        WHEN (
          CASE WHEN PhoneId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN PhoneNumber IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN CountryCode IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
