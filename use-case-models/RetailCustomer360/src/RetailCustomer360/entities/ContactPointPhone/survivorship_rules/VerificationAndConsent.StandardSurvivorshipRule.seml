_package: RetailCustomer360.entities.ContactPointPhone.survivorship_rules
_type: StandardSurvivorshipRule
_name: VerificationAndConsent
entity: RetailCustomer360.entities.ContactPointPhone.ContactPointPhone
label: Phone Verification and Consent Rule
description: "Prioritises phone metadata from systems that perform real-time number validation. SMS-capable channels (ECOMMERCE, LOYALTY) verify phone numbers at point of capture through OTP, making their verification status and consent data more accurate than numbers imported from legacy CRM records."
documentation: "Phone number verification via OTP is a standard practice in ECOMMERCE and LOYALTY systems. A verified phone number is a strong identity anchor and marketing consent signal. This rule protects verified consent and IsPrimary designation from being degraded by data that arrives without verification evidence. MANUAL and POS entries are treated as lowest trust as they are typically entered without real-time validation."
defaultRule: false
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: IsVerified
  - attributeName: VerificationDate
  - attributeName: ConsentStatus
  - attributeName: IsPrimary
  - attributeName: PhoneType
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.ECOMMERCE
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.LOYALTY
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.CRM
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.API
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.POS
  - _type: ConsoPublisherRanking
    publisher: RetailCustomer360.publishers.MANUAL
