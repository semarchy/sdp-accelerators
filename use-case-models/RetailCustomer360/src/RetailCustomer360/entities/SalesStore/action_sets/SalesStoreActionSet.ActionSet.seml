_package: RetailCustomer360.entities.SalesStore.action_sets
_type: ActionSet
_name: SalesStoreActionSet
entity: RetailCustomer360.entities.SalesStore.SalesStore
label: SalesStore Action Set
description: "Actions available to stewards on Sales Stores."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateSalesStore
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SalesStore.steppers.AuthorSalesStore
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditSalesStore
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SalesStore.steppers.AuthorSalesStore
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateSalesStore
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SalesStore.steppers.AuthorSalesStore
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteSalesStore
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportSalesStore
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportSalesStore
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.SalesStore.steppers.AuthorSalesStore
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphSalesStore
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
