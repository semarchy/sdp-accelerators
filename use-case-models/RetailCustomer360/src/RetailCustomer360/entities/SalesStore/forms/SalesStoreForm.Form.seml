                    content:
                      - _type: MenuField
                        _name: OvrSourceSystem
                        value: SourceSystem
                        useCustomLabel: false
                        dataType: STRING
                        componentProperties:
                          textAlign: left
                          useAvatarInMenu: '1'
                          useAvatarInMenuValueInterpreter: LITERAL
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrSourceStoreKey
                        value: SourceStoreKey
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrStoreId
                        value: StoreId
