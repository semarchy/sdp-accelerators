_package: RetailCustomer360.entities.SalesStore.business_views
_type: BusinessView
_name: SalesStoreBusinessView
label: Sales Stores
description: "Browse and steward Sales Stores."
entity: RetailCustomer360.entities.SalesStore.SalesStore
rootLabel: Sales Stores
rootPluralLabel: Sales Stores
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: SalesStore
  displayCard: RetailCustomer360.entities.SalesStore.display_cards.SalesStoreDisplayCard
  entity: RetailCustomer360.entities.SalesStore.SalesStore
  actionSet: RetailCustomer360.entities.SalesStore.action_sets.SalesStoreActionSet
  collection: RetailCustomer360.entities.SalesStore.collection_views.SalesStoreCollectionView
  form: RetailCustomer360.entities.SalesStore.forms.SalesStoreForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true
  transitions:
    - _type: BusinessViewTransition
      _name: AssociatedSalesOrder
      transitionPath: BelongsToSalesStoreFromSalesOrder
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      iconUrl: https://api.iconify.design/mdi/receipt.svg?color=%230D1B2A&width=64
      label: Order
      pluralLabel: Orders
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      visibleInFormTabCondition: any BelongsToSalesStoreFromSalesOrder has (1 = 1)
      businessViewEntity:
        _name: SalesOrderRecords
        _type: BusinessViewEntity
        collection: RetailCustomer360.entities.SalesOrder.collection_views.SalesOrderCollectionView
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        entity: RetailCustomer360.entities.SalesOrder.SalesOrder
        form: RetailCustomer360.entities.SalesOrder.forms.SalesOrderForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        actionSet: RetailCustomer360.entities.SalesOrder.action_sets.SalesOrderActionSet
        displayCard: RetailCustomer360.entities.SalesOrder.display_cards.SalesOrderDisplayCard
        businessEntityBuiltInFilters: []
        businessEntitySearchConfigs:
          - _name: TextConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: TEXT
            enabled: true
          - _name: FormConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: BY_FORM
            enabled: true
          - _name: AdvancedConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: ADVANCED
            enabled: true
          - _name: SemqlConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: SEMQL
            enabled: true
        embeddedCollectionNavigations: []
        referenceAttributeNavigationConfigs: []
        transitions: []
enableHierarchyView: false
useHierarchyOnOpen: false
