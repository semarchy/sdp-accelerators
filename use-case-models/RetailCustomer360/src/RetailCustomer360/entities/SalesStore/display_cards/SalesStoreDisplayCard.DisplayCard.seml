_package: RetailCustomer360.entities.SalesStore.display_cards
_type: DisplayCard
_name: SalesStoreDisplayCard
entity: RetailCustomer360.entities.SalesStore.SalesStore
default: true
primaryTextExpression: "CASE WHEN StoreName IS NOT NULL THEN StoreName ELSE 'Unnamed Store' END"
secondaryTextExpression: "CASE WHEN StoreType IS NOT NULL THEN StoreType ELSE 'Type unknown' END || CASE WHEN StoreStatus IS NOT NULL THEN ' - ' || StoreStatus ELSE '' END || CASE WHEN Address.City IS NOT NULL THEN ' - ' || Address.City ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/storefront.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/storefront.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/storefront.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
