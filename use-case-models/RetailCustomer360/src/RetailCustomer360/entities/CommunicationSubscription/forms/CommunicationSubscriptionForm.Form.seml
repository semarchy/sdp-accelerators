                    _name: OvrPreferencesRow
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: OvrFrequency
                        value: Frequency
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrPreferredSendTime
                        value: PreferredSendTime
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
