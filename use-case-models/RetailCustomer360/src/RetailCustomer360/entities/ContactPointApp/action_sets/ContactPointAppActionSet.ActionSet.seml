_package: RetailCustomer360.entities.ContactPointApp.action_sets
_type: ActionSet
_name: ContactPointAppActionSet
entity: RetailCustomer360.entities.ContactPointApp.ContactPointApp
label: ContactPointApp Action Set
description: "Actions available to stewards on App Contact Points."
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateContactPointApp
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointApp.steppers.AuthorContactPointApp
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditContactPointApp
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointApp.steppers.AuthorContactPointApp
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateContactPointApp
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.ContactPointApp.steppers.AuthorContactPointApp
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: DeleteContactPointApp
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: ExportContactPointApp
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportContactPointApp
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.ContactPointApp.steppers.ImportContactPointApp
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraphContactPointApp
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
