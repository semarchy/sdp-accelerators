_package: RetailCustomer360.entities.ContactPointApp.display_cards
_type: DisplayCard
_name: ContactPointAppDisplayCard
entity: RetailCustomer360.entities.ContactPointApp.ContactPointApp
default: true
primaryTextExpression: "COALESCE(FDN_Customer, 'Unknown Customer') || CASE WHEN IsPrimary = '1' THEN ' • Primary' ELSE '' END"
secondaryTextExpression: "COALESCE(AppPlatform, 'Unknown Platform') || CASE WHEN AppVersion IS NOT NULL THEN ' v' || AppVersion ELSE '' END || ' • ' || COALESCE(PushOptInStatus, 'No Push Status') || CASE WHEN FDN_SoftwareApplication IS NOT NULL THEN ' • ' || FDN_SoftwareApplication ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageValue: https://api.iconify.design/mdi/cellphone-cog.svg?color=%232563EB&width=128
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/cellphone-cog.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/cellphone-cog.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
