_package: RetailCustomer360.entities.ContactPointApp.survivorship_rules
_type: StandardSurvivorshipRule
_name: LocaleMostFrequent
entity: RetailCustomer360.entities.ContactPointApp.ContactPointApp
label: Locale and time zone (most frequent)
description: "Keeps the locale and time zone reported most often."
defaultRule: false
consolidationStrategy: MOST_FREQUENT_VALUE
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
  - attributeName: Locale
  - attributeName: TimeZone
