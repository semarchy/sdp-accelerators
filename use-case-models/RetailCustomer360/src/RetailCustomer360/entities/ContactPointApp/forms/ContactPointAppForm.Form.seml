                        _name: OvrInstallDate
                        value: InstallDate
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: DateField
                        _name: OvrLastOpenDate
                        value: LastOpenDate
                        useCustomLabel: false
                        dataType: DATE
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrDaysSinceLastOpen
                        value: DaysSinceLastOpen
                        useCustomLabel: false
                        dataType: LONG_INTEGER
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
          - _type: FormContainer
            _name: OverviewCol3
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: OvrLocalisation
                label: Localisation
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
