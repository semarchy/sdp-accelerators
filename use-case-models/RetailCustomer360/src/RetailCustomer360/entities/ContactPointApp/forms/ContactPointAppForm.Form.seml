                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
                      - _type: TextField
                        _name: OvrTimeZone
                        value: TimeZone
                        useCustomLabel: false
                        dataType: STRING
                        labelProperties:
                          alignment: left
                          position: top
                          typography: caption
                          isVisible: '1'
              - _type: FormSection
                _name: OvrLinkedRecords
                label: Linked Records
                layoutDirection: COLUMN
                documentationInterpreter: LITERAL
                content:
                  - _type: FormContainer
                    _name: OvrLinkedRecordsRow
                    layoutDirection: COLUMN
                    content:
                      - _type: ReferenceField
                        _name: OvrFDN_Customer
                        value: FDN_Customer
