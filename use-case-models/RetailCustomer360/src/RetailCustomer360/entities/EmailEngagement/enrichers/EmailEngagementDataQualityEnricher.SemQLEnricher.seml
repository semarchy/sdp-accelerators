_package: RetailCustomer360.entities.EmailEngagement.enrichers
_name: EmailEngagementDataQualityEnricher
_type: SemQLEnricher
entity: RetailCustomer360.entities.EmailEngagement.EmailEngagement
label: EmailEngagement Data Quality Enricher
description: "Computes standard completeness enrichment fields for EmailEngagement."
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: EnrichmentCompletenessScore
    expression: CASE
        WHEN EmailEventId IS NULL AND EmailMessageId IS NULL AND EmailAddress IS NULL THEN 0
        ELSE (
          CASE WHEN EmailEventId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN EmailMessageId IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN EmailAddress IS NOT NULL THEN 33 ELSE 0 END
        )
      END
  - attributeName: EnrichmentCompletenessBand
    expression: CASE
        WHEN EmailEventId IS NULL AND EmailMessageId IS NULL AND EmailAddress IS NULL THEN 'Low'
        WHEN (
          CASE WHEN EmailEventId IS NOT NULL THEN 34 ELSE 0 END
          + CASE WHEN EmailMessageId IS NOT NULL THEN 33 ELSE 0 END
          + CASE WHEN EmailAddress IS NOT NULL THEN 33 ELSE 0 END
        ) < 67 THEN 'Medium'
        ELSE 'High'
      END
  - attributeName: EnrichmentUpdatedOn
    expression: CURRENT_DATE()
