_package: RetailCustomer360.entities.EmailEngagement.forms
_type: Form
_name: EmailEngagementForm
entity: RetailCustomer360.entities.EmailEngagement.EmailEngagement
default: true

formTabs:
  - _type: FormTab
    _name: Overview
    label: Overview
