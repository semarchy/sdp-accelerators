_name: EmailEngagementDisplayCard
_package: RetailCustomer360.entities.EmailEngagement.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.EmailEngagement.EmailEngagement
default: true
primaryTextExpression: "CASE WHEN SubjectLine IS NOT NULL THEN SubjectLine WHEN EmailAddress IS NOT NULL THEN EmailAddress ELSE 'Email Interaction' END"
secondaryTextExpression: "CASE WHEN FDN_Customer IS NOT NULL THEN FDN_Customer ELSE EmailAddress END || CASE WHEN EventTimestamp IS NOT NULL THEN ' • ' || TO_CHAR(EventTimestamp, 'YYYY-MM-DD HH24:MI') ELSE '' END"
primaryImageValueInterpreter: LITERAL
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
avatarImageValue: https://api.iconify.design/mdi/email-newsletter.svg?color=%232563EB&width=128
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

