_package: RetailCustomer360.entities.EmailEngagement.action_sets
_type: ActionSet
_name: EmailEngagementActionSet
entity: RetailCustomer360.entities.EmailEngagement.EmailEngagement
label: Email Engagement Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateEmailEngagements
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.EmailEngagement.steppers.AuthorEmailEngagements
