_package: RetailCustomer360.entities.SalesOrder.search_forms
_type: SearchForm
_name: SalesOrderQuickFilters
label: Sales Order Quick Filters
entity: RetailCustomer360.entities.SalesOrder.SalesOrder
semQlCondition: 1=1
searchParameters:
