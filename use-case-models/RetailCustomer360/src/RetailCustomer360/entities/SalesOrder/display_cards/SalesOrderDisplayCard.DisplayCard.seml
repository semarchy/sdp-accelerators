_name: SalesOrderDisplayCard
_package: RetailCustomer360.entities.SalesOrder.display_cards
_type: DisplayCard
entity: RetailCustomer360.entities.SalesOrder.SalesOrder
default: true
primaryTextExpression: "CASE WHEN OrderNumber IS NOT NULL THEN OrderNumber ELSE 'Sales Order' END || CASE WHEN FDN_Customer IS NOT NULL THEN ' • ' || FDN_Customer ELSE '' END"
secondaryTextExpression: "CASE WHEN OrderStatus IS NOT NULL THEN OrderStatus ELSE 'Unknown' END || CASE WHEN PaymentStatus IS NOT NULL THEN ' • ' || PaymentStatus ELSE '' END || CASE WHEN OrderLifecycleStatus IS NOT NULL THEN ' • ' || OrderLifecycleStatus ELSE '' END"
primaryImageValueInterpreter: SEMQL
primaryImageValue: "CASE WHEN OrderLifecycleStatus = 'Settled' AND FinancialHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/cart-check.svg?color=%23059669&width=128' WHEN OrderLifecycleStatus = 'Closed' THEN 'https://api.iconify.design/mdi/cart-remove.svg?color=%23DC2626&width=128' WHEN FinancialHealthStatus IN ('Invalid', 'Invalid Discount') THEN 'https://api.iconify.design/mdi/cart-alert.svg?color=%23D97706&width=128' ELSE 'https://api.iconify.design/mdi/cart.svg?color=%232563EB&width=128' END"
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackValue: https://api.iconify.design/mdi/cart.svg?color=%232563EB&width=128
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
avatarImageValue: "CASE WHEN OrderLifecycleStatus = 'Settled' AND FinancialHealthStatus = 'Healthy' THEN 'https://api.iconify.design/mdi/cart-check.svg?color=%23059669&width=128' WHEN OrderLifecycleStatus = 'Closed' THEN 'https://api.iconify.design/mdi/cart-remove.svg?color=%23DC2626&width=128' WHEN FinancialHealthStatus IN ('Invalid', 'Invalid Discount') THEN 'https://api.iconify.design/mdi/cart-alert.svg?color=%23D97706&width=128' ELSE 'https://api.iconify.design/mdi/cart.svg?color=%232563EB&width=128' END"
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT

