_package: RetailCustomer360.entities.SalesOrder.action_sets
_type: ActionSet
_name: SalesOrderActionSet
entity: RetailCustomer360.entities.SalesOrder.SalesOrder
label: Sales Order Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateSalesOrders
    label: Create
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SalesOrder.steppers.AuthorSalesOrders
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditSalesOrders
    label: Edit
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SalesOrder.steppers.AuthorSalesOrders
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateSalesOrders
    label: Mass Update
    useCustomLabel: true
    stepper: RetailCustomer360.entities.SalesOrder.steppers.AuthorSalesOrders
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportSalesOrders
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: RetailCustomer360.entities.SalesOrder.steppers.AuthorSalesOrders
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

