# Description: List-of-values for `EmailDeliverabilityStatus`.
# Contains email deliverability status values (Deliverable, Bounced, Invalid, Suppressed).
_package: RetailCustomer360.list_of_values
_name: EmailDeliverabilityStatus
_type: LOVType
label: Email Deliverability Status
length: 50

lovValues:
  - label: Deliverable
    code: DELIVERABLE
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Bounced
    code: BOUNCED
    imageUrl: https://api.iconify.design/mdi/email-off.svg?color=%230D1B2A&width=32
  - label: Invalid
    code: INVALID
    imageUrl: https://api.iconify.design/mdi/email-remove.svg?color=%230D1B2A&width=32
  - label: Suppressed
    code: SUPPRESSED
    imageUrl: https://api.iconify.design/mdi/email-lock.svg?color=%230D1B2A&width=32

