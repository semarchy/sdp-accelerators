# Description: List-of-values for `CaseStatus`.
_package: RetailCustomer360.list_of_values
_name: CaseStatus
_type: LOVType
label: Case Status
description: "Lifecycle status of a customer service case."
length: 50

lovValues:
  - label: New
    code: NEW
    imageUrl: https://api.iconify.design/mdi/plus-circle.svg?color=%230D1B2A&width=32
  - label: In Progress
    code: IN_PROGRESS
    imageUrl: https://api.iconify.design/mdi/progress-clock.svg?color=%230D1B2A&width=32
  - label: On Hold
    code: ON_HOLD
    imageUrl: https://api.iconify.design/mdi/pause-circle.svg?color=%230D1B2A&width=32
  - label: Escalated
    code: ESCALATED
    imageUrl: https://api.iconify.design/mdi/arrow-up-circle.svg?color=%230D1B2A&width=32
  - label: Resolved
    code: RESOLVED
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Closed
    code: CLOSED
    imageUrl: https://api.iconify.design/mdi/close-circle.svg?color=%230D1B2A&width=32
