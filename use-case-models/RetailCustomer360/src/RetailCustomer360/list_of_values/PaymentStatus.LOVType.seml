# Description: List-of-values for `PaymentStatus`.
# Contains payment status values (Pending, Paid, Failed, Refunded, Partially Refunded).
_package: RetailCustomer360.list_of_values
_name: PaymentStatus
_type: LOVType
label: Payment Status
length: 50

lovValues:
  - label: Pending
    code: PENDING
    imageUrl: https://api.iconify.design/mdi/clock.svg?color=%230D1B2A&width=32
  - label: Paid
    code: PAID
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Failed
    code: FAILED
    imageUrl: https://api.iconify.design/mdi/close-circle.svg?color=%230D1B2A&width=32
  - label: Refunded
    code: REFUNDED
    imageUrl: https://api.iconify.design/mdi/credit-card-refund.svg?color=%230D1B2A&width=32
  - label: Partially Refunded
    code: PARTIALLY_REFUNDED
    imageUrl: https://api.iconify.design/mdi/credit-card-minus.svg?color=%230D1B2A&width=32

