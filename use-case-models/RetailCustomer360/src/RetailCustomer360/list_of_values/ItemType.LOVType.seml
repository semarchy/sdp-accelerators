# Description: List-of-values for `ItemType`.
# Contains order item type values (Product, Service, Shipping, Discount, Gift Wrap).
_package: RetailCustomer360.list_of_values
_name: ItemType
_type: LOVType
label: Item Type
length: 50

lovValues:
  - label: Product
    code: PRODUCT
    imageUrl: https://api.iconify.design/mdi/package-variant.svg?color=%230D1B2A&width=32
  - label: Service
    code: SERVICE
    imageUrl: https://api.iconify.design/mdi/wrench.svg?color=%230D1B2A&width=32
  - label: Shipping
    code: SHIPPING
    imageUrl: https://api.iconify.design/mdi/truck.svg?color=%230D1B2A&width=32
  - label: Discount
    code: DISCOUNT
    imageUrl: https://api.iconify.design/mdi/tag-minus.svg?color=%230D1B2A&width=32
  - label: Gift Wrap
    code: GIFT_WRAP
    imageUrl: https://api.iconify.design/mdi/gift.svg?color=%230D1B2A&width=32

