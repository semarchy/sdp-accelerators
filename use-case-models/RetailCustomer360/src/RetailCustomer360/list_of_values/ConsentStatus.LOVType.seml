# Description: List-of-values for `ConsentStatus`.
# Contains consent status values (Opted In, Opted Out, Withdrawn, Pending, Unknown).
_package: RetailCustomer360.list_of_values
_name: ConsentStatus
_type: LOVType
label: Consent Status
length: 50

lovValues:
  - label: Opted In
    code: OPTED_IN
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Opted Out
    code: OPTED_OUT
    imageUrl: https://api.iconify.design/mdi/close-circle.svg?color=%230D1B2A&width=32
  - label: Withdrawn
    code: WITHDRAWN
    imageUrl: https://api.iconify.design/mdi/undo.svg?color=%230D1B2A&width=32
  - label: Pending
    code: PENDING
    imageUrl: https://api.iconify.design/mdi/clock.svg?color=%230D1B2A&width=32
  - label: Unknown
    code: UNKNOWN
    imageUrl: https://api.iconify.design/mdi/help-circle.svg?color=%230D1B2A&width=32

