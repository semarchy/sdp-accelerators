# Description: List-of-values for `AccountStatus`.
# Contains lifecycle statuses for business accounts.
_package: RetailCustomer360.list_of_values
_name: AccountStatus
_type: LOVType
label: Account Status
length: 50

lovValues:
  - label: Active
    code: ACTIVE
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Inactive
    code: INACTIVE
    imageUrl: https://api.iconify.design/mdi/circle-off-outline.svg?color=%230D1B2A&width=32
  - label: Prospect
    code: PROSPECT
    imageUrl: https://api.iconify.design/mdi/account-clock.svg?color=%230D1B2A&width=32
  - label: Closed
    code: CLOSED
    imageUrl: https://api.iconify.design/mdi/close-circle.svg?color=%230D1B2A&width=32

