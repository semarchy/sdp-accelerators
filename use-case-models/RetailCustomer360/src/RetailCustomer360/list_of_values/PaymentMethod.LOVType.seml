# Description: List-of-values for `PaymentMethod`.
# Contains payment method values (Card, Cash, Wallet, UPI, BNPL, Gift Card).
_package: RetailCustomer360.list_of_values
_name: PaymentMethod
_type: LOVType
label: Payment Method
length: 50

lovValues:
  - label: Card
    code: CARD
    imageUrl: https://api.iconify.design/mdi/credit-card.svg?color=%230D1B2A&width=32
  - label: Cash
    code: CASH
    imageUrl: https://api.iconify.design/mdi/cash.svg?color=%230D1B2A&width=32
  - label: Wallet
    code: WALLET
    imageUrl: https://api.iconify.design/mdi/wallet.svg?color=%230D1B2A&width=32
  - label: UPI
    code: UPI
    imageUrl: https://api.iconify.design/mdi/qrcode.svg?color=%230D1B2A&width=32
  - label: BNPL
    code: BNPL
    imageUrl: https://api.iconify.design/mdi/calendar-credit-card.svg?color=%230D1B2A&width=32
  - label: Gift Card
    code: GIFT_CARD
    imageUrl: https://api.iconify.design/mdi/gift-card.svg?color=%230D1B2A&width=32

