  - label: Ship to Store
    code: SHIP_TO_STORE
    imageUrl: https://api.iconify.design/mdi/warehouse.svg?color=%230D1B2A&width=32
  - label: Digital
    code: DIGITAL
    imageUrl: https://api.iconify.design/mdi/download.svg?color=%230D1B2A&width=32

