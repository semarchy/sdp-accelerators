# Description: List-of-values for `ReturnStatus`.
# Contains return status values (Not Returned, Return Requested, Returned, Refunded).
_package: RetailCustomer360.list_of_values
_name: ReturnStatus
_type: LOVType
label: Return Status
length: 50

lovValues:
  - label: Not Returned
    code: NOT_RETURNED
    imageUrl: https://api.iconify.design/mdi/package-variant.svg?color=%230D1B2A&width=32
  - label: Return Requested
    code: RETURN_REQUESTED
    imageUrl: https://api.iconify.design/mdi/package-variant-closed-remove.svg?color=%230D1B2A&width=32
  - label: Returned
    code: RETURNED
    imageUrl: https://api.iconify.design/mdi/undo.svg?color=%230D1B2A&width=32
  - label: Refunded
    code: REFUNDED
    imageUrl: https://api.iconify.design/mdi/credit-card-refund.svg?color=%230D1B2A&width=32

