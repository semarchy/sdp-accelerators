  - label: Shipped
    code: SHIPPED
    imageUrl: https://api.iconify.design/mdi/truck.svg?color=%230D1B2A&width=32
  - label: Delivered
    code: DELIVERED
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Cancelled
    code: CANCELLED
    imageUrl: https://api.iconify.design/mdi/cancel.svg?color=%230D1B2A&width=32
  - label: Returned
