# Description: List-of-values for `FulfillmentStatus`.
# Contains fulfillment status values (Pending, Packed, Shipped, Delivered, Cancelled, Returned).
_package: RetailCustomer360.list_of_values
_name: FulfillmentStatus
_type: LOVType
label: Fulfillment Status
length: 50

lovValues:
