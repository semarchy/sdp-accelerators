# Description: List-of-values for `PushOptInStatus`.
# Contains push notification opt-in status values (Opted In, Opted Out, Unknown).
_package: RetailCustomer360.list_of_values
_name: PushOptInStatus
_type: LOVType
label: Push Opt In Status
length: 50

lovValues:
  - label: Opted In
