# Description: List-of-values for `SubscriptionStatus`.
_package: RetailCustomer360.list_of_values
_name: SubscriptionStatus
_type: LOVType
label: Subscription Status
description: "State of a customer communication subscription."
length: 50

lovValues:
  - label: Subscribed
    code: SUBSCRIBED
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Unsubscribed
    code: UNSUBSCRIBED
    imageUrl: https://api.iconify.design/mdi/close-circle.svg?color=%230D1B2A&width=32
  - label: Pending
    code: PENDING
    imageUrl: https://api.iconify.design/mdi/clock.svg?color=%230D1B2A&width=32
  - label: Bounced
    code: BOUNCED
    imageUrl: https://api.iconify.design/mdi/email-off.svg?color=%230D1B2A&width=32
