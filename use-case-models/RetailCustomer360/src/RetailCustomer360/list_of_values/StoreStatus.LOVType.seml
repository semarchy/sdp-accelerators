# Description: List-of-values for `StoreStatus`.
_package: RetailCustomer360.list_of_values
_name: StoreStatus
_type: LOVType
label: Store Status
description: "Operating status of a retail store."
length: 50

lovValues:
  - label: Open
    code: OPEN
    imageUrl: https://api.iconify.design/mdi/store-check.svg?color=%230D1B2A&width=32
  - label: Temporarily Closed
    code: TEMPORARILY_CLOSED
    imageUrl: https://api.iconify.design/mdi/store-clock.svg?color=%230D1B2A&width=32
  - label: Permanently Closed
    code: PERMANENTLY_CLOSED
    imageUrl: https://api.iconify.design/mdi/store-off.svg?color=%230D1B2A&width=32
  - label: Under Renovation
    code: UNDER_RENOVATION
    imageUrl: https://api.iconify.design/mdi/store-edit.svg?color=%230D1B2A&width=32
