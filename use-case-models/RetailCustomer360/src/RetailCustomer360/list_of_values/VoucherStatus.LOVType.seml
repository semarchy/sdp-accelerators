# Description: List-of-values for `VoucherStatus`.
_package: RetailCustomer360.list_of_values
_name: VoucherStatus
_type: LOVType
label: Voucher Status
description: "Redemption state of an issued voucher."
length: 50

lovValues:
  - label: Issued
    code: ISSUED
    imageUrl: https://api.iconify.design/mdi/ticket.svg?color=%230D1B2A&width=32
  - label: Reserved
    code: RESERVED
    imageUrl: https://api.iconify.design/mdi/ticket-account.svg?color=%230D1B2A&width=32
  - label: Redeemed
    code: REDEEMED
    imageUrl: https://api.iconify.design/mdi/ticket-confirmation.svg?color=%230D1B2A&width=32
  - label: Expired
    code: EXPIRED
    imageUrl: https://api.iconify.design/mdi/ticket-off.svg?color=%230D1B2A&width=32
  - label: Cancelled
    code: CANCELLED
    imageUrl: https://api.iconify.design/mdi/ticket-remove.svg?color=%230D1B2A&width=32
