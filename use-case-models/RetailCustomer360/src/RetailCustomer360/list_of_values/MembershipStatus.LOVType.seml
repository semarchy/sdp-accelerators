# Description: List-of-values for `MembershipStatus`.
# Contains loyalty member status values.
_package: RetailCustomer360.list_of_values
_name: MembershipStatus
_type: LOVType
label: Membership Status
length: 50

lovValues:
  - label: Active
    code: ACTIVE
