  - label: Inactive
    code: INACTIVE
    imageUrl: https://api.iconify.design/mdi/circle-off-outline.svg?color=%230D1B2A&width=32
  - label: Suspended
    code: SUSPENDED
    imageUrl: https://api.iconify.design/mdi/pause-circle.svg?color=%230D1B2A&width=32
  - label: Closed
    code: CLOSED
