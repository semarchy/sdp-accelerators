# Description: List-of-values for `RelationshipStatus`.
# Contains relationship lifecycle status values.
_package: RetailCustomer360.list_of_values
_name: RelationshipStatus
_type: LOVType
label: Relationship Status
length: 50

lovValues:
  - label: Active
    code: ACTIVE
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Inactive
    code: INACTIVE
    imageUrl: https://api.iconify.design/mdi/circle-off-outline.svg?color=%230D1B2A&width=32
  - label: Pending
    code: PENDING
    imageUrl: https://api.iconify.design/mdi/clock.svg?color=%230D1B2A&width=32
  - label: Ended
    code: ENDED
    imageUrl: https://api.iconify.design/mdi/close-circle.svg?color=%230D1B2A&width=32

