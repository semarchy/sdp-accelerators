# Description: List-of-values for `CartStatus`.
_package: RetailCustomer360.list_of_values
_name: CartStatus
_type: LOVType
label: Cart Status
description: "State of a shopping cart session."
length: 50

lovValues:
  - label: Active
    code: ACTIVE
    imageUrl: https://api.iconify.design/mdi/cart.svg?color=%230D1B2A&width=32
  - label: Abandoned
    code: ABANDONED
    imageUrl: https://api.iconify.design/mdi/cart-off.svg?color=%230D1B2A&width=32
  - label: Converted
    code: CONVERTED
    imageUrl: https://api.iconify.design/mdi/cart-check.svg?color=%230D1B2A&width=32
  - label: Expired
    code: EXPIRED
    imageUrl: https://api.iconify.design/mdi/clock-alert.svg?color=%230D1B2A&width=32
  - label: Merged
    code: MERGED
    imageUrl: https://api.iconify.design/mdi/merge.svg?color=%230D1B2A&width=32
