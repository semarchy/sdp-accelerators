# Description: List-of-values for `SMSEventType`.
_package: RetailCustomer360.list_of_values
_name: SMSEventType
_type: LOVType
label: SMS Event Type
description: "Event recorded against an SMS message."
length: 50

lovValues:
  - label: Sent
    code: SENT
    imageUrl: https://api.iconify.design/mdi/send.svg?color=%230D1B2A&width=32
  - label: Delivered
    code: DELIVERED
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Failed
    code: FAILED
    imageUrl: https://api.iconify.design/mdi/close-circle.svg?color=%230D1B2A&width=32
  - label: Clicked
    code: CLICKED
    imageUrl: https://api.iconify.design/mdi/cursor-default-click.svg?color=%230D1B2A&width=32
  - label: Replied
    code: REPLIED
    imageUrl: https://api.iconify.design/mdi/reply.svg?color=%230D1B2A&width=32
  - label: Opted Out
    code: OPTED_OUT
    imageUrl: https://api.iconify.design/mdi/message-off.svg?color=%230D1B2A&width=32
