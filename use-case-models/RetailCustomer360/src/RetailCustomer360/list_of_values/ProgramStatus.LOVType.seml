# Description: List-of-values for `ProgramStatus`.
# Contains loyalty program status values (Active, Inactive, Retired).
_package: RetailCustomer360.list_of_values
_name: ProgramStatus
_type: LOVType
label: Program Status
length: 50

lovValues:
  - label: Active
    code: ACTIVE
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Inactive
    code: INACTIVE
    imageUrl: https://api.iconify.design/mdi/circle-off-outline.svg?color=%230D1B2A&width=32
  - label: Planned
    code: PLANNED
    imageUrl: https://api.iconify.design/mdi/calendar-clock.svg?color=%230D1B2A&width=32
  - label: Retired
    code: RETIRED
    imageUrl: https://api.iconify.design/mdi/archive.svg?color=%230D1B2A&width=32

