# Description: List-of-values for `IdentificationStatus`.
# Contains identification status values (Active, Expired, Revoked, Suspended).
_package: RetailCustomer360.list_of_values
_name: IdentificationStatus
_type: LOVType
label: Identification Status
length: 50

lovValues:
  - label: Active
    code: ACTIVE
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Expired
    code: EXPIRED
    imageUrl: https://api.iconify.design/mdi/clock-alert.svg?color=%230D1B2A&width=32
  - label: Pending Verification
    code: PENDING_VERIFICATION
    imageUrl: https://api.iconify.design/mdi/clock.svg?color=%230D1B2A&width=32
  - label: Revoked
    code: REVOKED
    imageUrl: https://api.iconify.design/mdi/cancel.svg?color=%230D1B2A&width=32
  - label: Suspended
    code: SUSPENDED
    imageUrl: https://api.iconify.design/mdi/pause-circle.svg?color=%230D1B2A&width=32

