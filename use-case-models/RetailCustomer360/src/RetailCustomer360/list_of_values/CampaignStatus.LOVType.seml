# Description: List-of-values for `CampaignStatus`.
# Contains campaign lifecycle status values (Planned, Active, Paused, Completed, Cancelled).
_package: RetailCustomer360.list_of_values
_name: CampaignStatus
_type: LOVType
label: Campaign Status
length: 50

lovValues:
  - label: Planned
    code: PLANNED
    imageUrl: https://api.iconify.design/mdi/calendar-clock.svg?color=%230D1B2A&width=32
  - label: Active
    code: ACTIVE
    imageUrl: https://api.iconify.design/mdi/check-circle.svg?color=%230D1B2A&width=32
  - label: Paused
    code: PAUSED
    imageUrl: https://api.iconify.design/mdi/pause-circle.svg?color=%230D1B2A&width=32
  - label: Completed
    code: COMPLETED
    imageUrl: https://api.iconify.design/mdi/flag-checkered.svg?color=%230D1B2A&width=32
  - label: Cancelled
    code: CANCELLED
    imageUrl: https://api.iconify.design/mdi/cancel.svg?color=%230D1B2A&width=32

