_package: RetailCustomer360.complex_types
_type: ComplexType
_name: PostalAddress
label: Postal address
description: "Reusable postal address structure shared by stores, leads and service locations."
attributes:
  - _type: EntityAttribute
    _name: Street
    label: Street
    physicalName: STREET
    dataType: String
    length: 120
    mandatory: false
    searchable: true
    description: "Primary street line of the address."
  - _type: EntityAttribute
    _name: Street2
    label: Street (line 2)
    physicalName: STREET2
    dataType: String
    length: 120
    mandatory: false
    searchable: true
    description: "Secondary street line such as a suite or unit."
  - _type: EntityAttribute
    _name: PostalCode
    label: Postal code
    physicalName: POSTALCODE
    dataType: String
    length: 12
    mandatory: false
    searchable: true
    description: "Postal or ZIP code of the address."
  - _type: EntityAttribute
    _name: City
    label: City
    physicalName: CITY
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "City or locality of the address."
  - _type: EntityAttribute
    _name: Region
    label: Region / State
    physicalName: REGION
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "State, province or region of the address."
  - _type: EntityAttribute
    _name: CountryCode
    label: Country code (ISO)
    physicalName: COUNTRYCODE
    dataType: String
    length: 3
    mandatory: false
    searchable: true
    description: "ISO country code of the address."
displayName:
  _type: ComplexTypeDisplayName
  _name: DisplayName
  separator: ', '
  displayNameAttributes:
    - attribute: RetailCustomer360.complex_types.PostalAddress.Street
    - attribute: RetailCustomer360.complex_types.PostalAddress.City
