_package: RetailCustomer360.complex_types
_type: ComplexType
_name: GeoCoordinates
label: Geo coordinates
description: "Reusable latitude and longitude pair used to place stores and service locations on a map."
attributes:
  - _type: EntityAttribute
    _name: Latitude
    label: Latitude
    physicalName: LATITUDE
    dataType: Decimal
    precision: 10
    scale: 7
    mandatory: false
    searchable: false
    description: "Latitude in decimal degrees."
  - _type: EntityAttribute
    _name: Longitude
    label: Longitude
    physicalName: LONGITUDE
    dataType: Decimal
    precision: 10
    scale: 7
    mandatory: false
    searchable: false
    description: "Longitude in decimal degrees."
displayName:
  _type: ComplexTypeDisplayName
  _name: DisplayName
  separator: ', '
  displayNameAttributes:
    - attribute: RetailCustomer360.complex_types.GeoCoordinates.Latitude
    - attribute: RetailCustomer360.complex_types.GeoCoordinates.Longitude
