_package: CTMDM.applications
_type: Application
_name: CTMDMApplication
label: Clinical Trials Master
visibility: VISIBLE
applicationTitle: Clinical Trials Master

avatarImageUrl: images://ctmdm/ctmdm-new-avatar.png
logoUrl: images://ctmdm/ctmdm-dna-banner-updated.png
coverImageUrl: images://ctmdm/ctmdm-dna-square-new.png
favIcon: images://ctmdm/ctmdm-new-avatar.png
sortStrategy: POSITION
historyBrowsingEnabled: false
historyBrowsingRequiredRole: ""
titleBarDefaultColor: md:green 600

defaultAction: CTMDM.applications.CTMDMApplication.Root.GlobalSearch

documentationConfig:
  documentation: ""
  documentationConfigDiagrams:
    - _name: MainModel
      _type: DocumentationConfigDiagram
      modelDiagram: CTMDM.model_diagrams.CTMDM
      label: Main Model
    - _name: InvestigatorDomain
      _type: DocumentationConfigDiagram
      modelDiagram: CTMDM.model_diagrams.CTMDMInvestigators
      label: Investigator Domain
    - _name: SiteDomain
      _type: DocumentationConfigDiagram
      modelDiagram: CTMDM.model_diagrams.CTMDMSites
      label: Site Domain
    - _name: StudyDomain
      _type: DocumentationConfigDiagram
      modelDiagram: CTMDM.model_diagrams.CTMDMStudies
      label: Study Domain

globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: false
  globalSearchBusinessViews:
    - _type: GlobalSearchBoView
      _name: SearchInvestigators
      label: Investigators
      viewType: GD
      businessView: CTMDM.entities.Investigator.business_views.InvestigatorBusinessView
      searchTypeConfig: CTMDM.entities.Investigator.business_views.InvestigatorBusinessView.Investigator.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: SearchClinicalSites
      label: Clinical Sites
      viewType: GD
      businessView: CTMDM.entities.ClinicalSite.business_views.ClinicalSiteBusinessView
      searchTypeConfig: CTMDM.entities.ClinicalSite.business_views.ClinicalSiteBusinessView.ClinicalSite.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: SearchStudies
      label: Studies
      viewType: GD
      businessView: CTMDM.entities.Study.business_views.StudyBusinessView
      searchTypeConfig: CTMDM.entities.Study.business_views.StudyBusinessView.Study.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: SearchProtocols
      label: Protocols
      viewType: GD
      businessView: CTMDM.entities.Protocol.business_views.ProtocolBusinessView
      searchTypeConfig: CTMDM.entities.Protocol.business_views.ProtocolBusinessView.Protocol.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: SearchCROsVendors
      label: CROs / Vendors
      viewType: GD
      businessView: CTMDM.entities.Vendor.business_views.VendorBusinessView
      searchTypeConfig: CTMDM.entities.Vendor.business_views.VendorBusinessView.Vendor.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: SearchHealthcareOrganizations
      label: Healthcare Organizations
      viewType: GD
      businessView: CTMDM.entities.HealthcareOrganization.business_views.HealthcareOrganizationBusinessView
      searchTypeConfig: CTMDM.entities.HealthcareOrganization.business_views.HealthcareOrganizationBusinessView.HealthcareOrganization.TextConfig
      maxResults: 5

navDrawer:
  - _type: NavigationGroup
    _name: RootFolder
    label : Root Folder
    dividerVisible: false
    labelVisible: false
    
    actions:
      - appAction: CTMDM.applications.CTMDMApplication.Root.MyTasks
      - appAction: CTMDM.applications.CTMDMApplication.Root.GlobalSearch

  - _type: FolderNavGroup
    _name: Investigators
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.Investigators

  - _type: FolderNavGroup
    _name: InvestigatorsWF
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.WorkflowInv

  - _type: FolderNavGroup
    _name: Sites
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.Sites

  - _type: FolderNavGroup
    _name: Studies
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.Studies

  - _type: FolderNavGroup
    _name: ProtocolWF
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.WorkflowProt

  - _type: FolderNavGroup
    _name: Vendors
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.Vendor

  - _type: FolderNavGroup
    _name: Reference
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.ReferenceData

  - _type: FolderNavGroup
    _name: Suggestions
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.Suggestions

  - _type: FolderNavGroup
    _name: ConfirmMatches
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.ConfirmMatch

  - _type: FolderNavGroup
    _name: SourceErrors
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.SourceErrors

  - _type: FolderNavGroup
    _name: Admin
    dividerVisible: true
    labelVisible: false
    linkedFolder: CTMDM.applications.CTMDMApplication.Root.Admin

rootFolder:
  _type: FolderAction
  _name: Root
  label: Root Folder
  image: images://ctmdm/ctmdm-new-cover.png
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  
  appActions:
    - _type: MyTasksAction
      _name: MyTasks
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      badgeVisible: true

    - _type: GlobalSearchAction
      _name: GlobalSearch
      imageAlign: MIDDLE_CENTER
      imageMode: FIT

    - _type: FolderAction
      _name: Investigators
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      label: " "
      labelColor: md:teal
      image: images://ctmdm/ctmdm-folder-investigators.png
      iconColor: md:teal
      appActions:
        - _type: FolderAction
          _name: ClinicalInvestigators
          description: Browse Investigator related data
          icon: images://mdi/account-tie.svg
          iconColor: md:blue 700
          label: Clinical Investigators
          labelColor: md:blue 700
          appActions:
            - _type: BrowseBusinessViewAction
              _name: BrowseInvestigator
              businessView: CTMDM.entities.Investigator.business_views.InvestigatorBusinessView
              label: Investigators
              labelColor: md:teal
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
              nbRecordsBadgeVisible: true
              description: Browse Investigators records
              image: images://ctmdm/ctmdm-investigator.png
              iconColor: md:teal
              nbRecordsBadgeBackgroundColor: md:green 600
              
            - _type: BrowseBusinessViewAction
              _name: BrowseMedicalLicense
              businessView: CTMDM.entities.MedicalLicense.business_views.MedicalLicenseBusinessView
              label: Medical Licenses
              labelColor: md:teal
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
              nbRecordsBadgeVisible: true
              description: Browse Medical Licenses records
              image: images://ctmdm/ctmdm-medical-license.png
              iconColor: md:teal
              nbRecordsBadgeBackgroundColor: md:green 600
            - _type: BrowseBusinessViewAction
              _name: BrowseGcpCertification
              businessView: CTMDM.entities.GcpCertification.business_views.GcpCertificationBusinessView
              label: GCP Certifications
              labelColor: md:teal
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
              nbRecordsBadgeVisible: true
              description: Browse GCP Certifications records
              image: images://ctmdm/ctmdm-gcp-certification.png
              iconColor: md:teal
              nbRecordsBadgeBackgroundColor: md:green 600
            - _type: BrowseBusinessViewAction
              _name: BrowseStudyInvestigator
              businessView: CTMDM.entities.StudyInvestigator.business_views.StudyInvestigatorBusinessView
              label: Study Investigators
              labelColor: md:teal
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
              nbRecordsBadgeVisible: true
              description: Browse Study Investigators records
              image: images://ctmdm/ctmdm-study-investigator.png
              iconColor: md:teal

              nbRecordsBadgeBackgroundColor: md:green 600
    - _type: FolderAction
      _name: Sites
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      label: "  "
      labelColor: md:blue
      image: images://ctmdm/ctmdm-folder-sites.png
      iconColor: md:blue
      appActions:
        - _type: FolderAction
