      iconColor: md:red
      appActions:

        - _type: StartWorkflowAction
          _name: InvestigaotWf
          startEvent: CTMDM.workflows.OnboardInvestigator.StartFromScratch
          label: Onboard Investigators
          description: Start workflow to onboard new Investigator
          icon: images://mdi/person-plus.svg
          iconColor: md:blue 700
          labelColor: md:blue 700

