_package: CTMDM.entities.SiteEthicsCommittee.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.SiteEthicsCommittee.SiteEthicsCommittee
label: Default Rule
description: "Selects surviving Site Ethics Committee values using the configured preferred publisher ranking."
documentation: "Selects surviving Site Ethics Committee values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: OversightType
  - attributeName: OversightStatus
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RIM
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
