_package: CTMDM.entities.StudySite.collection_views
_type: CollectionView
_name: StudySiteCollectionView

entity: CTMDM.entities.StudySite.StudySite
default: true
displayCard: CTMDM.entities.StudySite.display_cards.StudySiteDisplayCard
tableDisplayCardColumnWidth: 300

gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1

listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true

tableAllowed: true
tableDisplayCardColumnLabel: Study Site
tableRowLines: 2
tableShowDisplayCard: true

tableColumns:
  - _type: ReferenceColumn
    _name: FDN_study
    value: FDN_study
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: CTMDM.entities.Study.Study

    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FDN_clinicalSite
    value: FDN_clinicalSite
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: CTMDM.entities.ClinicalSite.ClinicalSite
    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: SiteStatus
    value: SiteStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: EnrollmentTarget
    value: EnrollmentTarget
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: DateColumn
    _name: SiteActivationDate
    value: SiteActivationDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: DateColumn
    _name: SiteCloseDate
    value: SiteCloseDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: TextColumn
    _name: StartupRiskLevel
    value: StartupRiskLevel
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: TextColumn
    _name: SubjectsEnrolled
    value: SubjectsEnrolled
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180