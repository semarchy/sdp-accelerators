_package: CTMDM.entities.StudySite.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.StudySite.StudySite
label: Default Rule
description: "Selects surviving Study Site values using the configured preferred publisher ranking."
documentation: "Selects surviving Study Site values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: SiteStatus
  - attributeName: EnrollmentTarget
  - attributeName: SubjectsEnrolled
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CROSource
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
