_package: CTMDM.entities.StudySite.forms
_type: Form
_name: StudySiteForm
description: "Defines the form used to view and maintain Study Site records in Clinical Trial MDM workflows."
documentation: "Defines the form used to view and maintain Study Site records in Clinical Trial MDM workflows."

entity: CTMDM.entities.StudySite.StudySite
default: true

formTabs:
  - _type: FormTab
    _name: General
    label: Study Site
    documentation: This form provides a comprehensive view of Study Site details, allowing users to browse and manage records effectively
    documentationInterpreter: LITERAL
    visibleValue: "1"
    iconUrl: images://mdi/hospital-marker.svg
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: Container1
        layoutDirection: ROW

        content:
          - _type: FormContainer
            _name: Container2
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: GeneralInformation
                label: General Information
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: IdField
                    _name: StudySiteID
                    value: StudySiteID
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: SiteActivationDate
                    value: SiteActivationDate
                    useCustomLabel: false
                    dataType: DATE

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: SiteCloseDate
                    value: SiteCloseDate
                    useCustomLabel: false
                    dataType: DATE

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: SiteStatus
                    value: SiteStatus
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
          - _type: FormContainer
            _name: Container3
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: OperationalDetails
                label: Operational Details
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: TextField
                    _name: EnrollmentTarget
                    value: EnrollmentTarget
                    useCustomLabel: false
                    dataType: INTEGER

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: SubjectsEnrolled
                    value: SubjectsEnrolled
                    useCustomLabel: false
                    dataType: INTEGER

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: StartupRiskLevel
                    value: StartupRiskLevel
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
          - _type: FormContainer
            _name: Container4
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: RelationshipDetails
                label: Relationship Details
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: ReferenceField
                    _name: FDN_study
                    value: FDN_study
                    useCustomLabel: false
                    dataType: STRING
                    referencedEntity: CTMDM.entities.Study.Study

                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '350'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_clinicalSite
                    value: FDN_clinicalSite
                    useCustomLabel: false
                    dataType: STRING
                    referencedEntity: CTMDM.entities.ClinicalSite.ClinicalSite

                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '350'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption