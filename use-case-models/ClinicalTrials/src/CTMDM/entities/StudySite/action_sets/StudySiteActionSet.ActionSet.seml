_package: CTMDM.entities.StudySite.action_sets
_type: ActionSet
_name: StudySiteActionSet

entity: CTMDM.entities.StudySite.StudySite
label: Study Site Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorStudySites
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.StudySite.steppers.AuthorStudySites
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorStudySites
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.StudySite.steppers.AuthorStudySites
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorStudySites
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.StudySite.steppers.AuthorStudySites
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorStudySites
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.StudySite.steppers.AuthorStudySites
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
