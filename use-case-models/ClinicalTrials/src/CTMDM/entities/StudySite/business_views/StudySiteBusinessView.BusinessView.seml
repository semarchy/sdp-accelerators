_package: CTMDM.entities.StudySite.business_views
_type: BusinessView
_name: StudySiteBusinessView

entity: CTMDM.entities.StudySite.StudySite
rootLabel: Study Site
rootPluralLabel: Study Sites
rootIconUrl: images://mdi/hospital-marker.svg
displayRootNodeAs: ICON_LABEL
label: Study Sites
        
enableHierarchyView: false
useHierarchyOnOpen: false

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: StudySite
  entity: CTMDM.entities.StudySite.StudySite
  actionSet: CTMDM.entities.StudySite.action_sets.StudySiteActionSet
  collection: CTMDM.entities.StudySite.collection_views.StudySiteCollectionView
  form: CTMDM.entities.StudySite.forms.StudySiteForm
  displayCard: CTMDM.entities.StudySite.display_cards.StudySiteDisplayCard
  outlineVisible: false
  displayRecordCount: ALWAYS

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: MasterRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: CTMDM.entities.StudySite.business_views.StudySiteBusinessView.StudySite
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true