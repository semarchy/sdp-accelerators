_package: CTMDM.entities.StudyCountry.action_sets
_type: ActionSet
_name: StudyCountryActionSet

entity: CTMDM.entities.StudyCountry.StudyCountry
label: Study Country Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorStudyCountries
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.StudyCountry.steppers.AuthorStudyCountries
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorStudyCountries
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.StudyCountry.steppers.AuthorStudyCountries
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorStudyCountries
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.StudyCountry.steppers.AuthorStudyCountries
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorStudyCountries
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.StudyCountry.steppers.AuthorStudyCountries
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
