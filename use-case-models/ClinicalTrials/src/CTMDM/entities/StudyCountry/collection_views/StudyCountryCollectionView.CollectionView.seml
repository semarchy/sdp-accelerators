_package: CTMDM.entities.StudyCountry.collection_views
_type: CollectionView
_name: StudyCountryCollectionView

entity: CTMDM.entities.StudyCountry.StudyCountry
default: true
displayCard: CTMDM.entities.StudyCountry.display_cards.StudyCountryDisplayCard
tableDisplayCardColumnWidth: 300

gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1

listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true

tableAllowed: true
tableDisplayCardColumnLabel: Study Country
tableRowLines: 2
tableShowDisplayCard: true

tableColumns:
  - _type: ReferenceColumn
    _name: FDN_study
    value: FDN_study
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: CTMDM.entities.Study.Study

    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FDN_country
    value: FDN_country
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: CTMDM.entities.Country.Country
    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: CountryStatus
    value: CountryStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: EnrollmentTarget
    value: EnrollmentTarget
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: DateColumn
    _name: RegulatorySubmissionDate
    value: RegulatorySubmissionDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: DateColumn
    _name: RegulatoryApprovalDate
    value: RegulatoryApprovalDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: DateColumn
    _name: FirstSiteActivatedDate
    value: FirstSiteActivatedDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
