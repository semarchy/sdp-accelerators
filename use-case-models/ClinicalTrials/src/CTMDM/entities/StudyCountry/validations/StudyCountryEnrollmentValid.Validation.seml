_package: CTMDM.entities.StudyCountry.validations
_name: StudyCountryEnrollmentValid
_type: SemQLValidation
entity: CTMDM.entities.StudyCountry.StudyCountry
label: Country enrollment target must not be negative
validationScope: PRE_CONSO
