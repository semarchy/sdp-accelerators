_package: CTMDM.entities.StudyCountry.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.StudyCountry.StudyCountry
label: Default Rule
description: "Selects surviving Study Country values using the configured preferred publisher ranking."
documentation: "Selects surviving Study Country values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: CountryStatus
  - attributeName: RegulatoryApprovalDate
  - attributeName: EnrollmentTarget
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RIM
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CROSource
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
