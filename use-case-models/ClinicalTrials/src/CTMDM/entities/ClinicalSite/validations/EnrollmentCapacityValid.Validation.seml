_package: CTMDM.entities.ClinicalSite.validations
_name: EnrollmentCapacityValid
_type: SemQLValidation
entity: CTMDM.entities.ClinicalSite.ClinicalSite
label: Enrollment capacity must not be negative
validationScope: PRE_CONSO
description: "Enrollment capacity must not be negative before consolidation."

condition: EnrollmentCapacity IS NULL OR EnrollmentCapacity >= 0
