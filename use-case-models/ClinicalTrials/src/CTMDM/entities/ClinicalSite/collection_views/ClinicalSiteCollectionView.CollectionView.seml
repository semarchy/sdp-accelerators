_package: CTMDM.entities.ClinicalSite.collection_views
_type: CollectionView
_name: ClinicalSiteCollectionView

entity: CTMDM.entities.ClinicalSite.ClinicalSite
default: true
displayCard: CTMDM.entities.ClinicalSite.display_cards.ClinicalSiteDisplayCard
tableDisplayCardColumnWidth: 300

gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1

listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true

tableAllowed: true
tableDisplayCardColumnLabel: Clinical Site
tableRowLines: 2
tableShowDisplayCard: true

tableColumns:
  - _type: TextColumn
    _name: SiteName
    value: SiteName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: TextColumn
    _name: PostalCode
    value: PostalCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: ReferenceColumn
    _name: FDN_healthcareOrganization
    value: FDN_healthcareOrganization
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: CTMDM.entities.HealthcareOrganization.HealthcareOrganization

    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FDN_country
    value: FDN_country
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: CTMDM.entities.Country.Country
    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: SiteStatus
    value: SiteStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: EnrollmentCapacity
    value: EnrollmentCapacity
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: DateColumn
    _name: ActivationDate
    value: ActivationDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: DateColumn
    _name: DeactivationDate
    value: DeactivationDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: TextColumn
    _name: AddressLine1
    value: AddressLine1
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
