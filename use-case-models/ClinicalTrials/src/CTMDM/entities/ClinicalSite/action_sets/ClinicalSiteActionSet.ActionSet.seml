_package: CTMDM.entities.ClinicalSite.action_sets
_type: ActionSet
_name: ClinicalSiteActionSet

entity: CTMDM.entities.ClinicalSite.ClinicalSite
label: Clinical Site Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorClinicalSites
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.ClinicalSite.steppers.AuthorClinicalSites
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorClinicalSites
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.ClinicalSite.steppers.AuthorClinicalSites
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorClinicalSites
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.ClinicalSite.steppers.AuthorClinicalSites
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorClinicalSites
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.ClinicalSite.steppers.AuthorClinicalSites
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false

  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnClinicalSite
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.ClinicalSite.dups_managers.ReviewSuggestionsOnClinicalSite
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false

  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnClinicalSite
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.ClinicalSite.dups_managers.ReviewSuggestionsOnClinicalSite
    enableEdit: true
    waitDialogEnabled: false

  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnClinicalSite
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: CTMDM.entities.ClinicalSite.dups_managers.ReviewSuggestionsOnClinicalSite
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false

  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    displayCard: CTMDM.entities.ClinicalSite.display_cards.ClinicalSiteDisplayCard
    formTab: CTMDM.entities.ClinicalSite.forms.ClinicalSiteForm.General
    waitDialogEnabled: false
