_package: CTMDM.entities.GcpCertification.action_sets
_type: ActionSet
_name: GcpCertificationActionSet

entity: CTMDM.entities.GcpCertification.GcpCertification
label: GCP Certification Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorGCPCertifications
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.GcpCertification.steppers.AuthorGCPCertifications
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorGCPCertifications
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.GcpCertification.steppers.AuthorGCPCertifications
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorGCPCertifications
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.GcpCertification.steppers.AuthorGCPCertifications
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorGCPCertifications
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.GcpCertification.steppers.AuthorGCPCertifications
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
