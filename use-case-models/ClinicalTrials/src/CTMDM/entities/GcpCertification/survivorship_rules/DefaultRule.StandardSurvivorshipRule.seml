_package: CTMDM.entities.GcpCertification.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.GcpCertification.GcpCertification
label: Default Rule
description: "Selects surviving GCP Certification values using the configured preferred publisher ranking."
documentation: "Selects surviving GCP Certification values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: CertificateNumber
  - attributeName: CertificationStatus
  - attributeName: ExpirationDate
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.MedicalAffairs
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RegulatorySystem
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
