  - _type: EntityAttribute
    _name: RoleStartDate
    label: Role Start Date
    description: Date the investigator began the role.
    documentation: Date the investigator began the role.
    physicalName: ROLE_START_DATE
    dataType: Date
    mandatory: false

  - _type: EntityAttribute
    _name: RoleEndDate
    label: Role End Date
    description: Date the investigator ended the role.
    documentation: Date the investigator ended the role.
    physicalName: ROLE_END_DATE
    dataType: Date
    mandatory: false

  - _type: EntityAttribute
    _name: DelegationStatus
    label: Delegation Status
    description: Status of delegation and authorization.
    documentation: Status of delegation and authorization.
    physicalName: DELEGATION_STATUS
    dataType: String
    length: 50
    mandatory: false

  - _type: EntityAttribute
    _name: QualificationStatus
    label: Qualification Status
