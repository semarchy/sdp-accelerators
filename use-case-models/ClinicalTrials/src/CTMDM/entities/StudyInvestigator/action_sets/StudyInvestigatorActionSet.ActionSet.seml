_package: CTMDM.entities.StudyInvestigator.action_sets
_type: ActionSet
_name: StudyInvestigatorActionSet

entity: CTMDM.entities.StudyInvestigator.StudyInvestigator
label: Study Investigator Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorStudyInvestigators
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.StudyInvestigator.steppers.AuthorStudyInvestigators
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorStudyInvestigators
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.StudyInvestigator.steppers.AuthorStudyInvestigators
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorStudyInvestigators
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.StudyInvestigator.steppers.AuthorStudyInvestigators
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorStudyInvestigators
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.StudyInvestigator.steppers.AuthorStudyInvestigators
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
