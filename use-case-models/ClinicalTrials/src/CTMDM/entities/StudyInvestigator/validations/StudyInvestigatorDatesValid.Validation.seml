_package: CTMDM.entities.StudyInvestigator.validations
_name: StudyInvestigatorDatesValid
_type: SemQLValidation
entity: CTMDM.entities.StudyInvestigator.StudyInvestigator
label: Study investigator role end date must not be before start date
validationScope: PRE_CONSO
description: "Study investigator role end date must not be before start date before consolidation."

condition: RoleEndDate IS NULL OR RoleStartDate IS NULL OR RoleEndDate >= RoleStartDate
