_package: CTMDM.entities.Country.business_views
_type: BusinessView
_name: CountryBusinessView

entity: CTMDM.entities.Country.Country
rootLabel: Country
rootPluralLabel: Countries
rootIconUrl: images://mdi/earth.svg
displayRootNodeAs: ICON_LABEL
label: Countries
        
enableHierarchyView: false
useHierarchyOnOpen: false

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Country
  entity: CTMDM.entities.Country.Country
  actionSet: CTMDM.entities.Country.action_sets.CountryActionSet
  collection: CTMDM.entities.Country.collection_views.CountryCollectionView
  form: CTMDM.entities.Country.forms.CountryForm
  displayCard: CTMDM.entities.Country.display_cards.CountryDisplayCard
  outlineVisible: false
  displayRecordCount: ALWAYS

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: CTMDM.entities.Country.business_views.CountryBusinessView.Country
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true