_package: CTMDM.entities.Country.forms
_type: Form
_name: CountryForm
description: "Defines the form used to view and maintain Country records in Clinical Trial MDM workflows."
documentation: "Defines the form used to view and maintain Country records in Clinical Trial MDM workflows."

entity: CTMDM.entities.Country.Country
default: true

formTabs:
  - _type: FormTab
    _name: General
    label: Country
    documentation: This form provides a comprehensive view of Country details, allowing users to browse and manage records effectively
    documentationInterpreter: LITERAL
    visibleValue: "1"
    iconUrl: images://mdi/earth.svg
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: Container1
        layoutDirection: ROW

        content:
          - _type: FormContainer
            _name: Container2
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: GeneralInformation
                label: General Information
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: IdField
                    _name: CountryID
                    value: CountryID
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CountryCode
                    value: CountryCode
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CountryName
                    value: CountryName
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
          - _type: FormContainer
            _name: Container3
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: OperationalDetails
                label: Operational Details
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: TextField
                    _name: Region
                    value: Region
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RegulatoryRegion
                    value: RegulatoryRegion
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
          - _type: FormContainer
            _name: Container4
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: EnrichedInformation
                label: Enriched Information
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: TextField
                    _name: NormalizedCountryCode
                    value: NormalizedCountryCode
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: NormalizedCountryName
                    value: NormalizedCountryName
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption