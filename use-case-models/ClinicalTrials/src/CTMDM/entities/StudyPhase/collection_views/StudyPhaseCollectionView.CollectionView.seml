_package: CTMDM.entities.StudyPhase.collection_views
_type: CollectionView
_name: StudyPhaseCollectionView

entity: CTMDM.entities.StudyPhase.StudyPhase
default: true
displayCard: CTMDM.entities.StudyPhase.display_cards.StudyPhaseDisplayCard
tableDisplayCardColumnWidth: 300

gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1

listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true

tableAllowed: true
tableDisplayCardColumnLabel: Study Phase
tableRowLines: 2
tableShowDisplayCard: true

tableColumns:
  - _type: TextColumn
    _name: PhaseName
    value: PhaseName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: TextColumn
    _name: PhaseCode
    value: PhaseCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: PhaseSequence
    value: PhaseSequence
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: TextColumn
    _name: Description
    value: Description
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: CheckboxColumn
    _name: ActiveFlag
    value: ActiveFlag
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: true