_package: CTMDM.entities.EthicsCommittee.action_sets
_type: ActionSet
_name: EthicsCommitteeConfirmMatchesActionSet

entity: CTMDM.entities.EthicsCommittee.EthicsCommittee
label: Ethics Committee / IRB Confirm Matches Action Set
defaultActionSet: false

actions:
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false

  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnEthicsCommittee
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.EthicsCommittee.dups_managers.ConfirmMatchesOnEthicsCommittee
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false

  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnEthicsCommittee
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.EthicsCommittee.dups_managers.ConfirmMatchesOnEthicsCommittee
    enableEdit: true
    waitDialogEnabled: false
