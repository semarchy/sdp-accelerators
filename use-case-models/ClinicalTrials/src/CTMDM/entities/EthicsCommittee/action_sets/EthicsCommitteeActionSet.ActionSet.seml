_package: CTMDM.entities.EthicsCommittee.action_sets
_type: ActionSet
_name: EthicsCommitteeActionSet

entity: CTMDM.entities.EthicsCommittee.EthicsCommittee
label: Ethics Committee / IRB Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorEthicsCommitteesIRBs
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.EthicsCommittee.steppers.AuthorEthicsCommitteesIRBs
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorEthicsCommitteesIRBs
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.EthicsCommittee.steppers.AuthorEthicsCommitteesIRBs
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorEthicsCommitteesIRBs
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.EthicsCommittee.steppers.AuthorEthicsCommitteesIRBs
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorEthicsCommitteesIRBs
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.EthicsCommittee.steppers.AuthorEthicsCommitteesIRBs
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false

  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnEthicsCommittee
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.EthicsCommittee.dups_managers.ReviewSuggestionsOnEthicsCommittee
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false

  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnEthicsCommittee
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.EthicsCommittee.dups_managers.ReviewSuggestionsOnEthicsCommittee
    enableEdit: true
    waitDialogEnabled: false

  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnEthicsCommittee
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: CTMDM.entities.EthicsCommittee.dups_managers.ReviewSuggestionsOnEthicsCommittee
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false

  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    displayCard: CTMDM.entities.EthicsCommittee.display_cards.EthicsCommitteeDisplayCard
    formTab: CTMDM.entities.EthicsCommittee.forms.EthicsCommitteeForm.General
    waitDialogEnabled: false
