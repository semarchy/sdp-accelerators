_package: CTMDM.entities.EthicsCommittee.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.EthicsCommittee.EthicsCommittee
label: Default Rule
description: "Selects surviving Ethics Committee / IRB values using the configured preferred publisher ranking."
documentation: "Selects surviving Ethics Committee / IRB values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: CommitteeName
  - attributeName: CommitteeType
  - attributeName: RegistrationNumber
  - attributeName: Status
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RegulatorySystem
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RIM
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
