_package: CTMDM.entities.StudyVendor.action_sets
_type: ActionSet
_name: StudyVendorActionSet

entity: CTMDM.entities.StudyVendor.StudyVendor
label: Study Vendor Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorStudyVendors
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.StudyVendor.steppers.AuthorStudyVendors
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorStudyVendors
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.StudyVendor.steppers.AuthorStudyVendors
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorStudyVendors
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.StudyVendor.steppers.AuthorStudyVendors
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorStudyVendors
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.StudyVendor.steppers.AuthorStudyVendors
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
