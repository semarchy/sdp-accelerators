_package: CTMDM.entities.StudyVendor.business_views
_type: BusinessView
_name: StudyVendorBusinessView

entity: CTMDM.entities.StudyVendor.StudyVendor
rootLabel: Study Vendor
rootPluralLabel: Study Vendors
rootIconUrl: images://mdi/briefcase-check-outline.svg
displayRootNodeAs: ICON_LABEL
label: Study Vendors
        
enableHierarchyView: false
useHierarchyOnOpen: false

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: StudyVendor
  entity: CTMDM.entities.StudyVendor.StudyVendor
  actionSet: CTMDM.entities.StudyVendor.action_sets.StudyVendorActionSet
  collection: CTMDM.entities.StudyVendor.collection_views.StudyVendorCollectionView
  form: CTMDM.entities.StudyVendor.forms.StudyVendorForm
  displayCard: CTMDM.entities.StudyVendor.display_cards.StudyVendorDisplayCard
  outlineVisible: false
  displayRecordCount: ALWAYS

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: MasterRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: CTMDM.entities.StudyVendor.business_views.StudyVendorBusinessView.StudyVendor
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true