_package: CTMDM.entities.StudyVendor.forms
_type: Form
_name: StudyVendorForm
description: "Defines the form used to view and maintain Study Vendor records in Clinical Trial MDM workflows."
documentation: "Defines the form used to view and maintain Study Vendor records in Clinical Trial MDM workflows."

entity: CTMDM.entities.StudyVendor.StudyVendor
default: true

formTabs:
  - _type: FormTab
    _name: General
    label: Study Vendor
    documentation: This form provides a comprehensive view of Study Vendor details, allowing users to browse and manage records effectively
    documentationInterpreter: LITERAL
    visibleValue: "1"
    iconUrl: images://mdi/briefcase-check-outline.svg
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: Container1
        layoutDirection: ROW

        content:
          - _type: FormContainer
            _name: Container2
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: GeneralInformation
                label: General Information
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: IdField
                    _name: StudyVendorID
                    value: StudyVendorID
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ServiceScope
                    value: ServiceScope
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ContractStatus
                    value: ContractStatus
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
          - _type: FormContainer
            _name: Container3
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: OperationalDetails
                label: Operational Details
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: DateField
                    _name: StartDate
                    value: StartDate
                    useCustomLabel: false
                    dataType: DATE

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: EndDate
                    value: EndDate
                    useCustomLabel: false
                    dataType: DATE

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: OversightOwner
                    value: OversightOwner
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
          - _type: FormContainer
            _name: Container4
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: RelationshipDetails
                label: Relationship Details
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: ReferenceField
                    _name: FDN_study
                    value: FDN_study
                    useCustomLabel: false
                    dataType: STRING
                    referencedEntity: CTMDM.entities.Study.Study

                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '350'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_vendor
                    value: FDN_vendor
                    useCustomLabel: false
                    dataType: STRING
                    referencedEntity: CTMDM.entities.Vendor.Vendor

                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '350'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption