_package: CTMDM.entities.SiteCapabilityAssignment.action_sets
_type: ActionSet
_name: SiteCapabilityAssignmentActionSet

entity: CTMDM.entities.SiteCapabilityAssignment.SiteCapabilityAssignment
label: Site Capability Assignment Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorSiteCapabilityAssignments
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.SiteCapabilityAssignment.steppers.AuthorSiteCapabilityAssignments
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorSiteCapabilityAssignments
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.SiteCapabilityAssignment.steppers.AuthorSiteCapabilityAssignments
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorSiteCapabilityAssignments
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.SiteCapabilityAssignment.steppers.AuthorSiteCapabilityAssignments
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorSiteCapabilityAssignments
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.SiteCapabilityAssignment.steppers.AuthorSiteCapabilityAssignments
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
