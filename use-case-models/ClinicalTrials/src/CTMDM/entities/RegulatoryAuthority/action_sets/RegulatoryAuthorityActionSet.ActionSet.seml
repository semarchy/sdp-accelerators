_package: CTMDM.entities.RegulatoryAuthority.action_sets
_type: ActionSet
_name: RegulatoryAuthorityActionSet

entity: CTMDM.entities.RegulatoryAuthority.RegulatoryAuthority
label: Regulatory Authority Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorRegulatoryAuthorities
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.RegulatoryAuthority.steppers.AuthorRegulatoryAuthorities
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorRegulatoryAuthorities
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.RegulatoryAuthority.steppers.AuthorRegulatoryAuthorities
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorRegulatoryAuthorities
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.RegulatoryAuthority.steppers.AuthorRegulatoryAuthorities
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorRegulatoryAuthorities
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.RegulatoryAuthority.steppers.AuthorRegulatoryAuthorities
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
