_package: CTMDM.entities.SiteCapability.action_sets
_type: ActionSet
_name: SiteCapabilityActionSet

entity: CTMDM.entities.SiteCapability.SiteCapability
label: Site Capability Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorSiteCapabilities
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.SiteCapability.steppers.AuthorSiteCapabilities
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorSiteCapabilities
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.SiteCapability.steppers.AuthorSiteCapabilities
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorSiteCapabilities
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.SiteCapability.steppers.AuthorSiteCapabilities
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorSiteCapabilities
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.SiteCapability.steppers.AuthorSiteCapabilities
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
