_package: CTMDM.entities.Vendor.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.Vendor.Vendor
label: Default Rule
description: "Selects surviving CRO / Vendor values using the configured preferred publisher ranking."
documentation: "Selects surviving CRO / Vendor values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: VendorName
  - attributeName: VendorType
  - attributeName: Status
  - attributeName: QualificationStatus
  - attributeName: RiskTier
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ERP
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CRM
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CROSource
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
