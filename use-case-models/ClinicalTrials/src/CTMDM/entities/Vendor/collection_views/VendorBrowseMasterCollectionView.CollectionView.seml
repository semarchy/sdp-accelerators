_package: CTMDM.entities.Vendor.collection_views
_type: CollectionView
_name: VendorBrowseMasterCollectionView

entity: CTMDM.entities.Vendor.Vendor
default: false
displayCard: CTMDM.entities.Vendor.display_cards.VendorDisplayCard
tableDisplayCardColumnWidth: 300

gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1

listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true

tableAllowed: true
tableDisplayCardColumnLabel: CRO / Vendor
tableRowLines: 1
tableShowDisplayCard: true

tableColumns:
  - _type: TextColumn
    _name: ConfirmationStatus
    columnAlign: LEFT
    documentationInterpreter: LITERAL
    useCustomLabel: false
    dataType: STRING
    value: ConfirmationStatus
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: ConfidenceScore
    columnAlign: LEFT
    documentationInterpreter: LITERAL
    useCustomLabel: false
    dataType: LONG_INTEGER
    value: ConfidenceScore
    visibleByDefault: true

    defaultWidth: 180
  - _type: TextColumn
    _name: MastersCount
    columnAlign: LEFT
    documentationInterpreter: LITERAL
    useCustomLabel: false
    dataType: LONG_INTEGER
    value: MastersCount
    visibleByDefault: true

    defaultWidth: 180
  - _type: CheckboxColumn
    _name: HasSuggestedMerge
    columnAlign: LEFT
    documentationInterpreter: LITERAL
    useCustomLabel: false
    dataType: BOOLEAN
    value: HasSuggestedMerge
    visibleByDefault: true

  - _type: IdColumn
    _name: VendorID
    value: VendorID
    useCustomLabel: false
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: true

  - _type: TextColumn
    _name: VendorName
    value: VendorName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: TextColumn
    _name: NormalizedVendorName
    value: NormalizedVendorName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: TextColumn
    _name: PhonetizedVendorName
    value: PhonetizedVendorName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: TextColumn
    _name: VendorType
    value: VendorType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: TaxID
    value: TaxID
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: TextColumn
    _name: NormalizedTaxID
    value: NormalizedTaxID
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: TextColumn
    _name: AddressLine1
    value: AddressLine1
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: TextColumn
    _name: NormalizedAddressLine1
    value: NormalizedAddressLine1
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: TextColumn
    _name: Status
    value: Status
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: QualificationStatus
    value: QualificationStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: RiskTier
    value: RiskTier
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: ReferenceColumn
    _name: FDN_country
    value: FDN_country
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: CTMDM.entities.Country.Country
    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL