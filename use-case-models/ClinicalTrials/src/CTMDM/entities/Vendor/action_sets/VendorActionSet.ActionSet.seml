_package: CTMDM.entities.Vendor.action_sets
_type: ActionSet
_name: VendorActionSet

entity: CTMDM.entities.Vendor.Vendor
label: CRO / Vendor Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorCROsVendors
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.Vendor.steppers.AuthorCROsVendors
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorCROsVendors
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.Vendor.steppers.AuthorCROsVendors
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorCROsVendors
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.Vendor.steppers.AuthorCROsVendors
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorCROsVendors
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.Vendor.steppers.AuthorCROsVendors
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false

  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnVendor
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.Vendor.dups_managers.ReviewSuggestionsOnVendor
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false

  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnVendor
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.Vendor.dups_managers.ReviewSuggestionsOnVendor
    enableEdit: true
    waitDialogEnabled: false

  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnVendor
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: CTMDM.entities.Vendor.dups_managers.ReviewSuggestionsOnVendor
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false

  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    displayCard: CTMDM.entities.Vendor.display_cards.VendorDisplayCard
    formTab: CTMDM.entities.Vendor.forms.VendorForm.General
    waitDialogEnabled: false
