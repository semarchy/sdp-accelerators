_package: CTMDM.entities.Study.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.Study.Study
label: Default Rule
description: "Selects surviving Study values using the configured preferred publisher ranking."
documentation: "Selects surviving Study values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: StudyNumber
  - attributeName: StudyTitle
  - attributeName: Status
  - attributeName: Sponsor
  - attributeName: TargetEnrollment
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RIM
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.EDC
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
