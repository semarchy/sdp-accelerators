_package: CTMDM.entities.Study.validations
_name: StudyDateRangeValid
_type: SemQLValidation
entity: CTMDM.entities.Study.Study
label: Study planned end date must not be before planned start date
validationScope: PRE_CONSO
description: "Study planned end date must not be before planned start date before consolidation."

condition: PlannedEndDate IS NULL OR PlannedStartDate IS NULL OR PlannedEndDate >= PlannedStartDate
