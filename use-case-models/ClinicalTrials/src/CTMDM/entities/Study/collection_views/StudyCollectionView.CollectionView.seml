_package: CTMDM.entities.Study.collection_views
_type: CollectionView
_name: StudyCollectionView

entity: CTMDM.entities.Study.Study
default: true
displayCard: CTMDM.entities.Study.display_cards.StudyDisplayCard
tableDisplayCardColumnWidth: 300

gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1

listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true

tableAllowed: true
tableDisplayCardColumnLabel: Study
tableRowLines: 2
tableShowDisplayCard: true

tableColumns:
  - _type: TextColumn
    _name: StudyNumber
    value: StudyNumber
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 220
  - _type: ReferenceColumn
    _name: FDN_therapeuticArea
    value: FDN_therapeuticArea
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: CTMDM.entities.TherapeuticArea.TherapeuticArea

    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: StudyTitle
    value: StudyTitle
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: TextColumn
    _name: StudyAcronym
    value: StudyAcronym
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 220
  - _type: ReferenceColumn
    _name: FDN_studyPhase
    value: FDN_studyPhase
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: CTMDM.entities.StudyPhase.StudyPhase
    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Status
    value: Status
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: TargetEnrollment
    value: TargetEnrollment
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: DateColumn
    _name: PlannedStartDate
    value: PlannedStartDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: DateColumn
    _name: ActualStartDate
    value: ActualStartDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: DateColumn
    _name: PlannedEndDate
    value: PlannedEndDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: DateColumn
    _name: ActualEndDate
    value: ActualEndDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  - _type: TextColumn
    _name: Sponsor
    value: Sponsor
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: TextColumn
    _name: StudyDesign
    value: StudyDesign
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180