_package: CTMDM.entities.Study.business_views
_type: BusinessView
_name: StudyBusinessView

entity: CTMDM.entities.Study.Study
rootLabel: Study
rootPluralLabel: Studies
rootIconUrl: images://mdi/flask-outline.svg
displayRootNodeAs: ICON_LABEL
label: Studies
        
enableHierarchyView: false
useHierarchyOnOpen: false

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Study
  entity: CTMDM.entities.Study.Study
  actionSet: CTMDM.entities.Study.action_sets.StudyActionSet
  collection: CTMDM.entities.Study.collection_views.StudyCollectionView
  form: CTMDM.entities.Study.forms.StudyForm
  displayCard: CTMDM.entities.Study.display_cards.StudyDisplayCard
  outlineVisible: false
  displayRecordCount: ALWAYS

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: MasterRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: CTMDM.entities.Study.business_views.StudyBusinessView.Study
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true