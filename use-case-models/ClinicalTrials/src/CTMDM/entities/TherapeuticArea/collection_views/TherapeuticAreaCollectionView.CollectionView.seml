_package: CTMDM.entities.TherapeuticArea.collection_views
_type: CollectionView
_name: TherapeuticAreaCollectionView

entity: CTMDM.entities.TherapeuticArea.TherapeuticArea
default: true
displayCard: CTMDM.entities.TherapeuticArea.display_cards.TherapeuticAreaDisplayCard
tableDisplayCardColumnWidth: 300

gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1

listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true

tableAllowed: true
tableDisplayCardColumnLabel: Therapeutic Area
tableRowLines: 2
tableShowDisplayCard: true

tableColumns:
  - _type: TextColumn
    _name: TherapeuticAreaName
    value: TherapeuticAreaName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: TextColumn
    _name: TherapeuticAreaCode
    value: TherapeuticAreaCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: Description
    value: Description
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 300
  - _type: CheckboxColumn
    _name: ActiveFlag
    value: ActiveFlag
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: true