_package: CTMDM.entities.TherapeuticArea.action_sets
_type: ActionSet
_name: TherapeuticAreaActionSet

entity: CTMDM.entities.TherapeuticArea.TherapeuticArea
label: Therapeutic Area Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorTherapeuticAreas
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.TherapeuticArea.steppers.AuthorTherapeuticAreas
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorTherapeuticAreas
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.TherapeuticArea.steppers.AuthorTherapeuticAreas
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorTherapeuticAreas
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.TherapeuticArea.steppers.AuthorTherapeuticAreas
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorTherapeuticAreas
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.TherapeuticArea.steppers.AuthorTherapeuticAreas
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
