_package: CTMDM.entities.TherapeuticArea.business_views
_type: BusinessView
_name: TherapeuticAreaBusinessView

entity: CTMDM.entities.TherapeuticArea.TherapeuticArea
rootLabel: Therapeutic Area
rootPluralLabel: Therapeutic Areas
rootIconUrl: images://mdi/heart-pulse.svg
displayRootNodeAs: ICON_LABEL
label: Therapeutic Areas
        
enableHierarchyView: false
useHierarchyOnOpen: false

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: TherapeuticArea
  entity: CTMDM.entities.TherapeuticArea.TherapeuticArea
  actionSet: CTMDM.entities.TherapeuticArea.action_sets.TherapeuticAreaActionSet
  collection: CTMDM.entities.TherapeuticArea.collection_views.TherapeuticAreaCollectionView
  form: CTMDM.entities.TherapeuticArea.forms.TherapeuticAreaForm
  displayCard: CTMDM.entities.TherapeuticArea.display_cards.TherapeuticAreaDisplayCard
  outlineVisible: false
  displayRecordCount: ALWAYS

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: CTMDM.entities.TherapeuticArea.business_views.TherapeuticAreaBusinessView.TherapeuticArea
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true