_package: CTMDM.entities.HealthcareOrganization.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.HealthcareOrganization.HealthcareOrganization
label: Default Rule
description: "Selects surviving Healthcare Organization values using the configured preferred publisher ranking."
documentation: "Selects surviving Healthcare Organization values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: OrganizationName
  - attributeName: OrganizationType
  - attributeName: Website
  - attributeName: AccreditationStatus
  - attributeName: Status
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RegulatorySystem
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CROSource
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
