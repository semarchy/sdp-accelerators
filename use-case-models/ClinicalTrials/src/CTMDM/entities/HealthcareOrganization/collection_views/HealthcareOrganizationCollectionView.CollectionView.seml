    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: OrganizationType
    value: OrganizationType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: AccreditationStatus
    value: AccreditationStatus
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: Status
    value: Status
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 200
  - _type: TextColumn
    _name: TaxIdentifier
    value: TaxIdentifier
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

    defaultWidth: 180
  - _type: TextColumn
    _name: Website
    value: Website
    useCustomLabel: false
    dataType: STRING
