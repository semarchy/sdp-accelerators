_package: CTMDM.entities.ProtocolAmendment.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.ProtocolAmendment.ProtocolAmendment
label: Default Rule
description: "Selects surviving Protocol Amendment values using the configured preferred publisher ranking."
documentation: "Selects surviving Protocol Amendment values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: AmendmentNumber
  - attributeName: AmendmentType
  - attributeName: ApprovalDate
  - attributeName: Status
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RIM
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.MedicalAffairs
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
