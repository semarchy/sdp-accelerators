_package: CTMDM.entities.ProtocolAmendment.action_sets
_type: ActionSet
_name: ProtocolAmendmentActionSet

entity: CTMDM.entities.ProtocolAmendment.ProtocolAmendment
label: Protocol Amendment Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorProtocolAmendments
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.ProtocolAmendment.steppers.AuthorProtocolAmendments
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorProtocolAmendments
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.ProtocolAmendment.steppers.AuthorProtocolAmendments
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorProtocolAmendments
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.ProtocolAmendment.steppers.AuthorProtocolAmendments
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorProtocolAmendments
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.ProtocolAmendment.steppers.AuthorProtocolAmendments
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
