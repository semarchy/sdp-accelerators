                content:
                  - _type: ReferenceField
                    _name: FDN_country
                    value: FDN_country
                    useCustomLabel: false
                    dataType: STRING
                    referencedEntity: CTMDM.entities.Country.Country

                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '350'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
