_package: CTMDM.entities.Investigator.forms
_type: Form
_name: InvestigatorForm
description: "Defines the form used to view and maintain Investigator records in Clinical Trial MDM workflows."
documentation: "Defines the form used to view and maintain Investigator records in Clinical Trial MDM workflows."

entity: CTMDM.entities.Investigator.Investigator
default: true

formTabs:
  - _type: FormTab
    _name: General
    label: Investigator
    documentation: This form provides a comprehensive view of Investigator details, allowing users to browse and manage records effectively
    documentationInterpreter: LITERAL
    visibleValue: "1"
    iconUrl: images://mdi/account-tie.svg
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: Container1
        layoutDirection: ROW

        content:
          - _type: FormContainer
            _name: Container2
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: GeneralInformation
                label: General Information
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: IdField
                    _name: InvestigatorID
                    value: InvestigatorID
                    useCustomLabel: false
                    dataType: LONG_INTEGER

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FirstName
                    value: FirstName
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: LastName
                    value: LastName
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MiddleName
                    value: MiddleName
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Email
                    value: Email
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Phone
                    value: Phone
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MedicalLicenseNumber
                    value: MedicalLicenseNumber
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
          - _type: FormContainer
            _name: Container3
            layoutDirection: COLUMN

            content:
              - _type: FormSection
                _name: OperationalDetails
                label: Operational Details
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL

                content:
                  - _type: TextField
                    _name: Institution
                    value: Institution
                    useCustomLabel: false
                    dataType: STRING

                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
