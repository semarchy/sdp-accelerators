_package: CTMDM.entities.Investigator.action_sets
_type: ActionSet
_name: InvestigatorReviewSuggestionsActionSet

entity: CTMDM.entities.Investigator.Investigator
label: Investigator Review Suggestions Action Set
defaultActionSet: false

actions:
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnInvestigator
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.Investigator.dups_managers.ReviewSuggestionsOnInvestigator
    enableEdit: true
    waitDialogEnabled: false

  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnInvestigator
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: CTMDM.entities.Investigator.dups_managers.ReviewSuggestionsOnInvestigator
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
