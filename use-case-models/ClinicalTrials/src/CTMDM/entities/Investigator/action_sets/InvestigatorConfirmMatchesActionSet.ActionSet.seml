_package: CTMDM.entities.Investigator.action_sets
_type: ActionSet
_name: InvestigatorConfirmMatchesActionSet

entity: CTMDM.entities.Investigator.Investigator
label: Investigator Confirm Matches Action Set
defaultActionSet: false

actions:
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false

  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnInvestigator
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.Investigator.dups_managers.ConfirmMatchesOnInvestigator
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false

  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnInvestigator
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: CTMDM.entities.Investigator.dups_managers.ConfirmMatchesOnInvestigator
    enableEdit: true
    waitDialogEnabled: false
