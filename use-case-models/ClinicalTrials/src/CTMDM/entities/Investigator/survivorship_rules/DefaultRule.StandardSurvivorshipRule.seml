_package: CTMDM.entities.Investigator.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.Investigator.Investigator
label: Default Rule
description: "Selects surviving Investigator values using the configured preferred publisher ranking."
documentation: "Selects surviving Investigator values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: FirstName
  - attributeName: LastName
  - attributeName: Email
  - attributeName: Phone
  - attributeName: Specialty
  - attributeName: Status
  - attributeName: ORCID
  - attributeName: NPI
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RegulatorySystem
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.MedicalAffairs
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CROSource
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
