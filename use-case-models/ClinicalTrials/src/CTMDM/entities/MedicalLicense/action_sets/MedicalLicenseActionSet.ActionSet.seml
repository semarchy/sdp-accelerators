_package: CTMDM.entities.MedicalLicense.action_sets
_type: ActionSet
_name: MedicalLicenseActionSet

entity: CTMDM.entities.MedicalLicense.MedicalLicense
label: Medical License Action Set
defaultActionSet: true

actions:
  - _type: CreateAction
    _name: CreateAuthorMedicalLicenses
    label: Create
    useCustomLabel: true
    stepper: CTMDM.entities.MedicalLicense.steppers.AuthorMedicalLicenses
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: EditAction
    _name: EditAuthorMedicalLicenses
    label: Edit
    useCustomLabel: true
    stepper: CTMDM.entities.MedicalLicense.steppers.AuthorMedicalLicenses
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorMedicalLicenses
    label: Mass Update
    useCustomLabel: true
    stepper: CTMDM.entities.MedicalLicense.steppers.AuthorMedicalLicenses
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false

  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false

  - _type: ImportAction
    _name: ImportAuthorMedicalLicenses
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: CTMDM.entities.MedicalLicense.steppers.AuthorMedicalLicenses
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true

  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
