_package: CTMDM.entities.Protocol.business_views
_type: BusinessView
_name: ProtocolBusinessView

entity: CTMDM.entities.Protocol.Protocol
rootLabel: Protocol
rootPluralLabel: Protocols
rootIconUrl: images://mdi/file-document-edit-outline.svg
displayRootNodeAs: ICON_LABEL
label: Protocols
        
enableHierarchyView: false
useHierarchyOnOpen: false

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Protocol
  entity: CTMDM.entities.Protocol.Protocol
  actionSet: CTMDM.entities.Protocol.action_sets.ProtocolActionSet
  collection: CTMDM.entities.Protocol.collection_views.ProtocolCollectionView
  form: CTMDM.entities.Protocol.forms.ProtocolForm
  displayCard: CTMDM.entities.Protocol.display_cards.ProtocolDisplayCard
  outlineVisible: false
  displayRecordCount: ALWAYS

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: MasterRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: CTMDM.entities.Protocol.business_views.ProtocolBusinessView.Protocol
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true