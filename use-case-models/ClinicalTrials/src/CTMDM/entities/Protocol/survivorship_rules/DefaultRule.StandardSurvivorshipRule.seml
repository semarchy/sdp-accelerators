_package: CTMDM.entities.Protocol.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: CTMDM.entities.Protocol.Protocol
label: Default Rule
description: "Selects surviving Protocol values using the configured preferred publisher ranking."
documentation: "Selects surviving Protocol values using the configured preferred publisher ranking."
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE

attributes:
  - attributeName: ProtocolNumber
  - attributeName: VersionNumber
  - attributeName: EffectiveDate
  - attributeName: Status
  
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.RIM
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.CTMS
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.EDC
  - _type: ConsoPublisherRanking
    publisher: CTMDM.publishers.ManualEntry
