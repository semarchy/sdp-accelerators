_package: CTMDM.data_product_priv_grants
_name: MedicalAffairs
_type: DataProductPrivGrant
roleName: MedicalAffairs
label: Medical Affairs
description: Medical Affairs access for Clinical Trial MDM entities
entityPrivGrants:
  - _type: EntityPrivGrant
    entity: CTMDM.entities.Investigator.Investigator
    _name: Investigator
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.MedicalLicense.MedicalLicense
    _name: MedicalLicense
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.GcpCertification.GcpCertification
    _name: GcpCertification
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.StudyInvestigator.StudyInvestigator
    _name: StudyInvestigator
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
