_package: CTMDM.data_product_priv_grants
_name: StudyCoordinator
_type: DataProductPrivGrant
roleName: StudyCoordinator
label: Study Coordinator
description: Study Coordinator access for Clinical Trial MDM entities
entityPrivGrants:
  - _type: EntityPrivGrant
    entity: CTMDM.entities.Investigator.Investigator
    _name: Investigator
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.ClinicalSite.ClinicalSite
    _name: ClinicalSite
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.Study.Study
    _name: Study
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.StudySite.StudySite
    _name: StudySite
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.StudyInvestigator.StudyInvestigator
    _name: StudyInvestigator
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
