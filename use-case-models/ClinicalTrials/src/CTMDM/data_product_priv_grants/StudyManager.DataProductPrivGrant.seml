_package: CTMDM.data_product_priv_grants
_name: StudyManager
_type: DataProductPrivGrant
roleName: StudyManager
label: Study Manager
description: Study Manager access for Clinical Trial MDM entities
entityPrivGrants:
  - _type: EntityPrivGrant
    entity: CTMDM.entities.Study.Study
    _name: Study
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.Protocol.Protocol
    _name: Protocol
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.ProtocolAmendment.ProtocolAmendment
    _name: ProtocolAmendment
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.StudySite.StudySite
    _name: StudySite
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.StudyCountry.StudyCountry
    _name: StudyCountry
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: CTMDM.entities.StudyVendor.StudyVendor
    _name: StudyVendor
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: true
    exportAllowed: true
    removeAllowed: true
    defaultAccessType: READ_WRITE
