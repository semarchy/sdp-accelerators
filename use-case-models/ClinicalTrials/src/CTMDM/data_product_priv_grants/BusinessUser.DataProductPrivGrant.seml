    _name: ClinicalSite
    checkoutAllowed: true
    createAllowed: false
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
    defaultAccessType: READ
  - _type: EntityPrivGrant
    entity: CTMDM.entities.Study.Study
    _name: Study
    checkoutAllowed: true
    createAllowed: false
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
    defaultAccessType: READ
  - _type: EntityPrivGrant
    entity: CTMDM.entities.Protocol.Protocol
    _name: Protocol
    checkoutAllowed: true
    createAllowed: false
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
    defaultAccessType: READ
  - _type: EntityPrivGrant
    entity: CTMDM.entities.Vendor.Vendor
    _name: Vendor
    checkoutAllowed: true
    createAllowed: false
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
    defaultAccessType: READ
