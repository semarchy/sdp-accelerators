_package: CTMDM.data_product_priv_grants
_name: BusinessUser
_type: DataProductPrivGrant
roleName: BusinessUser
label: Business User
description: Business User access for Clinical Trial MDM entities
entityPrivGrants:
  - _type: EntityPrivGrant
    entity: CTMDM.entities.Investigator.Investigator
    _name: Investigator
    checkoutAllowed: true
    createAllowed: false
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
    defaultAccessType: READ
