_package: RestaurantMaster.entities.RestaurantIdentifier.forms
_type: Form
_name: RestaurantIdentifierForm
entity: RestaurantMaster.entities.RestaurantIdentifier.RestaurantIdentifier
default: true
formTabs:
- _type: FormTab
  _name: RestaurantIdentifier
  label: Restaurant identifier
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/identifier.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Identifier
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: RestaurantIdentifierID
          value: RestaurantIdentifierID
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: ReferenceField
          _name: FDN_Restaurant
          value: FDN_Restaurant
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.Restaurant.Restaurant
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 66
      - _type: FormContainer
        _name: S1Row2
        layoutDirection: ROW
        content:
        - _type: ReferenceField
          _name: FDN_SourceSystem
          value: FDN_SourceSystem
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.SourceSystem.SourceSystem
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 66
        - _type: ReferenceField
          _name: FDN_IdentifierType
          value: FDN_IdentifierType
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.IdentifierType.IdentifierType
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 33
      - _type: FormContainer
        _name: S1Row3
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: IdentifierValue
          value: IdentifierValue
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: DateField
          _name: ValidFrom
          value: ValidFrom
          useCustomLabel: false
          dataType: DATE
          relativeWidth: 33
        - _type: DateField
          _name: ValidTo
          value: ValidTo
          useCustomLabel: false
          dataType: DATE
          relativeWidth: 33
