_package: RestaurantMaster.entities.RestaurantIdentifier.enrichers
_name: BuildNaturalKey
_type: SemQLEnricher
entity: RestaurantMaster.entities.RestaurantIdentifier.RestaurantIdentifier
label: Build the natural key
description: Builds the key that allows only one row per system, identifier type, value and start date.
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
- attributeName: NaturalKey
  expression: FID_SourceSystem || '|' || FID_IdentifierType || '|' || IdentifierValue || '|' || TO_CHAR(ValidFrom, 'YYYY-MM-DD')
