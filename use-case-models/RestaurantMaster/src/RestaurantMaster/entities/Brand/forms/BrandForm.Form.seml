_package: RestaurantMaster.entities.Brand.forms
_type: Form
_name: BrandForm
entity: RestaurantMaster.entities.Brand.Brand
default: true
formTabs:
- _type: FormTab
  _name: Brand
  label: Brand
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/tag-heart-outline.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Brand
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: BrandCode
          value: BrandCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: BrandName
          value: BrandName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
