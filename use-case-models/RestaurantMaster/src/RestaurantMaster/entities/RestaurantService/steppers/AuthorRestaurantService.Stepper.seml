_package: RestaurantMaster.entities.RestaurantService.steppers
_type: Stepper
_name: AuthorRestaurantService
entity: RestaurantMaster.entities.RestaurantService.RestaurantService
label: Services
rootStep:
  _type: CollectionStep
  _name: RestaurantServiceCollection
  label: Services
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: RestaurantMaster.entities.RestaurantService.collection_views.RestaurantServiceCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
  - _type: FormStep
    _name: RestaurantService
    label: Service
    canFinishSubLevel: true
    enabledOnParentCreate: true
    enabledOnParentEdit: true
    formFieldsMode: AUTO
    enableMasterValuePicking: false
    formTab: RestaurantMaster.entities.RestaurantService.forms.RestaurantServiceForm.RestaurantService
    formStepValidations:
    - validationType: CHECK
      validator: RestaurantMaster.entities.RestaurantService.validations.KeyConvention
      executedOnDataChange: true
      executedOnFormOpen: true
    - validationType: CHECK
      validator: RestaurantMaster.entities.RestaurantService.validations.DeliveryPartnerRule
      executedOnDataChange: true
      executedOnFormOpen: true
