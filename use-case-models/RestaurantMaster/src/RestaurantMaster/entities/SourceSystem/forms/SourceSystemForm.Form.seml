_package: RestaurantMaster.entities.SourceSystem.forms
_type: Form
_name: SourceSystemForm
entity: RestaurantMaster.entities.SourceSystem.SourceSystem
default: true
formTabs:
- _type: FormTab
  _name: SourceSystem
  label: Source system
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/server-network.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: System
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: SourceSystemCode
          value: SourceSystemCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: SourceSystemName
          value: SourceSystemName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: SystemRole
          value: SystemRole
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
