_package: RestaurantMaster.entities.BuildingType.forms
_type: Form
_name: BuildingTypeForm
entity: RestaurantMaster.entities.BuildingType.BuildingType
default: true
formTabs:
- _type: FormTab
  _name: BuildingType
  label: Building type
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/office-building-outline.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Building type
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: BuildingTypeCode
          value: BuildingTypeCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: BuildingTypeName
          value: BuildingTypeName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
