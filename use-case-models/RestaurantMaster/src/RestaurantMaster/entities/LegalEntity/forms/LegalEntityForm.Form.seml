_package: RestaurantMaster.entities.LegalEntity.forms
_type: Form
_name: LegalEntityForm
entity: RestaurantMaster.entities.LegalEntity.LegalEntity
default: true
formTabs:
- _type: FormTab
  _name: LegalEntity
  label: Legal entity
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/domain.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Identity
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: LegalEntityKey
          value: LegalEntityKey
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: LegalName
          value: LegalName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: DoingBusinessAs
          value: DoingBusinessAs
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
      - _type: FormContainer
        _name: S1Row2
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: LegalEntityType
          value: LegalEntityType
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: LegalEntityStatus
          value: LegalEntityStatus
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: ReferenceField
          _name: FDN_Country
          value: FDN_Country
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.Country.Country
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 33
      - _type: FormContainer
        _name: S1Row3
        layoutDirection: ROW
        content:
        - _type: ReferenceField
          _name: FDN_Franchisee
          value: FDN_Franchisee
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.Franchisee.Franchisee
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 66
    - _type: FormSection
      _name: Sec2
      label: Billing
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S2Row1
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: BillingAccountNumber
          value: BillingAccountNumber
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: BillingAddressLine1
          value: BillingAddressLine1
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: BillingAddressLine2
          value: BillingAddressLine2
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
      - _type: FormContainer
        _name: S2Row2
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: BillingCity
          value: BillingCity
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: BillingPostalCode
          value: BillingPostalCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: ReferenceField
          _name: FDN_BillingState
          value: FDN_BillingState
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.StateProvince.StateProvince
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 33
