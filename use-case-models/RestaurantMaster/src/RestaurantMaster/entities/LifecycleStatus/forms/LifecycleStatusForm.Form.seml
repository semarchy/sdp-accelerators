_package: RestaurantMaster.entities.LifecycleStatus.forms
_type: Form
_name: LifecycleStatusForm
entity: RestaurantMaster.entities.LifecycleStatus.LifecycleStatus
default: true
formTabs:
- _type: FormTab
  _name: LifecycleStatus
  label: Lifecycle status
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/progress-check.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Status
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: StatusCode
          value: StatusCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: StatusName
          value: StatusName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: PublicChannelStatus
          value: PublicChannelStatus
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
      - _type: FormContainer
        _name: S1Row2
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: Sequence
          value: Sequence
          useCustomLabel: false
          dataType: INTEGER
          relativeWidth: 33
