  label: Localized name
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/translate.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Name
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: RestaurantLocalizedNameID
          value: RestaurantLocalizedNameID
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: ReferenceField
          _name: FDN_Restaurant
          value: FDN_Restaurant
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.Restaurant.Restaurant
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 66
      - _type: FormContainer
        _name: S1Row2
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: Language
          value: Language
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: LocalizedName
          value: LocalizedName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
