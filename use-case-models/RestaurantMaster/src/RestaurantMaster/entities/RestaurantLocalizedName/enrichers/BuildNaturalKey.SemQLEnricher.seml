_package: RestaurantMaster.entities.RestaurantLocalizedName.enrichers
_name: BuildNaturalKey
_type: SemQLEnricher
entity: RestaurantMaster.entities.RestaurantLocalizedName.RestaurantLocalizedName
label: Build the natural key
description: Builds the key that allows only one row per restaurant and language.
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
- attributeName: NaturalKey
  expression: FID_Restaurant || '|' || Language
