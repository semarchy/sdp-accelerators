_package: RestaurantMaster.entities.RestaurantOrgAssignment.forms
_type: Form
_name: RestaurantOrgAssignmentForm
entity: RestaurantMaster.entities.RestaurantOrgAssignment.RestaurantOrgAssignment
default: true
formTabs:
- _type: FormTab
  _name: RestaurantOrgAssignment
  label: Organization assignment
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/file-tree-outline.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Assignment
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: RestaurantOrgAssignmentID
          value: RestaurantOrgAssignmentID
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: ReferenceField
          _name: FDN_Restaurant
          value: FDN_Restaurant
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.Restaurant.Restaurant
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 66
      - _type: FormContainer
        _name: S1Row2
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: HierarchyType
          value: HierarchyType
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: ReferenceField
          _name: FDN_OrganizationUnit
          value: FDN_OrganizationUnit
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.OrganizationUnit.OrganizationUnit
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 66
      - _type: FormContainer
        _name: S1Row3
        layoutDirection: ROW
        content:
        - _type: DateField
          _name: EffectiveFrom
          value: EffectiveFrom
          useCustomLabel: false
          dataType: DATE
          relativeWidth: 33
