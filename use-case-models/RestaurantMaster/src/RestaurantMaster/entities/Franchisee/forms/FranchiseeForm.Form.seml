_package: RestaurantMaster.entities.Franchisee.forms
_type: Form
_name: FranchiseeForm
entity: RestaurantMaster.entities.Franchisee.Franchisee
default: true
formTabs:
- _type: FormTab
  _name: Franchisee
  label: Franchisee
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/account-group.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Identity
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: FranchiseeNumber
          value: FranchiseeNumber
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: FranchiseeName
          value: FranchiseeName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: FranchiseeStatus
          value: FranchiseeStatus
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
    - _type: FormSection
      _name: Sec2
      label: Principal
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S2Row1
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: PrincipalName
          value: PrincipalName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: PrincipalEmail
          value: PrincipalEmail
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
