_package: RestaurantMaster.entities.Franchisee.validations
_name: PrincipalEmailFormat
_type: SemQLValidation
entity: RestaurantMaster.entities.Franchisee.Franchisee
label: Principal email format
description: The principal email must look like name@domain.tld.
validationScope: PRE_CONSO
validationLabel: The principal email must look like name@domain.tld.
condition: PrincipalEmail IS NULL OR PrincipalEmail LIKE '%_@_%._%'
