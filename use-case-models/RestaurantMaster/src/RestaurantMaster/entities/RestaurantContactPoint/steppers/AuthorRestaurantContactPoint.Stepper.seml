_package: RestaurantMaster.entities.RestaurantContactPoint.steppers
_type: Stepper
_name: AuthorRestaurantContactPoint
entity: RestaurantMaster.entities.RestaurantContactPoint.RestaurantContactPoint
label: Contact points
rootStep:
  _type: CollectionStep
  _name: RestaurantContactPointCollection
  label: Contact points
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: RestaurantMaster.entities.RestaurantContactPoint.collection_views.RestaurantContactPointCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
  - _type: FormStep
    _name: RestaurantContactPoint
    label: Contact point
    canFinishSubLevel: true
    enabledOnParentCreate: true
    enabledOnParentEdit: true
    formFieldsMode: AUTO
    enableMasterValuePicking: false
    formTab: RestaurantMaster.entities.RestaurantContactPoint.forms.RestaurantContactPointForm.RestaurantContactPoint
    formStepEnrichers:
    - enricher: RestaurantMaster.entities.RestaurantContactPoint.enrichers.NormalizePhone
      executedOnDataChange: true
    formStepValidations:
    - validationType: CHECK
      validator: RestaurantMaster.entities.RestaurantContactPoint.validations.KeyConvention
      executedOnDataChange: true
      executedOnFormOpen: true
    - validationType: CHECK
      validator: RestaurantMaster.entities.RestaurantContactPoint.validations.ContactFormat
      executedOnDataChange: true
      executedOnFormOpen: true
