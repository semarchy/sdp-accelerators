_package: RestaurantMaster.entities.Country.forms
_type: Form
_name: CountryForm
entity: RestaurantMaster.entities.Country.Country
default: true
formTabs:
- _type: FormTab
  _name: Country
  label: Country
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/earth.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Country
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: CountryCode
          value: CountryCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: CountryName
          value: CountryName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
