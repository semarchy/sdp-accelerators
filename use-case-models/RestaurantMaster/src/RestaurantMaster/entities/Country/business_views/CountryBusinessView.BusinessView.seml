_package: RestaurantMaster.entities.Country.business_views
_type: BusinessView
_name: CountryBusinessView
entity: RestaurantMaster.entities.Country.Country
rootLabel: Countries
rootPluralLabel: Countries
displayRootNodeAs: ICON_LABEL
label: Country
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Country
  entity: RestaurantMaster.entities.Country.Country
  actionSet: RestaurantMaster.entities.Country.action_sets.CountryActionSet
  collection: RestaurantMaster.entities.Country.collection_views.CountryCollectionView
  form: RestaurantMaster.entities.Country.forms.CountryForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  displayCard: RestaurantMaster.entities.Country.display_cards.CountryDisplayCard
  businessEntitySearchConfigs:
  - _name: TextConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: TEXT
  - _name: FormConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: BY_FORM
  - _name: AdvancedConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: ADVANCED
  - _name: SemqlConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true
  transitions:
  - _type: BusinessViewTransition
    _name: StatesTab
    label: States and provinces
    useCustomLabel: true
    transitionPath: StatesProvinces
    transitionType: FULLY_QUALIFIED
    businessViewEntity:
      _type: BusinessViewEntity
      _name: StatesTabEnt
      entity: RestaurantMaster.entities.StateProvince.StateProvince
      actionSet: RestaurantMaster.entities.StateProvince.action_sets.StateProvinceActionSet
      collection: RestaurantMaster.entities.StateProvince.collection_views.StateProvinceCollectionView
      form: RestaurantMaster.entities.StateProvince.forms.StateProvinceForm
      displayCard: RestaurantMaster.entities.StateProvince.display_cards.StateProvinceDisplayCard
      outlineVisible: false
      displayRecordCount: ALWAYS
      businessEntitySearchConfigs:
      - _name: TextConfig
        _type: BusinessEntitySearchTypeConfig
        searchType: TEXT
      overrideDefaultSort: false
      enableUserDefinedSort: true
      listAllowed: true
      tableAllowed: true
      gridAllowed: false
    pluralLabel: States and provinces
    displayFormTabAs: ICON_LABEL
    displayTransitionNodeAs: ICON_LABEL
    iconUrl: images://mdi/map-outline.svg
    visibleInFormTabCondition: any StatesProvinces has (1=1)
enableHierarchyView: false
useHierarchyOnOpen: false
