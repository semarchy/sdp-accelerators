_package: RestaurantMaster.entities.RestaurantOperator.enrichers
_name: BuildNaturalKey
_type: SemQLEnricher
entity: RestaurantMaster.entities.RestaurantOperator.RestaurantOperator
label: Build the natural key
description: Builds the key that allows only one row per restaurant and start date.
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
- attributeName: NaturalKey
  expression: FID_Restaurant || '|' || TO_CHAR(EffectiveFrom, 'YYYY-MM-DD')
