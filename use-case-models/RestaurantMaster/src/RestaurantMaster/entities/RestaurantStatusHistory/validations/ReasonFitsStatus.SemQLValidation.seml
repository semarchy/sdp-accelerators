_package: RestaurantMaster.entities.RestaurantStatusHistory.validations
_name: ReasonFitsStatus
_type: SemQLValidation
entity: RestaurantMaster.entities.RestaurantStatusHistory.RestaurantStatusHistory
label: Reason belongs to the status
description: The reason must belong to the selected status.
validationScope: PRE_CONSO
validationLabel: The reason must belong to the selected status.
condition: FID_LifecycleStatusReason IS NULL OR LifecycleStatusReason.FID_LifecycleStatus = FID_LifecycleStatus
