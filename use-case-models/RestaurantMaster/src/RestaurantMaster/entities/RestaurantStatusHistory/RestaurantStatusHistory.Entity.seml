_package: RestaurantMaster.entities.RestaurantStatusHistory
_type: Entity
_name: RestaurantStatusHistory
label: Status history
pluralLabel: Status history
entityType: BASIC
physicalTableName: REST_STATUS_HISTORY
iconUrl: images://mdi/timeline-clock-outline.svg
description: Lifecycle statuses of a restaurant over time, with reason and comment; a planned change is a row dated in the future.
documentation: Lifecycle statuses of a restaurant over time, with reason and comment; a planned change is a row dated in the future.
historizeGolden: false
historizeMaster: false
enableDelete: true
attributes:
- _type: EntityAttribute
  _name: RestaurantStatusHistoryID
  label: Key
  physicalName: REST_STATUS_HISTORY_ID
  dataType: String
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  searchable: true
  description: 'Key of the row, sent by the publishing system or typed by the steward: the restaurant ID, a dash, then the row''s own business key in its source (for example R0000123-POS-4471).'
  documentation: 'Key of the row, sent by the publishing system or typed by the steward: the restaurant ID, a dash, then the row''s own business key in its source (for example R0000123-POS-4471).'
  length: 100
- _type: EntityAttribute
  _name: StartDate
  label: Start date
  physicalName: STARTDATE
  dataType: Date
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  searchable: true
  description: Day the status starts; it ends the day the next status of the restaurant starts.
  documentation: Day the status starts; it ends the day the next status of the restaurant starts.
- _type: EntityAttribute
  _name: StatusComment
  label: Comment
  physicalName: STATUSCOMMENT
  dataType: String
  length: 1000
  mandatory: false
  searchable: true
  description: Why the status changed.
  documentation: Why the status changed.
- _type: EntityAttribute
  _name: NaturalKey
  label: Natural key
  physicalName: NATURALKEY
  dataType: String
  length: 300
  mandatory: false
  searchable: false
  description: Business key of the row, built from its restaurant and its distinguishing fields; enforces uniqueness.
  documentation: Business key of the row, built from its restaurant and its distinguishing fields; enforces uniqueness.
primaryKey: RestaurantMaster.entities.RestaurantStatusHistory.RestaurantStatusHistory.RestaurantStatusHistoryID
sourceIdGeneration:
  mode: MANUAL
