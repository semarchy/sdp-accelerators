_package: RestaurantMaster.entities.StateProvince.forms
_type: Form
_name: StateProvinceForm
entity: RestaurantMaster.entities.StateProvince.StateProvince
default: true
formTabs:
- _type: FormTab
  _name: StateProvince
  label: State or province
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/map-outline.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: State or province
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: StateCode
          value: StateCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: StateName
          value: StateName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: ReferenceField
          _name: FDN_Country
          value: FDN_Country
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.Country.Country
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 33
      - _type: FormContainer
        _name: S1Row2
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: DefaultTimeZone
          value: DefaultTimeZone
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
