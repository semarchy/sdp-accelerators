_package: RestaurantMaster.entities.LocationType.forms
_type: Form
_name: LocationTypeForm
entity: RestaurantMaster.entities.LocationType.LocationType
default: true
formTabs:
- _type: FormTab
  _name: LocationType
  label: Location type
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/map-marker-radius-outline.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Location type
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: LocationTypeCode
          value: LocationTypeCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: LocationTypeName
          value: LocationTypeName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
