_name: UkDuplicateAddress
_type: UniqueKey
entity: RestaurantMaster.entities.Restaurant.Restaurant
label: One restaurant per brand and address
validationLabel: Another restaurant of the same brand exists at this address - possibly a mistyped restaurant ID.
validationScope: POST_CONSO
keyAttributes:
