_package: RestaurantMaster.entities.Restaurant.business_views
_type: BusinessView
_name: RestaurantBusinessView
entity: RestaurantMaster.entities.Restaurant.Restaurant
rootLabel: Restaurants
rootPluralLabel: Restaurants
displayRootNodeAs: ICON_LABEL
label: Restaurant
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Restaurant
  entity: RestaurantMaster.entities.Restaurant.Restaurant
  actionSet: RestaurantMaster.entities.Restaurant.action_sets.RestaurantActionSet
  collection: RestaurantMaster.entities.Restaurant.collection_views.RestaurantCollectionView
  form: RestaurantMaster.entities.Restaurant.forms.RestaurantForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  displayCard: RestaurantMaster.entities.Restaurant.display_cards.RestaurantDisplayCard
  businessEntitySearchConfigs:
  - _name: TextConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: TEXT
  - _name: FormConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: BY_FORM
  - _name: AdvancedConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: ADVANCED
  - _name: SemqlConfig
    _type: BusinessEntitySearchTypeConfig
    searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true
  businessEntityBuiltInFilters:
  - _type: BusinessEntityBuiltInFilter
    _name: FilterOpen
    label: Open
    semQlCondition: FID_LifecycleStatus = 'OPEN'
    visible: true
  - _type: BusinessEntityBuiltInFilter
    _name: FilterTempClosed
    label: Temporarily closed
    semQlCondition: FID_LifecycleStatus = 'TEMP_CLOSED'
    visible: true
  - _type: BusinessEntityBuiltInFilter
    _name: FilterPipeline
    label: Pipeline
    semQlCondition: FID_LifecycleStatus IN ('PIPELINE', 'APPROVED', 'UNDER_CONSTRUCTION')
    visible: true
  - _type: BusinessEntityBuiltInFilter
    _name: FilterClosed
    label: Closed
    semQlCondition: FID_LifecycleStatus IN ('PERM_CLOSED', 'RELOCATED', 'CANCELLED')
    visible: true
  - _type: BusinessEntityBuiltInFilter
    _name: AwaitingOnboarding
    label: Awaiting onboarding
    semQlCondition: FID_Brand IS NULL
    visible: true
  - _type: BusinessEntityBuiltInFilter
    _name: ListingIncomplete
    label: Listed but incomplete
    semQlCondition: PublicChannelStatus IN ('LISTED_OPEN', 'LISTED_TEMP_CLOSED') AND (RestaurantName IS NULL OR AddressLine1 IS NULL OR City IS NULL OR PostalCode IS NULL OR Latitude IS NULL OR MainPhone IS NULL)
    visible: true
  - _type: BusinessEntityBuiltInFilter
    _name: AddressInconsistent
    label: Address to check
    semQlCondition: (FID_StateProvince IS NOT NULL AND FID_Country IS NOT NULL AND StateProvince.FID_Country <> FID_Country) OR (Latitude IS NOT NULL AND (Latitude < 18 OR Latitude > 72)) OR (Longitude IS NOT NULL AND (Longitude < -170 OR Longitude > -52))
    visible: true
  - _type: BusinessEntityBuiltInFilter
    _name: UnknownToSystems
    label: Open but unknown to ERP or POS
    semQlCondition: FID_LifecycleStatus = 'OPEN' AND (COALESCE(InERP, 'N') = 'N' OR COALESCE(InPOS, 'N') = 'N')
    visible: true
  - _type: BusinessEntityBuiltInFilter
    _name: MissingOperatorOrStatus
    label: Missing operator or status history
    semQlCondition: FID_LifecycleStatus IS NOT NULL AND FID_LifecycleStatus NOT IN ('PIPELINE', 'CANCELLED') AND (NOT (any Operators have (EffectiveFrom <= CURRENT_DATE())) OR NOT (any StatusHistory have (StartDate <= CURRENT_DATE())))
    visible: true
  transitions:
  - _type: BusinessViewTransition
    _name: HoursTab
    label: Opening hours
    useCustomLabel: true
    transitionPath: Hours
    transitionType: FULLY_QUALIFIED
    businessViewEntity:
      _type: BusinessViewEntity
      _name: HoursTabEnt
      entity: RestaurantMaster.entities.RestaurantHours.RestaurantHours
      actionSet: RestaurantMaster.entities.RestaurantHours.action_sets.RestaurantHoursActionSet
      collection: RestaurantMaster.entities.RestaurantHours.collection_views.RestaurantHoursCollectionView
      form: RestaurantMaster.entities.RestaurantHours.forms.RestaurantHoursForm
      displayCard: RestaurantMaster.entities.RestaurantHours.display_cards.RestaurantHoursDisplayCard
      outlineVisible: false
      displayRecordCount: ALWAYS
      businessEntitySearchConfigs:
      - _name: TextConfig
        _type: BusinessEntitySearchTypeConfig
        searchType: TEXT
      overrideDefaultSort: false
      enableUserDefinedSort: true
      listAllowed: true
      tableAllowed: true
      gridAllowed: false
    pluralLabel: Opening hours
    displayFormTabAs: ICON_LABEL
    displayTransitionNodeAs: ICON_LABEL
    iconUrl: images://mdi/clock-outline.svg
    visibleInFormTabCondition: any Hours has (1=1)
  - _type: BusinessViewTransition
    _name: ServicesTab
    label: Services
    useCustomLabel: true
    transitionPath: Services
    transitionType: FULLY_QUALIFIED
    businessViewEntity:
      _type: BusinessViewEntity
      _name: ServicesTabEnt
      entity: RestaurantMaster.entities.RestaurantService.RestaurantService
      actionSet: RestaurantMaster.entities.RestaurantService.action_sets.RestaurantServiceActionSet
      collection: RestaurantMaster.entities.RestaurantService.collection_views.RestaurantServiceCollectionView
      form: RestaurantMaster.entities.RestaurantService.forms.RestaurantServiceForm
      displayCard: RestaurantMaster.entities.RestaurantService.display_cards.RestaurantServiceDisplayCard
      outlineVisible: false
      displayRecordCount: ALWAYS
      businessEntitySearchConfigs:
      - _name: TextConfig
        _type: BusinessEntitySearchTypeConfig
        searchType: TEXT
      overrideDefaultSort: false
      enableUserDefinedSort: true
      listAllowed: true
      tableAllowed: true
      gridAllowed: false
    pluralLabel: Services
    displayFormTabAs: ICON_LABEL
    displayTransitionNodeAs: ICON_LABEL
    iconUrl: images://mdi/room-service-outline.svg
    visibleInFormTabCondition: any Services has (1=1)
  - _type: BusinessViewTransition
    _name: ContactPointsTab
    label: Contact points
    useCustomLabel: true
    transitionPath: ContactPoints
    transitionType: FULLY_QUALIFIED
    businessViewEntity:
      _type: BusinessViewEntity
