      form: RestaurantMaster.entities.RestaurantContactPoint.forms.RestaurantContactPointForm
      displayCard: RestaurantMaster.entities.RestaurantContactPoint.display_cards.RestaurantContactPointDisplayCard
      outlineVisible: false
      displayRecordCount: ALWAYS
      businessEntitySearchConfigs:
      - _name: TextConfig
        _type: BusinessEntitySearchTypeConfig
        searchType: TEXT
      overrideDefaultSort: false
      enableUserDefinedSort: true
      listAllowed: true
      tableAllowed: true
      gridAllowed: false
    pluralLabel: Contact points
    displayFormTabAs: ICON_LABEL
    displayTransitionNodeAs: ICON_LABEL
    iconUrl: images://mdi/card-account-phone.svg
    visibleInFormTabCondition: any ContactPoints has (1=1)
  - _type: BusinessViewTransition
    _name: LocalizedNamesTab
    label: Localized names
    useCustomLabel: true
    transitionPath: LocalizedNames
    transitionType: FULLY_QUALIFIED
    businessViewEntity:
      _type: BusinessViewEntity
      _name: LocalizedNamesTabEnt
      entity: RestaurantMaster.entities.RestaurantLocalizedName.RestaurantLocalizedName
      actionSet: RestaurantMaster.entities.RestaurantLocalizedName.action_sets.RestaurantLocalizedNameActionSet
      collection: RestaurantMaster.entities.RestaurantLocalizedName.collection_views.RestaurantLocalizedNameCollectionView
      form: RestaurantMaster.entities.RestaurantLocalizedName.forms.RestaurantLocalizedNameForm
      displayCard: RestaurantMaster.entities.RestaurantLocalizedName.display_cards.RestaurantLocalizedNameDisplayCard
      outlineVisible: false
      displayRecordCount: ALWAYS
      businessEntitySearchConfigs:
      - _name: TextConfig
        _type: BusinessEntitySearchTypeConfig
        searchType: TEXT
      overrideDefaultSort: false
      enableUserDefinedSort: true
      listAllowed: true
      tableAllowed: true
      gridAllowed: false
    pluralLabel: Localized names
    displayFormTabAs: ICON_LABEL
    displayTransitionNodeAs: ICON_LABEL
    iconUrl: images://mdi/translate.svg
    visibleInFormTabCondition: any LocalizedNames has (1=1)
