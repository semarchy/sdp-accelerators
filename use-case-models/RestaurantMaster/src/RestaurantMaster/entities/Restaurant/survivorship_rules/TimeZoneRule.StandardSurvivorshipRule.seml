_package: RestaurantMaster.entities.Restaurant.survivorship_rules
_type: StandardSurvivorshipRule
_name: TimeZoneRule
entity: RestaurantMaster.entities.Restaurant.Restaurant
label: TimeZone (from the hub)
description: 'Owned by the hub: the value it sends is kept even when other systems send nothing.'
documentation: 'Owned by the hub: the value it sends is kept even when other systems send nothing.'
defaultRule: false
consolidationStrategy: LONGEST_VALUE
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
- attributeName: TimeZone
