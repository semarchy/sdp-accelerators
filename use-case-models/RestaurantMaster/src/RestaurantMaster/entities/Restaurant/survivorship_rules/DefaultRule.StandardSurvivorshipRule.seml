_package: RestaurantMaster.entities.Restaurant.survivorship_rules
_type: StandardSurvivorshipRule
_name: DefaultRule
entity: RestaurantMaster.entities.Restaurant.Restaurant
label: Site data (Real Estate first)
description: 'Site and real-estate attributes: Real Estate first, then ERP, the hub and the POS systems. A steward''s correction is kept until Real Estate sends a different value.'
documentation: 'Site and real-estate attributes: Real Estate first, then ERP, the hub and the POS systems. A steward''s correction is kept until Real Estate sends a different value.'
defaultRule: true
consolidationStrategy: PREFERRED_PUBLISHER
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
- attributeName: SiteID
- attributeName: LeaseSignedDate
- attributeName: LeaseExpirationDate
- attributeName: ConstructionStartDate
- attributeName: PlannedOpenDate
- attributeName: OriginalOpenDate
- attributeName: AddressLine1
- attributeName: AddressLine2
- attributeName: City
- attributeName: PostalCode
- attributeName: County
- attributeName: Latitude
- attributeName: Longitude
- attributeName: CoordinateSource
- attributeName: SquareFootage
- attributeName: ProjectNumber
publisherRankings:
- _type: ConsoPublisherRanking
  publisher: RestaurantMaster.publishers.RE
- _type: ConsoPublisherRanking
  publisher: RestaurantMaster.publishers.ERP
- _type: ConsoPublisherRanking
  publisher: RestaurantMaster.publishers.HUB
- _type: ConsoPublisherRanking
  publisher: RestaurantMaster.publishers.POSF
- _type: ConsoPublisherRanking
  publisher: RestaurantMaster.publishers.POSK
- _type: ConsoPublisherRanking
  publisher: RestaurantMaster.publishers.POSB
