_package: RestaurantMaster.entities.Restaurant.survivorship_rules
_type: StandardSurvivorshipRule
_name: CostCenterCodeRule
entity: RestaurantMaster.entities.Restaurant.Restaurant
label: CostCenterCode (from the ERP)
description: 'Owned by the ERP: the value it sends is kept even when other systems send nothing.'
documentation: 'Owned by the ERP: the value it sends is kept even when other systems send nothing.'
defaultRule: false
consolidationStrategy: LONGEST_VALUE
consolidationSkipNulls: false
overrideStrategy: UNTIL_CONSOLIDATED_VAL_CHANGE
attributes:
- attributeName: CostCenterCode
