_package: RestaurantMaster.entities.Restaurant.enrichers
_name: StampProvenance
_type: SemQLEnricher
entity: RestaurantMaster.entities.Restaurant.Restaurant
label: Record which systems publish the restaurant
description: Marks each source record with the system it comes from; consolidation keeps Yes as soon as one record of that system exists.
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
- attributeName: InRealEstate
  expression: CASE WHEN PublisherID = 'RE' THEN 'Y' ELSE 'N' END
- attributeName: InERP
  expression: CASE WHEN PublisherID = 'ERP' THEN 'Y' ELSE 'N' END
- attributeName: InPOS
  expression: CASE WHEN PublisherID IN ('POSF', 'POSK', 'POSB') THEN 'Y' ELSE 'N' END
