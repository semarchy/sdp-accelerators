_package: RestaurantMaster.entities.ServiceType.forms
_type: Form
_name: ServiceTypeForm
entity: RestaurantMaster.entities.ServiceType.ServiceType
default: true
formTabs:
- _type: FormTab
  _name: ServiceType
  label: Service type
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/silverware-fork-knife.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Service type
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: ServiceTypeCode
          value: ServiceTypeCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: ServiceTypeName
          value: ServiceTypeName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
