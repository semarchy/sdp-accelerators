_package: RestaurantMaster.entities.RestaurantHours.forms
_type: Form
_name: RestaurantHoursForm
entity: RestaurantMaster.entities.RestaurantHours.RestaurantHours
default: true
formTabs:
- _type: FormTab
  _name: RestaurantHours
  label: Opening hours
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/clock-outline.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Slot
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: RestaurantHoursID
          value: RestaurantHoursID
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: ReferenceField
          _name: FDN_Restaurant
          value: FDN_Restaurant
          useCustomLabel: false
          dataType: STRING
          referencedEntity: RestaurantMaster.entities.Restaurant.Restaurant
          componentProperties:
            displayType: chip
            displayTypeValueInterpreter: LITERAL
            useAvatarInChip: '1'
            useAvatarInChipValueInterpreter: LITERAL
            chipMaxWidth: '600'
            chipMaxWidthValueInterpreter: LITERAL
          relativeWidth: 66
      - _type: FormContainer
        _name: S1Row2
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: ServiceChannel
          value: ServiceChannel
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: HoursType
          value: HoursType
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: Occasion
          value: Occasion
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
      - _type: FormContainer
        _name: S1Row3
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: DayOfWeek
          value: DayOfWeek
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: DateField
          _name: SpecialDate
          value: SpecialDate
          useCustomLabel: false
          dataType: DATE
          relativeWidth: 33
    - _type: FormSection
      _name: Sec2
      label: Times
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S2Row1
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: OpenTime
          value: OpenTime
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: CloseTime
          value: CloseTime
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: ClosesNextDay
          value: ClosesNextDay
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
      - _type: FormContainer
        _name: S2Row2
        layoutDirection: ROW
        content:
        - _type: TextField
          _name: Closed
          value: Closed
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: Open24Hours
          value: Open24Hours
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
    - _type: FormSection
      _name: Sec3
      label: Validity
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S3Row1
        layoutDirection: ROW
        content:
        - _type: DateField
          _name: EffectiveFrom
          value: EffectiveFrom
          useCustomLabel: false
          dataType: DATE
          relativeWidth: 33
        - _type: DateField
          _name: EffectiveTo
          value: EffectiveTo
          useCustomLabel: false
          dataType: DATE
          relativeWidth: 33
