label: Status reason
pluralLabel: Status reasons
entityType: BASIC
physicalTableName: REF_STATUS_REASON
iconUrl: images://mdi/comment-question-outline.svg
description: Reasons for a lifecycle status (remodel, weather, lease expiry...), each belonging to one status.
documentation: Reasons for a lifecycle status (remodel, weather, lease expiry...), each belonging to one status.
historizeGolden: false
historizeMaster: false
enableDelete: true
attributes:
