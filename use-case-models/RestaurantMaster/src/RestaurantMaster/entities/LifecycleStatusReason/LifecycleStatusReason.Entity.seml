  _name: ReasonCode
  label: Reason code
  physicalName: REASONCODE
  dataType: String
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  searchable: true
  description: Code of the reason, unique across statuses.
  documentation: Code of the reason, unique across statuses.
  length: 64
- _type: EntityAttribute
  _name: ReasonName
  label: Reason name
  physicalName: REASONNAME
  dataType: String
  length: 256
  mandatory: true
  mandatoryValidationScope: PRE_CONSO
  searchable: true
  description: Name of the reason.
  documentation: Name of the reason.
primaryKey: RestaurantMaster.entities.LifecycleStatusReason.LifecycleStatusReason.ReasonCode
sourceIdGeneration:
  mode: MANUAL
