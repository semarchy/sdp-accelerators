  label: Status reason
  documentationInterpreter: LITERAL
  visibleValue: '1'
  visibleValueInterpreter: LITERAL
  displayFormTabAs: ICON_LABEL
  iconUrl: images://mdi/comment-question-outline.svg
  labelWidth: '150'
  content:
  - _type: FormContainer
    _name: Main
    layoutDirection: COLUMN
    content:
    - _type: FormSection
      _name: Sec1
      label: Reason
      layoutDirection: COLUMN
      content:
      - _type: FormContainer
        _name: S1Row1
        layoutDirection: ROW
        content:
        - _type: IdField
          _name: ReasonCode
          value: ReasonCode
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: TextField
          _name: ReasonName
          value: ReasonName
          useCustomLabel: false
          dataType: STRING
          relativeWidth: 33
        - _type: ReferenceField
