_package: RestaurantMaster.list_of_values
_type: LOVType
_name: OwnershipType
label: Ownership type
description: How the restaurant is operated.
length: 20
lovValues:
- code: FRANCHISED
  label: Franchised
  description: Operated by a franchisee under a franchise agreement.
- code: COMPANY_OPERATED
  label: Company-operated
  description: Operated by a Copperline company.
- code: JOINT_VENTURE
  label: Joint venture
  description: Operated jointly by Copperline and a partner.
- code: LICENSED
  label: Licensed
  description: Operated under a license (airports, campuses, travel centers).
