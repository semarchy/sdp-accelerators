_package: RestaurantMaster.list_of_values
_type: LOVType
_name: OrganizationLevel
label: Organization level
description: Level of an organization unit.
length: 16
lovValues:
- code: REGION
  label: Region
  description: Top level of the Finance and Operations hierarchies.
- code: AREA
  label: Area
  description: Group of districts or of restaurants within a region.
- code: DISTRICT
  label: District
  description: Operations district, typically 8 to 12 restaurants under one district manager.
- code: MARKET
  label: Market
  description: Marketing market of one brand, aligned with an advertising area.
