_package: RestaurantMaster.list_of_values
_type: LOVType
_name: SystemRole
label: System role
description: Role of a system towards the restaurant hub.
length: 20
lovValues:
- code: PUBLISHER
  label: Publisher
  description: Sends restaurant data to the hub.
- code: CONSUMER
  label: Consumer
  description: Receives restaurant data from the hub.
- code: DELIVERY_PARTNER
  label: Delivery partner
  description: Third-party delivery app; also a consumer.
