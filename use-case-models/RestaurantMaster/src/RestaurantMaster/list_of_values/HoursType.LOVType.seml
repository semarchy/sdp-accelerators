_package: RestaurantMaster.list_of_values
_type: LOVType
_name: HoursType
label: Hours type
description: Regular weekly hours or special hours for one date.
length: 16
lovValues:
- code: REGULAR
  label: Regular
  description: Weekly hours, one row per day of the week.
- code: SPECIAL
  label: Special
  description: Hours for one date (holiday, weather, event); override the regular hours that day.
