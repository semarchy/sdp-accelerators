_package: RestaurantMaster.list_of_values
_type: LOVType
_name: PublicChannelStatus
label: Public channel status
description: What public channels must show for a restaurant.
length: 20
lovValues:
- code: LISTED_OPEN
  label: Listed open
  description: Shown as open on maps, store locators and delivery apps.
- code: LISTED_TEMP_CLOSED
  label: Listed temporarily closed
  description: Shown with a temporary-closure notice and the planned reopening date.
- code: NOT_LISTED
  label: Not listed
  description: Must not appear on any public channel (pipeline, permanently closed, relocated, cancelled).
