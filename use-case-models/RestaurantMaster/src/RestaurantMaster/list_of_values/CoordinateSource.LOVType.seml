_package: RestaurantMaster.list_of_values
_type: LOVType
_name: CoordinateSource
label: Coordinate source
description: How the restaurant's coordinates were obtained.
length: 16
lovValues:
- code: SURVEYED
  label: Surveyed
  description: Measured on site; trusted for drive-thru entrances and delivery pick-up points.
- code: GEOCODED
  label: Geocoded
  description: Computed from the address by a geocoding service; approximate.
- code: MANUAL
  label: Entered by hand
  description: Placed by a steward on a map.
