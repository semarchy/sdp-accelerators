      - _type: BrowseBusinessViewAction
        _name: WLAwaitingOnboarding
        businessView: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView
        viewType: GD
        appliedFilter: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView.Restaurant.AwaitingOnboarding
        label: Awaiting onboarding
        businessViewLabelOverride: Awaiting onboarding
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: true
        description: Restaurants published by Real Estate that a steward has not onboarded yet (no brand).
        iconColor: md:teal
        icon: images://mdi/store-plus.svg
        image: images://restaurantmaster/awaiting-onboarding.png
      - _type: BrowseBusinessViewAction
        _name: WLListingIncomplete
        businessView: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView
        viewType: GD
        appliedFilter: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView.Restaurant.ListingIncomplete
        label: Listed but incomplete
        businessViewLabelOverride: Listed but incomplete
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: true
        description: Restaurants shown on public channels without a name, full address, coordinates or main phone.
        iconColor: md:orange
        icon: images://mdi/map-marker-alert-outline.svg
        image: images://restaurantmaster/listed-but-incomplete.png
      - _type: BrowseBusinessViewAction
        _name: WLAddressInconsistent
        businessView: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView
        viewType: GD
        appliedFilter: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView.Restaurant.AddressInconsistent
        label: Address to check
        businessViewLabelOverride: Address to check
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: true
        description: State outside the country, or coordinates outside the US and Canada.
        iconColor: md:orange
        icon: images://mdi/map-search-outline.svg
        image: images://restaurantmaster/address-to-check.png
      - _type: BrowseBusinessViewAction
        _name: WLUnknownToSystems
        businessView: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView
        viewType: GD
        appliedFilter: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView.Restaurant.UnknownToSystems
        label: Open but unknown to ERP or POS
        businessViewLabelOverride: Open but unknown to ERP or POS
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: true
        description: 'Open restaurants that ERP or the POS never published: a broken integration or a mistyped restaurant ID.'
        iconColor: md:red
        icon: images://mdi/lan-disconnect.svg
        image: images://restaurantmaster/open-but-unknown-to-erp-or-pos.png
      - _type: BrowseBusinessViewAction
        _name: WLMissingOperatorOrStatus
        businessView: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView
        viewType: GD
        appliedFilter: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView.Restaurant.MissingOperatorOrStatus
        label: Missing operator or status history
        businessViewLabelOverride: Missing operator or status history
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: true
        description: Restaurants beyond the pipeline without a started operator or status-history row.
        iconColor: md:amber
        icon: images://mdi/account-question-outline.svg
        image: images://restaurantmaster/missing-operator-or-status-history.png
      - _type: BrowseBusinessViewAction
        _name: WLLegalEntityWithoutFranchisee
        businessView: RestaurantMaster.entities.LegalEntity.business_views.LegalEntityBusinessView
        viewType: GD
        appliedFilter: RestaurantMaster.entities.LegalEntity.business_views.LegalEntityBusinessView.LegalEntity.LegalEntityWithoutFranchisee
        label: Franchisee companies without a group
        businessViewLabelOverride: Franchisee companies without a group
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: true
        description: Franchisee companies not yet attached to their franchisee group.
        iconColor: md:amber
        icon: images://mdi/link-off.svg
        image: images://restaurantmaster/franchisee-companies-without-a-group.png
      icon: images://mdi/clipboard-list-outline.svg
    icon: images://mdi/account-check.svg
