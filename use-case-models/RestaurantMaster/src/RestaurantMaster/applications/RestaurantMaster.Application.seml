        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: true
        description: Legal entities rejected by a validation rule before consolidation (source records).
        iconColor: md:red
        icon: images://mdi/domain.svg
        image: images://restaurantmaster/legal-entities.png
      - _type: BrowseBusinessViewAction
        _name: ErrFranchisee
