_package: RestaurantMaster.applications
_type: Application
_name: RestaurantMaster
label: Restaurant Master
description: Restaurant Master
visibility: VISIBLE
applicationTitle: Restaurant Master
avatarImageUrl: images://restaurantmaster/avatar.svg
logoUrl: images://restaurantmaster/logo.svg
coverImageUrl: images://restaurantmaster/cover.svg
favIcon: images://default/dm-favicon.svg
sortStrategy: POSITION
historyBrowsingEnabled: true
historyBrowsingRequiredRole: ''
defaultAction: RestaurantMaster.applications.RestaurantMaster.Root.GeneralActions.GlobalSearch
documentationConfig:
  documentation: Master data application for the group's restaurants, their operators and organization.
  documentationConfigDiagrams:
  - _type: DocumentationConfigDiagram
    _name: Main
    modelDiagram: RestaurantMaster.model_diagrams.MasterEntities
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: true
  globalSearchBusinessViews:
  - _type: GlobalSearchBoView
    _name: Restaurants
    viewType: GD
    businessView: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView
    searchTypeConfig: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView.Restaurant.TextConfig
    maxResults: 10
    label: Restaurants
  - _type: GlobalSearchBoView
    _name: RestaurantHourss
    viewType: GD
    businessView: RestaurantMaster.entities.RestaurantHours.business_views.RestaurantHoursBusinessView
    searchTypeConfig: RestaurantMaster.entities.RestaurantHours.business_views.RestaurantHoursBusinessView.RestaurantHours.TextConfig
    maxResults: 10
    label: Opening hours
  - _type: GlobalSearchBoView
    _name: RestaurantServices
    viewType: GD
    businessView: RestaurantMaster.entities.RestaurantService.business_views.RestaurantServiceBusinessView
    searchTypeConfig: RestaurantMaster.entities.RestaurantService.business_views.RestaurantServiceBusinessView.RestaurantService.TextConfig
    maxResults: 10
    label: Services
  - _type: GlobalSearchBoView
    _name: RestaurantContactPoints
    viewType: GD
    businessView: RestaurantMaster.entities.RestaurantContactPoint.business_views.RestaurantContactPointBusinessView
    searchTypeConfig: RestaurantMaster.entities.RestaurantContactPoint.business_views.RestaurantContactPointBusinessView.RestaurantContactPoint.TextConfig
    maxResults: 10
    label: Contact points
  - _type: GlobalSearchBoView
    _name: RestaurantLocalizedNames
    viewType: GD
    businessView: RestaurantMaster.entities.RestaurantLocalizedName.business_views.RestaurantLocalizedNameBusinessView
    searchTypeConfig: RestaurantMaster.entities.RestaurantLocalizedName.business_views.RestaurantLocalizedNameBusinessView.RestaurantLocalizedName.TextConfig
    maxResults: 10
    label: Localized names
  - _type: GlobalSearchBoView
    _name: RestaurantStatusHistorys
    viewType: GD
    businessView: RestaurantMaster.entities.RestaurantStatusHistory.business_views.RestaurantStatusHistoryBusinessView
    searchTypeConfig: RestaurantMaster.entities.RestaurantStatusHistory.business_views.RestaurantStatusHistoryBusinessView.RestaurantStatusHistory.TextConfig
    maxResults: 10
    label: Status history
  - _type: GlobalSearchBoView
    _name: RestaurantOperators
    viewType: GD
    businessView: RestaurantMaster.entities.RestaurantOperator.business_views.RestaurantOperatorBusinessView
    searchTypeConfig: RestaurantMaster.entities.RestaurantOperator.business_views.RestaurantOperatorBusinessView.RestaurantOperator.TextConfig
    maxResults: 10
    label: Operators
  - _type: GlobalSearchBoView
    _name: RestaurantOrgAssignments
    viewType: GD
    businessView: RestaurantMaster.entities.RestaurantOrgAssignment.business_views.RestaurantOrgAssignmentBusinessView
    searchTypeConfig: RestaurantMaster.entities.RestaurantOrgAssignment.business_views.RestaurantOrgAssignmentBusinessView.RestaurantOrgAssignment.TextConfig
    maxResults: 10
    label: Organization assignments
  - _type: GlobalSearchBoView
    _name: RestaurantIdentifiers
    viewType: GD
    businessView: RestaurantMaster.entities.RestaurantIdentifier.business_views.RestaurantIdentifierBusinessView
    searchTypeConfig: RestaurantMaster.entities.RestaurantIdentifier.business_views.RestaurantIdentifierBusinessView.RestaurantIdentifier.TextConfig
    maxResults: 10
    label: Restaurant identifiers
  - _type: GlobalSearchBoView
    _name: LegalEntitys
    viewType: GD
    businessView: RestaurantMaster.entities.LegalEntity.business_views.LegalEntityBusinessView
    searchTypeConfig: RestaurantMaster.entities.LegalEntity.business_views.LegalEntityBusinessView.LegalEntity.TextConfig
    maxResults: 10
    label: Legal entities
  - _type: GlobalSearchBoView
    _name: Franchisees
    viewType: GD
    businessView: RestaurantMaster.entities.Franchisee.business_views.FranchiseeBusinessView
    searchTypeConfig: RestaurantMaster.entities.Franchisee.business_views.FranchiseeBusinessView.Franchisee.TextConfig
    maxResults: 10
    label: Franchisees
  - _type: GlobalSearchBoView
    _name: OrganizationUnits
    viewType: GD
    businessView: RestaurantMaster.entities.OrganizationUnit.business_views.OrganizationUnitBusinessView
    searchTypeConfig: RestaurantMaster.entities.OrganizationUnit.business_views.OrganizationUnitBusinessView.OrganizationUnit.TextConfig
    maxResults: 10
    label: Organization units
navDrawer:
- _type: FolderNavGroup
  _name: GeneralActions
  dividerVisible: true
  labelVisible: false
  linkedFolder: RestaurantMaster.applications.RestaurantMaster.Root.GeneralActions
- _type: FolderNavGroup
  _name: RestaurantsDomain
  dividerVisible: true
  labelVisible: true
  linkedFolder: RestaurantMaster.applications.RestaurantMaster.Root.RestaurantsDomain
- _type: FolderNavGroup
  _name: OperatorsDomain
  dividerVisible: true
  labelVisible: true
  linkedFolder: RestaurantMaster.applications.RestaurantMaster.Root.OperatorsDomain
- _type: FolderNavGroup
  _name: OrganizationDomain
  dividerVisible: true
  labelVisible: true
  linkedFolder: RestaurantMaster.applications.RestaurantMaster.Root.OrganizationDomain
- _type: FolderNavGroup
  _name: ReferenceDataDomain
  dividerVisible: true
  labelVisible: false
  linkedFolder: RestaurantMaster.applications.RestaurantMaster.Root.ReferenceDataDomain
- _type: FolderNavGroup
  _name: Stewardship
  dividerVisible: true
  labelVisible: true
  linkedFolder: RestaurantMaster.applications.RestaurantMaster.Root.Stewardship
- _type: FolderNavGroup
  _name: Administration
  dividerVisible: true
  labelVisible: true
  linkedFolder: RestaurantMaster.applications.RestaurantMaster.Root.Administration
rootFolder:
  _type: FolderAction
  _name: Root
  label: Root folder
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  appActions:
  - _type: FolderAction
    _name: GeneralActions
    imageAlign: MIDDLE_CENTER
    imageMode: FIT
    label: Quick access
    appActions:
    - _type: GlobalSearchAction
      _name: GlobalSearch
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      description: Search restaurants, operators and organization
      iconColor: md:green
    - _type: MyTasksAction
      _name: MyTasks
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      badgeVisible: true
      description: My tasks
      iconColor: md:green
      icon: images://mdi/inbox-multiple.svg
  - _type: FolderAction
    _name: RestaurantsDomain
    imageAlign: MIDDLE_CENTER
    imageMode: FIT
    label: Restaurants
    iconColor: md:teal
    appActions:
    - _type: BrowseBusinessViewAction
      _name: BrowseRestaurant
      businessView: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView
      label: Restaurants
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      nbRecordsBadgeVisible: false
      description: Browse Restaurants
      iconColor: md:teal
      icon: images://mdi/storefront.svg
      image: images://restaurantmaster/restaurants.png
    - _type: FolderAction
      _name: RestaurantDetails
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      label: Restaurant details
      iconColor: md:cyan
      appActions:
      - _type: BrowseBusinessViewAction
        _name: BrowseRestaurantHours
        businessView: RestaurantMaster.entities.RestaurantHours.business_views.RestaurantHoursBusinessView
        label: Opening hours
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: false
        description: Browse Opening hours
        iconColor: md:cyan
        icon: images://mdi/clock-outline.svg
        image: images://restaurantmaster/opening-hours.png
      - _type: BrowseBusinessViewAction
        _name: BrowseRestaurantService
        businessView: RestaurantMaster.entities.RestaurantService.business_views.RestaurantServiceBusinessView
        label: Services
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: false
        description: Browse Services
        iconColor: md:cyan
        icon: images://mdi/room-service-outline.svg
        image: images://restaurantmaster/services.png
      - _type: BrowseBusinessViewAction
        _name: BrowseRestaurantContactPoint
        businessView: RestaurantMaster.entities.RestaurantContactPoint.business_views.RestaurantContactPointBusinessView
        label: Contact points
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: false
        description: Browse Contact points
        iconColor: md:cyan
        icon: images://mdi/card-account-phone.svg
        image: images://restaurantmaster/contact-points.png
      - _type: BrowseBusinessViewAction
        _name: BrowseRestaurantLocalizedName
        businessView: RestaurantMaster.entities.RestaurantLocalizedName.business_views.RestaurantLocalizedNameBusinessView
        label: Localized names
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: false
        description: Browse Localized names
        iconColor: md:cyan
        icon: images://mdi/translate.svg
        image: images://restaurantmaster/localized-names.png
      - _type: BrowseBusinessViewAction
        _name: BrowseRestaurantStatusHistory
        businessView: RestaurantMaster.entities.RestaurantStatusHistory.business_views.RestaurantStatusHistoryBusinessView
        label: Status history
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: false
        description: Browse Status history
        iconColor: md:cyan
        icon: images://mdi/timeline-clock-outline.svg
        image: images://restaurantmaster/status-history.png
      - _type: BrowseBusinessViewAction
        _name: BrowseRestaurantOperator
        businessView: RestaurantMaster.entities.RestaurantOperator.business_views.RestaurantOperatorBusinessView
        label: Operators
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: false
        description: Browse Operators
        iconColor: md:cyan
        icon: images://mdi/account-tie.svg
        image: images://restaurantmaster/operators.png
      - _type: BrowseBusinessViewAction
        _name: BrowseRestaurantOrgAssignment
        businessView: RestaurantMaster.entities.RestaurantOrgAssignment.business_views.RestaurantOrgAssignmentBusinessView
        label: Organization assignments
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: false
        description: Browse Organization assignments
        iconColor: md:cyan
        icon: images://mdi/file-tree-outline.svg
        image: images://restaurantmaster/organization-assignments.png
      - _type: BrowseBusinessViewAction
        _name: BrowseRestaurantIdentifier
        businessView: RestaurantMaster.entities.RestaurantIdentifier.business_views.RestaurantIdentifierBusinessView
        label: Restaurant identifiers
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: false
        description: Browse Restaurant identifiers
        iconColor: md:cyan
        icon: images://mdi/identifier.svg
        image: images://restaurantmaster/restaurant-identifiers.png
      icon: images://mdi/folder.svg
    description: The restaurants, with their hours, services, contacts, lifecycle, operators and system identifiers.
    icon: images://mdi/storefront.svg
  - _type: FolderAction
    _name: OperatorsDomain
    imageAlign: MIDDLE_CENTER
    imageMode: FIT
    label: Operators
    iconColor: md:indigo
    appActions:
    - _type: BrowseBusinessViewAction
      _name: BrowseFranchisee
      businessView: RestaurantMaster.entities.Franchisee.business_views.FranchiseeBusinessView
      label: Franchisees
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      nbRecordsBadgeVisible: false
      description: Browse Franchisees
      iconColor: md:indigo
      icon: images://mdi/account-group.svg
      image: images://restaurantmaster/franchisees.png
    - _type: BrowseBusinessViewAction
      _name: BrowseLegalEntity
      businessView: RestaurantMaster.entities.LegalEntity.business_views.LegalEntityBusinessView
      label: Legal entities
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      nbRecordsBadgeVisible: false
      description: Browse Legal entities
      iconColor: md:indigo
      icon: images://mdi/domain.svg
      image: images://restaurantmaster/legal-entities.png
    description: Franchisees and the legal entities that operate and are billed for restaurants.
    icon: images://mdi/account-group.svg
  - _type: FolderAction
    _name: OrganizationDomain
    imageAlign: MIDDLE_CENTER
    imageMode: FIT
    label: Organization
    iconColor: md:brown
    appActions:
    - _type: BrowseBusinessViewAction
      _name: BrowseOrganizationUnit
      businessView: RestaurantMaster.entities.OrganizationUnit.business_views.OrganizationUnitBusinessView
      label: Organization units
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      nbRecordsBadgeVisible: false
      description: Browse Organization units
      iconColor: md:brown
      icon: images://mdi/sitemap.svg
      image: images://restaurantmaster/organization-units.png
    description: Finance, Operations and Marketing hierarchies.
    icon: images://mdi/sitemap.svg
  - _type: FolderAction
    _name: ReferenceDataDomain
    imageAlign: MIDDLE_CENTER
    imageMode: FIT
    label: Reference data
    iconColor: md:blue grey
