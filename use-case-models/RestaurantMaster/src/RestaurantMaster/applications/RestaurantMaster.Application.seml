      - _type: BrowseBusinessViewAction
        _name: BrowseLocationType
        businessView: RestaurantMaster.entities.LocationType.business_views.LocationTypeBusinessView
        label: Location types
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: false
        description: Browse Location types
        iconColor: md:blue grey
        icon: images://mdi/map-marker-radius-outline.svg
        image: images://restaurantmaster/location-types.png
      icon: images://mdi/folder-cog-outline.svg
    description: Lists maintained by the data administrator.
    icon: images://mdi/folder-cog-outline.svg
  - _type: FolderAction
    _name: Stewardship
    imageAlign: MIDDLE_CENTER
    imageMode: FIT
    label: Data stewardship
    iconColor: md:deep-orange
    description: Records in error and data-quality queues
    appActions:
    - _type: FolderAction
      _name: Errors
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      label: Records in error
      iconColor: md:red
      appActions:
      - _type: BrowseBusinessViewAction
        _name: ErrRestaurant
        businessView: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView
        viewType: GDWE
        label: Restaurants in error
        businessViewLabelOverride: Restaurants in error
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: true
        description: Restaurants whose consolidated record breaks a rule checked after consolidation (golden records).
        iconColor: md:red
        icon: images://mdi/storefront.svg
        image: images://restaurantmaster/restaurants.png
      - _type: BrowseBusinessViewAction
        _name: ErrRestaurantSrc
        businessView: RestaurantMaster.entities.Restaurant.business_views.RestaurantBusinessView
        viewType: SDWE
        label: Restaurants rejected at load
        businessViewLabelOverride: Restaurants rejected at load
        imageAlign: MIDDLE_CENTER
        imageMode: FIT
        nbRecordsBadgeVisible: true
        description: Restaurants rejected by a validation rule before consolidation (source records).
        iconColor: md:red
        icon: images://mdi/storefront.svg
        image: images://restaurantmaster/restaurants.png
      - _type: BrowseBusinessViewAction
        _name: ErrLegalEntity
