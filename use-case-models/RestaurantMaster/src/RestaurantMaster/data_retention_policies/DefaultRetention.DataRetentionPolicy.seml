_package: RestaurantMaster.data_retention_policies
_type: DataRetentionPolicy
_name: DefaultRetention
description: Retention of history, deletions and source data for the restaurant master.
historyType: PERIOD
historyDuration: 7
historyUnit: YEAR
deletionsType: PERIOD
deletionsDuration: 3
deletionsUnit: YEAR
sourceDataType: PERIOD
sourceDataDuration: 2
sourceDataUnit: YEAR
sourceErrorsType: PERIOD
sourceErrorsDuration: 6
sourceErrorsUnit: MONTH
