_package: LifeAndAnnuityInsurance.list_of_values
_name: PartyType
_type: LOVType
description: "Classifies whether a party is an individual, group, or organization."
label: "Party Type"
length: 128
lovValues:
  - label: "Individual"
    code: INDIVIDUAL
    description: "A natural person participating in a policy, claim, or annuity relationship."
    imageUrl: images://mdi/account-outline.svg
  - label: "Group"
    code: GROUP
    description: "A household, trust, estate, or other grouped party structure."
    imageUrl: images://mdi/account-group-outline.svg
  - label: "Organization"
    code: ORGANIZATION
    description: "A company, agency, employer, or other organization."
    imageUrl: images://mdi/domain.svg
