_package: LifeAndAnnuityInsurance.entities.SurrenderChargeSchedule.forms
_type: Form
_name: SurrenderChargeScheduleForm
entity: LifeAndAnnuityInsurance.entities.SurrenderChargeSchedule.SurrenderChargeSchedule
default: true
formTabs:
  - _type: FormTab
    _name: SurrenderChargeSchedule
    label: "Surrender Charge Schedule"
    iconUrl: images://mdi/percent-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: SurrenderChargeScheduleDetails
        label: "Surrender Charge Schedule Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: SurrenderChargeScheduleDetailsRow
            content:
              - _type: FormContainer
                _name: SurrenderChargeScheduleColA
                content:
                  - _type: TextField
                    _name: SurrenderChargeScheduleID
                    label: "Surrender Charge Schedule ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: SurrenderChargeScheduleID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: YearNumber
                    label: "Year Number"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: YearNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveFrom
                    label: "Effective From"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveFrom
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: SurrenderChargeScheduleColB
                content:
                  - _type: TextField
                    _name: ScheduleCode
                    label: "Schedule Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: ScheduleCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ChargePercentage
                    label: "Charge Percentage"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: ChargePercentage
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveTo
                    label: "Effective To"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveTo
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_InsurancePlan
                    label: "Insurance Plan"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.InsurancePlan.InsurancePlan
                    useCustomLabel: true
                    value: FDN_InsurancePlan
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: SurrenderChargeScheduleColC
                content:
                  - _type: TextField
                    _name: ScheduleName
                    label: "Schedule Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: ScheduleName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ChargeAmount
                    label: "Charge Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: ChargeAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
