_package: LifeAndAnnuityInsurance.entities.PartyStatus.forms
_type: Form
_name: PartyStatusForm
entity: LifeAndAnnuityInsurance.entities.PartyStatus.PartyStatus
default: true
formTabs:
  - _type: FormTab
    _name: PartyStatus
    label: "Party Status"
    iconUrl: images://mdi/account-check-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PartyStatusDetails
        label: "Party Status Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PartyStatusDetailsRow
            content:
              - _type: FormContainer
                _name: PartyStatusColA
                content:
                  - _type: TextField
                    _name: PartyStatusID
                    label: "Party Status ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: PartyStatusID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: StatusCategory
                    label: "Status Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PartyStatusColB
                content:
                  - _type: TextField
                    _name: StatusCode
                    label: "Status Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PartyStatusColC
                content:
                  - _type: TextField
                    _name: StatusName
                    label: "Status Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
