documentation: "Defines lifecycle statuses for party wrapper records, such as active, inactive, merged, or pending verification."
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: PartyStatusID
    label: "Party Status ID"
    physicalName: PARTY_STAT_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the party status."
    documentation: "Unique identifier for the party status."
  - _type: EntityAttribute
    _name: StatusCode
    label: "Status Code"
    physicalName: STAT_CODE
    dataType: String
    length: 30
    mandatory: false
    searchable: true
    description: "Party status code."
    documentation: "Party status code."
  - _type: EntityAttribute
    _name: StatusName
    label: "Status Name"
    physicalName: STAT_NAME
    dataType: String
    length: 128
    mandatory: false
    searchable: true
    description: "Party status name."
    documentation: "Party status name."
  - _type: EntityAttribute
    _name: StatusCategory
    label: "Status Category"
    physicalName: STAT_CATEGORY
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Lifecycle category for the party status."
    documentation: "Lifecycle category for the party status."
  - _type: EntityAttribute
    _name: Description
