_package: LifeAndAnnuityInsurance.entities.PartyStatus
_type: Entity
_name: PartyStatus
label: "Party Status"
pluralLabel: "Party Statuses"
physicalTableName: PARTY_STAT
iconUrl: images://mdi/account-check-outline.svg
