_package: LifeAndAnnuityInsurance.entities.PartyStatus.action_sets
_type: ActionSet
_name: PartyStatusActionSet
entity: LifeAndAnnuityInsurance.entities.PartyStatus.PartyStatus
label: "Party Status Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorPartyStatuses
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.PartyStatus.steppers.AuthorPartyStatuses
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorPartyStatuses
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.PartyStatus.steppers.AuthorPartyStatuses
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorPartyStatuses
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.PartyStatus.steppers.AuthorPartyStatuses
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorPartyStatuses
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.PartyStatus.steppers.AuthorPartyStatuses
