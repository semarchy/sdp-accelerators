_package: LifeAndAnnuityInsurance.entities.RequirementType.business_views
_type: BusinessView
_name: RequirementTypeBusinessView
label: "Requirement Type"
entity: LifeAndAnnuityInsurance.entities.RequirementType.RequirementType
rootLabel: "Requirement Types"
rootPluralLabel: "Requirement Types"
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: RequirementType
  displayCard: LifeAndAnnuityInsurance.entities.RequirementType.display_cards.RequirementTypeDisplayCard
  entity: LifeAndAnnuityInsurance.entities.RequirementType.RequirementType
  actionSet: LifeAndAnnuityInsurance.entities.RequirementType.action_sets.RequirementTypeActionSet
  collection: LifeAndAnnuityInsurance.entities.RequirementType.collection_views.RequirementTypeCollectionView
  form: LifeAndAnnuityInsurance.entities.RequirementType.forms.RequirementTypeForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  transitions:
    - _type: BusinessViewTransition
      _name: UnderwritingRequirement
      label: "Underwriting Requirement"
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      pluralLabel: "Underwriting Requirements"
      iconUrl: images://mdi/clipboard-check.svg
      transitionPath: UnderwritingRequirement
      useCustomLabel: true
      description: "Transition from Requirement Type to related Underwriting Requirements."
      visibleInFormTabCondition: any UnderwritingRequirement has (1=1)
      enableHierarchy: any UnderwritingRequirement has (1=1)
      enableHierarchyInterpreter: SEMQL
      expandHierarchyByDefault: false
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: UnderwritingRequirement
        displayCard: LifeAndAnnuityInsurance.entities.UnderwritingRequirement.display_cards.UnderwritingRequirementDisplayCard
        entity: LifeAndAnnuityInsurance.entities.UnderwritingRequirement.UnderwritingRequirement
        actionSet: LifeAndAnnuityInsurance.entities.UnderwritingRequirement.action_sets.UnderwritingRequirementActionSet
        collection: LifeAndAnnuityInsurance.entities.UnderwritingRequirement.collection_views.UnderwritingRequirementCollectionView
        form: LifeAndAnnuityInsurance.entities.UnderwritingRequirement.forms.UnderwritingRequirementForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true
enableHierarchyView: false
useHierarchyOnOpen: false
rootIconUrl: images://mdi/clipboard-list-outline.svg
