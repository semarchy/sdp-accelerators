_package: LifeAndAnnuityInsurance.entities.RequirementType
_type: Entity
_name: RequirementType
label: "Requirement Type"
pluralLabel: "Requirement Types"
physicalTableName: REQ_TYPE
iconUrl: images://mdi/clipboard-list-outline.svg
description: "Defines underwriting requirement types such as application form, medical exam, labs, APS, financial evidence, or replacement review."
documentation: "Defines underwriting requirement types such as application form, medical exam, labs, APS, financial evidence, or replacement review."
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: RequirementTypeID
    label: "Requirement Type ID"
    physicalName: REQ_TYPE_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the requirement type."
    documentation: "Unique identifier for the requirement type."
  - _type: EntityAttribute
    _name: RequirementCode
    label: "Requirement Code"
    physicalName: REQ_CODE
    dataType: String
    length: 30
    mandatory: false
    searchable: true
    description: "Underwriting requirement code."
    documentation: "Underwriting requirement code."
  - _type: EntityAttribute
    _name: RequirementName
    label: "Requirement Name"
    physicalName: REQ_NAME
    dataType: String
    length: 128
    mandatory: false
    searchable: true
    description: "Business name of the underwriting requirement."
    documentation: "Business name of the underwriting requirement."
  - _type: EntityAttribute
    _name: RequirementCategory
    label: "Requirement Category"
    physicalName: REQ_CATEGORY
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Category of requirement."
    documentation: "Category of requirement."
  - _type: EntityAttribute
    _name: Description
