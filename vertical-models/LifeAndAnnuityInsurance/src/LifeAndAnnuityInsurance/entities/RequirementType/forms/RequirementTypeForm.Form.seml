_package: LifeAndAnnuityInsurance.entities.RequirementType.forms
_type: Form
_name: RequirementTypeForm
entity: LifeAndAnnuityInsurance.entities.RequirementType.RequirementType
default: true
formTabs:
  - _type: FormTab
    _name: RequirementType
    label: "Requirement Type"
    iconUrl: images://mdi/clipboard-list-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: RequirementTypeDetails
        label: "Requirement Type Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: RequirementTypeDetailsRow
            content:
              - _type: FormContainer
                _name: RequirementTypeColA
                content:
                  - _type: TextField
                    _name: RequirementTypeID
                    label: "Requirement Type ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: RequirementTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RequirementCategory
                    label: "Requirement Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: RequirementCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RequirementTypeColB
                content:
                  - _type: TextField
                    _name: RequirementCode
                    label: "Requirement Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: RequirementCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RequirementTypeColC
                content:
                  - _type: TextField
                    _name: RequirementName
                    label: "Requirement Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: RequirementName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DefaultValidityDays
                    label: "Default Validity Days"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: DefaultValidityDays
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
