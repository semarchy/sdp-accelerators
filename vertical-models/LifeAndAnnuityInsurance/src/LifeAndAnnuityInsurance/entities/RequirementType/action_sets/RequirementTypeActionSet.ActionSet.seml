_package: LifeAndAnnuityInsurance.entities.RequirementType.action_sets
_type: ActionSet
_name: RequirementTypeActionSet
entity: LifeAndAnnuityInsurance.entities.RequirementType.RequirementType
label: "Requirement Type Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorRequirementTypes
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.RequirementType.steppers.AuthorRequirementTypes
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorRequirementTypes
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.RequirementType.steppers.AuthorRequirementTypes
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorRequirementTypes
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.RequirementType.steppers.AuthorRequirementTypes
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorRequirementTypes
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.RequirementType.steppers.AuthorRequirementTypes
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
