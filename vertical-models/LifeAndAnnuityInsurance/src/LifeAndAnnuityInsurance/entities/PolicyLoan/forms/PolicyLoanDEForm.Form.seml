_package: LifeAndAnnuityInsurance.entities.PolicyLoan.forms
_type: Form
_name: PolicyLoanDEForm
entity: LifeAndAnnuityInsurance.entities.PolicyLoan.PolicyLoan
default: false
formTabs:
  - _type: FormTab
    _name: PolicyLoan
    label: "Policy Loan"
    iconUrl: images://mdi/cash-multiple.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PolicyLoanDetails
        label: "Policy Loan Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PolicyLoanDetailsRow
            content:
              - _type: FormContainer
                _name: PolicyLoanColA
                content:
                  - _type: TextField
                    _name: PolicyLoanID
                    label: "Policy Loan ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: PolicyLoanID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: LoanStatus
                    label: "Loan Status"
                    dataType: STRING
                    useCustomLabel: true
                    value: LoanStatus
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: OutstandingBalance
                    label: "Outstanding Balance"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: OutstandingBalance
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CollateralValue
                    label: "Collateral Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: CollateralValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyLoanColB
                content:
                  - _type: TextField
                    _name: LoanNumber
                    label: "Loan Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: LoanNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: LoanPrincipalAmount
                    label: "Loan Principal Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: LoanPrincipalAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: InterestAccruedAmount
                    label: "Interest Accrued Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: InterestAccruedAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyLoanColC
                content:
                  - _type: TextField
                    _name: LoanDate
                    label: "Loan Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: LoanDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: LoanInterestRate
                    label: "Loan Interest Rate"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: LoanInterestRate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RepaymentDueDate
                    label: "Repayment Due Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: RepaymentDueDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
