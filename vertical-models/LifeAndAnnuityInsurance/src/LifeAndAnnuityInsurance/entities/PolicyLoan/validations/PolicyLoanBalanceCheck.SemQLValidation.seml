_name: PolicyLoanBalanceCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.PolicyLoan.validations
entity: LifeAndAnnuityInsurance.entities.PolicyLoan.PolicyLoan
label: "Policy Loan Balance Check"
condition: OutstandingBalance IS NULL OR OutstandingBalance >= 0
validationScope: PRE_CONSO
description: "Checks policy loan balance check for Policy Loan."
validationLabel: "OutstandingBalance must be greater than or equal to zero."
