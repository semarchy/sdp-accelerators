_package: LifeAndAnnuityInsurance.entities.PolicyStatus
_type: Entity
_name: PolicyStatus
label: "Policy Status"
pluralLabel: "Policy Statuses"
physicalTableName: POL_STAT
iconUrl: images://mdi/file-document-check-outline.svg
description: "Defines policy lifecycle statuses such as pending, active, lapsed, surrendered, matured, or terminated."
documentation: "Defines policy lifecycle statuses such as pending, active, lapsed, surrendered, matured, or terminated."
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: PolicyStatusID
    label: "Policy Status ID"
    physicalName: POL_STAT_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the policy status."
    documentation: "Unique identifier for the policy status."
  - _type: EntityAttribute
    _name: StatusCode
    label: "Status Code"
    physicalName: STAT_CODE
    dataType: String
    length: 30
    mandatory: false
    searchable: true
    description: "Policy status code."
    documentation: "Policy status code."
  - _type: EntityAttribute
    _name: StatusName
    label: "Status Name"
    physicalName: STAT_NAME
    dataType: String
    length: 128
    mandatory: false
    searchable: true
    description: "Policy status name."
    documentation: "Policy status name."
  - _type: EntityAttribute
    _name: StatusCategory
    label: "Status Category"
    physicalName: STAT_CATEGORY
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Lifecycle category for the policy status."
    documentation: "Lifecycle category for the policy status."
  - _type: EntityAttribute
    _name: Description
    label: "Description"
    physicalName: DESC_TEXT
    dataType: LongText
    mandatory: false
    searchable: true
    description: "Business meaning and service implications of the policy status."
    documentation: "Business meaning and service implications of the policy status."
  - _type: EntityAttribute
    _name: ActiveIndicator
    label: "Active Indicator"
    physicalName: ACTIVE_IND
    dataType: Boolean
    length: 1
    mandatory: false
    searchable: true
    description: "Indicates whether the policy status is active."
    documentation: "Indicates whether the policy status is active."
sourceIdGeneration:
  mode: MANUAL
primaryKey: LifeAndAnnuityInsurance.entities.PolicyStatus.PolicyStatus.PolicyStatusID
entityType: BASIC
