_package: LifeAndAnnuityInsurance.entities.Policy.forms
_type: Form
_name: PolicyDEForm
entity: LifeAndAnnuityInsurance.entities.Policy.Policy
default: false
formTabs:
  - _type: FormTab
    _name: Policy
    label: "Policy"
    iconUrl: images://mdi/file-document-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PolicyDetails
        label: "Policy Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PolicyDetailsRow
            content:
              - _type: FormContainer
                _name: PolicyColA
                content:
                  - _type: TextField
                    _name: PolicyID
                    label: "Policy ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: PolicyID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: IssueDate
                    label: "Issue Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: IssueDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: SurrenderDate
                    label: "Surrender Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: SurrenderDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CurrencyCode
                    label: "Currency Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: CurrencyCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AnnualPremium
                    label: "Annual Premium"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: AnnualPremium
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FreeLookEndDate
                    label: "Free Look End Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: FreeLookEndDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: AutoPayIndicator
                    label: "Auto Pay Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: AutoPayIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_DistributionChannel
                    label: "Distribution Channel"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.DistributionChannel.DistributionChannel
                    useCustomLabel: true
                    value: FDN_DistributionChannel
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_TaxQualification
                    label: "Tax Qualification"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.TaxQualification.TaxQualification
                    useCustomLabel: true
                    value: FDN_TaxQualification
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyColB
                content:
