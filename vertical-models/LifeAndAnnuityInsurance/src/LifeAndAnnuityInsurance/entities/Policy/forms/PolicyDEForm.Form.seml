                    label: "Modal Premium"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: ModalPremium
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DeathBenefitAmount
                    label: "Death Benefit Amount"
