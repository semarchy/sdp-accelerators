                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyColC
                content:
                  - _type: TextField
                    _name: PolicyVersion
                    label: "Policy Version"
                    dataType: STRING
                    useCustomLabel: true
                    value: PolicyVersion
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MaturityDate
                    label: "Maturity Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: MaturityDate
