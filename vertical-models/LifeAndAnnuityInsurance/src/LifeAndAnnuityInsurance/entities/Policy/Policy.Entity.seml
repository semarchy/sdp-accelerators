_package: LifeAndAnnuityInsurance.entities.Policy
_type: Entity
_name: Policy
label: "Policy"
pluralLabel: "Policies"
physicalTableName: POL
iconUrl: images://mdi/file-document-outline.svg
description: "Represents a Life & Annuity policy or contract lifecycle record, including policy identity, dates, premium measures, values, and coverage amounts."
documentation: "Represents a Life & Annuity policy or contract lifecycle record, including policy identity, dates, premium measures, values, and coverage amounts."
historizeGolden: true
historizeMaster: true
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: PolicyID
