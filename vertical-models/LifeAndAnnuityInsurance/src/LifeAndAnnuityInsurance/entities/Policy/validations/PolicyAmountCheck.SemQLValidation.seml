_name: PolicyAmountCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.Policy.validations
entity: LifeAndAnnuityInsurance.entities.Policy.Policy
label: "Policy Amount Check"
condition: FaceAmount IS NULL OR FaceAmount >= 0
validationScope: PRE_CONSO
description: "Checks policy amount check for Policy."
validationLabel: "FaceAmount must be greater than or equal to zero."
