_name: PremiumTransactionAmountCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.PremiumTransaction.validations
entity: LifeAndAnnuityInsurance.entities.PremiumTransaction.PremiumTransaction
label: "Premium Transaction Amount Check"
condition: PaymentAmount IS NULL OR PaymentAmount >= 0
validationScope: PRE_CONSO
description: "Checks premium transaction amount check for Premium Transaction."
validationLabel: "PaymentAmount must be greater than or equal to zero."
