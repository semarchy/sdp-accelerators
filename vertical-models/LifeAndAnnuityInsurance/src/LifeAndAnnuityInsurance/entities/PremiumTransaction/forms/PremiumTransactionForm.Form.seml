_package: LifeAndAnnuityInsurance.entities.PremiumTransaction.forms
_type: Form
_name: PremiumTransactionForm
entity: LifeAndAnnuityInsurance.entities.PremiumTransaction.PremiumTransaction
default: true
formTabs:
  - _type: FormTab
    _name: PremiumTransaction
    label: "Premium Transaction"
    iconUrl: images://mdi/cash-multiple.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PremiumTransactionDetails
        label: "Premium Transaction Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PremiumTransactionDetailsRow
            content:
              - _type: FormContainer
                _name: PremiumTransactionColA
                content:
                  - _type: TextField
                    _name: PremiumTransactionID
                    label: "Premium Transaction ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: PremiumTransactionID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveDate
                    label: "Effective Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PremiumAmount
                    label: "Premium Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: PremiumAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PostedDate
                    label: "Posted Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: PostedDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_PaymentStatus
                    label: "Payment Status"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.PaymentStatus.PaymentStatus
                    useCustomLabel: true
                    value: FDN_PaymentStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PremiumTransactionColB
                content:
                  - _type: TextField
                    _name: TransactionNumber
                    label: "Transaction Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: TransactionNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TransactionType
                    label: "Transaction Type"
                    dataType: STRING
                    useCustomLabel: true
                    value: TransactionType
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FeeAmount
                    label: "Fee Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: FeeAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ReversalIndicator
                    label: "Reversal Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ReversalIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PremiumTransactionColC
                content:
                  - _type: TextField
                    _name: TransactionDate
                    label: "Transaction Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: TransactionDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PaymentAmount
                    label: "Payment Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: PaymentAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CurrencyCode
                    label: "Currency Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: CurrencyCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: SourceSystem
                    label: "Source System"
                    dataType: STRING
                    useCustomLabel: true
                    value: SourceSystem
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_PaymentPlan
                    label: "Payment Plan"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.PaymentPlan.PaymentPlan
                    useCustomLabel: true
                    value: FDN_PaymentPlan
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
