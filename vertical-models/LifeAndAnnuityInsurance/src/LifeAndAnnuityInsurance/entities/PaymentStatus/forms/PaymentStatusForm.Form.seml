_package: LifeAndAnnuityInsurance.entities.PaymentStatus.forms
_type: Form
_name: PaymentStatusForm
entity: LifeAndAnnuityInsurance.entities.PaymentStatus.PaymentStatus
default: true
formTabs:
  - _type: FormTab
    _name: PaymentStatus
    label: "Payment Status"
    iconUrl: images://mdi/cash-check.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PaymentStatusDetails
        label: "Payment Status Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PaymentStatusDetailsRow
            content:
              - _type: FormContainer
                _name: PaymentStatusColA
                content:
                  - _type: TextField
                    _name: PaymentStatusID
                    label: "Payment Status ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: PaymentStatusID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: StatusCategory
                    label: "Status Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PaymentStatusColB
                content:
                  - _type: TextField
                    _name: StatusCode
                    label: "Status Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PaymentStatusColC
                content:
                  - _type: TextField
                    _name: StatusName
                    label: "Status Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
