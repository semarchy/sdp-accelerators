_package: LifeAndAnnuityInsurance.entities.PaymentStatus
_type: Entity
_name: PaymentStatus
label: "Payment Status"
pluralLabel: "Payment Statuses"
physicalTableName: PAY_STAT
iconUrl: images://mdi/cash-check.svg
description: "Defines payment statuses used for premiums, disbursements, and claim benefit payments."
documentation: "Defines payment statuses used for premiums, disbursements, and claim benefit payments."
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: PaymentStatusID
    label: "Payment Status ID"
    physicalName: PAY_STAT_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the payment status."
    documentation: "Unique identifier for the payment status."
  - _type: EntityAttribute
    _name: StatusCode
    label: "Status Code"
    physicalName: STAT_CODE
    dataType: String
    length: 30
    mandatory: false
    searchable: true
    description: "Payment status code."
    documentation: "Payment status code."
  - _type: EntityAttribute
    _name: StatusName
    label: "Status Name"
    physicalName: STAT_NAME
    dataType: String
    length: 128
    mandatory: false
    searchable: true
    description: "Payment status name."
    documentation: "Payment status name."
  - _type: EntityAttribute
    _name: StatusCategory
    label: "Status Category"
    physicalName: STAT_CATEGORY
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Operational category for the payment status."
    documentation: "Operational category for the payment status."
  - _type: EntityAttribute
    _name: Description
    label: "Description"
    physicalName: DESC_TEXT
    dataType: LongText
    mandatory: false
    searchable: true
    description: "Business meaning and downstream implications of the payment status."
    documentation: "Business meaning and downstream implications of the payment status."
  - _type: EntityAttribute
    _name: ActiveIndicator
    label: "Active Indicator"
    physicalName: ACTIVE_IND
    dataType: Boolean
    length: 1
    mandatory: false
    searchable: true
    description: "Indicates whether the payment status is active."
    documentation: "Indicates whether the payment status is active."
sourceIdGeneration:
  mode: MANUAL
primaryKey: LifeAndAnnuityInsurance.entities.PaymentStatus.PaymentStatus.PaymentStatusID
entityType: BASIC
