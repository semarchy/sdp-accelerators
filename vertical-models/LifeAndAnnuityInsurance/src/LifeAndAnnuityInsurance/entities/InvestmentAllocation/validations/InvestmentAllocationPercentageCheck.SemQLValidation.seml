_name: InvestmentAllocationPercentageCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.InvestmentAllocation.validations
entity: LifeAndAnnuityInsurance.entities.InvestmentAllocation.InvestmentAllocation
label: "Investment Allocation Percentage Check"
condition: AllocationPercentage IS NULL OR (AllocationPercentage >= 0 AND AllocationPercentage <= 100)
validationScope: PRE_CONSO
description: "Checks investment allocation percentage check for Investment Allocation."
validationLabel: "AllocationPercentage must be between 0 and 100."
