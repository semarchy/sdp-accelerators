_name: InvestmentAllocationDateRangeCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.InvestmentAllocation.validations
entity: LifeAndAnnuityInsurance.entities.InvestmentAllocation.InvestmentAllocation
label: "Investment Allocation Date Range Check"
condition: AllocationEndDate IS NULL OR AllocationEffectiveDate IS NULL OR AllocationEffectiveDate <= AllocationEndDate
validationScope: PRE_CONSO
description: "Checks investment allocation date range check for Investment Allocation."
validationLabel: "AllocationEndDate must be greater than or equal to AllocationEffectiveDate."
