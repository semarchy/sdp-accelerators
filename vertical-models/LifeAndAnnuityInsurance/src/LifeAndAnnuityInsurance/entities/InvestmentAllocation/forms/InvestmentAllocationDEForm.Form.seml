_package: LifeAndAnnuityInsurance.entities.InvestmentAllocation.forms
_type: Form
_name: InvestmentAllocationDEForm
entity: LifeAndAnnuityInsurance.entities.InvestmentAllocation.InvestmentAllocation
default: false
formTabs:
  - _type: FormTab
    _name: InvestmentAllocation
    label: "Investment Allocation"
    iconUrl: images://mdi/chart-pie.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: InvestmentAllocationDetails
        label: "Investment Allocation Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: InvestmentAllocationDetailsRow
            content:
              - _type: FormContainer
                _name: InvestmentAllocationColA
                content:
                  - _type: TextField
                    _name: InvestmentAllocationID
                    label: "Investment Allocation ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: InvestmentAllocationID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AllocationPercentage
                    label: "Allocation Percentage"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: AllocationPercentage
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ModelPortfolioName
                    label: "Model Portfolio Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: ModelPortfolioName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: InvestmentAllocationColB
                content:
                  - _type: TextField
                    _name: AllocationEffectiveDate
                    label: "Allocation Effective Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: AllocationEffectiveDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AccountValue
                    label: "Account Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: AccountValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: RebalanceIndicator
                    label: "Rebalance Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: RebalanceIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Fund
                    label: "Fund"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Fund.Fund
                    useCustomLabel: true
                    value: FDN_Fund
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: InvestmentAllocationColC
                content:
                  - _type: TextField
                    _name: AllocationEndDate
                    label: "Allocation End Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: AllocationEndDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: TransferRestrictionIndicator
                    label: "Transfer Restriction Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: TransferRestrictionIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
