_package: LifeAndAnnuityInsurance.entities.CashValueSnapshot.action_sets
_type: ActionSet
_name: CashValueSnapshotActionSet
entity: LifeAndAnnuityInsurance.entities.CashValueSnapshot.CashValueSnapshot
label: "Cash Value Snapshot Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorCashValueSnapshots
