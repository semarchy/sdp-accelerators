    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.CashValueSnapshot.steppers.AuthorCashValueSnapshots
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorCashValueSnapshots
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.CashValueSnapshot.steppers.AuthorCashValueSnapshots
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorCashValueSnapshots
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.CashValueSnapshot.steppers.AuthorCashValueSnapshots
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorCashValueSnapshots
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.CashValueSnapshot.steppers.AuthorCashValueSnapshots
