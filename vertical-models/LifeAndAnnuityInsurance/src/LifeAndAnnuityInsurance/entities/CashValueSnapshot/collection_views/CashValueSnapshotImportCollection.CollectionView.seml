_package: LifeAndAnnuityInsurance.entities.CashValueSnapshot.collection_views
_type: CollectionView
_name: CashValueSnapshotImportCollection
entity: LifeAndAnnuityInsurance.entities.CashValueSnapshot.CashValueSnapshot
