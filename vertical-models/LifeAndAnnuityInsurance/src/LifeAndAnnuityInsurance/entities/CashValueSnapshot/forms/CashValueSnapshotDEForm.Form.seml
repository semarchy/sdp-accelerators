_package: LifeAndAnnuityInsurance.entities.CashValueSnapshot.forms
_type: Form
_name: CashValueSnapshotDEForm
entity: LifeAndAnnuityInsurance.entities.CashValueSnapshot.CashValueSnapshot
default: false
formTabs:
  - _type: FormTab
    _name: CashValueSnapshot
    label: "Cash Value Snapshot"
    iconUrl: images://mdi/wallet-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: CashValueSnapshotDetails
        label: "Cash Value Snapshot Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: CashValueSnapshotDetailsRow
            content:
              - _type: FormContainer
                _name: CashValueSnapshotColA
                content:
                  - _type: TextField
                    _name: CashValueSnapshotID
                    label: "Cash Value Snapshot ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: CashValueSnapshotID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CashSurrenderValue
                    label: "Cash Surrender Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: CashSurrenderValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CostBasis
                    label: "Cost Basis"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: CostBasis
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MarketValueAdjustmentAmount
                    label: "Market Value Adjustment Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: MarketValueAdjustmentAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: CashValueSnapshotColB
                content:
                  - _type: TextField
                    _name: ValuationDate
                    label: "Valuation Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: ValuationDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: LoanBalance
                    label: "Loan Balance"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: LoanBalance
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DividendValue
                    label: "Dividend Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: DividendValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: CashValueSnapshotColC
                content:
                  - _type: TextField
                    _name: AccountValue
                    label: "Account Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: AccountValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: NetCashValue
                    label: "Net Cash Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: NetCashValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: InterestCreditedAmount
                    label: "Interest Credited Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: InterestCreditedAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
