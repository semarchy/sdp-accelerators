_package: LifeAndAnnuityInsurance.entities.AnnuityPayoutOption.forms
_type: Form
_name: AnnuityPayoutOptionForm
entity: LifeAndAnnuityInsurance.entities.AnnuityPayoutOption.AnnuityPayoutOption
default: true
formTabs:
  - _type: FormTab
    _name: AnnuityPayoutOption
    label: "Annuity Payout Option"
    iconUrl: images://mdi/timetable.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: AnnuityPayoutOptionDetails
        label: "Annuity Payout Option Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: AnnuityPayoutOptionDetailsRow
            content:
              - _type: FormContainer
                _name: AnnuityPayoutOptionColA
                content:
                  - _type: TextField
                    _name: AnnuityPayoutOptionID
                    label: "Annuity Payout Option ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: AnnuityPayoutOptionID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PayoutCategory
                    label: "Payout Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: PayoutCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PeriodCertainMonths
                    label: "Period Certain Months"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: PeriodCertainMonths
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: AnnuityPayoutOptionColB
                content:
                  - _type: TextField
                    _name: PayoutOptionCode
                    label: "Payout Option Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: PayoutOptionCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: AnnuityPayoutOptionColC
                content:
                  - _type: TextField
                    _name: PayoutOptionName
                    label: "Payout Option Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: PayoutOptionName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: LifeContingentIndicator
                    label: "Life Contingent Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: LifeContingentIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
