_name: UnderwritingDecisionDateCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.UnderwritingCase.validations
entity: LifeAndAnnuityInsurance.entities.UnderwritingCase.UnderwritingCase
label: "Underwriting Decision Date Check"
condition: DecisionDate IS NULL OR ApplicationDate IS NULL OR ApplicationDate <= DecisionDate
validationScope: PRE_CONSO
description: "Checks underwriting decision date check for Underwriting Case."
validationLabel: "DecisionDate must be greater than or equal to ApplicationDate."
