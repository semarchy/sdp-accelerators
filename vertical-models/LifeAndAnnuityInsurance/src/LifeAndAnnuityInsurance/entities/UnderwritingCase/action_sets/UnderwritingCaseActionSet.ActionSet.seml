_package: LifeAndAnnuityInsurance.entities.UnderwritingCase.action_sets
_type: ActionSet
_name: UnderwritingCaseActionSet
entity: LifeAndAnnuityInsurance.entities.UnderwritingCase.UnderwritingCase
label: "Underwriting Case Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorUnderwritingCases
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.UnderwritingCase.steppers.AuthorUnderwritingCases
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorUnderwritingCases
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.UnderwritingCase.steppers.AuthorUnderwritingCases
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorUnderwritingCases
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.UnderwritingCase.steppers.AuthorUnderwritingCases
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorUnderwritingCases
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.UnderwritingCase.steppers.AuthorUnderwritingCases
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
