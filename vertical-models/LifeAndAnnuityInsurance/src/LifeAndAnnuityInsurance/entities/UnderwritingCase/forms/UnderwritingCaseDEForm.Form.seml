_package: LifeAndAnnuityInsurance.entities.UnderwritingCase.forms
_type: Form
_name: UnderwritingCaseDEForm
entity: LifeAndAnnuityInsurance.entities.UnderwritingCase.UnderwritingCase
default: false
formTabs:
  - _type: FormTab
    _name: UnderwritingCase
    label: "Underwriting Case"
    iconUrl: images://mdi/stethoscope.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: UnderwritingCaseDetails
        label: "Underwriting Case Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: UnderwritingCaseDetailsRow
            content:
              - _type: FormContainer
                _name: UnderwritingCaseColA
                content:
                  - _type: TextField
                    _name: UnderwritingCaseID
                    label: "Underwriting Case ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: UnderwritingCaseID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DecisionDate
                    label: "Decision Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: DecisionDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MedicalExamDate
                    label: "Medical Exam Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: MedicalExamDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: FinancialUnderwritingIndicator
                    label: "Financial Underwriting Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: FinancialUnderwritingIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_UnderwritingDecisionStatus
                    label: "Underwriting Decision Status"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.UnderwritingDecisionStatus.UnderwritingDecisionStatus
                    useCustomLabel: true
                    value: FDN_UnderwritingDecisionStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: UnderwritingCaseColB
                content:
                  - _type: TextField
                    _name: CaseNumber
                    label: "Case Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: CaseNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DecisionReason
                    label: "Decision Reason"
                    dataType: STRING
                    useCustomLabel: true
                    value: DecisionReason
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: MIBCheckIndicator
                    label: "MIBCheck Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: MIBCheckIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ReplacementReviewIndicator
                    label: "Replacement Review Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ReplacementReviewIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_ProposedInsuredParty
                    label: "Proposed Insured Party"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Party.Party
                    useCustomLabel: true
                    value: FDN_ProposedInsuredParty
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: UnderwritingCaseColC
                content:
                  - _type: TextField
                    _name: ApplicationDate
                    label: "Application Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: ApplicationDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: APSReceivedDate
                    label: "APSReceived Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: APSReceivedDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: PrescriptionCheckIndicator
                    label: "Prescription Check Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: PrescriptionCheckIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_RiskClass
                    label: "Risk Class"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.RiskClass.RiskClass
                    useCustomLabel: true
                    value: FDN_RiskClass
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
