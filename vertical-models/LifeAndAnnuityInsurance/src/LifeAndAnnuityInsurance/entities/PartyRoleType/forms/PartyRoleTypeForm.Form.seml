_package: LifeAndAnnuityInsurance.entities.PartyRoleType.forms
_type: Form
_name: PartyRoleTypeForm
entity: LifeAndAnnuityInsurance.entities.PartyRoleType.PartyRoleType
default: true
formTabs:
  - _type: FormTab
    _name: PartyRoleType
    label: "Party Role Type"
    iconUrl: images://mdi/account-tag-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PartyRoleTypeDetails
        label: "Party Role Type Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PartyRoleTypeDetailsRow
            content:
              - _type: FormContainer
                _name: PartyRoleTypeColA
                content:
                  - _type: TextField
                    _name: PartyRoleTypeID
                    label: "Party Role Type ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: PartyRoleTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RoleCategory
                    label: "Role Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: RoleCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PartyRoleTypeColB
                content:
                  - _type: TextField
                    _name: RoleCode
                    label: "Role Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: RoleCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PartyRoleTypeColC
                content:
                  - _type: TextField
                    _name: RoleName
                    label: "Role Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: RoleName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: RequiresInsurableInterest
                    label: "Requires Insurable Interest"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: RequiresInsurableInterest
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
