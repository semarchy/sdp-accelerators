_package: LifeAndAnnuityInsurance.entities.TaxQualification.forms
_type: Form
_name: TaxQualificationForm
entity: LifeAndAnnuityInsurance.entities.TaxQualification.TaxQualification
default: true
formTabs:
  - _type: FormTab
    _name: TaxQualification
    label: "Tax Qualification"
    iconUrl: images://mdi/bank-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: TaxQualificationDetails
        label: "Tax Qualification Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: TaxQualificationDetailsRow
            content:
              - _type: FormContainer
                _name: TaxQualificationColA
                content:
                  - _type: TextField
                    _name: TaxQualificationID
                    label: "Tax Qualification ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: TaxQualificationID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: QualificationCategory
                    label: "Qualification Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: QualificationCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: TaxQualificationColB
                content:
                  - _type: TextField
                    _name: QualificationCode
                    label: "Qualification Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: QualificationCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: TaxQualificationColC
                content:
                  - _type: TextField
                    _name: QualificationName
                    label: "Qualification Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: QualificationName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
