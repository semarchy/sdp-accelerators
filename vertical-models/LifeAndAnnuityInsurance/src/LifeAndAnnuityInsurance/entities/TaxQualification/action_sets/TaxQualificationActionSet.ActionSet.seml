_package: LifeAndAnnuityInsurance.entities.TaxQualification.action_sets
_type: ActionSet
_name: TaxQualificationActionSet
entity: LifeAndAnnuityInsurance.entities.TaxQualification.TaxQualification
label: "Tax Qualification Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorTaxQualifications
