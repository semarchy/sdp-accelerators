_package: LifeAndAnnuityInsurance.entities.TaxQualification.business_views
_type: BusinessView
_name: TaxQualificationBusinessView
label: "Tax Qualification"
entity: LifeAndAnnuityInsurance.entities.TaxQualification.TaxQualification
rootLabel: "Tax Qualifications"
rootPluralLabel: "Tax Qualifications"
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: TaxQualification
  displayCard: LifeAndAnnuityInsurance.entities.TaxQualification.display_cards.TaxQualificationDisplayCard
  entity: LifeAndAnnuityInsurance.entities.TaxQualification.TaxQualification
  actionSet: LifeAndAnnuityInsurance.entities.TaxQualification.action_sets.TaxQualificationActionSet
  collection: LifeAndAnnuityInsurance.entities.TaxQualification.collection_views.TaxQualificationCollectionView
  form: LifeAndAnnuityInsurance.entities.TaxQualification.forms.TaxQualificationForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  transitions:
    - _type: BusinessViewTransition
      _name: InsurancePlan
      label: "Insurance Plan"
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      pluralLabel: "Insurance Plans"
      iconUrl: images://mdi/file-cog-outline.svg
      transitionPath: InsurancePlan
      useCustomLabel: true
      description: "Transition from Tax Qualification to related Insurance Plans."
      visibleInFormTabCondition: any InsurancePlan has (1=1)
      enableHierarchy: any InsurancePlan has (1=1)
      enableHierarchyInterpreter: SEMQL
      expandHierarchyByDefault: false
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: InsurancePlan
        displayCard: LifeAndAnnuityInsurance.entities.InsurancePlan.display_cards.InsurancePlanDisplayCard
        entity: LifeAndAnnuityInsurance.entities.InsurancePlan.InsurancePlan
        actionSet: LifeAndAnnuityInsurance.entities.InsurancePlan.action_sets.InsurancePlanActionSet
        collection: LifeAndAnnuityInsurance.entities.InsurancePlan.collection_views.InsurancePlanCollectionView
        form: LifeAndAnnuityInsurance.entities.InsurancePlan.forms.InsurancePlanForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
    - _type: BusinessViewTransition
      _name: Policy
      label: "Policy"
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      pluralLabel: "Policies"
      iconUrl: images://mdi/file-document-outline.svg
      transitionPath: Policy
      useCustomLabel: true
      description: "Transition from Tax Qualification to related Policies."
      visibleInFormTabCondition: any Policy has (1=1)
      enableHierarchy: any Policy has (1=1)
      enableHierarchyInterpreter: SEMQL
      expandHierarchyByDefault: false
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: Policy
        displayCard: LifeAndAnnuityInsurance.entities.Policy.display_cards.PolicyDisplayCard
        entity: LifeAndAnnuityInsurance.entities.Policy.Policy
        actionSet: LifeAndAnnuityInsurance.entities.Policy.action_sets.PolicyActionSet
        collection: LifeAndAnnuityInsurance.entities.Policy.collection_views.PolicyCollectionView
        form: LifeAndAnnuityInsurance.entities.Policy.forms.PolicyForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
    - _type: BusinessViewTransition
      _name: AnnuityContract
      label: "Annuity Contract"
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      pluralLabel: "Annuity Contracts"
      iconUrl: images://mdi/calendar-star.svg
      transitionPath: AnnuityContract
      useCustomLabel: true
      description: "Transition from Tax Qualification to related Annuity Contracts."
      visibleInFormTabCondition: any AnnuityContract has (1=1)
      enableHierarchy: any AnnuityContract has (1=1)
      enableHierarchyInterpreter: SEMQL
      expandHierarchyByDefault: false
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: AnnuityContract
        displayCard: LifeAndAnnuityInsurance.entities.AnnuityContract.display_cards.AnnuityContractDisplayCard
        entity: LifeAndAnnuityInsurance.entities.AnnuityContract.AnnuityContract
        actionSet: LifeAndAnnuityInsurance.entities.AnnuityContract.action_sets.AnnuityContractActionSet
        collection: LifeAndAnnuityInsurance.entities.AnnuityContract.collection_views.AnnuityContractCollectionView
        form: LifeAndAnnuityInsurance.entities.AnnuityContract.forms.AnnuityContractForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true
enableHierarchyView: false
useHierarchyOnOpen: false
rootIconUrl: images://mdi/bank-outline.svg
