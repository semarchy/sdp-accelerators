_package: LifeAndAnnuityInsurance.entities.UnderwritingRequirement.forms
_type: Form
_name: UnderwritingRequirementDEForm
entity: LifeAndAnnuityInsurance.entities.UnderwritingRequirement.UnderwritingRequirement
default: false
formTabs:
  - _type: FormTab
    _name: UnderwritingRequirement
    label: "Underwriting Requirement"
    iconUrl: images://mdi/clipboard-check.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: UnderwritingRequirementDetails
        label: "Underwriting Requirement Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: UnderwritingRequirementDetailsRow
            content:
              - _type: FormContainer
                _name: UnderwritingRequirementColA
                content:
                  - _type: TextField
                    _name: UnderwritingRequirementID
                    label: "Underwriting Requirement ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: UnderwritingRequirementID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ReceivedDate
                    label: "Received Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: ReceivedDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: VendorName
                    label: "Vendor Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: VendorName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: UnderwritingRequirementColB
                content:
                  - _type: TextField
                    _name: RequirementStatus
                    label: "Requirement Status"
                    dataType: STRING
                    useCustomLabel: true
                    value: RequirementStatus
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ExpirationDate
                    label: "Expiration Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: ExpirationDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FollowUpDate
                    label: "Follow Up Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: FollowUpDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_UnderwritingCase
                    label: "Underwriting Case"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.UnderwritingCase.UnderwritingCase
                    useCustomLabel: true
                    value: FDN_UnderwritingCase
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: UnderwritingRequirementColC
                content:
                  - _type: TextField
                    _name: OrderedDate
                    label: "Ordered Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: OrderedDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RequirementResult
                    label: "Requirement Result"
                    dataType: STRING
                    useCustomLabel: true
                    value: RequirementResult
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: WaivedIndicator
                    label: "Waived Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: WaivedIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_RequirementType
                    label: "Requirement Type"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.RequirementType.RequirementType
                    useCustomLabel: true
                    value: FDN_RequirementType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
