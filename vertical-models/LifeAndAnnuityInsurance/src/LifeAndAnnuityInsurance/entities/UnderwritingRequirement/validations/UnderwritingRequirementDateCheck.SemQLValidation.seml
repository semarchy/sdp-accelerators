_name: UnderwritingRequirementDateCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.UnderwritingRequirement.validations
entity: LifeAndAnnuityInsurance.entities.UnderwritingRequirement.UnderwritingRequirement
label: "Underwriting Requirement Date Check"
condition: ReceivedDate IS NULL OR OrderedDate IS NULL OR OrderedDate <= ReceivedDate
validationScope: PRE_CONSO
description: "Checks underwriting requirement date check for Underwriting Requirement."
validationLabel: "ReceivedDate must be greater than or equal to OrderedDate."
