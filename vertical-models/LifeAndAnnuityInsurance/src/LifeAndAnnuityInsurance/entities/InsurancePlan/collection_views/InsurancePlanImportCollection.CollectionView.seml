_package: LifeAndAnnuityInsurance.entities.InsurancePlan.collection_views
_type: CollectionView
_name: InsurancePlanImportCollection
entity: LifeAndAnnuityInsurance.entities.InsurancePlan.InsurancePlan
default: false
