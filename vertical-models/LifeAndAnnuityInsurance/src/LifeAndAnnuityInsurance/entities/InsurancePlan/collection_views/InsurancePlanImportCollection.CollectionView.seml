    _name: MinimumPremium
    value: MinimumPremium
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ ##,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: CheckboxColumn
