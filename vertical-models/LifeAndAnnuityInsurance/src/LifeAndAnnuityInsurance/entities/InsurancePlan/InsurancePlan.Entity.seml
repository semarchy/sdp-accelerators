_package: LifeAndAnnuityInsurance.entities.InsurancePlan
_type: Entity
_name: InsurancePlan
label: "Insurance Plan"
pluralLabel: "Insurance Plans"
physicalTableName: INS_PLAN
iconUrl: images://mdi/file-cog-outline.svg
description: "Represents a sellable plan configuration under a Life & Annuity product, including issue rules, amounts, and lifecycle dates."
documentation: "Represents a sellable plan configuration under a Life & Annuity product, including issue rules, amounts, and lifecycle dates."
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: InsurancePlanID
    label: "Insurance Plan ID"
    physicalName: INS_PLAN_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the insurance plan."
    documentation: "Unique identifier for the insurance plan."
  - _type: EntityAttribute
    _name: PlanCode
    label: "Plan Code"
    physicalName: PLAN_CODE
    dataType: String
    length: 50
    mandatory: false
    searchable: true
    description: "Enterprise plan code."
    documentation: "Enterprise plan code."
  - _type: EntityAttribute
    _name: PlanName
    label: "Plan Name"
    physicalName: PLAN_NAME
    dataType: String
    length: 255
    mandatory: false
    searchable: true
    description: "Commercial or operational name of the plan."
    documentation: "Commercial or operational name of the plan."
  - _type: EntityAttribute
    _name: PlanVersion
    label: "Plan Version"
    physicalName: PLAN_VERSION
    dataType: String
    length: 30
    mandatory: false
    searchable: true
    description: "Version or release identifier of the plan configuration."
    documentation: "Version or release identifier of the plan configuration."
  - _type: EntityAttribute
    _name: PlanDescription
    label: "Plan Description"
    physicalName: PLAN_DESC_TEXT
    dataType: LongText
    mandatory: false
    searchable: true
    description: "Detailed explanation of plan features and eligibility."
    documentation: "Detailed explanation of plan features and eligibility."
  - _type: EntityAttribute
    _name: EffectiveFrom
    label: "Effective From"
    physicalName: EFF_FROM
    dataType: Date
    mandatory: false
    searchable: true
    description: "Date from which the plan is effective."
    documentation: "Date from which the plan is effective."
  - _type: EntityAttribute
    _name: EffectiveTo
    label: "Effective To"
    physicalName: EFF_TO
    dataType: Date
    mandatory: false
    searchable: true
    description: "Date until which the plan remains effective."
    documentation: "Date until which the plan remains effective."
  - _type: EntityAttribute
    _name: IssueAgeMin
    label: "Issue Age Min"
    physicalName: ISSUE_AGE_MIN
    dataType: Decimal
    precision: 9
    scale: 0
    mandatory: false
    searchable: true
    description: "Minimum issue age for the plan."
    documentation: "Minimum issue age for the plan."
  - _type: EntityAttribute
    _name: IssueAgeMax
    label: "Issue Age Max"
    physicalName: ISSUE_AGE_MAX
    dataType: Decimal
    precision: 9
    scale: 0
    mandatory: false
    searchable: true
    description: "Maximum issue age for the plan."
    documentation: "Maximum issue age for the plan."
  - _type: EntityAttribute
    _name: MinimumFaceAmount
    label: "Minimum Face Amount"
    physicalName: MIN_FACE_AMT
    dataType: Decimal
    precision: 18
    scale: 2
    mandatory: false
    searchable: true
    description: "Minimum face amount or contract amount allowed for the plan."
    documentation: "Minimum face amount or contract amount allowed for the plan."
  - _type: EntityAttribute
    _name: MinimumPremium
    label: "Minimum Premium"
    physicalName: MIN_PREM
    dataType: Decimal
    precision: 18
    scale: 2
    mandatory: false
    searchable: true
    description: "Minimum premium allowed for the plan."
    documentation: "Minimum premium allowed for the plan."
  - _type: EntityAttribute
    _name: ActiveIndicator
    label: "Active Indicator"
    physicalName: ACTIVE_IND
    dataType: Boolean
    length: 1
