_package: LifeAndAnnuityInsurance.entities.InsurancePlan.forms
_type: Form
_name: InsurancePlanForm
entity: LifeAndAnnuityInsurance.entities.InsurancePlan.InsurancePlan
default: true
formTabs:
  - _type: FormTab
    _name: InsurancePlan
    label: "Insurance Plan"
    iconUrl: images://mdi/file-cog-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: InsurancePlanDetails
        label: "Insurance Plan Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: InsurancePlanDetailsRow
            content:
              - _type: FormContainer
                _name: InsurancePlanColA
                content:
                  - _type: TextField
                    _name: InsurancePlanID
                    label: "Insurance Plan ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: InsurancePlanID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PlanVersion
                    label: "Plan Version"
                    dataType: STRING
                    useCustomLabel: true
                    value: PlanVersion
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveTo
                    label: "Effective To"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveTo
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MinimumFaceAmount
                    label: "Minimum Face Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: MinimumFaceAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_InsuranceProduct
                    label: "Insurance Product"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.InsuranceProduct.InsuranceProduct
                    useCustomLabel: true
                    value: FDN_InsuranceProduct
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: InsurancePlanColB
                content:
                  - _type: TextField
                    _name: PlanCode
                    label: "Plan Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: PlanCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PlanDescription
                    label: "Plan Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: PlanDescription
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: IssueAgeMin
                    label: "Issue Age Min"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: IssueAgeMin
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MinimumPremium
                    label: "Minimum Premium"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: MinimumPremium
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_PlanStatus
                    label: "Plan Status"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.PlanStatus.PlanStatus
                    useCustomLabel: true
                    value: FDN_PlanStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: InsurancePlanColC
                content:
                  - _type: TextField
                    _name: PlanName
                    label: "Plan Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: PlanName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveFrom
                    label: "Effective From"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveFrom
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: IssueAgeMax
                    label: "Issue Age Max"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: IssueAgeMax
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_TaxQualification
                    label: "Tax Qualification"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.TaxQualification.TaxQualification
                    useCustomLabel: true
                    value: FDN_TaxQualification
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
