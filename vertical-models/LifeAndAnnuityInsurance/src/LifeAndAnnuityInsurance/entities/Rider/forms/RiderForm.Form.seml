_package: LifeAndAnnuityInsurance.entities.Rider.forms
_type: Form
_name: RiderForm
entity: LifeAndAnnuityInsurance.entities.Rider.Rider
default: true
formTabs:
  - _type: FormTab
    _name: Rider
    label: "Rider"
    iconUrl: images://mdi/plus-box-multiple-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: RiderDetails
        label: "Rider Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: RiderDetailsRow
            content:
              - _type: FormContainer
                _name: RiderColA
                content:
                  - _type: TextField
                    _name: RiderID
                    label: "Rider ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiderID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RiderStatus
                    label: "Rider Status"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiderStatus
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: BenefitAmount
                    label: "Benefit Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: BenefitAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RiderColB
                content:
                  - _type: TextField
                    _name: RiderNumber
                    label: "Rider Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiderNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveDate
                    label: "Effective Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RiderPremium
                    label: "Rider Premium"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: RiderPremium
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: WaitingPeriodDays
                    label: "Waiting Period Days"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: WaitingPeriodDays
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Coverage
                    label: "Coverage"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Coverage.Coverage
                    useCustomLabel: true
                    value: FDN_Coverage
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RiderColC
                content:
                  - _type: TextField
                    _name: RiderName
                    label: "Rider Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiderName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TerminationDate
                    label: "Termination Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: TerminationDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: WaiverIndicator
                    label: "Waiver Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: WaiverIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EliminationPeriodDays
                    label: "Elimination Period Days"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: EliminationPeriodDays
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_RiderType
                    label: "Rider Type"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.RiderType.RiderType
                    useCustomLabel: true
                    value: FDN_RiderType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
