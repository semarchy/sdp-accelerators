_name: RiderDateRangeCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.Rider.validations
entity: LifeAndAnnuityInsurance.entities.Rider.Rider
label: "Rider Date Range Check"
condition: TerminationDate IS NULL OR EffectiveDate IS NULL OR EffectiveDate <= TerminationDate
validationScope: PRE_CONSO
description: "Checks rider date range check for Rider."
validationLabel: "TerminationDate must be greater than or equal to EffectiveDate."
