_package: LifeAndAnnuityInsurance.entities.Rider.action_sets
_type: ActionSet
_name: RiderActionSet
entity: LifeAndAnnuityInsurance.entities.Rider.Rider
label: "Rider Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorRiders
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Rider.steppers.AuthorRiders
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorRiders
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Rider.steppers.AuthorRiders
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorRiders
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Rider.steppers.AuthorRiders
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorRiders
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.Rider.steppers.AuthorRiders
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
