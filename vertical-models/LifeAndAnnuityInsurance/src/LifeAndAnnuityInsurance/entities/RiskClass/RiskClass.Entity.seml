_package: LifeAndAnnuityInsurance.entities.RiskClass
_type: Entity
_name: RiskClass
label: "Risk Class"
pluralLabel: "Risk Classes"
physicalTableName: RISK_CLASS
iconUrl: images://mdi/speedometer.svg
description: "Defines underwriting risk classes used in life insurance issue and rating decisions."
documentation: "Defines underwriting risk classes used in life insurance issue and rating decisions."
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: RiskClassID
    label: "Risk Class ID"
    physicalName: RISK_CLASS_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the risk class."
    documentation: "Unique identifier for the risk class."
  - _type: EntityAttribute
    _name: RiskClassCode
    label: "Risk Class Code"
    physicalName: RISK_CLASS_CODE
    dataType: String
    length: 30
    mandatory: false
    searchable: true
    description: "Underwriting risk class code."
    documentation: "Underwriting risk class code."
  - _type: EntityAttribute
    _name: RiskClassName
    label: "Risk Class Name"
    physicalName: RISK_CLASS_NAME
    dataType: String
    length: 128
    mandatory: false
    searchable: true
    description: "Business name of the risk class."
    documentation: "Business name of the risk class."
  - _type: EntityAttribute
    _name: TobaccoBasis
    label: "Tobacco Basis"
    physicalName: TOBACCO_BASIS
    dataType: String
    length: 50
    mandatory: false
    searchable: true
    description: "Tobacco or nicotine classification basis."
    documentation: "Tobacco or nicotine classification basis."
  - _type: EntityAttribute
    _name: UnderwritingBasis
    label: "Underwriting Basis"
    physicalName: UW_BASIS
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Basis used to assign the class, such as medical, simplified, or guaranteed issue."
    documentation: "Basis used to assign the class, such as medical, simplified, or guaranteed issue."
  - _type: EntityAttribute
    _name: Description
    label: "Description"
    physicalName: DESC_TEXT
    dataType: LongText
    mandatory: false
    searchable: true
    description: "Description of risk class usage."
    documentation: "Description of risk class usage."
  - _type: EntityAttribute
    _name: ActiveIndicator
    label: "Active Indicator"
    physicalName: ACTIVE_IND
    dataType: Boolean
    length: 1
    mandatory: false
    searchable: true
    description: "Indicates whether the risk class is active."
    documentation: "Indicates whether the risk class is active."
sourceIdGeneration:
  mode: MANUAL
primaryKey: LifeAndAnnuityInsurance.entities.RiskClass.RiskClass.RiskClassID
entityType: BASIC
