_package: LifeAndAnnuityInsurance.entities.RiskClass.forms
_type: Form
_name: RiskClassForm
entity: LifeAndAnnuityInsurance.entities.RiskClass.RiskClass
default: true
formTabs:
  - _type: FormTab
    _name: RiskClass
    label: "Risk Class"
    iconUrl: images://mdi/speedometer.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: RiskClassDetails
        label: "Risk Class Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: RiskClassDetailsRow
            content:
              - _type: FormContainer
                _name: RiskClassColA
                content:
                  - _type: TextField
                    _name: RiskClassID
                    label: "Risk Class ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiskClassID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TobaccoBasis
                    label: "Tobacco Basis"
                    dataType: STRING
                    useCustomLabel: true
                    value: TobaccoBasis
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RiskClassColB
                content:
                  - _type: TextField
                    _name: RiskClassCode
                    label: "Risk Class Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiskClassCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: UnderwritingBasis
                    label: "Underwriting Basis"
                    dataType: STRING
                    useCustomLabel: true
                    value: UnderwritingBasis
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RiskClassColC
                content:
                  - _type: TextField
                    _name: RiskClassName
                    label: "Risk Class Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiskClassName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
