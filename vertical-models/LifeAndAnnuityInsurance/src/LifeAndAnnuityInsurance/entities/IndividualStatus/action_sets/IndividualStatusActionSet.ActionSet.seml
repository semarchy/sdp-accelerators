_package: LifeAndAnnuityInsurance.entities.IndividualStatus.action_sets
_type: ActionSet
_name: IndividualStatusActionSet
entity: LifeAndAnnuityInsurance.entities.IndividualStatus.IndividualStatus
label: "Individual Status Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorIndividualStatuses
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.IndividualStatus.steppers.AuthorIndividualStatuses
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorIndividualStatuses
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.IndividualStatus.steppers.AuthorIndividualStatuses
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorIndividualStatuses
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.IndividualStatus.steppers.AuthorIndividualStatuses
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorIndividualStatuses
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.IndividualStatus.steppers.AuthorIndividualStatuses
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
