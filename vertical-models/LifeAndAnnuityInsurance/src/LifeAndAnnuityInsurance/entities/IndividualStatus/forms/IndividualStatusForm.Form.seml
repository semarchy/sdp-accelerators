_package: LifeAndAnnuityInsurance.entities.IndividualStatus.forms
_type: Form
_name: IndividualStatusForm
entity: LifeAndAnnuityInsurance.entities.IndividualStatus.IndividualStatus
default: true
formTabs:
  - _type: FormTab
    _name: IndividualStatus
    label: "Individual Status"
    iconUrl: images://mdi/account-badge-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: IndividualStatusDetails
        label: "Individual Status Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: IndividualStatusDetailsRow
            content:
              - _type: FormContainer
                _name: IndividualStatusColA
                content:
                  - _type: TextField
                    _name: IndividualStatusID
                    label: "Individual Status ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: IndividualStatusID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: StatusCategory
                    label: "Status Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: IndividualStatusColB
                content:
                  - _type: TextField
                    _name: StatusCode
                    label: "Status Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: IndividualStatusColC
                content:
                  - _type: TextField
                    _name: StatusName
                    label: "Status Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
