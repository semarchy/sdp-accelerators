_package: LifeAndAnnuityInsurance.entities.AnnuityContract.action_sets
_type: ActionSet
_name: AnnuityContractActionSet
entity: LifeAndAnnuityInsurance.entities.AnnuityContract.AnnuityContract
label: "Annuity Contract Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorAnnuityContracts
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.AnnuityContract.steppers.AuthorAnnuityContracts
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorAnnuityContracts
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.AnnuityContract.steppers.AuthorAnnuityContracts
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorAnnuityContracts
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.AnnuityContract.steppers.AuthorAnnuityContracts
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorAnnuityContracts
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.AnnuityContract.steppers.AuthorAnnuityContracts
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
