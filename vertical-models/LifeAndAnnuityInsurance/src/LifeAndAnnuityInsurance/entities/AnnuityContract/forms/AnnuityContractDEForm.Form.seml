_package: LifeAndAnnuityInsurance.entities.AnnuityContract.forms
_type: Form
_name: AnnuityContractDEForm
entity: LifeAndAnnuityInsurance.entities.AnnuityContract.AnnuityContract
default: false
formTabs:
  - _type: FormTab
    _name: AnnuityContract
    label: "Annuity Contract"
    iconUrl: images://mdi/calendar-star.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: AnnuityContractDetails
        label: "Annuity Contract Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: AnnuityContractDetailsRow
            content:
              - _type: FormContainer
                _name: AnnuityContractColA
                content:
                  - _type: TextField
                    _name: AnnuityContractID
                    label: "Annuity Contract ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: AnnuityContractID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: IssueDate
                    label: "Issue Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: IssueDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AccumulationValue
                    label: "Accumulation Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: AccumulationValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: IncomeBaseValue
                    label: "Income Base Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: IncomeBaseValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FreeWithdrawalPercentage
                    label: "Free Withdrawal Percentage"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: FreeWithdrawalPercentage
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: AnnuityContractColB
                content:
                  - _type: TextField
                    _name: ContractNumber
                    label: "Contract Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: ContractNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AnnuitizationDate
                    label: "Annuitization Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: AnnuitizationDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: SurrenderValue
                    label: "Surrender Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: SurrenderValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: RMDRequiredIndicator
                    label: "RMDRequired Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: RMDRequiredIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MaturityDate
                    label: "Maturity Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: MaturityDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_TaxQualification
                    label: "Tax Qualification"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.TaxQualification.TaxQualification
                    useCustomLabel: true
                    value: FDN_TaxQualification
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: AnnuityContractColC
                content:
                  - _type: TextField
                    _name: ContractType
                    label: "Contract Type"
                    dataType: STRING
                    useCustomLabel: true
                    value: ContractType
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PayoutStartDate
                    label: "Payout Start Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: PayoutStartDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: GuaranteedMinimumValue
                    label: "Guaranteed Minimum Value"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: GuaranteedMinimumValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: QualifiedIndicator
                    label: "Qualified Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: QualifiedIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_AnnuityPayoutOption
                    label: "Annuity Payout Option"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.AnnuityPayoutOption.AnnuityPayoutOption
                    useCustomLabel: true
                    value: FDN_AnnuityPayoutOption
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
