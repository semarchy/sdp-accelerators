_package: LifeAndAnnuityInsurance.entities.AnnuityContract.collection_views
_type: CollectionView
_name: AnnuityContractCollectionView
entity: LifeAndAnnuityInsurance.entities.AnnuityContract.AnnuityContract
default: true
displayCard: LifeAndAnnuityInsurance.entities.AnnuityContract.display_cards.AnnuityContractDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: "Annuity Contract"
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: AnnuityContractID
    value: AnnuityContractID
    useCustomLabel: false
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: ContractNumber
    value: ContractNumber
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: ContractType
    value: ContractType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: IssueDate
    value: IssueDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: AnnuitizationDate
    value: AnnuitizationDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: PayoutStartDate
    value: PayoutStartDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: AccumulationValue
    value: AccumulationValue
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ ##,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FID_Policy
    columnAlign: LEFT
    dataType: STRING
    label: "Policy"
    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
    useCustomLabel: true
    value: FDN_Policy
    visibleByDefault: true
    defaultWidth: 240
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '240'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FID_TaxQualification
    columnAlign: LEFT
    dataType: STRING
    label: "Tax Qualification"
    referencedEntity: LifeAndAnnuityInsurance.entities.TaxQualification.TaxQualification
    useCustomLabel: true
    value: FDN_TaxQualification
    visibleByDefault: true
    defaultWidth: 240
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '240'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FID_AnnuityPayoutOption
    columnAlign: LEFT
    dataType: STRING
    label: "Annuity Payout Option"
    referencedEntity: LifeAndAnnuityInsurance.entities.AnnuityPayoutOption.AnnuityPayoutOption
    useCustomLabel: true
    value: FDN_AnnuityPayoutOption
    visibleByDefault: true
    defaultWidth: 240
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '240'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
