_package: LifeAndAnnuityInsurance.entities.Coverage.business_views
_type: BusinessView
_name: CoverageBusinessView
label: "Coverage"
entity: LifeAndAnnuityInsurance.entities.Coverage.Coverage
rootLabel: "Coverages"
rootPluralLabel: "Coverages"
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Coverage
  displayCard: LifeAndAnnuityInsurance.entities.Coverage.display_cards.CoverageDisplayCard
  entity: LifeAndAnnuityInsurance.entities.Coverage.Coverage
  actionSet: LifeAndAnnuityInsurance.entities.Coverage.action_sets.CoverageActionSet
  collection: LifeAndAnnuityInsurance.entities.Coverage.collection_views.CoverageCollectionView
  form: LifeAndAnnuityInsurance.entities.Coverage.forms.CoverageForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  transitions:
    - _type: BusinessViewTransition
      _name: Rider
      label: "Rider"
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      pluralLabel: "Riders"
      iconUrl: images://mdi/plus-box-multiple-outline.svg
      transitionPath: Rider
      useCustomLabel: true
      description: "Transition from Coverage to related Riders."
      visibleInFormTabCondition: any Rider has (1=1)
      enableHierarchy: any Rider has (1=1)
      enableHierarchyInterpreter: SEMQL
      expandHierarchyByDefault: false
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: Rider
        displayCard: LifeAndAnnuityInsurance.entities.Rider.display_cards.RiderDisplayCard
        entity: LifeAndAnnuityInsurance.entities.Rider.Rider
        actionSet: LifeAndAnnuityInsurance.entities.Rider.action_sets.RiderActionSet
        collection: LifeAndAnnuityInsurance.entities.Rider.collection_views.RiderCollectionView
        form: LifeAndAnnuityInsurance.entities.Rider.forms.RiderForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
    - _name: MasterRecords
      _type: BusinessViewTransition
      transitionPath: MasterRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/file-tree-outline.svg
      label: Master Records
      pluralLabel: Master Records
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _name: CoverageMasterRecords
        _type: BusinessViewEntity
        displayCard: LifeAndAnnuityInsurance.entities.Coverage.display_cards.CoverageDisplayCard
        collection: LifeAndAnnuityInsurance.entities.Coverage.collection_views.CoverageCollectionView
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        entity: LifeAndAnnuityInsurance.entities.Coverage.Coverage
        form: LifeAndAnnuityInsurance.entities.Coverage.forms.CoverageForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        actionSet: LifeAndAnnuityInsurance.entities.Coverage.action_sets.CoverageActionSet
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: GoldenHistoryRecords
      description: "Transition from Coverage to related golden history records."
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: LifeAndAnnuityInsurance.entities.Coverage.business_views.CoverageBusinessView.Coverage
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
