_name: CoverageAmountCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.Coverage.validations
entity: LifeAndAnnuityInsurance.entities.Coverage.Coverage
label: "Coverage Amount Check"
condition: FaceAmount IS NULL OR FaceAmount >= 0
validationScope: PRE_CONSO
description: "Checks coverage amount check for Coverage."
validationLabel: "FaceAmount must be greater than or equal to zero."
