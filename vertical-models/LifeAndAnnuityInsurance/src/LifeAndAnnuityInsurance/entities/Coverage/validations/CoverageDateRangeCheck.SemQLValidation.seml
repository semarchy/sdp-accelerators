_name: CoverageDateRangeCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.Coverage.validations
entity: LifeAndAnnuityInsurance.entities.Coverage.Coverage
label: "Coverage Date Range Check"
condition: TerminationDate IS NULL OR EffectiveDate IS NULL OR EffectiveDate <= TerminationDate
validationScope: PRE_CONSO
description: "Checks coverage date range check for Coverage."
validationLabel: "TerminationDate must be greater than or equal to EffectiveDate."
