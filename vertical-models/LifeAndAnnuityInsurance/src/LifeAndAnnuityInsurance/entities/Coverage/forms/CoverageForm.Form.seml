_package: LifeAndAnnuityInsurance.entities.Coverage.forms
_type: Form
_name: CoverageForm
entity: LifeAndAnnuityInsurance.entities.Coverage.Coverage
default: true
formTabs:
  - _type: FormTab
    _name: Coverage
    label: "Coverage"
    iconUrl: images://mdi/shield-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: CoverageGeneralSection
        label: "Coverage General"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: CoverageGeneralRow
            content:
              - _type: FormContainer
                _name: CoverageGeneralColA
                content:
                  - _type: TextField
                    _name: CoverageID
                    label: "Coverage ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: CoverageID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CoverageNumber
                    label: "Coverage Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: CoverageNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CoverageName
                    label: "Coverage Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: CoverageName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CoverageType
                    label: "Coverage Type"
                    dataType: STRING
                    useCustomLabel: true
                    value: CoverageType
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: CoverageGeneralColB
                content:
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveDate
                    label: "Effective Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ConversionExpiryDate
                    label: "Conversion Expiry Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: ConversionExpiryDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TerminationDate
                    label: "Termination Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: TerminationDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: IssueAge
                    label: "Issue Age"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: IssueAge
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: CoverageGeneralColC
                content:
                  - _type: TextField
                    _name: FaceAmount
                    label: "Face Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: FaceAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PremiumBasis
                    label: "Premium Basis"
                    dataType: STRING
                    useCustomLabel: true
                    value: PremiumBasis
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DeathBenefitOption
                    label: "Death Benefit Option"
                    dataType: STRING
                    useCustomLabel: true
                    value: DeathBenefitOption
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ReinsuranceIndicator
                    label: "Reinsurance Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ReinsuranceIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: EvidenceOfInsurabilityIndicator
                    label: "Evidence Of Insurability Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: EvidenceOfInsurabilityIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN

      - _type: FormSection
        _name: CoverageClassificationSection
        label: "Classification and Status"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: CoverageClassificationRow
            content:
              - _type: FormContainer
                _name: CoverageClassificationColA
                content:
                  - _type: ReferenceField
                    _name: FDN_CoverageStatus
                    label: "Coverage Status"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.CoverageStatus.CoverageStatus
                    useCustomLabel: true
                    value: FDN_CoverageStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: CoverageClassificationColB
                content:
                  - _type: ReferenceField
                    _name: FDN_BenefitType
                    label: "Benefit Type"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.BenefitType.BenefitType
                    useCustomLabel: true
                    value: FDN_BenefitType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: CoverageClassificationColC
                content:
                  - _type: ReferenceField
                    _name: FDN_RiskClass
                    label: "Risk Class"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.RiskClass.RiskClass
                    useCustomLabel: true
                    value: FDN_RiskClass
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
