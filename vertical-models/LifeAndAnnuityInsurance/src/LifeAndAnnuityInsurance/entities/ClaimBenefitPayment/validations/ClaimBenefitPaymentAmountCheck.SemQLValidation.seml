_name: ClaimBenefitPaymentAmountCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.ClaimBenefitPayment.validations
entity: LifeAndAnnuityInsurance.entities.ClaimBenefitPayment.ClaimBenefitPayment
label: "Claim Benefit Payment Amount Check"
condition: PaymentAmount IS NULL OR PaymentAmount >= 0
validationScope: PRE_CONSO
description: "Checks claim benefit payment amount check for Claim Benefit Payment."
validationLabel: "PaymentAmount must be greater than or equal to zero."
