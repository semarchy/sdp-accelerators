_package: LifeAndAnnuityInsurance.entities.ClaimBenefitPayment.forms
_type: Form
_name: ClaimBenefitPaymentDEForm
entity: LifeAndAnnuityInsurance.entities.ClaimBenefitPayment.ClaimBenefitPayment
default: false
formTabs:
  - _type: FormTab
    _name: ClaimBenefitPayment
    label: "Claim Benefit Payment"
    iconUrl: images://mdi/cash-check.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: ClaimBenefitPaymentDetails
        label: "Claim Benefit Payment Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: ClaimBenefitPaymentDetailsRow
            content:
              - _type: FormContainer
                _name: ClaimBenefitPaymentColA
                content:
                  - _type: TextField
                    _name: ClaimBenefitPaymentID
                    label: "Claim Benefit Payment ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: ClaimBenefitPaymentID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PaymentAmount
                    label: "Payment Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: PaymentAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PaymentMethod
                    label: "Payment Method"
                    dataType: STRING
                    useCustomLabel: true
                    value: PaymentMethod
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_BenefitType
                    label: "Benefit Type"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.BenefitType.BenefitType
                    useCustomLabel: true
                    value: FDN_BenefitType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: ClaimBenefitPaymentColB
                content:
                  - _type: TextField
                    _name: PaymentNumber
                    label: "Payment Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: PaymentNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TaxableAmount
                    label: "Taxable Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: TaxableAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CheckNumber
                    label: "Check Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: CheckNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Claim
                    label: "Claim"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Claim.Claim
                    useCustomLabel: true
                    value: FDN_Claim
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_PaymentStatus
                    label: "Payment Status"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.PaymentStatus.PaymentStatus
                    useCustomLabel: true
                    value: FDN_PaymentStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: ClaimBenefitPaymentColC
                content:
                  - _type: TextField
                    _name: PaymentDate
                    label: "Payment Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: PaymentDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: WithholdingAmount
                    label: "Withholding Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: WithholdingAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EFTTraceNumber
                    label: "EFTTrace Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: EFTTraceNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_PayeeParty
                    label: "Payee Party"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Party.Party
                    useCustomLabel: true
                    value: FDN_PayeeParty
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
