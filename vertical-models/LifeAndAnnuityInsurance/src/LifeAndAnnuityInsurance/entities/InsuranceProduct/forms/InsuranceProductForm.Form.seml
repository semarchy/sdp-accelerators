_package: LifeAndAnnuityInsurance.entities.InsuranceProduct.forms
_type: Form
_name: InsuranceProductForm
entity: LifeAndAnnuityInsurance.entities.InsuranceProduct.InsuranceProduct
default: true
formTabs:
  - _type: FormTab
    _name: InsuranceProduct
    label: "Insurance Product"
    iconUrl: images://mdi/package.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: InsuranceProductDetails
        label: "Insurance Product Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: InsuranceProductDetailsRow
            content:
              - _type: FormContainer
                _name: InsuranceProductColA
                content:
                  - _type: TextField
                    _name: InsuranceProductID
                    label: "Insurance Product ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: InsuranceProductID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ProductDescription
                    label: "Product Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: ProductDescription
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MarketSegment
                    label: "Market Segment"
                    dataType: STRING
                    useCustomLabel: true
                    value: MarketSegment
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: IssueAgeMax
                    label: "Issue Age Max"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: IssueAgeMax
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_ProductType
                    label: "Product Type"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.ProductType.ProductType
                    useCustomLabel: true
                    value: FDN_ProductType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: InsuranceProductColB
                content:
                  - _type: TextField
                    _name: ProductCode
                    label: "Product Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: ProductCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveFrom
                    label: "Effective From"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveFrom
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CarrierCode
                    label: "Carrier Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: CarrierCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_ProductStatus
                    label: "Product Status"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.ProductStatus.ProductStatus
                    useCustomLabel: true
                    value: FDN_ProductStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: InsuranceProductColC
                content:
                  - _type: TextField
                    _name: ProductName
                    label: "Product Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: ProductName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveTo
                    label: "Effective To"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveTo
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: IssueAgeMin
                    label: "Issue Age Min"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: IssueAgeMin
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_LineOfBusiness
                    label: "Line Of Business"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.LineOfBusiness.LineOfBusiness
                    useCustomLabel: true
                    value: FDN_LineOfBusiness
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
