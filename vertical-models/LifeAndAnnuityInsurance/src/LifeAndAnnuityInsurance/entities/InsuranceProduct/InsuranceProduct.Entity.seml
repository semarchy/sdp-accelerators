_package: LifeAndAnnuityInsurance.entities.InsuranceProduct
_type: Entity
_name: InsuranceProduct
label: "Insurance Product"
pluralLabel: "Insurance Products"
physicalTableName: INS_PROD
iconUrl: images://mdi/package.svg
description: "Represents a Life & Annuity product offered by the carrier, including commercial identity, availability, and product governance attributes."
documentation: "Represents a Life & Annuity product offered by the carrier, including commercial identity, availability, and product governance attributes."
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: InsuranceProductID
    label: "Insurance Product ID"
    physicalName: INS_PROD_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the insurance product."
    documentation: "Unique identifier for the insurance product."
  - _type: EntityAttribute
    _name: ProductCode
    label: "Product Code"
    physicalName: PROD_CODE
    dataType: String
    length: 50
    mandatory: false
    searchable: true
    description: "Enterprise product code."
    documentation: "Enterprise product code."
  - _type: EntityAttribute
    _name: ProductName
    label: "Product Name"
    physicalName: PROD_NAME
    dataType: String
    length: 255
    mandatory: false
    searchable: true
    description: "Commercial or marketing name of the product."
    documentation: "Commercial or marketing name of the product."
  - _type: EntityAttribute
    _name: ProductDescription
    label: "Product Description"
    physicalName: PROD_DESC_TEXT
    dataType: LongText
    mandatory: false
    searchable: true
    description: "Detailed explanation of product features and target market."
    documentation: "Detailed explanation of product features and target market."
  - _type: EntityAttribute
    _name: EffectiveFrom
    label: "Effective From"
    physicalName: EFF_FROM
    dataType: Date
    mandatory: false
    searchable: true
    description: "Date from which the product configuration is effective."
    documentation: "Date from which the product configuration is effective."
  - _type: EntityAttribute
    _name: EffectiveTo
    label: "Effective To"
    physicalName: EFF_TO
    dataType: Date
    mandatory: false
    searchable: true
    description: "Date until which the product configuration remains effective."
    documentation: "Date until which the product configuration remains effective."
  - _type: EntityAttribute
    _name: MarketSegment
    label: "Market Segment"
    physicalName: MKT_SEGMENT
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Target market segment for the product."
    documentation: "Target market segment for the product."
  - _type: EntityAttribute
    _name: CarrierCode
    label: "Carrier Code"
    physicalName: CARRIER_CODE
    dataType: String
    length: 50
    mandatory: false
    searchable: true
    description: "Carrier or issuing company code."
    documentation: "Carrier or issuing company code."
  - _type: EntityAttribute
    _name: IssueAgeMin
    label: "Issue Age Min"
    physicalName: ISSUE_AGE_MIN
    dataType: Decimal
    precision: 9
    scale: 0
    mandatory: false
    searchable: true
    description: "Minimum issue age for the product."
    documentation: "Minimum issue age for the product."
  - _type: EntityAttribute
    _name: IssueAgeMax
    label: "Issue Age Max"
    physicalName: ISSUE_AGE_MAX
    dataType: Decimal
    precision: 9
    scale: 0
    mandatory: false
    searchable: true
    description: "Maximum issue age for the product."
    documentation: "Maximum issue age for the product."
  - _type: EntityAttribute
    _name: ActiveIndicator
    label: "Active Indicator"
    physicalName: ACTIVE_IND
    dataType: Boolean
    length: 1
    mandatory: false
    searchable: true
    description: "Indicates whether the product is active."
    documentation: "Indicates whether the product is active."
sourceIdGeneration:
  mode: MANUAL
primaryKey: LifeAndAnnuityInsurance.entities.InsuranceProduct.InsuranceProduct.InsuranceProductID
entityType: BASIC
