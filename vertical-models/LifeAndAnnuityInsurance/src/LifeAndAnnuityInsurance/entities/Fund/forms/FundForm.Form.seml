_package: LifeAndAnnuityInsurance.entities.Fund.forms
_type: Form
_name: FundForm
entity: LifeAndAnnuityInsurance.entities.Fund.Fund
default: true
formTabs:
  - _type: FormTab
    _name: Fund
    label: "Fund"
    iconUrl: images://mdi/chart-line.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: FundDetails
        label: "Fund Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: FundDetailsRow
            content:
              - _type: FormContainer
                _name: FundColA
                content:
                  - _type: TextField
                    _name: FundID
                    label: "Fund ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: FundID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FundFamily
                    label: "Fund Family"
                    dataType: STRING
                    useCustomLabel: true
                    value: FundFamily
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ExpenseRatio
                    label: "Expense Ratio"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: ExpenseRatio
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: FundColB
                content:
                  - _type: TextField
                    _name: FundCode
                    label: "Fund Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: FundCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AssetClass
                    label: "Asset Class"
                    dataType: STRING
                    useCustomLabel: true
                    value: AssetClass
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: InceptionDate
                    label: "Inception Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: InceptionDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: FundColC
                content:
                  - _type: TextField
                    _name: FundName
                    label: "Fund Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: FundName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RiskLevel
                    label: "Risk Level"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiskLevel
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
