documentation: "Defines funds and investment options available for variable life, variable annuity, and allocation-based products."
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: FundID
    label: "Fund ID"
    physicalName: FUND_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the fund."
    documentation: "Unique identifier for the fund."
  - _type: EntityAttribute
    _name: FundCode
    label: "Fund Code"
    physicalName: FUND_CODE
    dataType: String
    length: 30
    mandatory: false
    searchable: true
    description: "Fund or investment option code."
    documentation: "Fund or investment option code."
  - _type: EntityAttribute
    _name: FundName
    label: "Fund Name"
    physicalName: FUND_NAME
    dataType: String
    length: 128
    mandatory: false
    searchable: true
    description: "Business name of the fund or investment option."
    documentation: "Business name of the fund or investment option."
  - _type: EntityAttribute
    _name: FundFamily
    label: "Fund Family"
    physicalName: FUND_FAMILY
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Fund family or manager."
    documentation: "Fund family or manager."
  - _type: EntityAttribute
    _name: AssetClass
    label: "Asset Class"
    physicalName: ASSET_CLASS
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Primary asset class or allocation category."
    documentation: "Primary asset class or allocation category."
  - _type: EntityAttribute
    _name: RiskLevel
    label: "Risk Level"
    physicalName: RISK_LEVEL
    dataType: String
    length: 50
    mandatory: false
    searchable: true
    description: "Relative risk level for the fund."
    documentation: "Relative risk level for the fund."
  - _type: EntityAttribute
    _name: ExpenseRatio
