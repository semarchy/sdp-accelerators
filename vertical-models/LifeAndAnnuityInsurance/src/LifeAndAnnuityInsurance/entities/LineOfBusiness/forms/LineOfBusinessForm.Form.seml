_package: LifeAndAnnuityInsurance.entities.LineOfBusiness.forms
_type: Form
_name: LineOfBusinessForm
entity: LifeAndAnnuityInsurance.entities.LineOfBusiness.LineOfBusiness
default: true
formTabs:
  - _type: FormTab
    _name: LineOfBusiness
    label: "Line Of Business"
    iconUrl: images://mdi/family-tree.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: LineOfBusinessDetails
        label: "Line Of Business Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: LineOfBusinessDetailsRow
            content:
              - _type: FormContainer
                _name: LineOfBusinessColA
                content:
                  - _type: TextField
                    _name: LineOfBusinessID
                    label: "Line Of Business ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: LineOfBusinessID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MarketSegment
                    label: "Market Segment"
                    dataType: STRING
                    useCustomLabel: true
                    value: MarketSegment
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveTo
                    label: "Effective To"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveTo
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfBusinessColB
                content:
                  - _type: TextField
                    _name: LOBCode
                    label: "LOBCode"
                    dataType: STRING
                    useCustomLabel: true
                    value: LOBCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfBusinessColC
                content:
                  - _type: TextField
                    _name: LOBName
                    label: "LOBName"
                    dataType: STRING
                    useCustomLabel: true
                    value: LOBName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveFrom
                    label: "Effective From"
                    dataType: DATE
                    useCustomLabel: true
                    value: EffectiveFrom
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
