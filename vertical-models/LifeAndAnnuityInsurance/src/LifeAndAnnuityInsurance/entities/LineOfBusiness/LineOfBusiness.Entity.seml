    searchable: true
    description: "Unique identifier for the line of business."
    documentation: "Unique identifier for the line of business."
  - _type: EntityAttribute
    _name: LOBCode
    label: "LOBCode"
    physicalName: LOB_CODE
    dataType: String
    length: 30
    mandatory: false
    searchable: true
    description: "Enterprise line-of-business code."
    documentation: "Enterprise line-of-business code."
  - _type: EntityAttribute
    _name: LOBName
    label: "LOBName"
    physicalName: LOB_NAME
    dataType: String
    length: 128
    mandatory: false
    searchable: true
    description: "Business name of the line of business."
    documentation: "Business name of the line of business."
  - _type: EntityAttribute
    _name: MarketSegment
    label: "Market Segment"
    physicalName: MKT_SEGMENT
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Market segment served by the line of business."
    documentation: "Market segment served by the line of business."
  - _type: EntityAttribute
    _name: Description
