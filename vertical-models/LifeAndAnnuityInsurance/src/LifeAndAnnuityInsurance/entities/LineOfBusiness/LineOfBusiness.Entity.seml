    documentation: "Business description and governance purpose of the line of business."
  - _type: EntityAttribute
    _name: EffectiveFrom
    label: "Effective From"
    physicalName: EFF_FROM
    dataType: Date
    mandatory: false
    searchable: true
    description: "Date from which the line of business is effective."
