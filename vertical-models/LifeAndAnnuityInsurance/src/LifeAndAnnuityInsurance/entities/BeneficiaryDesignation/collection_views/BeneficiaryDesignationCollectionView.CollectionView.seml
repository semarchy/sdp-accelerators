_package: LifeAndAnnuityInsurance.entities.BeneficiaryDesignation.collection_views
_type: CollectionView
_name: BeneficiaryDesignationCollectionView
entity: LifeAndAnnuityInsurance.entities.BeneficiaryDesignation.BeneficiaryDesignation
default: true
displayCard: LifeAndAnnuityInsurance.entities.BeneficiaryDesignation.display_cards.BeneficiaryDesignationDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: "Beneficiary Designation"
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: TextColumn
    _name: DesignationDate
    value: DesignationDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: DesignationType
    value: DesignationType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: BeneficiaryClass
    value: BeneficiaryClass
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: PercentageShare
    value: PercentageShare
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: LEFT
    visibleByDefault: true
  - _type: CheckboxColumn
    _name: PerStirpesIndicator
    value: PerStirpesIndicator
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: true
  - _type: CheckboxColumn
    _name: RevocableIndicator
    value: RevocableIndicator
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FID_Policy
    columnAlign: LEFT
    dataType: STRING
    label: "Policy"
    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
    useCustomLabel: true
    value: FDN_Policy
    visibleByDefault: true
    defaultWidth: 240
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '240'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FID_BeneficiaryParty
    columnAlign: LEFT
    dataType: STRING
    label: "Beneficiary Party"
    referencedEntity: LifeAndAnnuityInsurance.entities.Party.Party
    useCustomLabel: true
    value: FDN_BeneficiaryParty
    visibleByDefault: true
    defaultWidth: 240
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '240'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
