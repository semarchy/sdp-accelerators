_package: LifeAndAnnuityInsurance.entities.BeneficiaryDesignation.forms
_type: Form
_name: BeneficiaryDesignationForm
entity: LifeAndAnnuityInsurance.entities.BeneficiaryDesignation.BeneficiaryDesignation
default: true
formTabs:
  - _type: FormTab
    _name: BeneficiaryDesignation
    label: "Beneficiary Designation"
    iconUrl: images://mdi/account-heart-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: BeneficiaryDesignationDetails
        label: "Beneficiary Designation Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: BeneficiaryDesignationDetailsRow
            content:
              - _type: FormContainer
                _name: BeneficiaryDesignationColA
                content:
                  - _type: TextField
                    _name: BeneficiaryDesignationID
                    label: "Beneficiary Designation ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: BeneficiaryDesignationID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: BeneficiaryClass
                    label: "Beneficiary Class"
                    dataType: STRING
                    useCustomLabel: true
                    value: BeneficiaryClass
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: RevocableIndicator
                    label: "Revocable Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: RevocableIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: MinorIndicator
                    label: "Minor Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: MinorIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_BeneficiaryParty
                    label: "Beneficiary Party"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Party.Party
                    useCustomLabel: true
                    value: FDN_BeneficiaryParty
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: BeneficiaryDesignationColB
                content:
                  - _type: TextField
                    _name: DesignationDate
                    label: "Designation Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: DesignationDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PercentageShare
                    label: "Percentage Share"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: PercentageShare
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ContingencyLevel
                    label: "Contingency Level"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: ContingencyLevel
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: BeneficiaryDesignationColC
                content:
                  - _type: TextField
                    _name: DesignationType
                    label: "Designation Type"
                    dataType: STRING
                    useCustomLabel: true
                    value: DesignationType
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: PerStirpesIndicator
                    label: "Per Stirpes Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: PerStirpesIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: TrustIndicator
                    label: "Trust Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: TrustIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
