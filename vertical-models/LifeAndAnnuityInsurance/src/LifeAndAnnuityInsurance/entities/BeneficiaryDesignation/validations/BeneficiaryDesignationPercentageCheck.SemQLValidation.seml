_name: BeneficiaryDesignationPercentageCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.BeneficiaryDesignation.validations
entity: LifeAndAnnuityInsurance.entities.BeneficiaryDesignation.BeneficiaryDesignation
label: "Beneficiary Designation Percentage Check"
condition: PercentageShare IS NULL OR (PercentageShare >= 0 AND PercentageShare <= 100)
validationScope: PRE_CONSO
description: "Checks beneficiary designation percentage check for Beneficiary Designation."
validationLabel: "PercentageShare must be between 0 and 100."
