_package: LifeAndAnnuityInsurance.entities.RiderType.forms
_type: Form
_name: RiderTypeForm
entity: LifeAndAnnuityInsurance.entities.RiderType.RiderType
default: true
formTabs:
  - _type: FormTab
    _name: RiderType
    label: "Rider Type"
    iconUrl: images://mdi/plus-box-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: RiderTypeDetails
        label: "Rider Type Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: RiderTypeDetailsRow
            content:
              - _type: FormContainer
                _name: RiderTypeColA
                content:
                  - _type: TextField
                    _name: RiderTypeID
                    label: "Rider Type ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiderTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RiderCategory
                    label: "Rider Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiderCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: AvailableForAnnuity
                    label: "Available For Annuity"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: AvailableForAnnuity
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RiderTypeColB
                content:
                  - _type: TextField
                    _name: RiderCode
                    label: "Rider Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiderCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RiderTypeColC
                content:
                  - _type: TextField
                    _name: RiderName
                    label: "Rider Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: RiderName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: AvailableForLife
                    label: "Available For Life"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: AvailableForLife
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
