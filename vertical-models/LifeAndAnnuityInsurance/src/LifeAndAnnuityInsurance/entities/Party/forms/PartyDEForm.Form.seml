_package: LifeAndAnnuityInsurance.entities.Party.forms
_type: Form
_name: PartyDEForm
entity: LifeAndAnnuityInsurance.entities.Party.Party
default: false
formTabs:
  - _type: FormTab
    _name: Party
    label: "Party"
    iconUrl: images://mdi/account-multiple-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PartyDetails
        label: "Party Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PartyDetailsRow
            content:
              - _type: FormContainer
                _name: PartyColA
                content:
                  - _type: TextField
                    _name: PartyID
                    label: "Party ID"
                    dataType: LONG_INTEGER
                    useCustomLabel: true
                    value: PartyID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PartyStartDate
                    label: "Party Start Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: PartyStartDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: SourceRecordID
                    label: "Source Record ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: SourceRecordID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PartyColB
                content:
                  - _type: TextField
                    _name: PartyNumber
                    label: "Party Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: PartyNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PartyEndDate
                    label: "Party End Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: PartyEndDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: VerificationDate
                    label: "Verification Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: VerificationDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Individual
                    label: "Individual"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Individual.Individual
                    useCustomLabel: true
                    value: FDN_Individual
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PartyColC
                content:
                  - _type: MenuField
                    _name: PartyType
                    label: "Party Type"
                    dataType: STRING
                    useCustomLabel: true
                    value: PartyType
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: SourceSystem
                    label: "Source System"
                    dataType: STRING
                    useCustomLabel: true
                    value: SourceSystem
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: VerifiedIndicator
                    label: "Verified Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: VerifiedIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_PartyStatus
                    label: "Party Status"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.PartyStatus.PartyStatus
                    useCustomLabel: true
                    value: FDN_PartyStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
