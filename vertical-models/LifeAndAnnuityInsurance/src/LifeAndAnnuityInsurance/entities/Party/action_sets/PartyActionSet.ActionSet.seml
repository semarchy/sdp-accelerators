_package: LifeAndAnnuityInsurance.entities.Party.action_sets
_type: ActionSet
_name: PartyActionSet
entity: LifeAndAnnuityInsurance.entities.Party.Party
label: "Party Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorParties
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Party.steppers.AuthorParties
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorParties
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Party.steppers.AuthorParties
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorParties
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Party.steppers.AuthorParties
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorParties
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.Party.steppers.AuthorParties
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
