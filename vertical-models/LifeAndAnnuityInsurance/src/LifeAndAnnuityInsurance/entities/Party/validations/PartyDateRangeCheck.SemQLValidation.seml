_name: PartyDateRangeCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.Party.validations
entity: LifeAndAnnuityInsurance.entities.Party.Party
label: "Party Date Range Check"
condition: PartyEndDate IS NULL OR PartyStartDate IS NULL OR PartyStartDate <= PartyEndDate
validationScope: PRE_CONSO
description: "Checks party date range check for Party."
validationLabel: "PartyEndDate must be greater than or equal to PartyStartDate."
