_package: LifeAndAnnuityInsurance.entities.Individual.business_views
_type: BusinessView
_name: IndividualBusinessView
label: "Individual"
entity: LifeAndAnnuityInsurance.entities.Individual.Individual
rootLabel: "Individuals"
rootPluralLabel: "Individuals"
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Individual
  displayCard: LifeAndAnnuityInsurance.entities.Individual.display_cards.IndividualDisplayCard
  entity: LifeAndAnnuityInsurance.entities.Individual.Individual
  actionSet: LifeAndAnnuityInsurance.entities.Individual.action_sets.IndividualActionSet
  collection: LifeAndAnnuityInsurance.entities.Individual.collection_views.IndividualCollectionView
  form: LifeAndAnnuityInsurance.entities.Individual.forms.IndividualForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  transitions:
    - _type: BusinessViewTransition
      _name: Party
      label: "Party"
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      pluralLabel: "Parties"
      iconUrl: images://mdi/account-multiple-outline.svg
      transitionPath: Party
      useCustomLabel: true
      description: "Transition from Individual to related Parties."
      visibleInFormTabCondition: any Party has (1=1)
      enableHierarchy: any Party has (1=1)
      enableHierarchyInterpreter: SEMQL
      expandHierarchyByDefault: false
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: Party
        displayCard: LifeAndAnnuityInsurance.entities.Party.display_cards.PartyDisplayCard
        entity: LifeAndAnnuityInsurance.entities.Party.Party
        actionSet: LifeAndAnnuityInsurance.entities.Party.action_sets.PartyActionSet
        collection: LifeAndAnnuityInsurance.entities.Party.collection_views.PartyCollectionView
        form: LifeAndAnnuityInsurance.entities.Party.forms.PartyForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
    - _name: MasterRecords
      _type: BusinessViewTransition
      transitionPath: MasterRecords
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/file-tree-outline.svg
      label: Master Records
      pluralLabel: Master Records
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _name: IndividualMasterRecords
        _type: BusinessViewEntity
        displayCard: LifeAndAnnuityInsurance.entities.Individual.display_cards.IndividualDisplayCard
        collection: LifeAndAnnuityInsurance.entities.Individual.collection_views.IndividualCollectionView
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        entity: LifeAndAnnuityInsurance.entities.Individual.Individual
        form: LifeAndAnnuityInsurance.entities.Individual.forms.IndividualForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        actionSet: LifeAndAnnuityInsurance.entities.Individual.action_sets.IndividualActionSet
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: GoldenHistoryRecords
      description: "Transition from Individual to related golden history records."
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: LifeAndAnnuityInsurance.entities.Individual.business_views.IndividualBusinessView.Individual
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true
