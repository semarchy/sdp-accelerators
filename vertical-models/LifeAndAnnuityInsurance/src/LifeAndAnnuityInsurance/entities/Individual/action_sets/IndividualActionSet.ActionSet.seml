_package: LifeAndAnnuityInsurance.entities.Individual.action_sets
_type: ActionSet
_name: IndividualActionSet
entity: LifeAndAnnuityInsurance.entities.Individual.Individual
label: "Individual Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorIndividuals
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Individual.steppers.AuthorIndividuals
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorIndividuals
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Individual.steppers.AuthorIndividuals
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorIndividuals
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Individual.steppers.AuthorIndividuals
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorIndividuals
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.Individual.steppers.AuthorIndividuals
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
