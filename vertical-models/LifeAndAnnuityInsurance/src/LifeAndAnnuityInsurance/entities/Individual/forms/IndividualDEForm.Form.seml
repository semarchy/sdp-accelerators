_package: LifeAndAnnuityInsurance.entities.Individual.forms
_type: Form
_name: IndividualDEForm
entity: LifeAndAnnuityInsurance.entities.Individual.Individual
default: false
formTabs:
  - _type: FormTab
    _name: Individual
    label: "Individual"
    iconUrl: images://mdi/account-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
