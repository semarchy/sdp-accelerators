      - _type: FormSection
        _name: IndividualDetails
        label: "Individual Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: IndividualDetailsRow
            content:
              - _type: FormContainer
                _name: IndividualColA
                content:
                  - _type: TextField
                    _name: IndividualID
                    label: "Individual ID"
                    dataType: LONG_INTEGER
                    useCustomLabel: true
                    value: IndividualID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MiddleName
                    label: "Middle Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: MiddleName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
