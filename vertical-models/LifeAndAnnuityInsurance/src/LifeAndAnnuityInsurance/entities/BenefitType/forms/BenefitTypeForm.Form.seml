_package: LifeAndAnnuityInsurance.entities.BenefitType.forms
_type: Form
_name: BenefitTypeForm
entity: LifeAndAnnuityInsurance.entities.BenefitType.BenefitType
default: true
formTabs:
  - _type: FormTab
    _name: BenefitType
    label: "Benefit Type"
    iconUrl: images://mdi/gift-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: BenefitTypeDetails
        label: "Benefit Type Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: BenefitTypeDetailsRow
            content:
              - _type: FormContainer
                _name: BenefitTypeColA
                content:
                  - _type: TextField
                    _name: BenefitTypeID
                    label: "Benefit Type ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: BenefitTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: BenefitCategory
                    label: "Benefit Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: BenefitCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: BenefitTypeColB
                content:
                  - _type: TextField
                    _name: BenefitCode
                    label: "Benefit Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: BenefitCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: BenefitTypeColC
                content:
                  - _type: TextField
                    _name: BenefitName
                    label: "Benefit Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: BenefitName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: TaxableIndicator
                    label: "Taxable Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: TaxableIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
