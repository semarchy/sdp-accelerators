_package: LifeAndAnnuityInsurance.entities.ProductStatus.action_sets
_type: ActionSet
_name: ProductStatusActionSet
entity: LifeAndAnnuityInsurance.entities.ProductStatus.ProductStatus
label: "Product Status Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorProductStatuses
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.ProductStatus.steppers.AuthorProductStatuses
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorProductStatuses
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.ProductStatus.steppers.AuthorProductStatuses
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorProductStatuses
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.ProductStatus.steppers.AuthorProductStatuses
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorProductStatuses
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.ProductStatus.steppers.AuthorProductStatuses
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
