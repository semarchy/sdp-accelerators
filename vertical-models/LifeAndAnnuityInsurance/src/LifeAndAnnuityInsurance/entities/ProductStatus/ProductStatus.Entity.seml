_package: LifeAndAnnuityInsurance.entities.ProductStatus
_type: Entity
_name: ProductStatus
label: "Product Status"
pluralLabel: "Product Statuses"
physicalTableName: PROD_STAT
iconUrl: images://mdi/package-check.svg
description: "Defines product lifecycle statuses used to govern product availability and retirement."
documentation: "Defines product lifecycle statuses used to govern product availability and retirement."
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: ProductStatusID
    label: "Product Status ID"
    physicalName: PROD_STAT_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the product status."
    documentation: "Unique identifier for the product status."
  - _type: EntityAttribute
    _name: StatusCode
    label: "Status Code"
    physicalName: STAT_CODE
    dataType: String
    length: 30
    mandatory: false
    searchable: true
    description: "Product status code."
    documentation: "Product status code."
  - _type: EntityAttribute
    _name: StatusName
    label: "Status Name"
    physicalName: STAT_NAME
    dataType: String
    length: 128
    mandatory: false
    searchable: true
    description: "Product status name."
    documentation: "Product status name."
  - _type: EntityAttribute
    _name: StatusCategory
    label: "Status Category"
    physicalName: STAT_CATEGORY
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Lifecycle category for the product status."
    documentation: "Lifecycle category for the product status."
  - _type: EntityAttribute
    _name: Description
    label: "Description"
    physicalName: DESC_TEXT
    dataType: LongText
    mandatory: false
    searchable: true
    description: "Business meaning and use of the product status."
    documentation: "Business meaning and use of the product status."
  - _type: EntityAttribute
    _name: ActiveIndicator
    label: "Active Indicator"
    physicalName: ACTIVE_IND
    dataType: Boolean
    length: 1
    mandatory: false
    searchable: true
    description: "Indicates whether the product status is active."
    documentation: "Indicates whether the product status is active."
sourceIdGeneration:
  mode: MANUAL
primaryKey: LifeAndAnnuityInsurance.entities.ProductStatus.ProductStatus.ProductStatusID
entityType: BASIC
