_package: LifeAndAnnuityInsurance.entities.DistributionChannel.forms
_type: Form
_name: DistributionChannelForm
entity: LifeAndAnnuityInsurance.entities.DistributionChannel.DistributionChannel
default: true
formTabs:
  - _type: FormTab
    _name: DistributionChannel
    label: "Distribution Channel"
    iconUrl: images://mdi/source-branch.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: DistributionChannelDetails
        label: "Distribution Channel Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: DistributionChannelDetailsRow
            content:
              - _type: FormContainer
                _name: DistributionChannelColA
                content:
                  - _type: TextField
                    _name: DistributionChannelID
                    label: "Distribution Channel ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: DistributionChannelID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ChannelType
                    label: "Channel Type"
                    dataType: STRING
                    useCustomLabel: true
                    value: ChannelType
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: DistributionChannelColB
                content:
                  - _type: TextField
                    _name: ChannelCode
                    label: "Channel Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: ChannelCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: DistributionChannelColC
                content:
                  - _type: TextField
                    _name: ChannelName
                    label: "Channel Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: ChannelName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
