_package: LifeAndAnnuityInsurance.entities.ProductType.forms
_type: Form
_name: ProductTypeForm
entity: LifeAndAnnuityInsurance.entities.ProductType.ProductType
default: true
formTabs:
  - _type: FormTab
    _name: ProductType
    label: "Product Type"
    iconUrl: images://mdi/shape-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: ProductTypeDetails
        label: "Product Type Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: ProductTypeDetailsRow
            content:
              - _type: FormContainer
                _name: ProductTypeColA
                content:
                  - _type: TextField
                    _name: ProductTypeID
                    label: "Product Type ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: ProductTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ProductFamily
                    label: "Product Family"
                    dataType: STRING
                    useCustomLabel: true
                    value: ProductFamily
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TaxTreatment
                    label: "Tax Treatment"
                    dataType: STRING
                    useCustomLabel: true
                    value: TaxTreatment
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: ProductTypeColB
                content:
                  - _type: TextField
                    _name: ProductTypeCode
                    label: "Product Type Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: ProductTypeCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: ProductTypeColC
                content:
                  - _type: TextField
                    _name: ProductTypeName
                    label: "Product Type Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: ProductTypeName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: LifeOrAnnuityIndicator
                    label: "Life Or Annuity Indicator"
                    dataType: STRING
                    useCustomLabel: true
                    value: LifeOrAnnuityIndicator
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
