_package: LifeAndAnnuityInsurance.entities.ProductType.business_views
_type: BusinessView
_name: ProductTypeBusinessView
label: "Product Type"
entity: LifeAndAnnuityInsurance.entities.ProductType.ProductType
rootLabel: "Product Types"
rootPluralLabel: "Product Types"
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: ProductType
  displayCard: LifeAndAnnuityInsurance.entities.ProductType.display_cards.ProductTypeDisplayCard
  entity: LifeAndAnnuityInsurance.entities.ProductType.ProductType
  actionSet: LifeAndAnnuityInsurance.entities.ProductType.action_sets.ProductTypeActionSet
  collection: LifeAndAnnuityInsurance.entities.ProductType.collection_views.ProductTypeCollectionView
  form: LifeAndAnnuityInsurance.entities.ProductType.forms.ProductTypeForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  transitions:
    - _type: BusinessViewTransition
      _name: InsuranceProduct
      label: "Insurance Product"
      transitionType: FULLY_QUALIFIED
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      pluralLabel: "Insurance Products"
      iconUrl: images://mdi/package.svg
      transitionPath: InsuranceProduct
      useCustomLabel: true
      description: "Transition from Product Type to related Insurance Products."
      visibleInFormTabCondition: any InsuranceProduct has (1=1)
      enableHierarchy: any InsuranceProduct has (1=1)
      enableHierarchyInterpreter: SEMQL
      expandHierarchyByDefault: false
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntity
        _name: InsuranceProduct
        displayCard: LifeAndAnnuityInsurance.entities.InsuranceProduct.display_cards.InsuranceProductDisplayCard
        entity: LifeAndAnnuityInsurance.entities.InsuranceProduct.InsuranceProduct
        actionSet: LifeAndAnnuityInsurance.entities.InsuranceProduct.action_sets.InsuranceProductActionSet
        collection: LifeAndAnnuityInsurance.entities.InsuranceProduct.collection_views.InsuranceProductCollectionView
        form: LifeAndAnnuityInsurance.entities.InsuranceProduct.forms.InsuranceProductForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true
enableHierarchyView: false
useHierarchyOnOpen: false
rootIconUrl: images://mdi/shape-outline.svg
