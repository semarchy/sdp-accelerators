_package: LifeAndAnnuityInsurance.entities.ProductType.action_sets
_type: ActionSet
_name: ProductTypeActionSet
entity: LifeAndAnnuityInsurance.entities.ProductType.ProductType
label: "Product Type Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorProductTypes
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.ProductType.steppers.AuthorProductTypes
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorProductTypes
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.ProductType.steppers.AuthorProductTypes
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorProductTypes
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.ProductType.steppers.AuthorProductTypes
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorProductTypes
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.ProductType.steppers.AuthorProductTypes
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
