    documentation: "Ownership percentage held by the party, if applicable."
  - _type: EntityAttribute
    _name: BeneficiaryPercentage
    label: "Beneficiary Percentage"
    physicalName: BEN_PCT
    dataType: Decimal
    precision: 9
    scale: 4
    mandatory: false
