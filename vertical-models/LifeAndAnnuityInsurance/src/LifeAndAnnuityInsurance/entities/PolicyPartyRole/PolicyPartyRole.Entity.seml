_package: LifeAndAnnuityInsurance.entities.PolicyPartyRole
_type: Entity
_name: PolicyPartyRole
label: "Policy Party Role"
pluralLabel: "Policy Party Roles"
physicalTableName: POL_PARTY_ROLE
iconUrl: images://mdi/account-switch-outline.svg
description: "Associates a party to a policy in a specific role, enabling the same party to be an owner, insured, annuitant, beneficiary, payer, trustee, producer, assignee, or claimant."
documentation: "Associates a party to a policy in a specific role, enabling the same party to be an owner, insured, annuitant, beneficiary, payer, trustee, producer, assignee, or claimant."
historizeGolden: true
historizeMaster: true
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: PolicyPartyRoleID
    label: "Policy Party Role ID"
    physicalName: POL_PARTY_ROLE_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for the policy party role."
    documentation: "Unique identifier for the policy party role."
  - _type: EntityAttribute
    _name: RoleEffectiveDate
    label: "Role Effective Date"
    physicalName: ROLE_EFF_DATE
    dataType: Date
    mandatory: false
    searchable: true
    description: "Date from which the party role is effective."
    documentation: "Date from which the party role is effective."
