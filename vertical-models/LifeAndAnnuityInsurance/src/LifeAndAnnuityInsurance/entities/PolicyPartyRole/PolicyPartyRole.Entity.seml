    documentation: "Indicates whether the role or designation is revocable."
  - _type: EntityAttribute
    _name: PrimaryIndicator
    label: "Primary Indicator"
    physicalName: PRIMARY_IND
    dataType: Boolean
    length: 1
    mandatory: false
    searchable: true
