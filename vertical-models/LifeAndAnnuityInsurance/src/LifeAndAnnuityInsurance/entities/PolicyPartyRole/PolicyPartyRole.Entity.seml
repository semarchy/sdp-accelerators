    label: "Role End Date"
    physicalName: ROLE_END_DATE
    dataType: Date
    mandatory: false
    searchable: true
    description: "Date on which the party role ended, if applicable."
    documentation: "Date on which the party role ended, if applicable."
  - _type: EntityAttribute
    _name: RoleStatus
    label: "Role Status"
    physicalName: ROLE_STAT
    dataType: String
    length: 50
    mandatory: false
    searchable: true
