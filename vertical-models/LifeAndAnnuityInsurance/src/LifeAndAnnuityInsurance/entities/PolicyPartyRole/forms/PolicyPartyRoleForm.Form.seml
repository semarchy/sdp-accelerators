                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: OwnershipPercentage
                    label: "Ownership Percentage"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: OwnershipPercentage
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
