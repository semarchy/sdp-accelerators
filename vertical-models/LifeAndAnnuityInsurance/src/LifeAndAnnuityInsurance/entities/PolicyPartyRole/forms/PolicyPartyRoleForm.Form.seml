_package: LifeAndAnnuityInsurance.entities.PolicyPartyRole.forms
_type: Form
_name: PolicyPartyRoleForm
entity: LifeAndAnnuityInsurance.entities.PolicyPartyRole.PolicyPartyRole
default: true
formTabs:
  - _type: FormTab
    _name: PolicyPartyRole
    label: "Policy Party Role"
    iconUrl: images://mdi/account-switch-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PolicyPartyRoleDetails
        label: "Policy Party Role Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PolicyPartyRoleDetailsRow
            content:
              - _type: FormContainer
                _name: PolicyPartyRoleColA
                content:
                  - _type: TextField
                    _name: PolicyPartyRoleID
                    label: "Policy Party Role ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: PolicyPartyRoleID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RoleStatus
                    label: "Role Status"
                    dataType: STRING
                    useCustomLabel: true
                    value: RoleStatus
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: RevocableIndicator
                    label: "Revocable Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: RevocableIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: InsurableInterestDescription
                    label: "Insurable Interest Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: InsurableInterestDescription
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyPartyRoleColB
                content:
                  - _type: TextField
                    _name: RoleEffectiveDate
                    label: "Role Effective Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: RoleEffectiveDate
