                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: SignatureRequiredIndicator
                    label: "Signature Required Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: SignatureRequiredIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
