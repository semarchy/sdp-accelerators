_name: BeneficiaryPercentageCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.PolicyPartyRole.validations
entity: LifeAndAnnuityInsurance.entities.PolicyPartyRole.PolicyPartyRole
label: "Beneficiary Percentage Check"
condition: BeneficiaryPercentage IS NULL OR (BeneficiaryPercentage >= 0 AND BeneficiaryPercentage <= 100)
validationScope: PRE_CONSO
description: "Checks beneficiary percentage check for Policy Party Role."
validationLabel: "BeneficiaryPercentage must be between 0 and 100."
