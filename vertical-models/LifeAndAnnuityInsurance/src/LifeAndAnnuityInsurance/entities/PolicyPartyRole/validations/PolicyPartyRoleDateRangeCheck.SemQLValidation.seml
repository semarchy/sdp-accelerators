_name: PolicyPartyRoleDateRangeCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.PolicyPartyRole.validations
entity: LifeAndAnnuityInsurance.entities.PolicyPartyRole.PolicyPartyRole
label: "Policy Party Role Date Range Check"
condition: RoleEndDate IS NULL OR RoleEffectiveDate IS NULL OR RoleEffectiveDate <= RoleEndDate
validationScope: PRE_CONSO
description: "Checks policy party role date range check for Policy Party Role."
validationLabel: "RoleEndDate must be greater than or equal to RoleEffectiveDate."
