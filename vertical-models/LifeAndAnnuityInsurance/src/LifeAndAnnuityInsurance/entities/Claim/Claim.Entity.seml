_package: LifeAndAnnuityInsurance.entities.Claim
_type: Entity
_name: Claim
label: "Claim"
pluralLabel: "Claims"
physicalTableName: CLM
iconUrl: images://mdi/file-alert-outline.svg
description: "Represents a Life & Annuity claim event and adjudication status for death, living benefit, surrender, maturity, or annuity income claims."
documentation: "Represents a Life & Annuity claim event and adjudication status for death, living benefit, surrender, maturity, or annuity income claims."
historizeGolden: true
historizeMaster: true
enableDelete: true
