    _name: ClaimType
    label: "Claim Type"
    physicalName: CLM_TYPE
    dataType: String
    length: 80
    mandatory: false
    searchable: true
    description: "Type of claim or benefit request."
    documentation: "Type of claim or benefit request."
  - _type: EntityAttribute
    _name: ClaimStatus
    label: "Claim Status"
    physicalName: CLM_STAT
    dataType: String
    length: 50
    mandatory: false
    searchable: true
    description: "Current claim status."
    documentation: "Current claim status."
  - _type: EntityAttribute
    _name: LossDate
    label: "Loss Date"
    physicalName: LOSS_DATE
    dataType: Date
    mandatory: false
    searchable: true
