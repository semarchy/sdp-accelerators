    mandatory: false
    searchable: true
    description: "Date the claim was reported."
    documentation: "Date the claim was reported."
  - _type: EntityAttribute
    _name: ApprovedDate
    label: "Approved Date"
    physicalName: APPROVED_DATE
    dataType: Date
    mandatory: false
    searchable: true
    description: "Date the claim was approved."
    documentation: "Date the claim was approved."
  - _type: EntityAttribute
    _name: ClosedDate
    label: "Closed Date"
    physicalName: CLOSED_DATE
    dataType: Date
    mandatory: false
    searchable: true
    description: "Date the claim was closed."
    documentation: "Date the claim was closed."
  - _type: EntityAttribute
    _name: ClaimAmount
