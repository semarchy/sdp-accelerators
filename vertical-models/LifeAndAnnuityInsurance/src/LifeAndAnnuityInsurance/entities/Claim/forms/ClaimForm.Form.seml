_package: LifeAndAnnuityInsurance.entities.Claim.forms
_type: Form
_name: ClaimForm
entity: LifeAndAnnuityInsurance.entities.Claim.Claim
default: true
formTabs:
  - _type: FormTab
    _name: Claim
    label: "Claim"
    iconUrl: images://mdi/file-alert-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: ClaimDetails
        label: "Claim Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: ClaimDetailsRow
            content:
              - _type: FormContainer
                _name: ClaimColA
                content:
                  - _type: TextField
                    _name: ClaimID
                    label: "Claim ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: ClaimID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ClaimStatus
                    label: "Claim Status"
                    dataType: STRING
                    useCustomLabel: true
                    value: ClaimStatus
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ApprovedDate
                    label: "Approved Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: ApprovedDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ApprovedAmount
                    label: "Approved Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: ApprovedAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Notes
                    label: "Notes"
                    dataType: STRING
                    useCustomLabel: true
                    value: Notes
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_InsuredParty
                    label: "Insured Party"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Party.Party
                    useCustomLabel: true
                    value: FDN_InsuredParty
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: ClaimColB
                content:
                  - _type: TextField
                    _name: ClaimNumber
                    label: "Claim Number"
                    dataType: STRING
                    useCustomLabel: true
                    value: ClaimNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: LossDate
                    label: "Loss Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: LossDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ClosedDate
                    label: "Closed Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: ClosedDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DenialReason
                    label: "Denial Reason"
                    dataType: STRING
                    useCustomLabel: true
                    value: DenialReason
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Policy
                    label: "Policy"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Policy.Policy
                    useCustomLabel: true
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_BenefitType
                    label: "Benefit Type"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.BenefitType.BenefitType
                    useCustomLabel: true
                    value: FDN_BenefitType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: ClaimColC
                content:
                  - _type: TextField
                    _name: ClaimType
                    label: "Claim Type"
                    dataType: STRING
                    useCustomLabel: true
                    value: ClaimType
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ReportedDate
                    label: "Reported Date"
                    dataType: DATE
                    useCustomLabel: true
                    value: ReportedDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ClaimAmount
                    label: "Claim Amount"
                    dataType: DECIMAL
                    useCustomLabel: true
                    value: ClaimAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ContestabilityReviewIndicator
                    label: "Contestability Review Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ContestabilityReviewIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_ClaimantParty
                    label: "Claimant Party"
                    dataType: STRING
                    referencedEntity: LifeAndAnnuityInsurance.entities.Party.Party
                    useCustomLabel: true
                    value: FDN_ClaimantParty
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
