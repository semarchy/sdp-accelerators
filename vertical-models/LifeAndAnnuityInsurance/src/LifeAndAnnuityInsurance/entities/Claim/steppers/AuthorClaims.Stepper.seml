_package: LifeAndAnnuityInsurance.entities.Claim.steppers
_type: Stepper
_name: AuthorClaims
entity: LifeAndAnnuityInsurance.entities.Claim.Claim
label: "Claims"
rootStep:
  _type: CollectionStep
  _name: Claims
  label: "Claims"
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: LifeAndAnnuityInsurance.entities.Claim.collection_views.ClaimImportCollection
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Claim
      label: "Claim"
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: LifeAndAnnuityInsurance.entities.Claim.forms.ClaimForm.Claim
      formStepValidations:
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          validator: LifeAndAnnuityInsurance.entities.Claim.validations.ClaimReportedDateCheck
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          validator: LifeAndAnnuityInsurance.entities.Claim.validations.ClaimAmountCheck
