_name: ClaimAmountCheck
_type: SemQLValidation
_package: LifeAndAnnuityInsurance.entities.Claim.validations
entity: LifeAndAnnuityInsurance.entities.Claim.Claim
label: "Claim Amount Check"
condition: ClaimAmount IS NULL OR ClaimAmount >= 0
validationScope: PRE_CONSO
description: "Checks claim amount check for Claim."
validationLabel: "ClaimAmount must be greater than or equal to zero."
