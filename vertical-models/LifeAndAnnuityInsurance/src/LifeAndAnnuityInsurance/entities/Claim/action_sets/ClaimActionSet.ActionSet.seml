_package: LifeAndAnnuityInsurance.entities.Claim.action_sets
_type: ActionSet
_name: ClaimActionSet
entity: LifeAndAnnuityInsurance.entities.Claim.Claim
label: "Claim Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorClaims
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Claim.steppers.AuthorClaims
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorClaims
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Claim.steppers.AuthorClaims
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorClaims
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.Claim.steppers.AuthorClaims
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorClaims
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.Claim.steppers.AuthorClaims
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
