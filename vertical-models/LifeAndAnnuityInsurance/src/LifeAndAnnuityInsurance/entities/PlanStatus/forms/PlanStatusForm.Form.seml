_package: LifeAndAnnuityInsurance.entities.PlanStatus.forms
_type: Form
_name: PlanStatusForm
entity: LifeAndAnnuityInsurance.entities.PlanStatus.PlanStatus
default: true
formTabs:
  - _type: FormTab
    _name: PlanStatus
    label: "Plan Status"
    iconUrl: images://mdi/clipboard-check-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PlanStatusDetails
        label: "Plan Status Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PlanStatusDetailsRow
            content:
              - _type: FormContainer
                _name: PlanStatusColA
                content:
                  - _type: TextField
                    _name: PlanStatusID
                    label: "Plan Status ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: PlanStatusID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: StatusCategory
                    label: "Status Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PlanStatusColB
                content:
                  - _type: TextField
                    _name: StatusCode
                    label: "Status Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PlanStatusColC
                content:
                  - _type: TextField
                    _name: StatusName
                    label: "Status Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
