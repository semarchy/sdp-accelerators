_package: LifeAndAnnuityInsurance.entities.PlanStatus.action_sets
_type: ActionSet
_name: PlanStatusActionSet
entity: LifeAndAnnuityInsurance.entities.PlanStatus.PlanStatus
label: "Plan Status Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorPlanStatuses
    label: Create
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.PlanStatus.steppers.AuthorPlanStatuses
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorPlanStatuses
    label: Edit
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.PlanStatus.steppers.AuthorPlanStatuses
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorPlanStatuses
    label: Mass Update
    useCustomLabel: true
    stepper: LifeAndAnnuityInsurance.entities.PlanStatus.steppers.AuthorPlanStatuses
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorPlanStatuses
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: LifeAndAnnuityInsurance.entities.PlanStatus.steppers.AuthorPlanStatuses
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
