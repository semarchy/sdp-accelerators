    documentation: "Plan status code."
  - _type: EntityAttribute
    _name: StatusName
    label: "Status Name"
    physicalName: STAT_NAME
    dataType: String
    length: 128
    mandatory: false
    searchable: true
    description: "Plan status name."
    documentation: "Plan status name."
  - _type: EntityAttribute
