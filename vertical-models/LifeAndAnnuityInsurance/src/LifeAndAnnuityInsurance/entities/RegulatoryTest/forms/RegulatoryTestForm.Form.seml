_package: LifeAndAnnuityInsurance.entities.RegulatoryTest.forms
_type: Form
_name: RegulatoryTestForm
entity: LifeAndAnnuityInsurance.entities.RegulatoryTest.RegulatoryTest
default: true
formTabs:
  - _type: FormTab
    _name: RegulatoryTest
    label: "Regulatory Test"
    iconUrl: images://mdi/scale-balance.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: RegulatoryTestDetails
        label: "Regulatory Test Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: RegulatoryTestDetailsRow
            content:
              - _type: FormContainer
                _name: RegulatoryTestColA
                content:
                  - _type: TextField
                    _name: RegulatoryTestID
                    label: "Regulatory Test ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: RegulatoryTestID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RegulationName
                    label: "Regulation Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: RegulationName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RegulatoryTestColB
                content:
                  - _type: TextField
                    _name: TestCode
                    label: "Test Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: TestCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Jurisdiction
                    label: "Jurisdiction"
                    dataType: STRING
                    useCustomLabel: true
                    value: Jurisdiction
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Severity
                    label: "Severity"
                    dataType: STRING
                    useCustomLabel: true
                    value: Severity
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RegulatoryTestColC
                content:
                  - _type: TextField
                    _name: TestName
                    label: "Test Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: TestName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Frequency
                    label: "Frequency"
                    dataType: STRING
                    useCustomLabel: true
                    value: Frequency
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
