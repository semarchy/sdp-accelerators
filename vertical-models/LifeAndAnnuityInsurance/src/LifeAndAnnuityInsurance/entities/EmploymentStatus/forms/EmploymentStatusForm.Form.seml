_package: LifeAndAnnuityInsurance.entities.EmploymentStatus.forms
_type: Form
_name: EmploymentStatusForm
entity: LifeAndAnnuityInsurance.entities.EmploymentStatus.EmploymentStatus
default: true
formTabs:
  - _type: FormTab
    _name: EmploymentStatus
    label: "Employment Status"
    iconUrl: images://mdi/briefcase-check-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: EmploymentStatusDetails
        label: "Employment Status Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: EmploymentStatusDetailsRow
            content:
              - _type: FormContainer
                _name: EmploymentStatusColA
                content:
                  - _type: TextField
                    _name: EmploymentStatusID
                    label: "Employment Status ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: EmploymentStatusID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: StatusCategory
                    label: "Status Category"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCategory
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: EmploymentStatusColB
                content:
                  - _type: TextField
                    _name: StatusCode
                    label: "Status Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: EmploymentStatusColC
                content:
                  - _type: TextField
                    _name: StatusName
                    label: "Status Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: StatusName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
