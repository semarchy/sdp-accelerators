_package: LifeAndAnnuityInsurance.entities.PaymentPlan.forms
_type: Form
_name: PaymentPlanForm
entity: LifeAndAnnuityInsurance.entities.PaymentPlan.PaymentPlan
default: true
formTabs:
  - _type: FormTab
    _name: PaymentPlan
    label: "Payment Plan"
    iconUrl: images://mdi/calendar-cash.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: PaymentPlanDetails
        label: "Payment Plan Details"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PaymentPlanDetailsRow
            content:
              - _type: FormContainer
                _name: PaymentPlanColA
                content:
                  - _type: TextField
                    _name: PaymentPlanID
                    label: "Payment Plan ID"
                    dataType: STRING
                    useCustomLabel: true
                    value: PaymentPlanID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: BillingFrequency
                    label: "Billing Frequency"
                    dataType: STRING
                    useCustomLabel: true
                    value: BillingFrequency
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: ActiveIndicator
                    label: "Active Indicator"
                    dataType: BOOLEAN
                    useCustomLabel: true
                    value: ActiveIndicator
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PaymentPlanColB
                content:
                  - _type: TextField
                    _name: PlanCode
                    label: "Plan Code"
                    dataType: STRING
                    useCustomLabel: true
                    value: PlanCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PaymentMode
                    label: "Payment Mode"
                    dataType: STRING
                    useCustomLabel: true
                    value: PaymentMode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PaymentPlanColC
                content:
                  - _type: TextField
                    _name: PlanName
                    label: "Plan Name"
                    dataType: STRING
                    useCustomLabel: true
                    value: PlanName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    label: "Description"
                    dataType: STRING
                    useCustomLabel: true
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
