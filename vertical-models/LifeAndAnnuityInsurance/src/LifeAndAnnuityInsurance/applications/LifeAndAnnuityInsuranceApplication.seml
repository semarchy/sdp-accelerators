_package: LifeAndAnnuityInsurance.applications
_type: Application
_name: LifeAndAnnuityInsuranceApplication
label: Life and Annuity Insurance
visibility: VISIBLE
applicationTitle: Life and Annuity Insurance MDM
avatarImageUrl: images://life-annuity-ins/lna-ins-avatar.png
logoUrl: images://life-annuity-ins/lna-ins-cover.png
coverImageUrl: images://life-annuity-ins/lna-ins-logo.png
favIcon: images://life-annuity-ins/lna-ins-avatar.png
titleColor: md:blue 800
titleBarDefaultColor: md:teal 800
titleBarAuthoringColor: md:green 300
titleBarErrorColor: md:red 300
sortStrategy: POSITION
historyBrowsingEnabled: false
historyBrowsingRequiredRole: ""
defaultAction: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.GlobalSearch
documentationConfig:
  documentation: ""
  documentationConfigDiagrams:
    - _type: DocumentationConfigDiagram
      _name: AllEntitiesDiagram
      modelDiagram: LifeAndAnnuityInsurance.model_diagrams.AllEntities

    - _type: DocumentationConfigDiagram
      _name: ProductDiagram
      modelDiagram: LifeAndAnnuityInsurance.model_diagrams.Product

    - _type: DocumentationConfigDiagram
      _name: PolicyDiagram
      modelDiagram: LifeAndAnnuityInsurance.model_diagrams.Policy

    - _type: DocumentationConfigDiagram
      _name: AnnuitiesDiagram
      modelDiagram: LifeAndAnnuityInsurance.model_diagrams.Annuity

    - _type: DocumentationConfigDiagram
      _name: ClaimsDiagram
      modelDiagram: LifeAndAnnuityInsurance.model_diagrams.Claims

    - _type: DocumentationConfigDiagram
      _name: UnderwritingDiagram
      modelDiagram: LifeAndAnnuityInsurance.model_diagrams.Underwriting
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: false
  globalSearchBusinessViews:
    - _type: GlobalSearchBoView
      _name: Individual
      label: "Individuals"
      viewType: GD
      businessView: LifeAndAnnuityInsurance.entities.Individual.business_views.IndividualBusinessView
      searchTypeConfig: LifeAndAnnuityInsurance.entities.Individual.business_views.IndividualBusinessView.Individual.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: Party
      label: "Parties"
      viewType: GD
      businessView: LifeAndAnnuityInsurance.entities.Party.business_views.PartyBusinessView
      searchTypeConfig: LifeAndAnnuityInsurance.entities.Party.business_views.PartyBusinessView.Party.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: Policy
      label: "Policies"
      viewType: GD
      businessView: LifeAndAnnuityInsurance.entities.Policy.business_views.PolicyBusinessView
      searchTypeConfig: LifeAndAnnuityInsurance.entities.Policy.business_views.PolicyBusinessView.Policy.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: InsuranceProduct
      label: "Insurance Products"
      viewType: GD
      businessView: LifeAndAnnuityInsurance.entities.InsuranceProduct.business_views.InsuranceProductBusinessView
      searchTypeConfig: LifeAndAnnuityInsurance.entities.InsuranceProduct.business_views.InsuranceProductBusinessView.InsuranceProduct.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: AnnuityContract
      label: "Annuity Contracts"
      viewType: GD
      businessView: LifeAndAnnuityInsurance.entities.AnnuityContract.business_views.AnnuityContractBusinessView
      searchTypeConfig: LifeAndAnnuityInsurance.entities.AnnuityContract.business_views.AnnuityContractBusinessView.AnnuityContract.TextConfig
      maxResults: 5
    - _type: GlobalSearchBoView
      _name: Claim
      label: "Claims"
      viewType: GD
      businessView: LifeAndAnnuityInsurance.entities.Claim.business_views.ClaimBusinessView
      searchTypeConfig: LifeAndAnnuityInsurance.entities.Claim.business_views.ClaimBusinessView.Claim.TextConfig
      maxResults: 5
navDrawer:
  - _type: NavigationGroup
    _name: RootFolder
    label: Root Folder
    dividerVisible: false
    labelVisible: false
    actions:
      - appAction: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.MyTasks
      - appAction: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.GlobalSearch
  - _type: FolderNavGroup
    _name: ProductManagement
    dividerVisible: true
    labelVisible: true
    linkedFolder: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.ProductManagement
  - _type: FolderNavGroup
    _name: PartyManagement
    dividerVisible: true
    labelVisible: true
    linkedFolder: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.PartyManagement
  - _type: FolderNavGroup
    _name: PolicyAdministration
    dividerVisible: true
    labelVisible: true
    linkedFolder: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.PolicyAdministration
  - _type: FolderNavGroup
    _name: Underwriting
    dividerVisible: true
    labelVisible: true
    linkedFolder: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.Underwriting
  - _type: FolderNavGroup
    _name: AnnuityAndValues
    dividerVisible: true
    labelVisible: true
    linkedFolder: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.AnnuityAndValues
  - _type: FolderNavGroup
    _name: ClaimsAndBenefits
    dividerVisible: true
    labelVisible: true
    linkedFolder: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.ClaimsAndBenefits

  - _type: FolderNavGroup
    _name: Stewardship
    dividerVisible: true
    labelVisible: true
    linkedFolder: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.Stewardship
  - _type: FolderNavGroup
    _name: Admin
    dividerVisible: true
    labelVisible: true
    linkedFolder: LifeAndAnnuityInsurance.applications.LifeAndAnnuityInsuranceApplication.Root.Admin
rootFolder:
  _type: FolderAction
  _name: Root
  label: Root Folder
  image: images://mdi/folder.svg
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  appActions:
    - _type: MyTasksAction
      _name: MyTasks
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      badgeVisible: false
    - _type: GlobalSearchAction
      _name: GlobalSearch
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
    - _type: FolderAction
      _name: ProductManagement
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      label: "Product Management"
      icon: images://mdi/package-variant-closed.svg
      iconColor: md:blue 700
      labelColor: md:blue 700
      appActions:
        - _type: BrowseBusinessViewAction
          _name: BrowseLineOfBusiness
          businessView: LifeAndAnnuityInsurance.entities.LineOfBusiness.business_views.LineOfBusinessBusinessView
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          iconColor: md:light-blue 600
          labelColor: md:light-blue 600
          label: "Line Of Businesses"
          description: "Browse Line Of Businesses records."
          image: images://life-annuity-ins/lna-ins-line-of-business.png
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
        - _type: BrowseBusinessViewAction
          _name: BrowseInsuranceProduct
          businessView: LifeAndAnnuityInsurance.entities.InsuranceProduct.business_views.InsuranceProductBusinessView
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          iconColor: md:light-blue 600
          labelColor: md:light-blue 600
          label: "Insurance Products"
          description: "Browse Insurance Products records."
          image: images://life-annuity-ins/lna-ins-insurance-product.png
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
        - _type: FolderAction
          _name: ProductConfigurations
          description: "Browse reference data for life and annuity product management."
          label: "Product Configurations"
          icon: images://mdi/cog-outline.svg
          iconColor: md:light-blue 600
          labelColor: md:light-blue 600
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          appActions:
            
            - _type: BrowseBusinessViewAction
              _name: BrowseInsurancePlan
              businessView: LifeAndAnnuityInsurance.entities.InsurancePlan.business_views.InsurancePlanBusinessView
              nbRecordsBadgeVisible: true
              nbRecordsBadgeBackgroundColor: md:green 500
              useSearchOnOpen: false
              iconColor: md:light-blue 800
              labelColor: md:light-blue 800
              label: "Insurance Plans"
              description: "Browse Insurance Plans records."
              image: images://life-annuity-ins/lna-ins-insurance-plan.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
            - _type: BrowseBusinessViewAction
              _name: BrowseProductType
              businessView: LifeAndAnnuityInsurance.entities.ProductType.business_views.ProductTypeBusinessView
              nbRecordsBadgeVisible: true
              nbRecordsBadgeBackgroundColor: md:green 500
              useSearchOnOpen: false
              iconColor: md:teal 800
              labelColor: md:teal 800
              label: "Product Types"
              description: "Browse Product Types records."
              image: images://life-annuity-ins/lna-ins-product-type.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
            - _type: BrowseBusinessViewAction
              _name: BrowseProductStatus
              businessView: LifeAndAnnuityInsurance.entities.ProductStatus.business_views.ProductStatusBusinessView
              nbRecordsBadgeVisible: true
              nbRecordsBadgeBackgroundColor: md:green 500
              useSearchOnOpen: false
              iconColor: md:teal 800
              labelColor: md:teal 800
              label: "Product Statuses"
              description: "Browse Product Statuses records."
              image: images://life-annuity-ins/lna-ins-product-status.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
            - _type: BrowseBusinessViewAction
              _name: BrowsePlanStatus
              businessView: LifeAndAnnuityInsurance.entities.PlanStatus.business_views.PlanStatusBusinessView
              nbRecordsBadgeVisible: true
              nbRecordsBadgeBackgroundColor: md:green 500
              useSearchOnOpen: false
              iconColor: md:teal 800
              labelColor: md:teal 800
              label: "Plan Statuses"
              description: "Browse Plan Statuses records."
              image: images://life-annuity-ins/lna-ins-plan-status.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
            - _type: BrowseBusinessViewAction
              _name: BrowseRegulatoryTest
