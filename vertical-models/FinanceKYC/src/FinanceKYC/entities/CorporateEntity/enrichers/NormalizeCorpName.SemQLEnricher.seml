_package: FinanceKYC.entities.CorporateEntity.enrichers
_name: NormalizeCorpName
_type: SemQLEnricher
entity: FinanceKYC.entities.CorporateEntity.CorporateEntity
label: Normalize Corporate Entity Name
description: 'Normalizes the corporate entity name by trimming whitespace and converting it to uppercase for matching.'
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: NormalizedCorpName
    expression: "RTRIM(LTRIM(UPPER(EntityName)))"
