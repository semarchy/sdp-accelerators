_package: FinanceKYC.entities.CorporateEntity.enrichers
_name: NormalizeRegistNum
_type: SemQLEnricher
entity: FinanceKYC.entities.CorporateEntity.CorporateEntity
label: Normalize Corporate Entity Registration Number
description: 'Normalizes the corporate registration number by trimming whitespace and converting it to uppercase for matching.'
enricherExecutionScope: PRE_CONSO

semQlEnricherExpressions:
  - attributeName: NormalizedRegistrationNum
    expression: "RTRIM(LTRIM(UPPER(RIGHT(RegistrationNumber, 7))))"
