_name: OnboardCustomer
_package: Manufacturing.workflows
_type: Workflow
label: Onboard Customer
generalProperties:
  attachmentMimeTypes: "*"
  attachmentMaxFileCount: 5
  attachmentMaxFileSize: 10000
notifications:
  workflowAdminOnDueDate: false
dataScope:
  - _name: Customer
    _type: RootEntity
    cardinality: SINGLE_RECORD
    displayCard: Manufacturing.entities.Customer.display_cards.CustomerDisplayCard
    entity: Manufacturing.entities.Customer.Customer
    childEntities:
      - ref: Manufacturing.references.CustomerVehiclesCustomer
      - ref: Manufacturing.references.ServiceAppointmentstVehicle
retentionPolicy:
  retentionTimeUnit: DAYS
  retentionType: FOREVER
steps:
  - _name: CreateCustomer
    _type: StartFromEmptySelectionEvent
    defaultPriority: NORMAL
    position:
      x: 0
      y: -50
    label: Create Customer
    transition:
      _name: outgoing
      _type: StartEventTransition
      toStep: Manufacturing.workflows.OnboardCustomer.NewCustomer
      bendPoints: []
    startupParameters:
      attachmentParamRequired: false
      attachmentParamSupported: true
      commentParamRequired: false
      commentParamSupported: true
      descriptionParamSupported: true
      dueDateParamRequired: false
      dueDateParamSupported: true
      nextTaskAssigneeRequired: false
      nextTaskAssigneeSupported: false
      priorityParamSupported: true
      showWaitDialog: true
  - _name: NewCustomer
    _type: UserTask
    label: New Customer
    position:
      x: 190
      y: -50
    assigneeCanRelease: true
    myTasksConfiguration: {}
    notificationsOnTaskAssignment:
      toAssignee: true
      toCandidates: true
    notificationsOnTaskExpiration:
      toAdmin: false
      toCandidatesOrAssignee: false
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    taskType: DATA_AUTHORING
    application: Manufacturing.applications.Automotive
    assigneeCondition: Username = StepInstance.WorkflowInstance.InitiatorName
    entity: Manufacturing.entities.Customer.Customer
    stepper: Manufacturing.entities.Customer.steppers.AuthorCustomers
    transitions:
      - _name: Cancel
        _type: UserTaskTransition
        label: Cancel
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          attachmentParamRequired: false
          attachmentParamSupported: true
          commentParamRequired: false
          commentParamSupported: true
          descriptionParamSupported: false
          dueDateParamRequired: false
          dueDateParamSupported: false
          nextTaskAssigneeRequired: false
          nextTaskAssigneeSupported: false
          priorityParamSupported: false
        userTaskCompletionRequired: true
        bendPoints: []
        toStep: Manufacturing.workflows.OnboardCustomer.EndCreate
        transitionValidations: []
      - _name: PublishDraft
        _type: UserTaskTransition
        label: Publish Draft
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          attachmentParamRequired: false
          attachmentParamSupported: true
          commentParamRequired: false
          commentParamSupported: true
          descriptionParamSupported: false
          dueDateParamRequired: false
          dueDateParamSupported: false
          nextTaskAssigneeRequired: false
          nextTaskAssigneeSupported: false
          priorityParamSupported: false
        userTaskCompletionRequired: true
        bendPoints: []
        toStep: Manufacturing.workflows.OnboardCustomer.SubmitDraft
        transitionValidations: []
  - _name: EndCreate
    _type: EndEvent
    position:
      x: 190
      y: 40
  - _name: SubmitDraft
    _type: SubmitAutomation
    label: Submit Draft
    position:
      x: 190
      y: -210
    icon: images://mdi/circle-edit-outline.svg
    submitUserExpression: PreviousStep.WorkflowInstance.InitiatorName
    transition:
      _name: outgoing
      _type: AutomationTransition
      bendPoints: []
      label: Outgoing
      toStep: Manufacturing.workflows.OnboardCustomer.ParallelActions
  - _name: ParallelActions
    _type: ParallelBlock
    label: Parallel Actions
    position:
      x: 480
      y: -210
    transition:
      _name: outgoing
      _type: ParallelBlockTransition
      bendPoints: []
      toStep: Manufacturing.workflows.OnboardCustomer.SubmitPendingValidation
    branches:
      - _name: Sales
        _type: Branch
        index: 1
        label: Sales
        steps:
          - _name: Start
            _type: BranchStartEvent
            position:
              x: -220
              y: -50
            transition:
              _name: outgoing
              _type: StartEventTransition
              toStep: Manufacturing.workflows.OnboardCustomer.ParallelActions.Sales.SalesInformation
              bendPoints: []
          - _name: SalesInformation
            _type: UserTask
            label: Sales Information
            position:
              x: -10
              y: -50
            assigneeCanRelease: true
            myTasksConfiguration: {}
            notificationsOnTaskAssignment:
              toAssignee: true
              toCandidates: true
            notificationsOnTaskExpiration:
              toAdmin: false
              toCandidatesOrAssignee: false
            notificationsOnWorkflowDueDate:
              toCandidatesOrAssignee: false
            taskType: DATA_AUTHORING
            application: Manufacturing.applications.Automotive
            entity: Manufacturing.entities.Customer.Customer
            stepper: Manufacturing.entities.Customer.steppers.WorkflowStep2Sales
            transitions:
              - _name: SendForApproval
                _type: UserTaskTransition
                label: Send For Approval
                behaviorOnTransition: KEEP_DATA
                showWaitDialog: true
                transitionParameters:
                  attachmentParamRequired: false
                  attachmentParamSupported: true
                  commentParamRequired: false
                  commentParamSupported: true
                  descriptionParamSupported: false
                  dueDateParamRequired: false
                  dueDateParamSupported: false
                  nextTaskAssigneeRequired: false
                  nextTaskAssigneeSupported: false
                  priorityParamSupported: false
                userTaskCompletionRequired: true
                bendPoints: []
                toStep: Manufacturing.workflows.OnboardCustomer.ParallelActions.Sales.End
                transitionValidations: []
          - _name: End
            _type: BranchEndEvent
            position:
              x: 280
              y: -50
      - _name: Appointments
        _type: Branch
        index: 2
        label: Appointments
        steps:
          - _name: Start
            _type: BranchStartEvent
            position:
              x: -230
              y: -50
            transition:
              _name: outgoing
              _type: StartEventTransition
              toStep: Manufacturing.workflows.OnboardCustomer.ParallelActions.Appointments.ServiceInformation
              bendPoints: []
          - _name: End
            _type: BranchEndEvent
            position:
              x: 170
              y: -40
          - _name: ServiceInformation
            _type: UserTask
            label: Service Information
            position:
              x: -30
              y: -50
            assigneeCanRelease: true
            myTasksConfiguration: {}
            notificationsOnTaskAssignment:
              toAssignee: true
              toCandidates: true
            notificationsOnTaskExpiration:
              toAdmin: false
              toCandidatesOrAssignee: false
            notificationsOnWorkflowDueDate:
              toCandidatesOrAssignee: false
            taskType: DATA_AUTHORING
            application: Manufacturing.applications.Automotive
            entity: Manufacturing.entities.Customer.Customer
            stepper: Manufacturing.entities.Customer.steppers.WorkflowStep3Services
            transitions:
              - _name: SendForApproval
                _type: UserTaskTransition
                label: Send For Approval
                behaviorOnTransition: KEEP_DATA
                showWaitDialog: true
                transitionParameters:
                  attachmentParamRequired: false
                  attachmentParamSupported: true
                  commentParamRequired: false
                  commentParamSupported: true
                  descriptionParamSupported: false
                  dueDateParamRequired: false
                  dueDateParamSupported: false
                  nextTaskAssigneeRequired: false
                  nextTaskAssigneeSupported: false
                  priorityParamSupported: false
                userTaskCompletionRequired: true
                bendPoints: []
                toStep: Manufacturing.workflows.OnboardCustomer.ParallelActions.Appointments.End
                transitionValidations: []
  - _name: SubmitPendingValidation
    _type: SubmitAutomation
    label: Submit Pending Validation
    position:
      x: 740
      y: -210
    icon: images://mdi/circle-edit-outline.svg
    submitUserExpression: >- 
      LOOKUP 
          FIRST(AssigneeName) 
          FROM PreviousStep.ParallelBlockInstance.Branches.Steps.UserTaskInstance 
          ORDER BY EndDate DESC 
      END
    transition:
      _name: outgoing
      _type: AutomationTransition
      bendPoints: []
      label: Outgoing
      toStep: Manufacturing.workflows.OnboardCustomer.Approve
  - _name: Approve
    _type: UserTask
    label: Approve
    position:
      x: 740
      y: -50
    assigneeCanRelease: true
    myTasksConfiguration: {}
    notificationsOnTaskAssignment:
      toAssignee: true
      toCandidates: true
    notificationsOnTaskExpiration:
      toAdmin: false
      toCandidatesOrAssignee: false
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    taskType: DATA_AUTHORING
    application: Manufacturing.applications.Automotive
    entity: Manufacturing.entities.Customer.Customer
    stepper: Manufacturing.entities.Customer.steppers.WorkflowStep4Approve
    transitions:
      - _name: Submit
        _type: UserTaskTransition
        label: Submit
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          attachmentParamRequired: false
          attachmentParamSupported: true
          commentParamRequired: false
          commentParamSupported: true
          descriptionParamSupported: false
          dueDateParamRequired: false
          dueDateParamSupported: false
          nextTaskAssigneeRequired: false
          nextTaskAssigneeSupported: false
          priorityParamSupported: false
        userTaskCompletionRequired: true
        bendPoints: []
        toStep: Manufacturing.workflows.OnboardCustomer.SubmitCustomer
        transitionValidations: []
      - _name: Cancel
        _type: UserTaskTransition
        label: Cancel
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          attachmentParamRequired: false
          attachmentParamSupported: true
          commentParamRequired: false
          commentParamSupported: true
          descriptionParamSupported: false
          dueDateParamRequired: false
          dueDateParamSupported: false
          nextTaskAssigneeRequired: false
          nextTaskAssigneeSupported: false
          priorityParamSupported: false
        userTaskCompletionRequired: true
        bendPoints: []
        toStep: Manufacturing.workflows.OnboardCustomer.FinishCreation
        transitionValidations: []
  - _name: FinishCreation
    _type: EndEvent
    position:
      x: 950
      y: -50
  - _name: SubmitCustomer
    _type: SubmitAutomation
    label: Submit Customer
    position:
      x: 880
      y: -140
    icon: images://mdi/check-circle-outline.svg
    submitUserExpression: PreviousStep.UserTaskInstance.AssigneeName
    transition:
      _name: outgoing
      _type: AutomationTransition
      bendPoints: []
      label: Outgoing
      toStep: Manufacturing.workflows.OnboardCustomer.FinishCreation
