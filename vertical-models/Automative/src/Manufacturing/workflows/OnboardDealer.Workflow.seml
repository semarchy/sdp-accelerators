                  dueDateParamSupported: false
                  nextTaskAssigneeRequired: false
                  nextTaskAssigneeSupported: false
                  priorityParamSupported: false
                userTaskCompletionRequired: true
                bendPoints: []
                toStep: Manufacturing.workflows.OnboardDealer.ParallelActions.Operations.End
                transitionValidations: []
          - _name: End
            _type: BranchEndEvent
            position:
              x: 90
              y: -20
      - _name: Logistics
        _type: Branch
        index: 2
        label: Logistics
        steps:
          - _name: Start
            _type: BranchStartEvent
            position:
              x: -470
              y: -120
            transition:
              _name: outgoing
              _type: StartEventTransition
              toStep: Manufacturing.workflows.OnboardDealer.ParallelActions.Logistics.AddLocationDetails
              bendPoints: []
          - _name: AddLocationDetails
