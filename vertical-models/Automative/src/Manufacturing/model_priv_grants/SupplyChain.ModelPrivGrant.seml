_name: SupplyChain
_package: Manufacturing.model_priv_grants
_type: ModelPrivGrant
allowApiPublishingAsUser: false
allowDataQualityDocumentation: false
allowEnrichmentDocumentation: false
dataAdminRole: false
integrationWsRole: false
label: Supply Chain
roleName: SupplyChain
entityPrivGrants:
  - _name: AddressCountry
    _type: EntityPrivGrant
    attributePrivGrants: []
    entity: Manufacturing.entities.AddressCountry.AddressCountry
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: false
    removeAllowed: false
  - _name: ManufacturingPlantType
    _type: EntityPrivGrant
    attributePrivGrants: []
    entity: Manufacturing.entities.ManufacturingPlantType.ManufacturingPlantType
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: false
    removeAllowed: false
  - _name: Item_ItemImageJoin
    _type: EntityPrivGrant
    attributePrivGrants: []
    entity: Manufacturing.entities.Item_ItemImageJoin.Item_ItemImageJoin
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: false
    removeAllowed: false
  - _name: Address
    _type: EntityPrivGrant
    attributePrivGrants: []
    entity: Manufacturing.entities.Address.Address
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
  - _name: AddressState
    _type: EntityPrivGrant
    attributePrivGrants: []
    entity: Manufacturing.entities.AddressState.AddressState
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: false
    removeAllowed: false
  - _name: SupplierAddress
    _type: EntityPrivGrant
    attributePrivGrants: []
    entity: Manufacturing.entities.SupplierAddress.SupplierAddress
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: true
    filter: FID_AddressType = 'Shipping Address'
    removeAllowed: false
  - _name: PaymentTerm
    _type: EntityPrivGrant
    attributePrivGrants: []
    entity: Manufacturing.entities.PaymentTerm.PaymentTerm
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
  - _name: AddressType
    _type: EntityPrivGrant
    attributePrivGrants: []
    entity: Manufacturing.entities.AddressType.AddressType
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: false
    removeAllowed: false
  - _name: ItemCondition
    _type: EntityPrivGrant
    attributePrivGrants: []
    entity: Manufacturing.entities.ItemCondition.ItemCondition
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: false
    removeAllowed: false
  - _name: Supplier
    _type: EntityPrivGrant
    attributePrivGrants:
      - attribute: Manufacturing.entities.Supplier.Supplier.Revenue
        accessType: DENIED
      - attribute: Manufacturing.entities.Supplier.Supplier.EmployeeRange
        accessType: DENIED
