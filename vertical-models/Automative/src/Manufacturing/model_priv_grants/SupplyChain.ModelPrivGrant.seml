        accessType: DENIED
    entity: Manufacturing.entities.Supplier.Supplier
    checkoutAllowed: false
    createAllowed: false
    defaultAccessType: READ
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
  - _name: ItemBillOfMaterial
    _type: EntityPrivGrant
    attributePrivGrants: []
