          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: MyTasksAction
          badgeVisible: true
        - _name: Entities
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseEntitiesFolderAction
          lineageEnabled: true
