_package: Manufacturing.applications
_name: Automotive
_type: Application
applicationTitle: Automotive
avatarImageUrl: images://manufacturing/automobile-car-multiple.svg
coverImageUrl: images://default/cover.png
favIcon: images://manufacturing/automobile-car-multiple.svg
historyBrowsingEnabled: true
historyBrowsingRequiredRole: ""
logoUrl: images://manufacturing/cover.png
visibility: VISIBLE
documentationConfig:
  documentationConfigDiagrams:
    - _name: AutommotiveReferenceData
      _type: DocumentationConfigDiagram
      modelDiagram: Manufacturing.model_diagrams.AutommotiveReferenceData
      label: Autommotive Reference Data
    - _name: Automotive
      _type: DocumentationConfigDiagram
      modelDiagram: Manufacturing.model_diagrams.Automotive
      label: Automotive
label: Automotive
sortStrategy: POSITION
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: true
  globalSearchBusinessViews:
    - _name: DealerView
      _type: GlobalSearchBoView
      viewType: GD
      businessView: Manufacturing.entities.ProductDealer.business_views.ProductDealer
      maxResults: 5
      searchTypeConfig: Manufacturing.entities.ProductDealer.business_views.ProductDealer.ProductDealerEO.TextConfig
rootFolder:
  _name: Root
  icon: images://mdi/folder.svg
  label: Root Folder
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  _type: FolderAction
  appActions:
    - _name: Dealer
      icon: images://mdi/store-outline.svg
      label: Dealer
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      _type: FolderAction
      appActions:
        - _name: Dealers
          icon: images://mdi/store-outline.svg
          label: Dealer
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseBusinessViewAction
          businessView: Manufacturing.entities.ProductDealer.business_views.ProductDealer
          nbRecordsBadgeVisible: false
          businessViewIconOverride: images://mdi/store-outline.svg
          businessViewLabelOverride: Dealer
          businessViewRootLabelOverride: Dealer
          businessViewRootPluralLabelOverride: Dealers
          useSearchOnOpen: false
          viewType: GD
        - _name: Services
          icon: images://mdi/tools.svg
          label: Service
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseBusinessViewAction
          businessView: Manufacturing.entities.ProductService.business_views.ProductService
          nbRecordsBadgeVisible: false
          businessViewIconOverride: images://mdi/tools.svg
          businessViewLabelOverride: Service
          businessViewRootLabelOverride: Service
          businessViewRootPluralLabelOverride: Services
          useSearchOnOpen: false
          viewType: GD
        - _name: ServiceType
          icon: images://mdi/format-list-bulleted-type.svg
          label: Service Types
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseBusinessViewAction
          businessView: Manufacturing.entities.ProductServiceType.business_views.ProductServiceType
          nbRecordsBadgeVisible: false
          businessViewIconOverride: images://mdi/format-list-bulleted-type.svg
          businessViewLabelOverride: Service Type
          businessViewRootLabelOverride: Service Type
          businessViewRootPluralLabelOverride: Service Types
          useSearchOnOpen: false
          viewType: GD
        - _name: ServiceAppointments
          icon: images://mdi/calendar-alert.svg
          label: Service Appointment
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseBusinessViewAction
          businessView: Manufacturing.entities.CustomerServiceAppointment.business_views.CustomerServiceAppointment
          nbRecordsBadgeVisible: false
          businessViewIconOverride: images://mdi/calendar-alert.svg
          businessViewLabelOverride: Service Appointment
          businessViewRootLabelOverride: Service Appointment
          businessViewRootPluralLabelOverride: Service Appointments
          useSearchOnOpen: false
          viewType: GD
    - _name: General
      label: General
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      _type: FolderAction
      appActions:
