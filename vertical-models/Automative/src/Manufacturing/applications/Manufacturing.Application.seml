_package: Manufacturing.applications
_name: Manufacturing
_type: Application
applicationTitle: Manufacturing Demo
avatarImageUrl: images://manufacturing/manufacturing-production-icon-green.svg
coverImageUrl: images://manufacturing/Manufacturing.png
favIcon: images://default/favicon.png
historyBrowsingEnabled: true
historyBrowsingRequiredRole: ""
logoUrl: images://default/logo.png
visibility: VISIBLE
documentationConfig:
  documentationConfigDiagrams:
    - _name: Automotive
      _type: DocumentationConfigDiagram
      modelDiagram: Manufacturing.model_diagrams.Automotive
      label: Automotive
    - _name: Address
      _type: DocumentationConfigDiagram
      modelDiagram: Manufacturing.model_diagrams.Address
      label: Address
    - _name: Manufacturing
      _type: DocumentationConfigDiagram
      modelDiagram: Manufacturing.model_diagrams.Manufacturing
      label: Manufacturing
    - _name: AutommotiveReferenceData
      _type: DocumentationConfigDiagram
      modelDiagram: Manufacturing.model_diagrams.AutommotiveReferenceData
      label: Autommotive Reference Data
    - _name: Customer
      _type: DocumentationConfigDiagram
      modelDiagram: Manufacturing.model_diagrams.Customer
      label: Customer
label: Manufacturing
sortStrategy: POSITION
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: true
  globalSearchBusinessViews:
    - _name: ItemView
      _type: GlobalSearchBoView
      viewType: GD
      businessView: Manufacturing.entities.Item.business_views.Item
      label: Item
      maxResults: 5
      searchTypeConfig: Manufacturing.entities.Item.business_views.Item.ItemEO.TextConfig
    - _name: ProductTrim
      _type: GlobalSearchBoView
      viewType: GD
      businessView: Manufacturing.entities.ProductTrim.business_views.ProductTrim
      label: Trim
      maxResults: 5
      searchTypeConfig: Manufacturing.entities.ProductTrim.business_views.ProductTrim.ProductTrimEO.TextConfig
rootFolder:
  _name: Root
  icon: images://mdi/folder.svg
  label: Root Folder
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  _type: FolderAction
  appActions:
    - _name: Roo
      label: Root
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      _type: FolderAction
      appActions:
        - _name: GlobalSearch
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: GlobalSearchAction
        - _name: MyTasks
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: MyTasksAction
          badgeVisible: true
        - _name: Entities
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseEntitiesFolderAction
          lineageEnabled: true
        - _name: Dashboard
          icon: images://mdi/chart-bar-stacked.svg
          image: images://mdi/chart-bar-stacked.svg
          label: Dashboards
          imageAlign: MIDDLE_CENTER
          imageMode: CONTAIN
          _type: FolderAction
          appActions:
            - _name: Profiling
              description: Source Data Profiling
              icon: images://default/discovery-app-avatar.png
              image: images://default/discovery-app-avatar.png
              label: Discovery (Data Profiling)
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
              _type: OpenDashboardAction
              dashboard: DatasourceProfileDashboard
              dashboardApplication: Manufacturing_Stg_Profiling
              parameters: []
            - _name: Dashboards
              description: Business Dashbaord for Supplier Data
              image: images://mdi/office-building-outline.svg
              label: Supplier Dashbaord
              imageAlign: MIDDLE_CENTER
              imageMode: CONTAIN
              _type: OpenDashboardAction
              dashboard: SupplierDashboard
              dashboardApplication: ManufacturingIndustryModel
              parameters: []
            - _name: ProductCompliance
              description: Is Product Inline with various compliancess
              icon: images://mdi/car-back.svg
              image: images://mdi/car-back.svg
              label: Product/ Vehicle Compliance
              imageAlign: MIDDLE_CENTER
              imageMode: CONTAIN
              _type: OpenDashboardAction
              dashboard: ProductCompliance
              dashboardApplication: ManufacturingIndustryModel
              parameters: []
    - _name: Item
      label: Item
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      _type: FolderAction
