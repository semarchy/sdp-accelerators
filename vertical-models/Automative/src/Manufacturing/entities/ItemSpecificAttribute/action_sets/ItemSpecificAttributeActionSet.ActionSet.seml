_name: ItemSpecificAttributeActionSet
_package: Manufacturing.entities.ItemSpecificAttribute.action_sets
_type: ActionSet
entity: Manufacturing.entities.ItemSpecificAttribute.ItemSpecificAttribute
label: Item Specific Attribute Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorItemSpecificAttributes
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: Manufacturing.entities.ItemSpecificAttribute.steppers.AuthorItemSpecificAttributes
  - _name: EditAuthorItemSpecificAttributes
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: Manufacturing.entities.ItemSpecificAttribute.steppers.AuthorItemSpecificAttributes
  - _name: MassUpdateAuthorItemSpecificAttributes
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: Manufacturing.entities.ItemSpecificAttribute.steppers.AuthorItemSpecificAttributes
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorItemSpecificAttributes
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: Manufacturing.entities.ItemSpecificAttribute.steppers.AuthorItemSpecificAttributes
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
