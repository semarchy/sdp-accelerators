_name: AddressStateActionSet
_package: Manufacturing.entities.AddressState.action_sets
_type: ActionSet
entity: Manufacturing.entities.AddressState.AddressState
label: Address State Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorAddressStates
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
