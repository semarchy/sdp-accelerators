          executedOnFormOpen: false
        - validationType: MANDATORY
          attribute: Manufacturing.references.ServiceAppointmentsCustomer.Customer
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: Manufacturing.references.ServiceAppointmentsCustomer.Customer
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: MANDATORY
          attribute: Manufacturing.references.ServiceAppointmentstVehicle.Vehicle
          executedOnDataChange: false
          executedOnFormOpen: false
