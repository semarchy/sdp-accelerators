_name: AddressDisplayCard
_package: Manufacturing.entities.Address.display_cards
_type: DisplayCard
entity: Manufacturing.entities.Address.Address
default: true
primaryTextExpression: >-
  case when GeocodedCountry is not null then SEM_CONCAT(', ','1',
  GeocodedStreetNumber , GeocodedStreetName ,GeocodedLocality, GeocodedState,
  GeocodedCountry)

  else SEM_CONCAT(', ','1', InputAddressLine, FDN_InputState, FDN_InputCountry)

  end
secondaryTextExpression: SEM_CONCAT(', ','1', InputAddressLine, FDN_InputState, FDN_InputCountry)
primaryImageValueInterpreter: LITERAL
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValue: "'https://semarchy-tutorials.s3.amazonaws.com/iso-3166/' ||
  LOWER(InputCountry.Alpha2Code) || '.svg'"
avatarImageValueInterpreter: SEMQL
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
