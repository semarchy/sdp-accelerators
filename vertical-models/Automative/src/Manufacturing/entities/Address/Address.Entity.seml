matcher:
  _name: SemlQLMatcherAddress
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: false
  mergeThresholdMergingConfirmed: 0
  mergeThresholdMergingConfirmedWithNewMasters: 0
  mergeThresholdMergingConfirmedWithUnconfirmed: 0
  mergeThresholdMergingUnconfirmed: 0
  mergeThresholdMergingUnconfirmedWithNewMasters: 0
  mergeThresholdNewGroup: 0
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: true
  useTransitiveMatchScore: true
  description: Supplier Address Matcher
  matchRules:
    - _type: SemQLMatchRule
      _name: AddressMatch
      condition: |-
        Record1.GeocodedStreetNumber = Record2.GeocodedStreetNumber
        AND
        Record1.GeocodedStreetName = Record2.GeocodedStreetName
        AND
        Record1.GeocodedState = Record2.GeocodedState
        AND
        Record1.GeocodedCountry = Record2.GeocodedCountry
      label: Address Match
      matchScore: 98
      documentation: Exact Match on Address
      usingMatchOn: false
      binningExpressions:
        - expression: FID_InputCountry
