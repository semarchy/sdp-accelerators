_name: Address
_package: Manufacturing.entities.Address
_type: Entity
primaryKey: Manufacturing.entities.Address.Address.AddressID
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 10000
sourceIdGeneration:
  mode: SEQUENCE
  startWith: 10000
label: Address
enableDelete: true
entityType: FUZZY_MATCHED
iconUrl: images://mdi/office-building-marker.svg
pluralLabel: Addresses
description: "Mastered physical address records with source input fields, geocoded components, and household grouping support."
documentation: "Mastered physical address records with source input fields, geocoded components, and household grouping support. Use this entity to understand and govern this business object in the Manufacturing and Automotive accelerator applications."
historizeGolden: true
historizeMaster: false
physicalTableName: ADDRESS
dataEntryAllowed: true
attributes:
