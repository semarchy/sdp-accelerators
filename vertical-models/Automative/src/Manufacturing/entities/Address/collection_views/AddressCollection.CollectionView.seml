_package: Manufacturing.entities.Address.collection_views
_name: AddressCollection
_type: CollectionView
entity: Manufacturing.entities.Address.Address
default: true
displayCard: Manufacturing.entities.Address.display_cards.AddressDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Address
tableShowDisplayCard: true
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: AddressID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: AddressID
    visibleByDefault: true
  - _type: CheckboxColumn
    _name: Household
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: Household
    visibleByDefault: true
    componentProperties:
      useSwitch: "0"
      useSwitchValueInterpreter: LITERAL
  - _type: TextColumn
    _name: InputAddressLine
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: InputAddressLine
    visibleByDefault: true
  - _type: TextColumn
