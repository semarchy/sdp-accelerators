_name: ProductDealerServiceDisplayCard
_package: Manufacturing.entities.ProductDealerService.display_cards
_type: DisplayCard
entity: Manufacturing.entities.ProductDealerService.ProductDealerService
default: true
primaryTextExpression: sem_concat(' - ','1', FDN_Dealer , FDN_Service )
primaryImageValueInterpreter: LITERAL
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValue: >-
  case 

  when lower(Dealer.Name ) like '%mercedes%' then
  'https://cdn.freebiesupply.com/logos/large/2x/mercedes-benz-9-logo-svg-vector.svg'

  else null 

  end
avatarImageValueInterpreter: SEMQL
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
