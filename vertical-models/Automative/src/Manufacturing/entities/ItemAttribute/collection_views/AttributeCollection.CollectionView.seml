_package: Manufacturing.entities.ItemAttribute.collection_views
_name: AttributeCollection
_type: CollectionView
entity: Manufacturing.entities.ItemAttribute.ItemAttribute
default: true
displayCard: Manufacturing.entities.ItemAttribute.display_cards.AttributeDisplayCard
tableAllowed: true
tableRowLines: 1
tableDisplayCardColumnLabel: Attribute
tableShowDisplayCard: true
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: ID
    visibleByDefault: true
  - _type: TextColumn
    _name: Attribute
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Attribute
    visibleByDefault: true
  - _type: CheckboxColumn
    _name: Mandatory
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: Mandatory
    visibleByDefault: true
    componentProperties:
      useSwitch: "0"
      useSwitchValueInterpreter: LITERAL
  - _type: CheckboxColumn
    _name: Constrained
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: Constrained
    visibleByDefault: true
    componentProperties:
      useSwitch: "0"
      useSwitchValueInterpreter: LITERAL
