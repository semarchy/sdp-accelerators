matcher:
  _name: SemlQLMatcherCustomer
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 95
  autoConfirmSingletons: false
  mergeThresholdMergingConfirmed: 85
  mergeThresholdMergingConfirmedWithNewMasters: 85
  mergeThresholdMergingConfirmedWithUnconfirmed: 85
  mergeThresholdMergingUnconfirmed: 85
  mergeThresholdMergingUnconfirmedWithNewMasters: 85
  mergeThresholdNewGroup: 85
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: true
  useTransitiveMatchScore: true
  description: CustomerMatcher
  matchRules:
    - _type: SemQLMatchRule
      _name: NormalizedLastNameMemberID
      condition: |-
        /*** Last Name exact match ***/ 
        Record1.NormalizedLastName = Record2.NormalizedLastName

        /*** Social Security Number exact match ***/
        AND Record1.MemberID = Record2.MemberID
      label: Exact Name Member ID
      matchScore: 100
      documentation: "In the best case scenario, we match people with this rule: match on Name and Member ID across systems."
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: NormalizedNameOrNicknameDOBEmail
      condition: |-
        /*** Normalized Name or nickname exact match ***/
        ( Record1.NormalizedFirstName = Record2.NormalizedFirstName
           OR Record1.Nickname = Record2.Nickname
           OR Record1.NormalizedFirstName = Record2.Nickname
           OR Record1.Nickname =  Record2.NormalizedFirstName
        ) 
        AND Record1.NormalizedLastName = Record2.NormalizedLastName


        /*** Date of birth exact match ***/
        AND Record1.DateOfBirth = Record2.DateOfBirth

        /*** Email exact match ***/
        AND Record1.CleansedEmail = Record2.CleansedEmail
      label: Normalized Name Or Nickname DOB Email
      matchScore: 98
      documentation: 'In the "Normal Ideal" case, we match people with this rule: match on Name, Date of Birth, and Email, across systems.'
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: NormalizedNameOrNicknameDOBPhone
      condition: |-
        /*** Normalized Name or nickname exact match ***/
        ( Record1.NormalizedFirstName = Record2.NormalizedFirstName
           OR Record1.Nickname = Record2.Nickname 
           OR Record1.NormalizedFirstName = Record2.Nickname 
           OR Record1.Nickname =  Record2.NormalizedFirstName
        ) 
        AND Record1.NormalizedLastName = Record2.NormalizedLastName


        /*** Date of birth exact match ***/
        AND Record1.DateOfBirth = Record2.DateOfBirth

        /*** Address match ***/
        AND Record1.StandardizedPhone = Record2.StandardizedPhone
      label: Normalized Name Or Nickname DOB Phone
      matchScore: 96
      documentation: "In this match case scenario, we match people with this rule: match on Name, Normalized Address, and Date of Birth across systems."
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: NormalizedNameOrNicknameAddressEmailPhone
      condition: |-
        /*** Normalized Name or nickname exact match ***/
        ( Record1.NormalizedFirstName = Record2.NormalizedFirstName
           OR Record1.Nickname = Record2.Nickname 
           OR Record1.NormalizedFirstName = Record2.Nickname 
           OR Record1.Nickname =  Record2.NormalizedFirstName
        ) 
        AND Record1.NormalizedLastName = Record2.NormalizedLastName


        /*** Address match ***/
        AND Record1.GeocodedStreetNumber= Record2.GeocodedStreetNumber
        AND Record1.GeocodedStreetName = Record2.GeocodedStreetName
        AND Record1.GeocodedLocality = Record2.GeocodedLocality
        AND Record1.GeocodedState = Record2.GeocodedState
        AND Record1.GeocodedPostalCode = Record2.GeocodedPostalCode
        AND Record1.GeocodedCountry = Record2.GeocodedCountry

        /*** Cleansed contact info ***/
        AND Record1.StandardizedPhone = Record2.StandardizedPhone
        AND Record1.CleansedEmail = Record2.CleansedEmail
      label: Normalized Name Or Nickname Address Email Phone
      matchScore: 94
      documentation: Match by exact Normalized Name/NickName, Address, Email and Phone
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: PhoneticNameAddressEmailPhone
      condition: |-
        /*** Phonetic Name match ***/
        Record1.PhoneticFirstName = Record2.PhoneticFirstName
        AND Record1.PhoneticLastName = Record2.PhoneticLastName

        /*** Address match ***/
        AND Record1.GeocodedStreetNumber = Record2.GeocodedStreetNumber
        AND Record1.GeocodedStreetName = Record2.GeocodedStreetName
        AND Record1.GeocodedLocality = Record2.GeocodedLocality
        AND Record1.GeocodedState = Record2.GeocodedState
        AND Record1.GeocodedPostalCode = Record2.GeocodedPostalCode
        AND Record1.GeocodedCountry = Record2.GeocodedCountry

        /*** Cleansed contact info ***/
        AND Record1.StandardizedPhone = Record2.StandardizedPhone
        AND Record1.CleansedEmail = Record2.CleansedEmail
      label: Phonetic Name Address Email Phone
      matchScore: 78
      documentation: Match by exact Phonetized Name, address, Email and Phone
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: ExactEmailMatch
      condition: Record1.CleansedEmail = Record2.CleansedEmail
      label: Exact Email Match
      matchScore: 68
      description: "Email is a strong match because most customers have a unique email, but it could be shared in a family situation so it is a useful suggestion."
      documentation: Match by exact Normalized Name/NickName, Address, Email and Phone
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: SimilarNameAddress
      condition: >-
        /*** Matching on similar names, catching typos ***/

        ( SEM_EDIT_DISTANCE_SIMILARITY( Record1.FirstName, Record2.FirstName ) >
        75

        AND SEM_EDIT_DISTANCE_SIMILARITY(Record1.LastName, Record2.LastName ) >
        75

        )

        OR

        ( SEM_EDIT_DISTANCE_SIMILARITY(
        Record1.NormalizedFirstName,  Record2.NormalizedFirstName ) > 80

        AND SEM_EDIT_DISTANCE_SIMILARITY( Record1.NormalizedLastName,
        Record2.NormalizedLastName ) > 80 

        )


        /*** Match on similar address ***/

        AND  SEM_EDIT_DISTANCE_SIMILARITY( Record1.GeocodedLocality,
        Record2.GeocodedLocality)  > 75

        AND  SEM_EDIT_DISTANCE_SIMILARITY(
        Record1.GeocodedStreetName,  Record2.GeocodedStreetName ) > 75


        /*** Exact match on zip code, state, and country ***/

        AND Record1.GeocodedState = Record2.GeocodedState

        AND Record1.GeocodedPostalCode = Record2.GeocodedPostalCode

        AND Record1.GeocodedCountry = Record2.GeocodedCountry
      label: Similar Name Address
      matchScore: 68
      documentation: Fuzzy matching rule to catch typos with name and address data entry
      usingMatchOn: false
