_type: JavaPluginEnricher
_package: Manufacturing.entities.Customer.enrichers
_name: Household
entity: Manufacturing.entities.Customer.Customer
label: Household
description: "Looks up a household address from geocoded street information to group customers at the same household."
pluginId: com.semarchy.engine.plugins.convergence.lookup
batchUpdateSize: 1
condition: FID_Household is null
numberOfRetry: 0
onErrorBehavior: FAIL_JOB
enricherExecutionScope: PRE_CONSO
processingBatchSize: 1
threadPoolSize: 1
pluginParams:
  - paramName: PARAM_LOOKUP_COLUMN
    value: GEOCODED_STREET_NAME
  - paramName: PARAM_OUTPUT_COLUMNS
    value: ADDRESS_ID
  - paramName: PARAM_MAPPING_TABLE
    value: gd_address
pluginInputs:
  - inputName: IN_LOOKUP_VALUE
    expression: GeocodedStreetName
pluginOutputs:
  - outputName: OUT_RESULT1
    attributeName: HouseholdID
afterEnrichers: Manufacturing.entities.Customer.enrichers.GeocodeUsingGoogle
