_type: JavaPluginEnricher
_package: Manufacturing.entities.Customer.enrichers
_name: LookupNickname
entity: Manufacturing.entities.Customer.Customer
label: Lookup Nickname
description: "Looks up common nicknames for the customer first name to support household analysis and fuzzy matching."
pluginId: com.semarchy.engine.plugins.convergence.lookup
batchUpdateSize: 1
numberOfRetry: 0
onErrorBehavior: FAIL_JOB
enricherExecutionScope: PRE_CONSO
processingBatchSize: 1
threadPoolSize: 1
pluginParams:
  - paramName: PARAM_MAPPING_TABLE
    value: GD_NICKNAME
  - paramName: PARAM_LOOKUP_COLUMN
    value: GIVEN_NAME
  - paramName: PARAM_OUTPUT_COLUMNS
    value: TOP_NICKNAME
pluginInputs:
  - inputName: IN_LOOKUP_VALUE
    expression: LOWER( COALESCE( NormalizedFirstName, FirstName) )
pluginOutputs:
  - outputName: OUT_RESULT1
    attributeName: Nickname
afterEnrichers: Manufacturing.entities.Customer.enrichers.NormalizeName
