_type: JavaPluginEnricher
_package: Manufacturing.entities.Customer.enrichers
_name: MelissaPersonatorEnricher
entity: Manufacturing.entities.Customer.Customer
label: Melissa Personator Enricher
pluginId: com.semarchy.engine.plugins.melissa.personator
batchUpdateSize: 1000
enricherCache: Manufacturing.enricher_caches.MelissaPersonator
numberOfRetry: 10
onErrorBehavior: FAIL_JOB
description: This is the Semarchy-built Melissa plugin, not the legacy version
  built by Melissa.
enricherExecutionScope: PRE_POST
processingBatchSize: 1
threadPoolSize: 1
pluginParams:
  - paramName: PARAM_APPEND
    value: "true"
  - paramName: PARAM_LICENSE
    value: INSERT_YOUR_API_KEY
  - paramName: PARAM_MOVE
    value: "true"
  - paramName: PARAM_VERIFY
    value: "true"
pluginInputs:
  - inputName: IN_PHONE
    expression: SourcePhone
  - inputName: IN_CITY
    expression: InputCity
  - inputName: IN_COUNTRY
    expression: InputCountry
  - inputName: IN_POSTAL_CODE
    expression: InputZipCode
  - inputName: IN_EMAIL
    expression: SourceEmail
  - inputName: IN_STATE
    expression: InputState
  - inputName: IN_FULLNAME
    expression: concat(FirstName ,' ', LastName)
  - inputName: IN_ADDRESS_LINE_1
    expression: InputAddressLine
pluginOutputs:
  - outputName: OUT_ADDR_SUITE_NUMBER
    attributeName: MDPersonator.AddressSuiteNumber
  - outputName: OUT_PHONE_PREFIX
    attributeName: MDPersonator.PhonePrefix
  - outputName: OUT_EMAIL
    attributeName: MDPersonator.EmailAddress
  - outputName: OUT_ADDR_POST_DIR
    attributeName: MDPersonator.AddressPostDirection
  - outputName: OUT_URBAN_NAME
    attributeName: MDPersonator.UrbanizationName
  - outputName: OUT_NAME_LAST
    attributeName: MDPersonator.NameLast
  - outputName: OUT_CBSA_DIV_TITLE
    attributeName: MDPersonator.CBSADivisionTitle
  - outputName: OUT_COUNTY_NAME
    attributeName: MDPersonator.CountyName
  - outputName: OUT_ADDR_ROUTE_SERVICE
    attributeName: MDPersonator.AddressRouteService
  - outputName: OUT_LENGTH_OF_RESIDENCE
    attributeName: MDPersonator.LengthOfResidence
  - outputName: OUT_GENDER
    attributeName: MDPersonator.Gender
  - outputName: OUT_NAME_FIRST2
    attributeName: MDPersonator.NameFirst2
  - outputName: OUT_HOUSEHOLD_SIZE
    attributeName: MDPersonator.HouseholdSize
  - outputName: OUT_CREDIT_CARD_USER
    attributeName: MDPersonator.CreditCardUser
  - outputName: OUT_ETHNIC_GROUP
    attributeName: MDPersonator.EthnicGroup
  - outputName: OUT_PHONE_NEW_AREA_CODE
    attributeName: MDPersonator.PhoneNewAreaCode
  - outputName: OUT_DELIVERY_PC_DIGIT
    attributeName: MDPersonator.DeliveryPointCheckDigit
  - outputName: OUT_PHONE_EXT
    attributeName: MDPersonator.PhoneExtension
  - outputName: OUT_CENSUS_TRACT
    attributeName: MDPersonator.CensusTract
  - outputName: OUT_PRESENCE_OF_SENIOR
    attributeName: MDPersonator.PresenceOfSenior
  - outputName: OUT_DEMOGRAPHICS_RESULTS
    attributeName: MDPersonator.DemographicsResults
  - outputName: OUT_PRESENCE_OF_CHILDREN
    attributeName: MDPersonator.PresenceOfChildren
  - outputName: OUT_LATITUDE
    attributeName: MDPersonator.Latitude
  - outputName: OUT_ETHNIC_CODE
    attributeName: MDPersonator.EthnicCode
  - outputName: OUT_CBSA_TITLE
    attributeName: MDPersonator.CBSATitle
  - outputName: OUT_DELIVERY_IND
