_name: AuthorCustomers
_package: Manufacturing.entities.Customer.steppers
_type: Stepper
entity: Manufacturing.entities.Customer.Customer
rootStep:
  _name: Customers
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: Manufacturing.entities.Customer.collection_views.CustomerCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Customers
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.CustomersHousehold.Household
    - onStepExit: SKIP
      validationType: DETECT_DUPS
      matcher: Manufacturing.entities.Customer.Customer.SemlQLMatcherCustomer
    - onStepExit: BLOCK
      validationType: MANDATORY
      attribute: Manufacturing.entities.Customer.Customer.LastName
    - onStepExit: SKIP
      validationType: LOV
      attribute: Manufacturing.entities.Customer.Customer.MDPersonator
      definitionAttribute: Manufacturing.complex_types.MelissaDataPersonatorType.Results
  stepTriggers: []
  childSteps:
    - _name: Customer
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Customer
      formTab: Manufacturing.entities.Customer.forms.CustomerForm.Customer
      formStepEnrichers:
        - enricher: Manufacturing.entities.Customer.enrichers.LookupNickname
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.FillInUnknownNicknames
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.PhonetizeFirstName
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.HouseholdIDToInteger
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.Household
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.NormalizeName
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.MelissaPersonatorEnricher
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.PhonetizeLastName
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.StandardizePhone
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.CleanseEmail
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Customer.enrichers.GeocodeUsingGoogle
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
      referenceFormFieldConfigs: []
      formStepValidations:
        - validationType: LOV
          attribute: Manufacturing.entities.Customer.Customer.MDPersonator
          executedOnDataChange: true
          executedOnFormOpen: true
          definitionAttribute: Manufacturing.complex_types.MelissaDataPersonatorType.Results
        - validationType: FOREIGN
          attribute: Manufacturing.references.CustomersHousehold.Household
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: MANDATORY
          attribute: Manufacturing.entities.Customer.Customer.LastName
          executedOnDataChange: true
          executedOnFormOpen: true
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: LOV
          attribute: Manufacturing.entities.Customer.Customer.MDPersonator
          definitionAttribute: Manufacturing.complex_types.MelissaDataPersonatorType.Results
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Manufacturing.entities.Customer.Customer.LastName
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.CustomersHousehold.Household
        - onStepExit: SKIP
          validationType: DETECT_DUPS
          matcher: Manufacturing.entities.Customer.Customer.SemlQLMatcherCustomer
      stepTriggers: []
label: Author Customers
stepperFinishValidations:
  - onStepperFinish: SKIP
    validationType: LOV
    attribute: Manufacturing.entities.Customer.Customer.MDPersonator
    definitionAttribute: Manufacturing.complex_types.MelissaDataPersonatorType.Results
  - onStepperFinish: SKIP
    validationType: DETECT_DUPS
  - onStepperFinish: SKIP
    validationType: MANDATORY
    attribute: Manufacturing.entities.Customer.Customer.LastName
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: Manufacturing.references.CustomersHousehold.Household
triggers: []
