        entity: Manufacturing.entities.ProductModel.ProductModel
        form: Manufacturing.entities.ProductModel.forms.ProductModelForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: true
        tableAllowed: true
