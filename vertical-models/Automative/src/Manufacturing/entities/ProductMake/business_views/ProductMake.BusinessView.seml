_name: ProductMake
_package: Manufacturing.entities.ProductMake.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: true
entity: Manufacturing.entities.ProductMake.ProductMake
rootLabel: Make
rootPluralLabel: Makes
useHierarchyOnOpen: false
label: Makes
rootBusinessViewEntity:
  _name: ProductMakeEO
  _type: BusinessViewEntity
  collection: Manufacturing.entities.ProductMake.collection_views.ProductMakeCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: Manufacturing.entities.ProductMake.ProductMake
  form: Manufacturing.entities.ProductMake.forms.ProductMakeForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  tableAllowed: true
  actionSet: Manufacturing.entities.ProductMake.action_sets.ProductMakeActionSet
  sortExpression: (case when Name = 'Mercedes-Benz' then 1 else 2 end)ASC
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: false
    - _name: ProductMakeSearchFormModel
      _type: BusinessEntitySearchTypeConfig
      searchType: CUSTOM_FORM
      customForm: Manufacturing.entities.ProductMake.search_forms.ProductMakeSearchFormModel
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs: []
  transitions:
    - _name: Models
