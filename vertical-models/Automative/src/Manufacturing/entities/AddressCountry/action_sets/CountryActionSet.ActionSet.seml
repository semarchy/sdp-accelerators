_name: CountryActionSet
_package: Manufacturing.entities.AddressCountry.action_sets
_type: ActionSet
entity: Manufacturing.entities.AddressCountry.AddressCountry
label: Country Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorCountries
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: Manufacturing.entities.AddressCountry.steppers.AuthorCountries
  - _name: EditAuthorCountries
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: Manufacturing.entities.AddressCountry.steppers.AuthorCountries
  - _name: MassUpdateAuthorCountries
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: Manufacturing.entities.AddressCountry.steppers.AuthorCountries
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorCountries
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: Manufacturing.entities.AddressCountry.steppers.AuthorCountries
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
