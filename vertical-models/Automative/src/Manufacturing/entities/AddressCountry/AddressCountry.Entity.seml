_name: AddressCountry
_package: Manufacturing.entities.AddressCountry
_type: Entity
primaryKey: Manufacturing.entities.AddressCountry.AddressCountry.CountryID
sourceIdGeneration:
  mode: MANUAL
label: Country
documentation: Countries reference table
enableDelete: true
entityType: BASIC
iconUrl: images://mdi/flag-variant.svg
pluralLabel: Countries
description: "Country reference data used to standardize addresses, plants, suppliers, dealers, and customer locations."
historizeGolden: true
historizeMaster: false
physicalTableName: COUNTRY
dataEntryAllowed: true
attributes:
  - _type: EntityAttribute
    _name: CountryID
    physicalName: COUNTRY_ID
    dataType: String
    description: "Surrogate identifier for the Country record."
    documentation: 'At our company we use this two-letter code (alpha-2) as our ID for all countries. <a href="https://www.iso.org/iso-3166-country-codes.html" target="_blank">ISO 3166 Country Codes</a>'
    goldenAttribute: true
    i18ned: false
    label: Country ID
    mandatory: true
    length: 2
    multiValued: false
    precision: 0
    scale: 0
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: Alpha2Code
    physicalName: ALPHA2_CODE
    dataType: String
    description: "This two-letter code (alpha-2) is recommended as the general-purpose code."
    documentation: "This two-letter code (alpha-2) is recommended as the general-purpose code. ISO 3166 Country Codes: https://www.iso.org/iso-3166-country-codes.html"
    goldenAttribute: true
    i18ned: false
    label: ISO 3166-1 2-Letter Code
    mandatory: false
    length: 2
    lovValidationScope: PRE_CONSO
    mandatoryValidationScope: PRE_CONSO
    multiValued: false
    precision: 0
    scale: 0
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: FlagURL
    physicalName: FLAG_URL
    dataType: String
    description: "URL or asset reference for the country flag displayed in the application."
    documentation: "URL or asset reference for the country flag displayed in the application."
    goldenAttribute: true
    i18ned: false
    label: Flag URL
    mandatory: false
    length: 128
    lovValidationScope: PRE_CONSO
    mandatoryValidationScope: PRE_CONSO
    multiValued: false
    precision: 0
    scale: 0
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: CountryName
    physicalName: COUNTRY_NAME
    dataType: String
    description: Name of the Country
    documentation: Name of the Country
    goldenAttribute: true
    i18ned: false
    label: Country Name
    mandatory: true
    length: 128
    lovValidationScope: PRE_CONSO
    mandatoryValidationScope: PRE_CONSO
    multiValued: false
    precision: 0
    scale: 0
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: Alpha3Cde
    physicalName: ALPHA3_CDE
    dataType: String
    description: "This three-letter code (alpha-3) is more closely related to the country name than the two-letter code. The two-letter code is preferred in most situations."
    documentation: "This three-letter code (alpha-3) is more closely related to the country name than the two-letter code. The two-letter code is preferred in most situations. ISO 3166 Country Codes: https://www.iso.org/iso-3166-country-codes.html"
    goldenAttribute: true
    i18ned: false
    label: ISO 3166-1 3-Letter Code
    mandatory: false
    length: 3
    lovValidationScope: PRE_CONSO
    mandatoryValidationScope: PRE_CONSO
    multiValued: false
    precision: 0
    scale: 0
    searchable: true
    valueSeparator: ","
