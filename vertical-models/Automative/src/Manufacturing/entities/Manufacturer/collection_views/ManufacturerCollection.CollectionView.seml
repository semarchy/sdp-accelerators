_package: Manufacturing.entities.Manufacturer.collection_views
_name: ManufacturerCollection
_type: CollectionView
entity: Manufacturing.entities.Manufacturer.Manufacturer
default: true
displayCard: Manufacturing.entities.Manufacturer.display_cards.ManufacturerDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Manufacturer
tableShowDisplayCard: true
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ManufacturerID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: ManufacturerID
    visibleByDefault: true
  - _type: TextColumn
    _name: Name
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Name
    visibleByDefault: true
  - _type: TextColumn
    _name: Code
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Code
    visibleByDefault: true
  - _type: HyperlinkColumn
    _name: Webiste
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Webiste
    visibleByDefault: true
    componentProperties:
      linkDisplayText: Name
      linkDisplayTextValueInterpreter: SEMQL
      linkTarget: new-window
      linkTargetValueInterpreter: LITERAL
      linkSourceType: url
      linkSourceTypeValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Revenue
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Revenue
    visibleByDefault: true
