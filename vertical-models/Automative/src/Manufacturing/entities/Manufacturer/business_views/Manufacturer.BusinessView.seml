            transitionType: FULLY_QUALIFIED
            useCustomLabel: true
            displayFormTabAs: ICON_LABEL
            displayTransitionNodeAs: ICON_LABEL
            enableHierarchy: ANY SupplierManufacturers.Item have (FID_ItemType like
              'Finished%' or FID_ItemType like '%Assembly%')
            enableHierarchyInterpreter: SEMQL
            expandHierarchyByDefault: false
            filter: ANY SupplierManufacturers.Item have (FID_ItemType like 'Finished%' or
              FID_ItemType like '%Assembly%')
            iconUrl: images://mdi/hammer-screwdriver.svg
