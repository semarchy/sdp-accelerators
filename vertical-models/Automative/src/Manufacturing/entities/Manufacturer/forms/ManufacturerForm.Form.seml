              - searchType: ADVANCED
                enabled: true
              - searchType: BY_FORM
                enabled: true
              - searchType: SEMQL
                enabled: true
          - _name: Collection2
            _type: FormCollection
            displayRecordCount: ALWAYS
            enableUserDefinedSort: true
            filter: FID_ItemType like 'Finished%' or FID_ItemType like '%Assembly%'
            gridAllowed: true
            listAllowed: true
            tableAllowed: true
            transitionPath: SupplierManufacturerPlants.Item
