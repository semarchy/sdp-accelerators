    _name: Revenue
    physicalName: REVENUE
    dataType: String
    description: "Reported revenue for the Manufacturer record."
    documentation: Revenue of the Manufacturer
    goldenAttribute: true
    i18ned: false
    label: Revenue
    mandatory: false
    length: 128
    lovValidationScope: PRE_CONSO
    mandatoryValidationScope: PRE_CONSO
    multiValued: false
    precision: 0
    scale: 0
    searchable: true
    valueSeparator: ","
  - _type: EntityAttribute
    _name: Webiste
    physicalName: WEBISTE
    dataType: String
