                  textColorValueInterpreter: SEMQL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "0"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "3"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  color: >-
                    case

                    when

                    ANY BillOfMaterials have (RelationshipType = 'ReplacedBy')
                    then 'md:red'

                    else null

                    end
                  colorValueInterpreter: SEMQL
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: right
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: OtherName
                value: OtherName
                dataType: STRING
                useCustomLabel: false
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textColor: >-
                    case

                    when

                    ANY BillOfMaterials have (RelationshipType = 'ReplacedBy')
                    then 'md:red'

                    else 'md:black'

                    end
                  textColorValueInterpreter: SEMQL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "1"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "3"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  color: >-
                    case

                    when

                    ANY BillOfMaterials have (RelationshipType = 'ReplacedBy')
                    then 'md:red'

                    else null

                    end
                  colorValueInterpreter: SEMQL
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: right
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: FDN_ItemFamily
                value: FDN_ItemFamily
                dataType: STRING
                useCustomLabel: false
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                referencedEntity: Manufacturing.entities.ItemFamily.ItemFamily
                _type: ReferenceField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textColor: >-
                    case

                    when

                    ANY BillOfMaterials have (RelationshipType = 'ReplacedBy')
                    then 'md:red'

                    else 'md:black'

                    end
                  textColorValueInterpreter: SEMQL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  displayType: hyperlink
                  displayTypeValueInterpreter: LITERAL
                labelProperties:
                  color: >-
