_package: Manufacturing.entities.Item.forms
_type: Form
_name: ItemForm
entity: Manufacturing.entities.Item.Item
default: true
formTabs:
  - _name: Item
    _type: FormTab
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    iconUrl: images://mdi/screw-machine-flat-top.svg
    label: Item
    displayFormTabAs: ICON_LABEL
    content:
      - _name: ReplacedBy
        label: Replaced By
        value: >-
          'This item ' || Name || '(' || SKU || ') supplied by ' || (LOOKUP
          distinct_string_agg Name separated by ', ' FROM
          SupplierManufacturers.Supplier END) || ' is replaced by ' ||

          LOOKUP
          	FIRST '<a href="Manufacturing/Manufacturing/browsing/Item/' || FID_ParentItem || '/ReplacedBys/' || FID_ChildItem || '" target="_blank">' || sem_concat(' ', '1', ChildItem.Name,'(' , ChildItem.SKU, ')', ' starting from ', TO_CHAR(EffectiveStartDate,'FMMon DD, YYYY')) || '</a>'
          	FROM BillOfMaterials
          END
        dataType: STRING
        useCustomLabel: true
        documentationInterpreter: LITERAL
        visibleValue: ANY BillOfMaterials have (RelationshipType = 'ReplacedBy')
        visibleValueInterpreter: SEMQL
        _type: MarkdownField
        authoringMode: auto
        authoringModeValueInterpreter: LITERAL
        componentProperties:
          textAlign: center
          textAlignValueInterpreter: LITERAL
          textColor: md:white
          textColorValueInterpreter: LITERAL
          textTypography: body-1
          textTypographyValueInterpreter: LITERAL
          contentHeight: "46"
          contentHeightValueInterpreter: LITERAL
          contentBackgroundColor: md:amber
          contentBackgroundColorValueInterpreter: LITERAL
          isCharCounterVisible: "0"
          isCharCounterVisibleValueInterpreter: LITERAL
        labelProperties:
          position: left
          positionValueInterpreter: LITERAL
          alignment: right
          alignmentValueInterpreter: LITERAL
          typography: caption
          typographyValueInterpreter: LITERAL
          isVisible: "0"
          isVisibleValueInterpreter: LITERAL
      - _type: FormContainer
        _name: Container3
        layoutDirection: ROW
        labelWidth: 200px
        content:
          - _type: FormContainer
            _name: Container2
            layoutDirection: COLUMN
            content:
              - _name: ItemID
                value: ItemID
                dataType: LONG_INTEGER
                useCustomLabel: false
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: IdField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textColor: >-
                    case

                    when

                    ANY BillOfMaterials have (RelationshipType = 'ReplacedBy')
                    then 'md:red'

                    else 'md:black'

                    end
                  textColorValueInterpreter: SEMQL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                labelProperties:
                  color: >-
                    case

                    when

                    ANY BillOfMaterials have (RelationshipType = 'ReplacedBy')
                    then 'md:red'

                    else null

                    end
                  colorValueInterpreter: SEMQL
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: right
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: SKU
                label: SKU
                value: COALESCE(NormalizedSKU , SKU)
                dataType: STRING
                useCustomLabel: true
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textColor: >-
                    case

                    when

                    ANY BillOfMaterials have (RelationshipType = 'ReplacedBy')
                    then 'md:red'

                    else 'md:black'

                    end
                  textColorValueInterpreter: SEMQL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "0"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "3"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  color: >-
                    case

                    when

                    ANY BillOfMaterials have (RelationshipType = 'ReplacedBy')
                    then 'md:red'

                    else null

                    end
                  colorValueInterpreter: SEMQL
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: right
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: Name
                value: Name
                dataType: STRING
                useCustomLabel: false
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                _type: TextField
