_name: Item
_package: Manufacturing.entities.Item.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: true
entity: Manufacturing.entities.Item.Item
rootLabel: Item
rootPluralLabel: Items
useHierarchyOnOpen: true
label: Items
rootBusinessViewEntity:
  _name: ItemEO
  _type: BusinessViewEntity
  collection: Manufacturing.entities.Item.collection_views.ItemCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: Manufacturing.entities.Item.Item
  form: Manufacturing.entities.Item.forms.ItemForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: false
  tableAllowed: true
  actionSet: Manufacturing.entities.Item.action_sets.ItemActionSet
  businessEntityBuiltInFilters:
    - _name: NewItems
      _type: BusinessEntityBuiltInFilter
      label: New Items
      semQlCondition: FID_ItemCondition = 'New'
      visible: true
    - _name: RemanufacturedItems
      _type: BusinessEntityBuiltInFilter
      label: Remanufactured Items
      semQlCondition: FID_ItemCondition = 'Remanufactured'
      visible: true
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations:
    - browsingTarget: NOT_NAVIGABLE
      formCollection: Manufacturing.entities.Item.forms.ItemForm.Item.Container6.BillOfMaterial
  referenceAttributeNavigationConfigs: []
  transitions:
    - _name: Suppliers
      _type: BusinessViewTransition
      transitionPath: SupplierManufacturers.Supplier
      transitionType: FULLY_QUALIFIED
      useCustomLabel: false
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: |-
        ANY SupplierManufacturers.Supplier have (SupplierID is not null) 
        and
        (FID_ItemType not like '%Assembly' OR FID_ItemType not like 'Finished%')
      enableHierarchyInterpreter: SEMQL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/office-building.svg
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      visibleInFormTabCondition: |-
        ANY SupplierManufacturers.Supplier have (SupplierID is not null) 
        and
        (FID_ItemType not like '%Assembly' OR FID_ItemType not like 'Finished%')
      businessViewEntity:
        _name: Supplier
        _type: BusinessViewEntity
        collection: Manufacturing.entities.Supplier.collection_views.SupplierCollection
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        entity: Manufacturing.entities.Supplier.Supplier
        form: Manufacturing.entities.Supplier.forms.SupplierForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        businessEntityBuiltInFilters: []
        businessEntitySearchConfigs:
          - _name: TextConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: TEXT
            enabled: true
          - _name: FormConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: BY_FORM
            enabled: true
          - _name: AdvancedConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: ADVANCED
            enabled: true
          - _name: SemqlConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: SEMQL
            enabled: true
        embeddedCollectionNavigations: []
        referenceAttributeNavigationConfigs:
          - formField: Manufacturing.entities.Supplier.forms.SupplierForm.Supplier.Details.Container.Container2.FDN_SupplierPaymentTerm
            navigationMode: MODAL_FORM
        transitions: []
    - _name: ManufacturingPlant
      _type: BusinessViewTransition
      transitionPath: SupplierManufacturers.ManufacturingPlant
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: ANY SupplierManufacturers.ManufacturingPlant have
        (ManufacturingPlantID is not null) and (FID_ItemType like '%Assembly' OR
        FID_ItemType like 'Finished%')
      enableHierarchyInterpreter: SEMQL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/factory.svg
      label: Manufacturer
      pluralLabel: Manufacturers
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      visibleInFormTabCondition: ANY SupplierManufacturers.ManufacturingPlant have
        (ManufacturingPlantID is not null) and (FID_ItemType like '%Assembly' OR
        FID_ItemType like 'Finished%')
      businessViewEntity:
        _name: ManufacturingPlant
        _type: BusinessViewEntity
        collection: Manufacturing.entities.ManufacturingPlant.collection_views.ManufacturingPlantCollection
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        entity: Manufacturing.entities.ManufacturingPlant.ManufacturingPlant
        form: Manufacturing.entities.ManufacturingPlant.forms.ManufacturingPlantForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        businessEntityBuiltInFilters: []
        businessEntitySearchConfigs:
          - _name: TextConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: TEXT
            enabled: true
          - _name: FormConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: BY_FORM
            enabled: true
          - _name: AdvancedConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: ADVANCED
            enabled: true
          - _name: SemqlConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: SEMQL
            enabled: true
        embeddedCollectionNavigations: []
        referenceAttributeNavigationConfigs:
          - formField: Manufacturing.entities.ManufacturingPlant.forms.ManufacturingPlantForm.ManufacturingPlant.FDN_Manufacturer
            navigationMode: MODAL_FORM
          - formField: Manufacturing.entities.ManufacturingPlant.forms.ManufacturingPlantForm.ManufacturingPlant.FDN_ManufacturingPlantType
