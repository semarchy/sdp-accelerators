_package: Manufacturing.entities.Item.collection_views
_name: ItemCollection
_type: CollectionView
entity: Manufacturing.entities.Item.Item
default: true
displayCard: Manufacturing.entities.Item.display_cards.ItemsDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Item
tableShowDisplayCard: true
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: true
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ItemID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: ItemID
    visibleByDefault: false
  - _type: TextColumn
    _name: SKU
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: SKU
    visibleByDefault: true
  - _type: TextColumn
    _name: Name
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Name
    visibleByDefault: true
  - _type: TextColumn
    _name: OtherName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: OtherName
    visibleByDefault: true
  - _type: TextColumn
    _name: Description
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Description
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_ItemFamily
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_ItemFamily
    visibleByDefault: true
    referencedEntity: Manufacturing.entities.ItemFamily.ItemFamily
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FDN_ItemSubFamily
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_ItemSubFamily
    visibleByDefault: true
    referencedEntity: Manufacturing.entities.ItemSubFamily.ItemSubFamily
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FDN_ItemType
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_ItemType
    visibleByDefault: true
    referencedEntity: Manufacturing.entities.ItemType.ItemType
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FDN_ItemCondition
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_ItemCondition
    visibleByDefault: true
    referencedEntity: Manufacturing.entities.ItemCondition.ItemCondition
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      useAvatarInChip: "1"
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: LeadTime
    columnAlign: LEFT
    dataType: INTEGER
    useCustomLabel: false
    value: LeadTime
    visibleByDefault: true
