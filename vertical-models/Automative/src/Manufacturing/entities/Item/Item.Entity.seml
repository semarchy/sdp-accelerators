sourceIdGeneration:
  mode: MANUAL
  startWith: 1
label: Item
enableDelete: true
entityType: BASIC
iconUrl: images://mdi/hammer-screwdriver.svg
pluralLabel: Items
description: "Product, part, raw material, semi-finished good, or finished assembly managed across sourcing and manufacturing processes."
documentation: "Product, part, raw material, semi-finished good, or finished assembly managed across sourcing and manufacturing processes. Use this entity to understand and govern this business object in the Manufacturing and Automotive accelerator applications."
