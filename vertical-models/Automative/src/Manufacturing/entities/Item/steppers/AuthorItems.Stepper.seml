      childImportModeOnParentEdit: CREATE_AND_UPDATE
      createChildUsingManyToManyPicker: false
      enableChildCopyOnParentCreate: true
      enableChildCopyOnParentEdit: true
      enableChildCreationOnParentCreate: true
      enableChildCreationOnParentEdit: true
      enableChildDeleteOnParentEdit: true
      enableChildEditOnParentCreate: true
      enableChildEditOnParentEdit: true
      enableChildImportOnParentCreate: false
      enableChildImportOnParentEdit: false
      enableChildRemoveOnParentCreate: true
      enableChildRemoveOnParentEdit: true
      manyToManyCustomSortEnabled: false
      manyToManyDisplayGridAllowed: true
      manyToManyDisplayListAllowed: true
      manyToManyDisplayTableAllowed: true
      manyToManyUserDefinedSortEnabled: true
      skipToChildCreationOnParentCreate: false
      skipToChildEditingOnParentEdit: false
      manyToManyDefaultDisplayType: TABLE
      oneToManyReference: Manufacturing.references.SupplierManufacturersHasItem
      manyToManyPickerSearchTypeConfigs: []
      childSteps:
        - _name: SupplierManufacturerPlant
          _type: FormStep
          canFinishSubLevel: true
          enabledOnParentCreate: true
          enabledOnParentEdit: true
          enableMasterValuePicking: false
          formFieldsMode: AUTO
          label: Supplier Manufacturer Plant
          formTab: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant
          formStepEnrichers:
            - enricher: Manufacturing.entities.SupplierManufacturerPlant.enrichers.Manufacturer
              executedOnButtonClick: false
              executedOnDataChange: false
              executedOnFormOpen: false
          referenceFormFieldConfigs:
            - enableUserSort: true
              referencePickerType: AUTO_COMPLETE
              fdnFormField: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant.FDN_Item
              referencePickerCollectionView: Manufacturing.entities.Item.collection_views.ItemCollection
              sortExpression: UpdateDate, ItemID DESC
              referencePickerSearchTypeConfigs: []
            - enableUserSort: true
              referencePickerType: AUTO_COMPLETE
              fdnFormField: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant.FDN_ManufacturingPlant
              referenceFilter: >-
                (Referenced.FID_Manufacturer  = Record.FID_Manufacturer )

                OR

                (Record.FID_Manufacturer IS NULL AND Referenced.PlantName like
                '%')
              referencePickerCollectionView: Manufacturing.entities.ManufacturingPlant.collection_views.ManufacturingPlantCollection
              referencePickerSearchTypeConfigs: []
            - enableUserSort: true
              referencePickerType: AUTO_COMPLETE
              fdnFormField: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant.FDN_Supplier
              referencePickerCollectionView: Manufacturing.entities.Supplier.collection_views.SupplierCollection
              sortExpression: |-
                (LOOKUP
                	COUNT ItemID
                	FROM SupplierManufacturers.Item
                END) DESC
              referencePickerSearchTypeConfigs: []
            - enableUserSort: true
              referencePickerType: AUTO_COMPLETE
              fdnFormField: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant.FDN_SupplierAddress
              referenceFilter: >-
                (ANY Referenced.SupplierAddressJoins.Supplier has (SupplierID =
                Record.FID_Supplier ))

                OR

                (Record.FID_Supplier IS NULL and Referenced.GeocodedCountry like
                '%' and Referenced.Household = 'false')
              referencePickerCollectionView: Manufacturing.entities.Address.collection_views.AddressCollection
              referencePickerSearchTypeConfigs: []
            - enableUserSort: true
              referencePickerType: AUTO_COMPLETE
              fdnFormField: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant.FDN_Manufacturer
              referencePickerCollectionView: Manufacturing.entities.Manufacturer.collection_views.ManufacturerCollection
              sortExpression: |-
                (LOOKUP
                	COUNT ItemID
                	FROM SupplierManufacturerPlants.Item
                END) DESC
              referencePickerSearchTypeConfigs: []
          formStepValidations:
            - validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturersHasItem.Item
              executedOnDataChange: true
              executedOnFormOpen: false
            - validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturersHaveSupplierAddress.SupplierAddress
              executedOnDataChange: true
              executedOnFormOpen: false
            - validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturerPlantsHasManufacturer.Manufacturer
              executedOnDataChange: true
              executedOnFormOpen: false
            - validationType: MANDATORY
              attribute: Manufacturing.references.SupplierManufacturersHasItem.Item
              executedOnDataChange: true
              executedOnFormOpen: true
            - validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturersSupplier.Supplier
              executedOnDataChange: true
              executedOnFormOpen: false
            - validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturersHasManufacturingPlant.ManufacturingPlant
              executedOnDataChange: true
              executedOnFormOpen: false
            - validationType: MANDATORY
              attribute: Manufacturing.references.SupplierManufacturersHasManufacturingPlant.ManufacturingPlant
              executedOnDataChange: true
              executedOnFormOpen: true
          stepTransitionValidations:
            - onStepExit: SKIP
              validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturersHaveSupplierAddress.SupplierAddress
            - onStepExit: SKIP
              validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturersHasItem.Item
            - onStepExit: SKIP
              validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturersHasManufacturingPlant.ManufacturingPlant
            - onStepExit: WARN
              validationType: MANDATORY
              attribute: Manufacturing.references.SupplierManufacturersHasManufacturingPlant.ManufacturingPlant
            - onStepExit: BLOCK
              validationType: MANDATORY
              attribute: Manufacturing.references.SupplierManufacturersHasItem.Item
            - onStepExit: SKIP
              validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturerPlantsHasManufacturer.Manufacturer
            - onStepExit: SKIP
              validationType: FOREIGN
              attribute: Manufacturing.references.SupplierManufacturersSupplier.Supplier
          stepTriggers: []
