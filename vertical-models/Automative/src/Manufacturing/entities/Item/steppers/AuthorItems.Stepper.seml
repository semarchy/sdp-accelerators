_name: AuthorItems
_package: Manufacturing.entities.Item.steppers
_type: Stepper
entity: Manufacturing.entities.Item.Item
rootStep:
  _name: Items
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: Manufacturing.entities.Item.collection_views.ItemCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Items
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: MANDATORY
      attribute: Manufacturing.references.ItemsHaveItemSubFamily.ItemSubFamily
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.ItemsBelongsToItemFamily.ItemFamily
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.ItemsHaveItemCondition.ItemCondition
    - onStepExit: SKIP
      validationType: MANDATORY
      attribute: Manufacturing.references.ItemsBelongsToItemFamily.ItemFamily
    - onStepExit: SKIP
      validationType: MANDATORY
      attribute: Manufacturing.entities.Item.Item.Name
    - onStepExit: SKIP
      validationType: MANDATORY
      attribute: Manufacturing.entities.Item.Item.SKU
    - onStepExit: SKIP
      validationType: UNIQUE
      uniqueKey: Manufacturing.entities.Item.unique_keys.SKU_ID
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.ItemsHaveItemType.ItemType
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.ItemsHaveItemSubFamily.ItemSubFamily
  stepTriggers: []
  childSteps:
    - _name: Item
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Item
      formTab: Manufacturing.entities.Item.forms.ItemFormDataEntry.Item
      formStepEnrichers:
        - enricher: Manufacturing.entities.Item.enrichers.DefaultItemCondition
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Manufacturing.entities.Item.enrichers.NormalizeSKU
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: false
      referenceFormFieldConfigs:
        - enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Manufacturing.entities.Item.forms.ItemFormDataEntry.Item.Container4.FDN_ItemType
          referencePickerCollectionView: Manufacturing.entities.ItemType.collection_views.ItemTypeCollection
          referencePickerSearchTypeConfigs: []
        - enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Manufacturing.entities.Item.forms.ItemFormDataEntry.Item.Container.Container3.FDN_ItemSubFamily
          referenceFilter: Referenced.FID_ItemFamily = Record.FID_ItemFamily
          referencePickerCollectionView: Manufacturing.entities.ItemSubFamily.collection_views.ItemSubFamilyCollection
          referencePickerSearchTypeConfigs: []
        - enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Manufacturing.entities.Item.forms.ItemFormDataEntry.Item.Container.Container2.FDN_ItemFamily
          referencePickerCollectionView: Manufacturing.entities.ItemFamily.collection_views.ItemFamilyCollection
          referencePickerSearchTypeConfigs: []
        - enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Manufacturing.entities.Item.forms.ItemFormDataEntry.Item.Container4.FDN_ItemCondition
          referencePickerCollectionView: Manufacturing.entities.ItemCondition.collection_views.ItemConditionCollection
          referencePickerSearchTypeConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: Manufacturing.references.ItemsHaveItemCondition.ItemCondition
          executedOnDataChange: true
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: Manufacturing.references.ItemsBelongsToItemFamily.ItemFamily
          executedOnDataChange: true
          executedOnFormOpen: false
        - validationType: MANDATORY
          attribute: Manufacturing.entities.Item.Item.Name
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: UNIQUE
          executedOnDataChange: true
          executedOnFormOpen: false
          uniqueKey: Manufacturing.entities.Item.unique_keys.SKU_ID
        - validationType: FOREIGN
          attribute: Manufacturing.references.ItemsHaveItemType.ItemType
          executedOnDataChange: true
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: Manufacturing.references.ItemsHaveItemSubFamily.ItemSubFamily
          executedOnDataChange: true
          executedOnFormOpen: false
        - validationType: MANDATORY
          attribute: Manufacturing.entities.Item.Item.SKU
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: MANDATORY
          attribute: Manufacturing.references.ItemsHaveItemSubFamily.ItemSubFamily
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: MANDATORY
          attribute: Manufacturing.references.ItemsBelongsToItemFamily.ItemFamily
          executedOnDataChange: true
          executedOnFormOpen: true
      stepTransitionValidations:
        - onStepExit: WARN
          validationType: FOREIGN
          attribute: Manufacturing.references.ItemsHaveItemType.ItemType
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Manufacturing.entities.Item.Item.Name
        - onStepExit: WARN
          validationType: MANDATORY
          attribute: Manufacturing.references.ItemsHaveItemSubFamily.ItemSubFamily
        - onStepExit: WARN
          validationType: MANDATORY
          attribute: Manufacturing.references.ItemsBelongsToItemFamily.ItemFamily
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Manufacturing.entities.Item.Item.SKU
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.ItemsHaveItemCondition.ItemCondition
        - onStepExit: WARN
          validationType: FOREIGN
          attribute: Manufacturing.references.ItemsBelongsToItemFamily.ItemFamily
        - onStepExit: WARN
          validationType: FOREIGN
          attribute: Manufacturing.references.ItemsHaveItemSubFamily.ItemSubFamily
        - onStepExit: BLOCK
          validationType: UNIQUE
          uniqueKey: Manufacturing.entities.Item.unique_keys.SKU_ID
      stepTriggers: []
