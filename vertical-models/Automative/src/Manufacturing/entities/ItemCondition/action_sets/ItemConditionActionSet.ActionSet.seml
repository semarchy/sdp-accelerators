_name: ItemConditionActionSet
_package: Manufacturing.entities.ItemCondition.action_sets
_type: ActionSet
entity: Manufacturing.entities.ItemCondition.ItemCondition
label: Item Condition Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorItemConditions
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: Manufacturing.entities.ItemCondition.steppers.AuthorItemConditions
  - _name: EditAuthorItemConditions
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: Manufacturing.entities.ItemCondition.steppers.AuthorItemConditions
  - _name: MassUpdateAuthorItemConditions
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: Manufacturing.entities.ItemCondition.steppers.AuthorItemConditions
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorItemConditions
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: Manufacturing.entities.ItemCondition.steppers.AuthorItemConditions
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
