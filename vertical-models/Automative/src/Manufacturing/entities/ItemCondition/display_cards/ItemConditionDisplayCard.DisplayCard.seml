_name: ItemConditionDisplayCard
_package: Manufacturing.entities.ItemCondition.display_cards
_type: DisplayCard
entity: Manufacturing.entities.ItemCondition.ItemCondition
default: true
primaryTextExpression: ItemCondition
primaryImageValueInterpreter: LITERAL
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValue: case when ItemCondition = 'Remanufactured' then
  'images://mdi/autorenew.svg' else 'images://mdi/sticker-check.svg' end
avatarImageValueInterpreter: SEMQL
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
