          referencePickerType: AUTO_COMPLETE
          fdnFormField: Manufacturing.entities.ProductVehicleOptionOrFeature.forms.ProductVehicleOptionOrFeatureForm.ProductVehicleOptionOrFeature.FDN_OptionOrFeatureValue
          referenceFilter: Record.FDN_ProductTrimOptionOrFeature =
            Referenced.FDN_OptionOrFeature
          referencePickerCollectionView: Manufacturing.entities.ProductOptionOrFeatureValue.collection_views.ProductOptionOrFeatureValueCollection
          referencePickerSearchTypeConfigs: []
        - enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Manufacturing.entities.ProductVehicleOptionOrFeature.forms.ProductVehicleOptionOrFeatureForm.ProductVehicleOptionOrFeature.FDN_ProductTrimOptionOrFeature
          referenceFilter: Referenced.FDN_Trim = Record.Vehicle.FDN_Trim
          referencePickerCollectionView: Manufacturing.entities.ProductTrimOptionOrFeature.collection_views.ProductTrimOptionOrFeatureCollection
          referencePickerSearchTypeConfigs: []
      formStepValidations:
