      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Vehicle Option Or Feature
      formTab: Manufacturing.entities.ProductVehicleOptionOrFeature.forms.ProductVehicleOptionOrFeatureForm.ProductVehicleOptionOrFeature
      formStepEnrichers: []
      referenceFormFieldConfigs:
        - enableUserSort: true
          referencePickerType: AUTO_COMPLETE
