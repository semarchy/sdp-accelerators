          executedOnFormOpen: false
        - validationType: MANDATORY
          attribute: Manufacturing.references.VehicleOptionOrFeaturesProductTrimOptionOrFeature.ProductTrimOptionOrFeature
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: FOREIGN
          attribute: Manufacturing.references.VehicleOptionOrFeaturesVehicle.Vehicle
          executedOnDataChange: false
          executedOnFormOpen: false
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.VehicleOptionOrFeaturesProductOptionOrFeatureValue.OptionOrFeatureValue
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.VehicleOptionOrFeaturesVehicle.Vehicle
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.VehicleOptionOrFeaturesProductTrimOptionOrFeature.ProductTrimOptionOrFeature
        - onStepExit: SKIP
