_name: ProductDealer
_package: Manufacturing.entities.ProductDealer.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: true
entity: Manufacturing.entities.ProductDealer.ProductDealer
rootLabel: Dealer
rootPluralLabel: Dealers
useHierarchyOnOpen: false
label: Dealers
rootBusinessViewEntity:
  _name: ProductDealerEO
  _type: BusinessViewEntity
  collection: Manufacturing.entities.ProductDealer.collection_views.ProductDealerCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: Manufacturing.entities.ProductDealer.ProductDealer
  form: Manufacturing.entities.ProductDealer.forms.ProductDealerForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  tableAllowed: true
  actionSet: Manufacturing.entities.ProductDealer.action_sets.ProductDealerActionSet
  sortExpression: |-
    (LOOKUP
    	COUNT MakeID
    	FROM DealerMakes.Make
    END) DESC,
    (LOOKUP
    	COUNT VehicleID
    	FROM Vehicles
    	WHERE FDN_SellingDealership like 'Mercedes%'
    END) DESC
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs:
    - formField: Manufacturing.entities.ProductDealer.forms.ProductDealerForm.ProductDealer.FDN_Address
      navigationMode: MODAL_FORM
  transitions:
    - _name: Service
      _type: BusinessViewTransition
      transitionPath: DealerServices.Service
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "1"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/tools.svg
      label: Service
      pluralLabel: Service
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _name: ProductDealerService
        _type: BusinessViewEntity
        collection: Manufacturing.entities.ProductService.collection_views.ProductServiceCollectionNameOnly
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        entity: Manufacturing.entities.ProductService.ProductService
        form: Manufacturing.entities.ProductService.forms.ProductServiceForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: false
        tableAllowed: true
        businessEntityBuiltInFilters: []
        businessEntitySearchConfigs:
          - _name: TextConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: TEXT
            enabled: true
          - _name: FormConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: BY_FORM
            enabled: true
          - _name: AdvancedConfig
            _type: BusinessEntitySearchTypeConfig
