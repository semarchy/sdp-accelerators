          - _name: FormField
            value: >-
              '<!DOCTYPE html>

              <html>
                <head>   
                  <meta charset="utf-8">
                  <script src="https://maps.googleapis.com/maps/api/js?key=INSERT_YOUR_API_KEY"></script>
                  <script>
              var address= "' || SEM_CONCAT(' ', '1', Name,
              Address.GeocodedStreetNumber, Address.GeocodedStreetName,
              Address.GeocodedLocality, Address.GeocodedState,
              Address.GeocodedCountry, Address.GeocodedPostalCode) || '"

              var zoom = 18;

              // mapType

              // ROADMAP displays the normal, default 2D tiles of Google Maps.

              // SATELLITE displays photographic tiles.

              // HYBRID displays a mix of photographic tiles and a tile layer
              for prominent features (roads, city names).

              // TERRAIN

              var mapType = google.maps.MapTypeId.SATELLITE;

              var useMarker = true;

              var map;

              function initialize() {   
                var geocoder = new google.maps.Geocoder();
                geocoder.geocode( { "address": address}, function(results, status) {
                  if (status == google.maps.GeocoderStatus.OK) {
                    displayMap(results[0].geometry.location);
                  }
                });
                window.onresize = resize;
              }

              function displayMap(latlng) {
                var mapOptions = {
                  zoom: zoom,
                  center: latlng,
                  mapTypeId: mapType
                }
                map = new google.maps.Map(document.getElementById("map_canvas"), mapOptions);
                if (useMarker) {
                  var marker = new google.maps.Marker({
                  map: map,
                  position: latlng,
                  opacity: 0.85,
                  title: "' 
              || CONCAT( Name

              , '" + String.fromCharCode(13) + "',
              	Address.GeocodedStreetNumber
                , ' '
                , Address.GeocodedStreetName
                , '" + String.fromCharCode(13) + "'
                , Address.GeocodedLocality
                , ', '
                , Address.GeocodedState
              )  

              || '"
                  });
                }
                resize("");
              }

              function resize(e) {
                var center = map.getCenter();
                map.getDiv().style.height = window.innerHeight + "px";
                map.getDiv().style.width =  window.innerWidth + "px";
                google.maps.event.trigger(map, ''resize'');
                map.setCenter(center);
              }

              google.maps.event.addDomListener(window, "load", initialize);
                  </script>
                </head>
                <body style="margin:0px;">
                  <div id="map_canvas" style="margin:0px;"></div>
                </body>
              </html>'
            dataType: STRING
            useCustomLabel: false
            documentationInterpreter: LITERAL
            visibleValue: "1"
            visibleValueInterpreter: LITERAL
            _type: ObjectField
            authoringMode: auto
            authoringModeValueInterpreter: LITERAL
            componentProperties:
              textTypography: body-1
              textTypographyValueInterpreter: LITERAL
              objectHeight: "425"
              objectHeightValueInterpreter: LITERAL
              sourceType: content
              sourceTypeValueInterpreter: LITERAL
            labelProperties:
              position: left
              positionValueInterpreter: LITERAL
              alignment: right
              alignmentValueInterpreter: LITERAL
              typography: caption
              typographyValueInterpreter: LITERAL
              isVisible: "0"
              isVisibleValueInterpreter: LITERAL
