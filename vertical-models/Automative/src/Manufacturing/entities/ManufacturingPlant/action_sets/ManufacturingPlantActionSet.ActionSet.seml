    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorManufacturingPlants
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
