    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: Manufacturing.entities.ManufacturingPlant.steppers.AuthorManufacturingPlants
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
