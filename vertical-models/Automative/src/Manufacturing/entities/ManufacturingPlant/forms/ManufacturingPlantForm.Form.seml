      - _type: FormSection
        _name: PlantTiming
        label: Plant Timing
        layoutDirection: COLUMN
        documentationInterpreter: LITERAL
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: Container2
            layoutDirection: ROW
            content:
              - _name: Is24_7
                label: 24 * 7
                value: |-
                  LOOKUP
                  	FIRST Is24_7
                  	FROM WorkShifts
                  	ORDER BY UpdateDate DESC
                  END
                dataType: BOOLEAN
                useCustomLabel: true
                documentationInterpreter: LITERAL
                visibleValue: |-
                  (LOOKUP 	
                  	FIRST StartTime
                  	FROM WorkShifts 	
                  	ORDER BY UpdateDate DESC 
                  END) IS NULL OR 
                  (LOOKUP 	
                  	FIRST EndTime
                  	FROM WorkShifts 	
                  	ORDER BY UpdateDate DESC 
                  END) IS NULL
                visibleValueInterpreter: SEMQL
                _type: CheckboxField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  useSwitch: "0"
                  useSwitchValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: right
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
                  authoringLabelPosition: left
                  authoringLabelPositionValueInterpreter: LITERAL
              - _name: StartTime
                label: Start Time
                value: |-
                  LOOKUP
                  	FIRST StartTime
                  	FROM WorkShifts
                  	ORDER BY UpdateDate DESC
                  END
                dataType: STRING
                useCustomLabel: true
                documentationInterpreter: LITERAL
                visibleValue: |-
                  (LOOKUP
                  	FIRST Is24_7
                  	FROM WorkShifts
                  	ORDER BY UpdateDate DESC
                  END) = 'FALSE' OR 
                  (LOOKUP
                  	FIRST Is24_7
                  	FROM WorkShifts
                  	ORDER BY UpdateDate DESC
                  END) IS NULL
                visibleValueInterpreter: SEMQL
                _type: TextField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "0"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "3"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: right
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _name: EndTime
                label: EndTime
                value: |-
                  LOOKUP
                  	FIRST EndTime
                  	FROM WorkShifts
                  	ORDER BY UpdateDate DESC
                  END
                dataType: STRING
                useCustomLabel: true
                documentationInterpreter: LITERAL
                visibleValue: (LOOKUP 	FIRST Is24_7 	FROM WorkShifts 	ORDER BY UpdateDate DESC
                  END) = 'FALSE' OR  (LOOKUP 	FIRST Is24_7 	FROM
                  WorkShifts 	ORDER BY UpdateDate DESC END) IS NULL
                visibleValueInterpreter: SEMQL
                _type: TextField
                authoringMode: auto
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  isMultiline: "0"
                  isMultilineValueInterpreter: LITERAL
                  multilineMaxLines: "3"
                  multilineMaxLinesValueInterpreter: LITERAL
                  multilineMinLines: "1"
                  multilineMinLinesValueInterpreter: LITERAL
                  isCharCounterVisible: "0"
                  isCharCounterVisibleValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: right
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
