_package: Manufacturing.entities.ManufacturingPlant.collection_views
_name: ManufacturingPlantCollection
_type: CollectionView
entity: Manufacturing.entities.ManufacturingPlant.ManufacturingPlant
default: true
displayCard: Manufacturing.entities.ManufacturingPlant.display_cards.ManufacturingPlantDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Manufacturing Plant
tableShowDisplayCard: true
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ManufacturingPlantID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: ManufacturingPlantID
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_Manufacturer
    columnAlign: LEFT
    dataType: STRING
    label: Manufacturer
    useCustomLabel: true
    value: FDN_Manufacturer
    visibleByDefault: true
    referencedEntity: Manufacturing.entities.Manufacturer.Manufacturer
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: TextColumn
    _name: PlantName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PlantName
    visibleByDefault: true
  - _type: MenuColumn
    _name: PlantOwnership
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: PlantOwnership
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_ManufacturingPlantType
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_ManufacturingPlantType
    visibleByDefault: true
    referencedEntity: Manufacturing.entities.ManufacturingPlantType.ManufacturingPlantType
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: DateColumn
    _name: OperationStartDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: OperationStartDate
    visibleByDefault: true
  - _type: DateColumn
    _name: OperationEndDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: OperationEndDate
    visibleByDefault: true
  - _type: CheckboxColumn
    _name: IsActive
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: IsActive
    visibleByDefault: true
    componentProperties:
      useSwitch: "0"
      useSwitchValueInterpreter: LITERAL
  - _type: ChipsColumn
    _name: OutputProduct
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: OutputProduct
    visibleByDefault: true
