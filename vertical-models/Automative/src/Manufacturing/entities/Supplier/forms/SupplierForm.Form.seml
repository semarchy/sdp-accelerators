                content:
                  - _name: FDN_SupplierPaymentTerm
                    label: Payment Term
                    value: FDN_SupplierPaymentTerm
                    dataType: STRING
                    useCustomLabel: true
                    documentation: >-
                      Supplier Payment Terms specify when a buyer must pay
                      invoices to a supplier. Terms like "Net 30" mean payment
                      is due 30 days after invoicing. 


                      These agreements impact cash flow and relationships,
                      influencing supplier loyalty. Balancing financial
                      obligations and positive ties is crucial for effective
                      business and a sustainable supply chain.
                    documentationInterpreter: LITERAL
                    visibleValue: "1"
                    visibleValueInterpreter: LITERAL
                    referencedEntity: Manufacturing.entities.PaymentTerm.PaymentTerm
                    _type: ReferenceField
                    authoringMode: auto
                    authoringModeValueInterpreter: LITERAL
                    componentProperties:
                      textAlign: left
                      textAlignValueInterpreter: LITERAL
                      textTypography: body-1
                      textTypographyValueInterpreter: LITERAL
