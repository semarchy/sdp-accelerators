    iconUrl: images://manufacturing/legal-entity-mgmt.svg
    label: Supplier Check
    displayFormTabAs: ICON_LABEL
    content:
      - _name: SupplierFinancialCheck
        label: Supplier Financial Check
        value: >-
          case when (LOOKUP COUNT(FID_Supplier) FROM SupplierManufacturers
          END)>0 then 'Stable'

          else 'Unstable'

          end
        dataType: STRING
        useCustomLabel: true
        documentation: Financial check to see performed by Compliance team to see the
          Financial Viability of the vendor.
        documentationInterpreter: LITERAL
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        _type: TextField
