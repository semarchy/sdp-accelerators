_name: AuthorSuppliers
_package: Manufacturing.entities.Supplier.steppers
_type: Stepper
entity: Manufacturing.entities.Supplier.Supplier
rootStep:
  _name: Suppliers
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: Manufacturing.entities.Supplier.collection_views.SupplierCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Suppliers
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: DETECT_DUPS
      matcher: Manufacturing.entities.Supplier.Supplier.SemlQLMatcherSupplier
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.SuppliersHavePaymentTerm.SupplierPaymentTerm
    - onStepExit: SKIP
      validationType: CHECK
      validator: Manufacturing.entities.Supplier.validations.FoundedYear
    - onStepExit: SKIP
      validationType: MANDATORY
      attribute: Manufacturing.entities.Supplier.Supplier.Name
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.SuppliersBelongToParentSupplier.ParentSupplier
  stepTriggers: []
  childSteps:
    - _name: Supplier
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: true
      formFieldsMode: AUTO
      label: Supplier
      formTab: Manufacturing.entities.Supplier.forms.SupplierFormEdit.Supplier
      formStepEnrichers: []
      referenceFormFieldConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: Manufacturing.references.SuppliersHavePaymentTerm.SupplierPaymentTerm
          executedOnDataChange: true
          executedOnFormOpen: false
        - validationType: CHECK
          executedOnDataChange: true
          executedOnFormOpen: true
          validator: Manufacturing.entities.Supplier.validations.FoundedYear
        - validationType: MANDATORY
          attribute: Manufacturing.entities.Supplier.Supplier.Name
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: FOREIGN
          attribute: Manufacturing.references.SuppliersBelongToParentSupplier.ParentSupplier
          executedOnDataChange: true
          executedOnFormOpen: false
      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Manufacturing.entities.Supplier.Supplier.Name
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.SuppliersHavePaymentTerm.SupplierPaymentTerm
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.SuppliersBelongToParentSupplier.ParentSupplier
        - onStepExit: WARN
          validationType: CHECK
          validator: Manufacturing.entities.Supplier.validations.FoundedYear
        - onStepExit: WARN
          validationType: DETECT_DUPS
          matcher: Manufacturing.entities.Supplier.Supplier.SemlQLMatcherSupplier
      stepTriggers: []
    - _name: Contact
      _type: CollectionStep
      canFinishSubLevel: true
      childDeleteType: HARD_DELETE
      collectionView: Manufacturing.entities.Contact.collection_views.ContactCollection
      customSortEnabled: false
      defaultDisplayType: TABLE
      displayGridAllowed: false
      displayListAllowed: true
      displayTableAllowed: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      label: Contact
      linear: true
      useCustomCollectionLabel: false
      userDefinedSortEnabled: true
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.SuppliersBelongToParentSupplier.ParentSupplier
        - onStepExit: SKIP
          validationType: DETECT_DUPS
          matcher: Manufacturing.entities.Contact.Contact.SemlQLMatcherContact
        - onStepExit: SKIP
          validationType: MANDATORY
          attribute: Manufacturing.entities.Contact.Contact.Number
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.ContactsHaveManufacturingPlant.ManufacturingPlant
        - onStepExit: SKIP
          validationType: MANDATORY
          attribute: Manufacturing.entities.Contact.Contact.Name
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.ContactsBelongsToManufacturer.Manufacturer
        - onStepExit: SKIP
          validationType: DETECT_DUPS
          matcher: Manufacturing.entities.Supplier.Supplier.SemlQLMatcherSupplier
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.ContactsHasSupplier.Supplier
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.SuppliersHavePaymentTerm.SupplierPaymentTerm
        - onStepExit: SKIP
          validationType: CHECK
          validator: Manufacturing.entities.Supplier.validations.FoundedYear
        - onStepExit: SKIP
          validationType: MANDATORY
          attribute: Manufacturing.entities.Supplier.Supplier.Name
      stepTriggers: []
      childImportModeOnParentEdit: CREATE_AND_UPDATE
      createChildUsingManyToManyPicker: false
      enableChildCopyOnParentCreate: true
      enableChildCopyOnParentEdit: true
      enableChildCreationOnParentCreate: true
      enableChildCreationOnParentEdit: true
      enableChildDeleteOnParentEdit: true
      enableChildEditOnParentCreate: true
      enableChildEditOnParentEdit: true
      enableChildImportOnParentCreate: false
      enableChildImportOnParentEdit: false
      enableChildRemoveOnParentCreate: true
      enableChildRemoveOnParentEdit: true
      manyToManyCustomSortEnabled: false
      manyToManyDisplayGridAllowed: true
      manyToManyDisplayListAllowed: true
      manyToManyDisplayTableAllowed: true
      manyToManyUserDefinedSortEnabled: true
      skipToChildCreationOnParentCreate: false
      skipToChildEditingOnParentEdit: false
      manyToManyDefaultDisplayType: TABLE
      oneToManyReference: Manufacturing.references.ContactsHasSupplier
      manyToManyPickerSearchTypeConfigs: []
      childSteps:
        - _name: SupplierDetails
          _type: FormStep
          canFinishSubLevel: true
          enabledOnParentCreate: true
          enabledOnParentEdit: true
          enableMasterValuePicking: false
          formFieldsMode: AUTO
          label: Supplier Details
          formSection: Manufacturing.entities.Contact.forms.ContactForm.Contact.SupplierDetails
          formStepEnrichers: []
          referenceFormFieldConfigs: []
          formStepValidations:
            - validationType: MANDATORY
              attribute: Manufacturing.entities.Contact.Contact.Name
              executedOnDataChange: false
              executedOnFormOpen: false
            - validationType: FOREIGN
              attribute: Manufacturing.references.ContactsBelongsToManufacturer.Manufacturer
              executedOnDataChange: false
              executedOnFormOpen: false
            - validationType: FOREIGN
              attribute: Manufacturing.references.ContactsHasSupplier.Supplier
              executedOnDataChange: false
              executedOnFormOpen: false
            - validationType: FOREIGN
              attribute: Manufacturing.references.ContactsHaveManufacturingPlant.ManufacturingPlant
              executedOnDataChange: false
              executedOnFormOpen: false
            - validationType: MANDATORY
              attribute: Manufacturing.entities.Contact.Contact.Number
              executedOnDataChange: false
              executedOnFormOpen: false
          stepTransitionValidations:
            - onStepExit: SKIP
              validationType: FOREIGN
              attribute: Manufacturing.references.ContactsHasSupplier.Supplier
            - onStepExit: SKIP
              validationType: MANDATORY
              attribute: Manufacturing.entities.Contact.Contact.Name
            - onStepExit: SKIP
              validationType: FOREIGN
              attribute: Manufacturing.references.ContactsBelongsToManufacturer.Manufacturer
            - onStepExit: SKIP
              validationType: DETECT_DUPS
              matcher: Manufacturing.entities.Contact.Contact.SemlQLMatcherContact
            - onStepExit: SKIP
              validationType: MANDATORY
              attribute: Manufacturing.entities.Contact.Contact.Number
            - onStepExit: SKIP
              validationType: FOREIGN
              attribute: Manufacturing.references.ContactsHaveManufacturingPlant.ManufacturingPlant
          stepTriggers: []
    - _name: Items
      _type: CollectionStep
