              referencePickerCollectionView: Manufacturing.entities.Address.collection_views.AddressCollection
              referencePickerSearchTypeConfigs: []
            - enableUserSort: true
              referencePickerType: AUTO_COMPLETE
              fdnFormField: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant.FDN_Manufacturer
              referencePickerCollectionView: Manufacturing.entities.Manufacturer.collection_views.ManufacturerCollection
              referencePickerSearchTypeConfigs: []
            - enableUserSort: true
              referencePickerType: AUTO_COMPLETE
              fdnFormField: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant.FDN_ManufacturingPlant
              referencePickerCollectionView: Manufacturing.entities.ManufacturingPlant.collection_views.ManufacturingPlantCollection
              referencePickerSearchTypeConfigs: []
            - enableUserSort: true
              referencePickerType: AUTO_COMPLETE
              fdnFormField: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant.FDN_Item
              referencePickerCollectionView: Manufacturing.entities.Item.collection_views.ItemCollection
              referencePickerSearchTypeConfigs: []
            - enableUserSort: true
              referencePickerType: AUTO_COMPLETE
              fdnFormField: Manufacturing.entities.SupplierManufacturerPlant.forms.SupplierManufacturerPlantForm.SupplierManufacturerPlant.FDN_Supplier
              referencePickerCollectionView: Manufacturing.entities.Supplier.collection_views.SupplierCollection
              referencePickerSearchTypeConfigs: []
          formStepValidations:
