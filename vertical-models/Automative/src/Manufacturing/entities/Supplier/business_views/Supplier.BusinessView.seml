_name: Supplier
_package: Manufacturing.entities.Supplier.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: true
entity: Manufacturing.entities.Supplier.Supplier
rootLabel: Supplier
rootPluralLabel: Suppliers
useHierarchyOnOpen: true
label: Suppliers
rootBusinessViewEntity:
  _name: SupplierEO
  _type: BusinessViewEntity
  collection: Manufacturing.entities.Supplier.collection_views.SupplierCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: Manufacturing.entities.Supplier.Supplier
  form: Manufacturing.entities.Supplier.forms.SupplierForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  sortExpression: Name ASC
  tableAllowed: true
  actionSet: Manufacturing.entities.Supplier.action_sets.SupplierActionSet
  businessEntityBuiltInFilters:
    - _name: HasSuggstedMatch
      _type: BusinessEntityBuiltInFilter
      label: Has Suggsted Match
      semQlCondition: HasSuggestedMerge = '1'
      visible: false
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs:
    - formField: Manufacturing.entities.Supplier.forms.SupplierForm.Supplier.Details.Container.Container2.FDN_SupplierPaymentTerm
      navigationMode: MODAL_FORM
  transitions:
    - _name: SupplierAddressJoins
      _type: BusinessViewTransition
      transitionPath: SupplierAddressJoins
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/office-building-marker.svg
      label: Supplier Address
      pluralLabel: Supplier Addresses
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      visibleInFormTabCondition: ANY SupplierAddressJoins have (SupplierAddressID is not null)
      businessViewEntity:
        _name: SupplierAddress
        _type: BusinessViewEntity
        collection: Manufacturing.entities.SupplierAddress.collection_views.SupplierAddressCollection_AdddressOnly
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
