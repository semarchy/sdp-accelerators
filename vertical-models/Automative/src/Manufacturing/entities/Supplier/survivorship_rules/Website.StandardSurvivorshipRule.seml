_type: StandardSurvivorshipRule
entity: Manufacturing.entities.Supplier.Supplier
_package: Manufacturing.entities.Supplier.survivorship_rules
defaultRule: false
_name: Website
consolidationSkipNulls: true
consolidationStrategy: PREFERRED_PUBLISHER
label: Website
description: "Selects the surviving supplier website during consolidation."
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: Manufacturing.publishers.MKT
  - _type: ConsoPublisherRanking
    publisher: Manufacturing.publishers.ERP
  - _type: ConsoPublisherRanking
    publisher: Manufacturing.publishers.CRM
overrideDecayTimeDuration: 1
overrideDecayTimeUnit: DAYS
overrideStrategy: NO_OVERRIDE
attributes:
  - attributeName: Website
