_name: SupplierActionSet
_package: Manufacturing.entities.Supplier.action_sets
_type: ActionSet
entity: Manufacturing.entities.Supplier.Supplier
label: Supplier Action Set
defaultActionSet: true
actions:
  - _name: StartWorkflow
    _type: StartWorkflowEntityAction
    label: OnboardSupplier
    useCustomLabel: true
    waitDialogEnabled: false
    startEvent: Manufacturing.workflows.OnboardSupplier.Start
  - _name: CreateAuthorSuppliers
    label: Direct Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: Manufacturing.entities.Supplier.steppers.AuthorSuppliers
  - _name: EditAuthorSuppliers
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    multipleSelectionAllowed: true
    stepper: Manufacturing.entities.Supplier.steppers.AuthorSuppliers
  - _name: MassUpdateAuthorSuppliers
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: Manufacturing.entities.Supplier.steppers.AuthorSuppliers
  - _name: CopyAuthorSuppliers
    label: Copy
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CopyAction
    multipleSelectionAllowed: true
    stepper: Manufacturing.entities.Supplier.steppers.AuthorSuppliers
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorSuppliers
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: Manufacturing.entities.Supplier.steppers.AuthorSuppliers
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
  - _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DirectConfirmDupsAction
  - _name: ReviewAndConfirmDuplicatesManageDuplicatesOnSupplier
    label: Review And Confirm Duplicates
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewAndConfirm
    dupsManager: Manufacturing.entities.Supplier.dups_managers.ManageDuplicatesOnSupplier
    enableEdit: true
    mandateConfirmAll: false
  - _name: MergeOrSplitDuplicatesManageDuplicatesOnSupplier
    label: Merge Or Split Duplicates
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MergeOrSplit
    dupsManager: Manufacturing.entities.Supplier.dups_managers.ManageDuplicatesOnSupplier
    enableEdit: true
  - _name: ReviewSuggestionsDuplicatesManageDuplicatesOnSupplier
    label: Review Duplicates Suggestions
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewSuggestions
    dupsManager: Manufacturing.entities.Supplier.dups_managers.ManageDuplicatesOnSupplier
    enableEdit: true
    mandateResolveAllSuggestions: false
    onAcceptPromptGoldenId: false
  - _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExplainRecordAction
    displayCard: Manufacturing.entities.Supplier.display_cards.SupplierDisplayCard
    formTab: Manufacturing.entities.Supplier.forms.SupplierForm.Supplier
