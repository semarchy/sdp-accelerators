_package: Manufacturing.entities.Supplier.collection_views
_name: SupplierCollection
_type: CollectionView
entity: Manufacturing.entities.Supplier.Supplier
default: true
displayCard: Manufacturing.entities.Supplier.display_cards.SupplierDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Supplier
tableShowDisplayCard: true
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: false
listShowDivider: true
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: SupplierID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: SupplierID
    visibleByDefault: true
  - _type: TextColumn
    _name: Name
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Name
    visibleByDefault: true
  - _type: TextColumn
    _name: ARIBACode
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: ARIBACode
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_SupplierPaymentTerm
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_SupplierPaymentTerm
    visibleByDefault: true
    referencedEntity: Manufacturing.entities.PaymentTerm.PaymentTerm
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: HyperlinkColumn
    _name: Website
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Website
    visibleByDefault: true
    componentProperties:
      linkDisplayText: Website
      linkDisplayTextValueInterpreter: SEMQL
      linkTarget: new-window
      linkTargetValueInterpreter: LITERAL
      linkSourceType: url
      linkSourceTypeValueInterpreter: LITERAL
