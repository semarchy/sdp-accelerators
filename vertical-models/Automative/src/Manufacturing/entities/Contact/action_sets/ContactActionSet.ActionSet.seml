_name: ContactActionSet
_package: Manufacturing.entities.Contact.action_sets
_type: ActionSet
entity: Manufacturing.entities.Contact.Contact
label: Contact Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorContacts
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: Manufacturing.entities.Contact.steppers.AuthorContacts
  - _name: EditAuthorContacts
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: Manufacturing.entities.Contact.steppers.AuthorContacts
  - _name: MassUpdateAuthorContacts
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: Manufacturing.entities.Contact.steppers.AuthorContacts
  - _name: CopyAuthorContacts
    label: Copy
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CopyAction
    multipleSelectionAllowed: true
    stepper: Manufacturing.entities.Contact.steppers.AuthorContacts
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorContacts
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: Manufacturing.entities.Contact.steppers.AuthorContacts
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
  - _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DirectConfirmDupsAction
  - _name: ReviewAndConfirmDuplicatesManageDuplicatesOnContact
    label: Review And Confirm Duplicates
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewAndConfirm
    dupsManager: Manufacturing.entities.Contact.dups_managers.ManageDuplicatesOnContact
    enableEdit: true
    mandateConfirmAll: false
  - _name: MergeOrSplitDuplicatesManageDuplicatesOnContact
    label: Merge Or Split Duplicates
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MergeOrSplit
    dupsManager: Manufacturing.entities.Contact.dups_managers.ManageDuplicatesOnContact
    enableEdit: true
  - _name: ReviewSuggestionsDuplicatesManageDuplicatesOnContact
    label: Review Duplicates Suggestions
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewSuggestions
    dupsManager: Manufacturing.entities.Contact.dups_managers.ManageDuplicatesOnContact
    enableEdit: true
    mandateResolveAllSuggestions: false
    onAcceptPromptGoldenId: false
  - _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExplainRecordAction
    displayCard: Manufacturing.entities.Contact.display_cards.ContactDisplayCard
    formTab: Manufacturing.entities.Contact.forms.ContactForm.Contact
