_name: AuthorContacts
_package: Manufacturing.entities.Contact.steppers
_type: Stepper
entity: Manufacturing.entities.Contact.Contact
rootStep:
  _name: Contacts
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: Manufacturing.entities.Contact.collection_views.ContactCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Contacts
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: DETECT_DUPS
      matcher: Manufacturing.entities.Contact.Contact.SemlQLMatcherContact
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.ContactsHaveManufacturingPlant.ManufacturingPlant
    - onStepExit: SKIP
      validationType: MANDATORY
      attribute: Manufacturing.entities.Contact.Contact.Name
    - onStepExit: SKIP
      validationType: MANDATORY
      attribute: Manufacturing.entities.Contact.Contact.Number
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.ContactsHasSupplier.Supplier
    - onStepExit: SKIP
      validationType: FOREIGN
      attribute: Manufacturing.references.ContactsBelongsToManufacturer.Manufacturer
  stepTriggers: []
  childSteps:
    - _name: Contact
      _type: FormStep
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Contact
      formTab: Manufacturing.entities.Contact.forms.ContactForm.Contact
      formStepEnrichers: []
      referenceFormFieldConfigs:
        - enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Manufacturing.entities.Contact.forms.ContactForm.Contact.FDN_ManufacturingPlant
          referenceFilter: Record.FID_Manufacturer = Referenced.Manufacturer.ManufacturerID
          referencePickerCollectionView: Manufacturing.entities.ManufacturingPlant.collection_views.ManufacturingPlantCollection
          referencePickerSearchTypeConfigs: []
        - enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Manufacturing.entities.Contact.forms.ContactForm.Contact.FDN_Supplier
          referencePickerCollectionView: Manufacturing.entities.Supplier.collection_views.SupplierCollection
          referencePickerSearchTypeConfigs: []
        - enableUserSort: true
          referencePickerType: NONE
          fdnFormField: Manufacturing.entities.Contact.forms.ContactForm.Contact.FDN_Manufacturer
          referencePickerSearchTypeConfigs: []
      formStepValidations:
        - validationType: FOREIGN
          attribute: Manufacturing.references.ContactsBelongsToManufacturer.Manufacturer
          executedOnDataChange: false
          executedOnFormOpen: false
        - validationType: MANDATORY
          attribute: Manufacturing.entities.Contact.Contact.Number
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: MANDATORY
          attribute: Manufacturing.entities.Contact.Contact.Name
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: FOREIGN
          attribute: Manufacturing.references.ContactsHasSupplier.Supplier
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: FOREIGN
          attribute: Manufacturing.references.ContactsHaveManufacturingPlant.ManufacturingPlant
          executedOnDataChange: true
          executedOnFormOpen: true
      stepTransitionValidations:
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.ContactsBelongsToManufacturer.Manufacturer
        - onStepExit: SKIP
          validationType: MANDATORY
          attribute: Manufacturing.entities.Contact.Contact.Name
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.ContactsHasSupplier.Supplier
        - onStepExit: SKIP
          validationType: DETECT_DUPS
          matcher: Manufacturing.entities.Contact.Contact.SemlQLMatcherContact
        - onStepExit: SKIP
          validationType: MANDATORY
          attribute: Manufacturing.entities.Contact.Contact.Number
        - onStepExit: SKIP
          validationType: FOREIGN
          attribute: Manufacturing.references.ContactsHaveManufacturingPlant.ManufacturingPlant
      stepTriggers: []
label: Author Contacts
stepperFinishValidations:
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: Manufacturing.references.ContactsBelongsToManufacturer.Manufacturer
  - onStepperFinish: SKIP
    validationType: MANDATORY
    attribute: Manufacturing.entities.Contact.Contact.Number
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: Manufacturing.references.ContactsHasSupplier.Supplier
  - onStepperFinish: SKIP
    validationType: FOREIGN
    attribute: Manufacturing.references.ContactsHaveManufacturingPlant.ManufacturingPlant
  - onStepperFinish: SKIP
    validationType: MANDATORY
    attribute: Manufacturing.entities.Contact.Contact.Name
  - onStepperFinish: SKIP
    validationType: DETECT_DUPS
triggers: []
