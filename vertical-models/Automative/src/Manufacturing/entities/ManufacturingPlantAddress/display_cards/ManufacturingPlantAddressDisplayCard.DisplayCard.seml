_name: ManufacturingPlantAddressDisplayCard
_package: Manufacturing.entities.ManufacturingPlantAddress.display_cards
_type: DisplayCard
entity: Manufacturing.entities.ManufacturingPlantAddress.ManufacturingPlantAddress
default: true
primaryTextExpression: FDN_ManufacturingPlant
secondaryTextExpression: FDN_Address
primaryImageValueInterpreter: LITERAL
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValue: |-
  case when FID_AddressType like 'Head%' then 'images://mdi/office-building.svg'
  else 'images://mdi/factory.svg'
  end
avatarImageValueInterpreter: SEMQL
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
