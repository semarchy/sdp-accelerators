_package: Manufacturing.entities.ProductOptionOrFeature.collection_views
_name: ProductOptionOrFeatureCollection
_type: CollectionView
entity: Manufacturing.entities.ProductOptionOrFeature.ProductOptionOrFeature
default: true
displayCard: Manufacturing.entities.ProductOptionOrFeature.display_cards.ProductOptionOrFeatureDisplayCard
tableAllowed: true
