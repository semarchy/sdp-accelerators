tableDisplayCardColumnLabel: Option Or Feature
tableShowDisplayCard: true
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
gridAllowed: false
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: OptionOrFeatureID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: OptionOrFeatureID
    visibleByDefault: true
  - _type: TextColumn
    _name: Name
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Name
    visibleByDefault: true
  - _type: TextColumn
    _name: Description
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Description
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_ProductOptionCategory
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_ProductOptionCategory
    visibleByDefault: true
    referencedEntity: Manufacturing.entities.ProductOptionCategory.ProductOptionCategory
