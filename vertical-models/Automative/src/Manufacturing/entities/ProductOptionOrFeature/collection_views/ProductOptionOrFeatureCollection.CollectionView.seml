      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: CheckboxColumn
    _name: Contrained
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: Contrained
    visibleByDefault: true
    componentProperties:
      useSwitch: "0"
      useSwitchValueInterpreter: LITERAL
  - _type: TextColumn
    _name: AdditionalCost
    columnAlign: LEFT
    dataType: DECIMAL
    useCustomLabel: false
    value: AdditionalCost
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_ProductOrOptionGroup
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_ProductOrOptionGroup
    visibleByDefault: true
