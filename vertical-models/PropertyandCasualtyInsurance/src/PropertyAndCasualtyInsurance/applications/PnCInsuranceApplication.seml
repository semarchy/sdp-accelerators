        - _type: FolderAction
          _name: ImportData
          icon: images://mdi/database-import.svg
          image: images://default/folder-item-import.png
          iconColor: md:black
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          label: Import Data
          requiredRole: semarchyAdmin

          appActions:
            - _type: ImportDataAppAction
              _name: ImportAssetStatus
              label: 01-Import Asset Status
              image: images://default/folder-item-import.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
              importAction: PropertyAndCasualtyInsurance.entities.AssetStatus.action_sets.AssetStatusActionSet.ImportAuthorAssetStatuses

            - _type: ImportDataAppAction
              _name: ImportAssetType
              label: 02-Import Asset Type
              image: images://default/folder-item-import.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
              importAction: PropertyAndCasualtyInsurance.entities.AssetType.action_sets.AssetTypeActionSet.ImportAuthorAssetTypes

            - _type: ImportDataAppAction
              _name: ImportBasementType
              label: 03-Import Basement Type
              image: images://default/folder-item-import.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
              importAction: PropertyAndCasualtyInsurance.entities.BasementType.action_sets.BasementTypeActionSet.ImportAuthorBasementTypes

            - _type: ImportDataAppAction
              _name: ImportBodyStyle
              label: 04-Import Body Style
              image: images://default/folder-item-import.png
