              iconColor: md:blue
              labelColor: md:blue 900
              label: Coverage Categories
              description: Browse Coverage Categories
              image: images://pnc-ins/pnc-coverage-category.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT

            - _type: BrowseBusinessViewAction
