_package: PropertyAndCasualtyInsurance.applications
_type: Application
_name: PnCInsuranceApplication
label: Property and Casualty Insurance
visibility: VISIBLE
applicationTitle: Property and Casualty Insurance MDM
avatarImageUrl: images://pnc-ins/pncAvatar.png
logoUrl: images://pnc-ins/pncSearch.png
coverImageUrl: images://pnc-ins/pncNavLogo.png
favIcon: images://pnc-ins/pncAvatar.png
titleColor: md:blue 800
titleBarDefaultColor: md:green 300
titleBarAuthoringColor: md:orange 300
titleBarErrorColor: md:red 300
sortStrategy: POSITION
historyBrowsingEnabled: false
historyBrowsingRequiredRole: ""
defaultAction: PropertyAndCasualtyInsurance.applications.PnCInsuranceApplication.Root.ExecutiveDashboard
documentationConfig:
  documentation: "Property and Casualty Model diagram covering all entities "
  documentationConfigDiagrams:
    - _type: DocumentationConfigDiagram
      _name: AllEntities
      modelDiagram: PropertyAndCasualtyInsurance.model_diagrams.AllEntities
      label: Property and Casualty All Entities
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: false
  globalSearchBusinessViews:
    - _type: GlobalSearchBoView
      _name: LineOfCoverage
      label: Line Of Coverage
      viewType: GD
      businessView: PropertyAndCasualtyInsurance.entities.Coverage.business_views.CoverageBusinessView
      searchTypeConfig: PropertyAndCasualtyInsurance.entities.Coverage.business_views.CoverageBusinessView.Coverage.TextConfig
      maxResults: 5
    
    - _type: GlobalSearchBoView
      _name: VehicleAssets
      label: Vehicle Assets
      viewType: GD
      businessView: PropertyAndCasualtyInsurance.entities.VehicleAsset.business_views.VehicleAssetBusinessView
      searchTypeConfig: PropertyAndCasualtyInsurance.entities.VehicleAsset.business_views.VehicleAssetBusinessView.VehicleAsset.TextConfig
      maxResults: 5

    - _type: GlobalSearchBoView
      _name: HomeAssets
      label: Home Assets
      viewType: GD
      businessView: PropertyAndCasualtyInsurance.entities.HomeAsset.business_views.HomeAssetBusinessView
      searchTypeConfig: PropertyAndCasualtyInsurance.entities.HomeAsset.business_views.HomeAssetBusinessView.HomeAsset.TextConfig
      maxResults: 5
navDrawer:
  - _type: NavigationGroup
    _name: RootFolder
    label: Root Folder
    dividerVisible: false
    labelVisible: false
    actions:
      - appAction: PropertyAndCasualtyInsurance.applications.PnCInsuranceApplication.Root.MyTasks
      - appAction: PropertyAndCasualtyInsurance.applications.PnCInsuranceApplication.Root.GlobalSearch

      - appAction: PropertyAndCasualtyInsurance.applications.PnCInsuranceApplication.Root.ExecutiveDashboard

  - _type: FolderNavGroup
    _name: ProductManagement
    dividerVisible: true
    labelVisible: true
    linkedFolder: PropertyAndCasualtyInsurance.applications.PnCInsuranceApplication.Root.ProductManagement

  - _type: FolderNavGroup
    _name: PolicyManagement
    dividerVisible: true
    labelVisible: true
    linkedFolder: PropertyAndCasualtyInsurance.applications.PnCInsuranceApplication.Root.PolicyManagement

  - _type: FolderNavGroup
    _name: InsuredAssetManagement
    dividerVisible: true
    labelVisible: true
    linkedFolder: PropertyAndCasualtyInsurance.applications.PnCInsuranceApplication.Root.InsuredAssetManagement
  - _type: FolderNavGroup
    _name: Admin
    dividerVisible: true
    labelVisible: true
    linkedFolder: PropertyAndCasualtyInsurance.applications.PnCInsuranceApplication.Root.Admin
rootFolder:
  _type: FolderAction
  _name: Root
  label: Root Folder
  image: images://mdi/folder.svg
  imageAlign: MIDDLE_CENTER
  imageMode: FIT

  appActions:
    - _type: MyTasksAction
      _name: MyTasks
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      badgeVisible: false

    - _type: GlobalSearchAction
      _name: GlobalSearch
      imageAlign: MIDDLE_CENTER
      imageMode: FIT

    - _type: OpenDashboardAction
      _name: ExecutiveDashboard
      dashboard: ExecutivePolicyOverview
      label: Executive Dashboard
      dashboardApplication: PropertyAndCasualty
      icon: images://mdi/chart-box.svg
      imageAlign: MIDDLE_CENTER
      imageMode: FIT

    - _type: FolderAction
      _name: ProductManagement
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      label: Product Management
      labelColor: md:blue 900
      appActions:
        
        - _type: BrowseBusinessViewAction
          _name: BrowseLineOfBusiness
          businessView: PropertyAndCasualtyInsurance.entities.LineOfBusiness.business_views.LineOfBusinessBusinessView
          label: Line of Business
          nbRecordsBadgeVisible: false
          description: Browse Line Of Business Hierarchy
          iconColor: md:blue 700
          icon: images://mdi/family-tree.svg
          labelColor: md:blue 700

        - _type: BrowseBusinessViewAction
          _name: BrowseInsuranceProduct
          label: Insurance Products
          businessView: PropertyAndCasualtyInsurance.entities.InsuranceProduct.business_views.InsuranceProductBusinessView
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          description: Browse Insurance Product records
          iconColor: md:blue 700
          labelColor: md:blue 700
          icon: images://mdi/package.svg

        - _type: BrowseBusinessViewAction
          _name: InsuranceType
          label: Insurance Types
          businessView: PropertyAndCasualtyInsurance.entities.InsuranceType.business_views.InsuranceTypeBusinessView
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          description: Browse Insurance Type records
          iconColor: md:blue 700
          labelColor: md:blue 700
          icon: images://mdi/arrow-decision-outline.svg

        - _type: FolderAction
          _name: ProductConfigurations
          description: Browse other relevant information for insurance product management
          label: Product Configurations
          icon: images://mdi/cog-outline.svg
          iconColor: md:blue 700
          labelColor: md:blue 700
          appActions:

            - _type: BrowseBusinessViewAction
              _name: BrowseCoverage
              businessView: PropertyAndCasualtyInsurance.entities.Coverage.business_views.CoverageBusinessView
              nbRecordsBadgeVisible: true
              nbRecordsBadgeBackgroundColor: md:green 500
              useSearchOnOpen: false
              iconColor: md:blue
              labelColor: md:blue 900
              label: Coverages
              description: Browse Insurance Coverages
              image: images://pnc-ins/pnc-coverage.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT

            - _type: BrowseBusinessViewAction
              _name: BrowseCoverageCategory
              businessView: PropertyAndCasualtyInsurance.entities.CoverageCategory.business_views.CoverageCategoryBusinessView
              nbRecordsBadgeVisible: true
              nbRecordsBadgeBackgroundColor: md:green 500
