    - _type: FolderAction
      _name: Admin
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      label: Administration

      appActions:
        - _type: FolderAction
          _name: Errors
          icon: images://mdi/alert-box.svg
          iconColor: md:black
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          label: Manage Errors
          appActions:
            - _type: BrowseBusinessViewAction
              _name: VehicleAssets
              businessView: PropertyAndCasualtyInsurance.entities.VehicleAsset.business_views.VehicleAssetBusinessView
              nbRecordsBadgeVisible: true
              nbRecordsBadgeBackgroundColor: md:red 700
              viewType: SDWE
              image: images://pnc-ins/pnc-vehicle-asset-error.png
              imageAlign: MIDDLE_CENTER
              imageMode: FIT
            - _type: BrowseBusinessViewAction
              _name: Policies
              businessView: PropertyAndCasualtyInsurance.entities.Policy.business_views.PolicyBusinessView
              nbRecordsBadgeVisible: true
              nbRecordsBadgeBackgroundColor: md:red 700
              viewType: SDWE
              image: images://pnc-ins/pnc-policy-error.png
