_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.InclusionExclusion.validations
entity: PropertyAndCasualtyInsurance.entities.InclusionExclusion.InclusionExclusion
label: Date Range Check
condition: EffectiveFrom <= EffectiveTo
validationScope: PRE_CONSO
description: Checks that the EffectiveFrom date is less than or equal to the EffectiveTo date for an Inclusion Exclusion entity.
validationLabel: EffectiveTo must be greater than or equal to EffectiveFrom