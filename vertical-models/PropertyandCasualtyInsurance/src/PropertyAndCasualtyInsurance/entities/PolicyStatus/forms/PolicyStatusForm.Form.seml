_package: PropertyAndCasualtyInsurance.entities.PolicyStatus.forms
_type: Form
_name: PolicyStatusForm
entity: PropertyAndCasualtyInsurance.entities.PolicyStatus.PolicyStatus
default: true
formTabs:
  - _type: FormTab
    _name: PolicyStatus
    label: Policy Status
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    iconUrl: images://mdi/flag-outline.svg
    labelWidth: '200'
    content:
      - _type: IdField
        _name: PolicyStatusCode
        value: PolicyStatusCode
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: PolicyStatusName
        value: PolicyStatusName
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: StatusCategory
        value: StatusCategory
        useCustomLabel: false
        dataType: STRING
      - _type: CheckboxField
        _name: IsInForceFlag
        value: IsInForceFlag
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: TextField
        _name: Description
        dataType: LONG_TEXT
        useCustomLabel: false
        value: Description
