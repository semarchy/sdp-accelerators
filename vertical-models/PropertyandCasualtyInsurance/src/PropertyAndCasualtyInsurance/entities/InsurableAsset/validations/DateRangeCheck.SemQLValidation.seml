_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.InsurableAsset.validations
entity: PropertyAndCasualtyInsurance.entities.InsurableAsset.InsurableAsset
label: Date Range Check
condition: StartDate <= EndDate
validationScope: PRE_CONSO
description: Checks that the StartDate is less than or equal to the EndDate for an Insurable Asset entity.
validationLabel: EndDate must be greater than or equal to StartDate