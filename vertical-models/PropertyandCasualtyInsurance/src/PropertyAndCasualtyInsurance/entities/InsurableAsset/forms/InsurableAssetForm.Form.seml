_package: PropertyAndCasualtyInsurance.entities.InsurableAsset.forms
_type: Form
_name: InsurableAssetForm
entity: PropertyAndCasualtyInsurance.entities.InsurableAsset.InsurableAsset
default: true
formTabs:
  - _type: FormTab
    _name: InsurableAsset
    label: "Insurable Asset"
    iconUrl: images://mdi/shield-home-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: InsurableAssetSection1
        label: "Asset Identity"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: InsurableAssetSection1Row
            content:
              - _type: FormContainer
                _name: InsurableAssetSection1Col1
                content:
                  - _type: IdField
                    _name: AssetId
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: AssetId
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_AssetType
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.AssetType.AssetType
                    useCustomLabel: false
                    value: FDN_AssetType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_AssetStatus
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.AssetStatus.AssetStatus
                    useCustomLabel: false
                    value: FDN_AssetStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: InsurableAssetSection1Col2
                content:
                  - _type: TextField
                    _name: AssetDescription
                    dataType: STRING
                    useCustomLabel: false
                    value: AssetDescription
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: InsurableAssetSection2
        label: "Asset Relationships"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: InsurableAssetSection2Row
            content:
              - _type: FormContainer
                _name: InsurableAssetSection2Col1
                content:
                  - _type: ReferenceField
                    _name: FDN_VehicleAsset
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.VehicleAsset.VehicleAsset
                    useCustomLabel: false
                    value: FDN_VehicleAsset
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_HomeAsset
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.HomeAsset.HomeAsset
                    useCustomLabel: false
                    value: FDN_HomeAsset
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: InsurableAssetSection2Col2
                content:
                  
                  - _type: ReferenceField
                    _name: FDN_AssignedPolicy
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.Policy.Policy
                    useCustomLabel: false
                    value: FDN_AssignedPolicy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_LineOfBusiness
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.LineOfBusiness.LineOfBusiness
                    useCustomLabel: false
                    value: FDN_LineOfBusiness
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: InsurableAssetSection3
        label: "Lifecycle"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: InsurableAssetSection3Row
            content:
              - _type: FormContainer
                _name: InsurableAssetSection3Col1
                content:
                  - _type: TextField
                    _name: StartDate
                    dataType: DATE
                    useCustomLabel: false
                    value: StartDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EndDate
                    dataType: DATE
                    useCustomLabel: false
                    value: EndDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
