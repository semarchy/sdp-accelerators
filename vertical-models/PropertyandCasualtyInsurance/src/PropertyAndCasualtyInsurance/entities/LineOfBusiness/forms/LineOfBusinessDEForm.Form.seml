_package: PropertyAndCasualtyInsurance.entities.LineOfBusiness.forms
_type: Form
_name: LineOfBusinessDEForm
entity: PropertyAndCasualtyInsurance.entities.LineOfBusiness.LineOfBusiness
default: true
formTabs:
  - _type: FormTab
    _name: LineOfBusiness
    label: Line Of Business
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: FormContainer
        _name: LineOfBusinessContainer01
        content:
          - _type: FormContainer
            _name: LineOfBusinessContainer01A
            content:
              - _type: IdField
                _name: LineOfBusinessID
                value: LineOfBusinessID
                useCustomLabel: false
                dataType: STRING
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: LOBCode
                value: LOBCode
                useCustomLabel: false
                dataType: STRING
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: LOBName
                value: LOBName
                useCustomLabel: false
                dataType: STRING
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
            layoutDirection: COLUMN
          - _type: FormContainer
            _name: LineOfBusinessContainer01B
            content:
              - _type: TextField
                _name: LOBDescription
                value: LOBDescription
                useCustomLabel: false
                dataType: LONG_TEXT
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              

              - _type: CheckboxField
                _name: ActiveFlag
                value: ActiveFlag
                useCustomLabel: false
                dataType: BOOLEAN
                componentProperties:
                  useSwitch: '1'
                  useSwitchValueInterpreter: LITERAL
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
                  authoringLabelPosition: top
                  authoringLabelPositionValueInterpreter: LITERAL
                  
            layoutDirection: COLUMN
          - _type: FormContainer
            _name: LineOfBusinessContainer01C
            content:
              - _type: DateField
                _name: EffectiveFrom
                value: EffectiveFrom
                useCustomLabel: false
                dataType: DATE
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                labelProperties:
                  position: top
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              - _type: DateField
                _name: EffectiveTo
                value: EffectiveTo
                useCustomLabel: false
                dataType: DATE
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                labelProperties:
                  position: top
                  positionValueInterpreter: LITERAL
                  alignment: left
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
              
            layoutDirection: COLUMN
        layoutDirection: ROW

