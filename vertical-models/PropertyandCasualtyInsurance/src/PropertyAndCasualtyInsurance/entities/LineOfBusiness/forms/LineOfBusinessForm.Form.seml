                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: LOBName
                value: LOBName
                useCustomLabel: false
                dataType: STRING
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
