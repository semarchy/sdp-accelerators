_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.LineOfBusiness.validations
entity: PropertyAndCasualtyInsurance.entities.LineOfBusiness.LineOfBusiness
label: Date Range Check
condition: EffectiveFrom <= EffectiveTo
validationScope: PRE_CONSO
description: Checks that the EffectiveFrom date is less than or equal to the EffectiveTo date for a Line of Business entity. 
validationLabel: EffectiveTo must be greater than or equal to EffectiveFrom
