_package: PropertyAndCasualtyInsurance.entities.LineOfBusiness.display_cards
_type: DisplayCard
_name: LineOfBusinessDisplayCard
entity: PropertyAndCasualtyInsurance.entities.LineOfBusiness.LineOfBusiness
default: true
primaryTextExpression: SEM_CONCAT(' ','1', LOBName, ' (', LOBCode, ')')
primaryImageValueInterpreter: LITERAL
avatarImageSourceType: URL
avatarImageValue: CASE 
                      WHEN LOBCode = 'AUTO-COMM' THEN 'images://mdi/taxi.svg' 
                      WHEN LOBCode = 'PROP' THEN 'images://mdi/home-modern.svg' 
                      WHEN LOBCode = 'AUTO-PERS' THEN 'images://mdi/car-hatchback.svg' 
                      WHEN LOBCode = 'HOME' THEN 'images://mdi/home-account.svg' 
                      ELSE 'images://mdi/default.svg' END
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: SEMQL
primaryImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
