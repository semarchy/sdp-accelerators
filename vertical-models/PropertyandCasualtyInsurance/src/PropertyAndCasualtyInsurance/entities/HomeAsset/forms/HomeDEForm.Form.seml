                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: SmokeDetectorFlag
                    dataType: BOOLEAN
                    useCustomLabel: false
                    value: SmokeDetectorFlag
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: HomeAssetSection3Col2
                content:
                  - _type: CheckboxField
                    _name: SwimmingPoolFlag
                    dataType: BOOLEAN
                    useCustomLabel: false
                    value: SwimmingPoolFlag
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: TrampolineFlag
