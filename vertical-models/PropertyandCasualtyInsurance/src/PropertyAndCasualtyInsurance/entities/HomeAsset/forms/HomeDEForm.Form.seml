      - _type: FormSection
        _name: HomeAssetSection4
        label: "Valuation and Limits"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: HomeAssetSection4Row
            content:
              - _type: FormContainer
                _name: HomeAssetSection4Col1
                content:
                  - _type: TextField
                    _name: ReplacementCost
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: ReplacementCost
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MarketValue
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: MarketValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PersonalPropertyLimit
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: PersonalPropertyLimit
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: HomeAssetSection4Col2
                content:
                  - _type: TextField
                    _name: LossUseLimit
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: LossUseLimit
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: LiabilityLimit
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: LiabilityLimit
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DeductibleAmount
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: DeductibleAmount
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: HomeAssetSection5
