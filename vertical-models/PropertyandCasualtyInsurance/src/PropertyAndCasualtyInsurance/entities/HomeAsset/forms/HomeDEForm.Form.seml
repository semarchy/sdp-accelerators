                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DogBreed
                    dataType: STRING
                    useCustomLabel: false
                    value: DogBreed
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: HomeAssetSection3Col3
                content:
                  - _type: CheckboxField
                    _name: WindHailExclusionFlag
                    dataType: BOOLEAN
                    useCustomLabel: false
                    value: WindHailExclusionFlag
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FloodZone
                    dataType: STRING
                    useCustomLabel: false
                    value: FloodZone
