_package: PropertyAndCasualtyInsurance.entities.HomeAsset.forms
_type: Form
_name: HomeDEForm
entity: PropertyAndCasualtyInsurance.entities.HomeAsset.HomeAsset
default: false
formTabs:
  - _type: FormTab
    _name: HomeAsset
    label: "Home Asset"
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: FormSection
        _name: HomeAssetSection1
        label: "Property Identity"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: HomeAssetSection1Row
            content:
              - _type: FormContainer
                _name: HomeAssetSection1Col1
                content:
                  - _type: IdField
                    _name: HomeAssetId
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: HomeAssetId
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PropertyAddressLine1
                    dataType: STRING
                    useCustomLabel: false
                    value: PropertyAddressLine1
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PropertyAddressLine2
                    dataType: STRING
                    useCustomLabel: false
                    value: PropertyAddressLine2
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  
                  - _type: TextField
                    _name: YearBuilt
                    dataType: INTEGER
                    useCustomLabel: false
                    value: YearBuilt
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: HomeAssetSection1Col2
                content:
                  - _type: TextField
                    _name: PropertyCity
                    dataType: STRING
                    useCustomLabel: false
                    value: PropertyCity
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PropertyState
                    dataType: STRING
                    useCustomLabel: false
                    value: PropertyState
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PropertyPostalCode
                    dataType: STRING
                    useCustomLabel: false
                    value: PropertyPostalCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PropertyCountry
                    dataType: STRING
                    useCustomLabel: false
                    value: PropertyCountry
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: MenuField
                    _name: OccupancyType
                    dataType: STRING
                    useCustomLabel: false
                    value: OccupancyType
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: PrimaryResidenceFlag
                    dataType: BOOLEAN
                    useCustomLabel: false
                    value: PrimaryResidenceFlag
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: HomeAssetSection2
        label: "Construction and Risk"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: HomeAssetSection2Row
            content:
              - _type: FormContainer
                _name: HomeAssetSection2Col1
                content:
                  - _type: ReferenceField
                    _name: FDN_ConstructionType
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.ConstructionType.ConstructionType
                    useCustomLabel: false
                    value: FDN_ConstructionType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: MenuField
                    _name: ConstructionQuality
                    dataType: STRING
                    useCustomLabel: false
                    value: ConstructionQuality
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_RoofType
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.RoofType.RoofType
                    useCustomLabel: false
                    value: FDN_RoofType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: HomeAssetSection2Col2
                content:
                  - _type: TextField
                    _name: RoofYear
                    dataType: INTEGER
                    useCustomLabel: false
                    value: RoofYear
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: SquareFootage
                    dataType: INTEGER
                    useCustomLabel: false
                    value: SquareFootage
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: NumberOfStories
                    dataType: INTEGER
                    useCustomLabel: false
                    value: NumberOfStories
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: HomeAssetSection2Col3
                content:
                  - _type: TextField
                    _name: NumberOfUnits
                    dataType: INTEGER
                    useCustomLabel: false
                    value: NumberOfUnits
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_BasementType
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.BasementType.BasementType
                    useCustomLabel: false
                    value: FDN_BasementType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_FoundationType
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.FoundationType.FoundationType
                    useCustomLabel: false
                    value: FDN_FoundationType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: HomeAssetSection2Col4
                content:
                  - _type: MenuField
                    _name: GarageType
                    dataType: STRING
                    useCustomLabel: false
                    value: GarageType
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ProtectionClass
                    dataType: STRING
                    useCustomLabel: false
                    value: ProtectionClass
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DistanceToFireStation
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: DistanceToFireStation
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: HomeAssetSection3
        label: "Protective Devices and Liability"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: HomeAssetSection3Row
            content:
              - _type: FormContainer
                _name: HomeAssetSection3Col1
                content:
