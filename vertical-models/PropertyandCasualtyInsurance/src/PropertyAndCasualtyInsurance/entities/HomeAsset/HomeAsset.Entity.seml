sourceIdGeneration:
  mode: UUID
primaryKey: PropertyAndCasualtyInsurance.entities.HomeAsset.HomeAsset.HomeAssetId
matcher:
  _name: SemQLMatcherHomeAsset
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 91
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 85
  mergeThresholdMergingConfirmedWithNewMasters: 75
  mergeThresholdMergingConfirmedWithUnconfirmed: 75
  mergeThresholdMergingUnconfirmed: 75
  mergeThresholdMergingUnconfirmedWithNewMasters: 75
  mergeThresholdNewGroup: 75
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: true
  useTransitiveMatchScore: true
  description: Home Asset Match Rules
  matchRules:
    - _type: SemQLMatchRule
      _name: ExactAddressYearAndSize
      condition: >-
        Record1.PropertyAddressLine1 = Record2.PropertyAddressLine1
        and Record1.PropertyPostalCode = Record2.PropertyPostalCode
        and Record1.PropertyCity = Record2.PropertyCity
        and Record1.YearBuilt = Record2.YearBuilt
        and Record1.SquareFootage = Record2.SquareFootage
      label: Exact Address Year And Size
      matchScore: 96
      color: md:green 800
      documentation: Matches home assets using normalized address, build year, and square footage.
      description: Matches home assets using normalized address, build year, and square footage.
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: AddressAndConstructionProfile
      condition: >-
        Record1.PropertyAddressLine1 = Record2.PropertyAddressLine1
        and Record1.PropertyPostalCode = Record2.PropertyPostalCode
        and Record1.PropertyState = Record2.PropertyState
        and Record1.ConstructionType.ConstructionTypeCode = Record2.ConstructionType.ConstructionTypeCode
        and Record1.RoofType.RoofTypeCode = Record2.RoofType.RoofTypeCode
      label: Address And Construction Profile
      matchScore: 88
      color: md:green 600
      documentation: Matches home assets using normalized address, build year, and square footage.
      description: Matches home assets using address and key construction attributes.
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: AddressAndValuationProfile
      condition: >-
        Record1.PropertyPostalCode = Record2.PropertyPostalCode
        and Record1.PropertyState = Record2.PropertyState
        and Record1.YearBuilt = Record2.YearBuilt
        and Record1.MarketValue = Record2.MarketValue
        and Record1.ReplacementCost = Record2.ReplacementCost
      label: Address And Valuation Profile
      matchScore: 82
      color: md:green 300
      documentation: Matches home assets using address and key construction attributes.
      description: Matches home assets using postal code, year built, and valuation details.
      usingMatchOn: false
