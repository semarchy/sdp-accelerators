_package: PropertyAndCasualtyInsurance.entities.HomeAsset
_type: Entity
_name: HomeAsset
label: "Home Asset"
pluralLabel: "Home Assets"
goldenIdGeneration:
  mode: SEQUENCE
  startWith: 100000
entityType: FUZZY_MATCHED
physicalTableName: HOME_ASSET
iconUrl: images://mdi/home-city-outline.svg
