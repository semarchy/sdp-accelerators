_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.HomeAsset.validations
entity: PropertyAndCasualtyInsurance.entities.HomeAsset.HomeAsset
label: Date Range Check
condition: StartDate <= EndDate
validationScope: PRE_CONSO
description: Checks that the StartDate is less than or equal to the EndDate for a Home Asset entity.
validationLabel: EndDate must be greater than or equal to StartDate