_package: PropertyAndCasualtyInsurance.entities.LineOfCoverage.collection_views
_type: CollectionView
_name: LineOfCoverageImportCollection
entity: PropertyAndCasualtyInsurance.entities.LineOfCoverage.LineOfCoverage
default: true
