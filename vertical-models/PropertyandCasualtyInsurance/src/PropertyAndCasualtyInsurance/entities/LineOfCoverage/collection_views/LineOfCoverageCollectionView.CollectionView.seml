_package: PropertyAndCasualtyInsurance.entities.LineOfCoverage.collection_views
_type: CollectionView
_name: LineOfCoverageCollectionView
entity: PropertyAndCasualtyInsurance.entities.LineOfCoverage.LineOfCoverage
default: true
displayCard: PropertyAndCasualtyInsurance.entities.LineOfCoverage.display_cards.LineOfCoverageDisplayCard
tableDisplayCardColumnWidth: 400
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Line Of Coverage
tableRowLines: 2
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: LineOfCoverageId
    value: LineOfCoverageId
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FID_Policy
    columnAlign: LEFT
    dataType: STRING
    label: Policy
    referencedEntity: PropertyAndCasualtyInsurance.entities.Policy.Policy
    useCustomLabel: true
    value: FDN_Policy
    visibleByDefault: true
    defaultWidth: 220
    componentProperties:
      displayType: chip
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
      chipMaxWidth: '220'
      chipMaxWidthValueInterpreter: LITERAL

  - _type: ReferenceColumn
    _name: FID_CoverageStatus
    columnAlign: LEFT
    dataType: STRING
    label: Coverage Status
    referencedEntity: PropertyAndCasualtyInsurance.entities.CoverageStatus.CoverageStatus
    useCustomLabel: true
    value: FDN_CoverageStatus
    visibleByDefault: true
    defaultWidth: 220
    componentProperties:
      displayType: chip
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
      chipMaxWidth: '220'
      chipMaxWidthValueInterpreter: LITERAL
  - _type: MenuColumn
    _name: CoverageTrigger
    value: CoverageTrigger
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: LimitAmount
    value: LimitAmount
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ ##,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: DeductibleAmount
    value: DeductibleAmount
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ ##,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: WrittenPremium
    value: WrittenPremium
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ ##,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: MenuColumn
    _name: ValuationMethod
    value: ValuationMethod
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    defaultWidth: 200
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: EffectiveFrom
    value: EffectiveFrom
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: EffectiveTo
    value: EffectiveTo
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: CheckboxColumn
    _name: ActiveFlag
    value: ActiveFlag
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: true
