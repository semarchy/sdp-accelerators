_package: PropertyAndCasualtyInsurance.entities.LineOfCoverage
_type: Entity
_name: LineOfCoverage
label: Line Of Coverage
pluralLabel: Lines Of Coverage
entityType: ID_MATCHED
physicalTableName: LINE_OF_COVERAGE
iconUrl: images://mdi/book.svg
description: "Represents a policy-level coverage instance including limits, pricing, and lifecycle details."
documentation: "Represents a policy-level coverage instance including limits, pricing, and lifecycle details."
historizeGolden: true
historizeMaster: true
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: LineOfCoverageId
    label: Line Of Coverage Id
    physicalName: LINE_OF_COVERAGE_ID
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "System-generated unique identifier representing a specific policy coverage instance."
    documentation: "System-generated unique identifier representing a specific policy coverage instance."
  - _type: EntityAttribute
    _name: AssetId
    label: Asset Id
    physicalName: ASSET_ID
    dataType: String
    length: 50
    mandatory: false
    searchable: true
    description: "Reference to specific insured asset when coverage applies at item level."
    documentation: "Reference to specific insured asset when coverage applies at item level."
  - _type: EntityAttribute
    _name: CoverageTrigger
    label: Coverage Trigger
    physicalName: COVERAGE_TRIGGER
    dataType: PropertyAndCasualtyInsurance.list_of_values.CoverageTriggerType
    lovValidationScope: PRE_CONSO
    mandatory: false
    searchable: true
    description: "Defines claim trigger mechanism such as Occurrence or Claims-Made."
    documentation: "Defines claim trigger mechanism such as Occurrence or Claims-Made."
  - _type: EntityAttribute
    _name: ClaimsMadeRetroDate
    label: Claims Made Retro Date
    physicalName: CLAIMS_MADE_RETRO_DATE
    dataType: Date
    mandatory: false
    searchable: true
    description: "Retroactive date applicable for claims-made coverage."
    documentation: "Retroactive date applicable for claims-made coverage."
  - _type: EntityAttribute
    _name: LimitAmount
    label: Limit Amount
    physicalName: LIMIT_AMOUNT
    dataType: Decimal
    precision: 18
    scale: 2
    mandatory: false
    searchable: true
    description: "Primary limit of liability for this coverage instance."
    documentation: "Primary limit of liability for this coverage instance."
  - _type: EntityAttribute
    _name: LimitType
    label: Limit Type
    physicalName: LIMIT_TYPE
    dataType: PropertyAndCasualtyInsurance.list_of_values.CoverageLimitType
    lovValidationScope: PRE_CONSO
    mandatory: false
    searchable: true
    description: "Structure of the limit (Per Occurrence, Aggregate, Combined Single Limit)."
    documentation: "Structure of the limit (Per Occurrence, Aggregate, Combined Single Limit)."
  - _type: EntityAttribute
    _name: AggregateLimit
    label: Aggregate Limit
    physicalName: AGGREGATE_LIMIT
    dataType: Decimal
    precision: 18
    scale: 2
    mandatory: false
    searchable: true
    description: "Maximum cumulative payout allowed during policy period."
    documentation: "Maximum cumulative payout allowed during policy period."
  - _type: EntityAttribute
    _name: SublimitAmount
    label: Sublimit Amount
    physicalName: SUBLIMIT_AMOUNT
    dataType: Decimal
    precision: 18
    scale: 2
    mandatory: false
    searchable: true
    description: "Specific lower limit applied to defined peril or subcategory."
    documentation: "Specific lower limit applied to defined peril or subcategory."
  - _type: EntityAttribute
    _name: PerRiskLimit
