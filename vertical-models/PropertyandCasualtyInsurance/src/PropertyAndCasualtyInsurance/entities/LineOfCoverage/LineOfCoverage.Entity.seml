    physicalName: DEDUCTIBLE_AMOUNT
    dataType: Decimal
    precision: 18
    scale: 2
    mandatory: false
    searchable: true
    description: "Deductible applicable to this coverage instance."
    documentation: "Deductible applicable to this coverage instance."
  - _type: EntityAttribute
    _name: DeductibleType
