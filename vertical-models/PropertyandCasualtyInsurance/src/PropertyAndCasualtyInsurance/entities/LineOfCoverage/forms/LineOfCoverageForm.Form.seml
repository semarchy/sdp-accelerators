_package: PropertyAndCasualtyInsurance.entities.LineOfCoverage.forms
_type: Form
_name: LineOfCoverageForm
entity: PropertyAndCasualtyInsurance.entities.LineOfCoverage.LineOfCoverage
default: true
formTabs:
  - _type: FormTab
    _name: LineOfCoverageSummary
    iconUrl: images://mdi/file-document-box.svg
    label: Summary
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: Summary01
        content:
          - _type: MarkdownField
            _name: LineOfCoverageSummaryOverview
            label: Overview
            value: >-
              SEM_CONCAT('', '1',
                '# Line Of Coverage ', COALESCE(LineOfCoverageId, 'Unidentified line'), CHR(10), CHR(10),
                '**Policy:** ', COALESCE(FDN_Policy, 'Not recorded'), CHR(10), CHR(10),
                '**Coverage:** ', COALESCE(FDN_Coverage, 'Not recorded'), CHR(10), CHR(10),
                '**Coverage status:** ', COALESCE(FDN_CoverageStatus, 'Not recorded'), CHR(10), CHR(10),
                '**Trigger:** ', COALESCE(CoverageTrigger, 'Not recorded'), CHR(10), CHR(10),
                CASE
                  WHEN COALESCE(SEM_BOOLEAN_TO_CHAR(ActiveFlag), 'false') = 'true' THEN 'This line is currently active and available for claim and servicing operations.'
                  ELSE 'This line is currently inactive and should be reviewed before servicing.'
                END
              )
            useCustomLabel: true
            dataType: STRING
            relativeWidth: 100
            authoringMode: auto
            authoringModeValueInterpreter: LITERAL
            componentProperties:
              textAlign: left
              textAlignValueInterpreter: LITERAL
              textColor: md:blue-grey 900
              textColorValueInterpreter: LITERAL
              textTypography: body-1
              textTypographyValueInterpreter: LITERAL
              isCharCounterVisible: "0"
              isCharCounterVisibleValueInterpreter: LITERAL
            labelProperties:
              position: top
              positionValueInterpreter: LITERAL
              alignment: left
              alignmentValueInterpreter: LITERAL
              typography: title
              typographyValueInterpreter: LITERAL
              icon: images://mdi/shield-outline.svg
              iconValueInterpreter: LITERAL
              iconColor: md:blue 700
              iconColorValueInterpreter: LITERAL
              isVisible: "1"
              isVisibleValueInterpreter: LITERAL
        layoutDirection: ROW
      - _type: FormContainer
        _name: Summary02
        content:
          - _type: MarkdownField
            _name: LineOfCoverageSummaryLimits
            label: Limits and deductibles
            value: >-
              SEM_CONCAT('', '1',
                '## Financial structure', CHR(10), CHR(10),
                '| Measure | Value |', CHR(10),
                '| --- | ---: |', CHR(10),
                '| Limit amount | ', CASE WHEN LimitAmount IS NOT NULL THEN SEM_NUMBER_TO_CHAR(LimitAmount) ELSE 'Not recorded' END, ' |', CHR(10),
                '| Aggregate limit | ', CASE WHEN AggregateLimit IS NOT NULL THEN SEM_NUMBER_TO_CHAR(AggregateLimit) ELSE 'Not recorded' END, ' |', CHR(10),
                '| Per risk limit | ', CASE WHEN PerRiskLimit IS NOT NULL THEN SEM_NUMBER_TO_CHAR(PerRiskLimit) ELSE 'Not recorded' END, ' |', CHR(10),
                '| Deductible amount | ', CASE WHEN DeductibleAmount IS NOT NULL THEN SEM_NUMBER_TO_CHAR(DeductibleAmount) ELSE 'Not recorded' END, ' |', CHR(10),
                '| Deductible type | ', COALESCE(DeductibleType, 'Not recorded'), ' |'
              )
            useCustomLabel: true
            dataType: STRING
            relativeWidth: 100
            authoringMode: auto
            authoringModeValueInterpreter: LITERAL
            componentProperties:
              textAlign: left
              textAlignValueInterpreter: LITERAL
              textColor: md:blue-grey 900
              textColorValueInterpreter: LITERAL
              textTypography: body-1
              textTypographyValueInterpreter: LITERAL
              isCharCounterVisible: "0"
              isCharCounterVisibleValueInterpreter: LITERAL
            labelProperties:
              position: top
              positionValueInterpreter: LITERAL
              alignment: left
              alignmentValueInterpreter: LITERAL
              typography: title
              typographyValueInterpreter: LITERAL
              icon: images://mdi/cash-multiple.svg
              iconValueInterpreter: LITERAL
              iconColor: md:green 500
              iconColorValueInterpreter: LITERAL
              isVisible: "1"
              isVisibleValueInterpreter: LITERAL
          - _type: MarkdownField
            _name: LineOfCoverageSummaryPremium
            label: Premium and dates
            value: >-
              SEM_CONCAT('', '1',
                '## Premium and timeline', CHR(10), CHR(10),
                '| Milestone | Value |', CHR(10),
                '| --- | --- |', CHR(10),
                '| Written premium | ', CASE WHEN WrittenPremium IS NOT NULL THEN SEM_NUMBER_TO_CHAR(WrittenPremium) ELSE 'Not recorded' END, ' |', CHR(10),
                '| Earned premium | ', CASE WHEN EarnedPremium IS NOT NULL THEN SEM_NUMBER_TO_CHAR(EarnedPremium) ELSE 'Not recorded' END, ' |', CHR(10),
                '| Effective from | ', CASE WHEN EffectiveFrom IS NOT NULL THEN SEM_TO_CHAR2(EffectiveFrom) ELSE 'Not recorded' END, ' |', CHR(10),
                '| Effective to | ', CASE WHEN EffectiveTo IS NOT NULL THEN SEM_TO_CHAR2(EffectiveTo) ELSE 'Not recorded' END, ' |', CHR(10),
                '| Endorsement effective | ', CASE WHEN EndorsementEffectiveDate IS NOT NULL THEN SEM_TO_CHAR2(EndorsementEffectiveDate) ELSE 'Not recorded' END, ' |'
              )
            useCustomLabel: true
            dataType: STRING
            relativeWidth: 100
            authoringMode: auto
            authoringModeValueInterpreter: LITERAL
            componentProperties:
              textAlign: left
              textAlignValueInterpreter: LITERAL
              textColor: md:blue-grey 900
              textColorValueInterpreter: LITERAL
              textTypography: body-1
              textTypographyValueInterpreter: LITERAL
              isCharCounterVisible: "0"
              isCharCounterVisibleValueInterpreter: LITERAL
            labelProperties:
              position: top
              positionValueInterpreter: LITERAL
              alignment: left
              alignmentValueInterpreter: LITERAL
              typography: title
              typographyValueInterpreter: LITERAL
              icon: images://mdi/calendar-clock.svg
              iconValueInterpreter: LITERAL
              iconColor: md:indigo 700
              iconColorValueInterpreter: LITERAL
              isVisible: "1"
              isVisibleValueInterpreter: LITERAL
        layoutDirection: ROW

  - _type: FormTab
    _name: LineOfCoverage
    label: Line Of Coverage
    iconUrl: images://mdi/file-document.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: LineOfCoverageGeneralSection
        label: Line Of Coverage General
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: LineOfCoverageGeneralRow
            content:
              - _type: FormContainer
                _name: LineOfCoverageGeneralColA
                content:
                  - _type: IdField
                    _name: LineOfCoverageId
                    value: LineOfCoverageId
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AssetId
                    value: AssetId
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_CoverageStatus
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.CoverageStatus.CoverageStatus
                    useCustomLabel: false
                    value: FDN_CoverageStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '350'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfCoverageGeneralColB
                content:
                  - _type: ReferenceField
                    _name: FDN_Policy
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.Policy.Policy
                    useCustomLabel: false
                    value: FDN_Policy
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '250'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Coverage
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.Coverage.Coverage
                    useCustomLabel: false
                    value: FDN_Coverage
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '400'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: MenuField
                    _name: CoverageTrigger
                    value: CoverageTrigger
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfCoverageGeneralColC
                content:
                  - _type: CheckboxField
                    _name: ActiveFlag
                    value: ActiveFlag
                    useCustomLabel: false
                    dataType: BOOLEAN
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ClaimsMadeRetroDate
                    value: ClaimsMadeRetroDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: LineOfCoverageLimitSection
        label: Limits and Deductibles
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: LineOfCoverageLimitRow
            content:
              - _type: FormContainer
                _name: LineOfCoverageLimitColA
                content:
                  - _type: TextField
                    _name: LimitAmount
                    value: LimitAmount
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AggregateLimit
                    value: AggregateLimit
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PerRiskLimit
                    value: PerRiskLimit
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfCoverageLimitColB
                content:
                  - _type: TextField
                    _name: SublimitAmount
                    value: SublimitAmount
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DeductibleAmount
                    value: DeductibleAmount
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: MenuField
                    _name: DeductibleType
                    value: DeductibleType
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfCoverageLimitColC
                content:
                  - _type: MenuField
                    _name: LimitType
                    value: LimitType
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                      
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: MenuField
                    _name: ValuationMethod
                    value: ValuationMethod
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: BlanketIndicator
                    value: BlanketIndicator
                    useCustomLabel: false
                    dataType: BOOLEAN
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: LineOfCoveragePremiumSection
        label: Pricing and Premium
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: LineOfCoveragePremiumRow
            content:
              - _type: FormContainer
                _name: LineOfCoveragePremiumColA
                content:
                  - _type: TextField
                    _name: Rate
                    value: Rate
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ExposureBase
                    value: ExposureBase
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ExposureUnit
                    value: ExposureUnit
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: FullyEarnedFlag
                    value: FullyEarnedFlag
                    useCustomLabel: false
                    dataType: BOOLEAN
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfCoveragePremiumColB
                content:
                  - _type: TextField
                    _name: ManualPremium
                    value: ManualPremium
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TechnicalPremium
                    value: TechnicalPremium
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: WrittenPremium
                    value: WrittenPremium
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfCoveragePremiumColC
                content:
                  - _type: TextField
                    _name: EarnedPremium
                    value: EarnedPremium
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: DiscountAmount
                    value: DiscountAmount
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: SurchargeAmount
                    value: SurchargeAmount
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: LineOfCoverageTermSection
        label: Term and Endorsement
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: LineOfCoverageTermRow
            content:
              - _type: FormContainer
                _name: LineOfCoverageTermColA
                content:
                  - _type: TextField
                    _name: EffectiveFrom
                    value: EffectiveFrom
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EffectiveTo
                    value: EffectiveTo
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: OriginalEffectiveDate
                    value: OriginalEffectiveDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfCoverageTermColB
                content:
                  - _type: CheckboxField
                    _name: EndorsementIndicator
                    value: EndorsementIndicator
                    useCustomLabel: false
                    dataType: BOOLEAN
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EndorsementEffectiveDate
                    value: EndorsementEffectiveDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PrimaryExcessIndicator
                    value: PrimaryExcessIndicator
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: LineOfCoverageTermColC
                content:
                  - _type: TextField
                    _name: QuotaSharePercent
                    value: SEM_NUMBER_TO_CHAR(QuotaSharePercent) || ' %'
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RiskScore
                    value: RiskScore
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: LossHistoryIndicator
                    value: LossHistoryIndicator
                    useCustomLabel: false
                    dataType: BOOLEAN
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: LineOfCoverageUnderwritingSection
        label: Underwriting
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: LineOfCoverageUnderwritingRow
            content:
              - _type: FormContainer
                _name: LineOfCoverageUnderwritingColA
                content:
                  - _type: TextField
                    _name: UnderwriterNotes
                    value: UnderwriterNotes
                    useCustomLabel: false
                    dataType: LONG_TEXT
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
