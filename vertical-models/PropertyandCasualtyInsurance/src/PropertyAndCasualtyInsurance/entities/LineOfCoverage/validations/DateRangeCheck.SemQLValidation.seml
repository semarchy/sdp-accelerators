_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.LineOfCoverage.validations
entity: PropertyAndCasualtyInsurance.entities.LineOfCoverage.LineOfCoverage
label: Date Range Check
condition: EffectiveFrom <= EffectiveTo
validationScope: PRE_CONSO
description: Checks that the EffectiveFrom date is less than or equal to the EffectiveTo date for a Line of Coverage entity.
validationLabel: EffectiveTo must be greater than or equal to EffectiveFrom