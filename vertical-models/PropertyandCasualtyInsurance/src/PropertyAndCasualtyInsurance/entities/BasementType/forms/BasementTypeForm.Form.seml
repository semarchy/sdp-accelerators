_package: PropertyAndCasualtyInsurance.entities.BasementType.forms
_type: Form
_name: BasementTypeForm
entity: PropertyAndCasualtyInsurance.entities.BasementType.BasementType
default: true
formTabs:
  - _type: FormTab
    _name: BasementType
    label: "Basement Type"
    iconUrl: images://mdi/home-floor-g.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: BasementTypeSection1
        label: "Basement Type Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: BasementTypeSection1Row
            content:
              - _type: FormContainer
                _name: BasementTypeSection1Col1
                content:
                  - _type: IdField
                    _name: BasementTypeID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: BasementTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: BasementTypeCode
                    dataType: STRING
                    useCustomLabel: false
                    value: BasementTypeCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: BasementTypeName
                    dataType: STRING
                    useCustomLabel: false
                    value: BasementTypeName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: BasementTypeSection1Col2
                content:
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
