_package: PropertyAndCasualtyInsurance.entities.PaymentPlan.action_sets
_type: ActionSet
_name: PaymentPlanActionSet
entity: PropertyAndCasualtyInsurance.entities.PaymentPlan.PaymentPlan
label: Payment Plan Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorPaymentPlans
    label: Create
    useCustomLabel: true
    stepper: PropertyAndCasualtyInsurance.entities.PaymentPlan.steppers.AuthorPaymentPlans
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorPaymentPlans
    label: Edit
    useCustomLabel: true
    stepper: PropertyAndCasualtyInsurance.entities.PaymentPlan.steppers.AuthorPaymentPlans
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorPaymentPlans
    label: Mass Update
    useCustomLabel: true
    stepper: PropertyAndCasualtyInsurance.entities.PaymentPlan.steppers.AuthorPaymentPlans
    availableForGoldenData: true
    availableForErrorData: false
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorPaymentPlans
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: PropertyAndCasualtyInsurance.entities.PaymentPlan.steppers.AuthorPaymentPlans
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
