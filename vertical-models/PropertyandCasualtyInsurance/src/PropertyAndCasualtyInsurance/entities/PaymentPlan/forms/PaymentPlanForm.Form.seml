_package: PropertyAndCasualtyInsurance.entities.PaymentPlan.forms
_type: Form
_name: PaymentPlanForm
entity: PropertyAndCasualtyInsurance.entities.PaymentPlan.PaymentPlan
default: true
formTabs:
  - _type: FormTab
    _name: PaymentPlan
    label: Payment Plan
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: '200'
    content:
      - _type: IdField
        _name: PlanCode
        value: PlanCode
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: PlanName
        value: PlanName
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: BillingFrequency
        value: BillingFrequency
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: InstallmentCount
        value: InstallmentCount
        useCustomLabel: false
        dataType: INTEGER
      - _type: CheckboxField
        _name: AutoPaySupportedFlag
        value: AutoPaySupportedFlag
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: TextField
        _name: GracePeriodDays
        value: GracePeriodDays
        useCustomLabel: false
        dataType: INTEGER
