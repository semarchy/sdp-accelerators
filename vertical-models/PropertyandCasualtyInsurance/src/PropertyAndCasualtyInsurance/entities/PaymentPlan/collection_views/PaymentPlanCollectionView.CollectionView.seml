  - _type: TextColumn
    _name: BillingFrequency
    value: BillingFrequency
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: InstallmentCount
    value: InstallmentCount
    useCustomLabel: false
