_package: PropertyAndCasualtyInsurance.entities.VehicleType.forms
_type: Form
_name: VehicleTypeForm
entity: PropertyAndCasualtyInsurance.entities.VehicleType.VehicleType
default: true
formTabs:
  - _type: FormTab
    _name: VehicleType
    label: "Vehicle Type"
    iconUrl: images://mdi/car-cog.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: VehicleTypeSection1
        label: "Vehicle Type Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: VehicleTypeSection1Row
            content:
              - _type: FormContainer
                _name: VehicleTypeSection1Col1
                content:
                  - _type: IdField
                    _name: VehicleTypeID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: VehicleTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: VehicleTypeCode
                    dataType: STRING
                    useCustomLabel: false
                    value: VehicleTypeCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: VehicleTypeName
                    dataType: STRING
                    useCustomLabel: false
                    value: VehicleTypeName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleTypeSection1Col2
                content:
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
