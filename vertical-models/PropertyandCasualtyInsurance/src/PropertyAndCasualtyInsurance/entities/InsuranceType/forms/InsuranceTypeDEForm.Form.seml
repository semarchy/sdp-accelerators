_package: PropertyAndCasualtyInsurance.entities.InsuranceType.forms
_type: Form
_name: InsuranceTypeDEForm
entity: PropertyAndCasualtyInsurance.entities.InsuranceType.InsuranceType
default: true
description: Form for browsing insurance types
formTabs:
  - _type: FormTab
    _name: General
    label: General Details
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
          - _type: FormContainer
            _name: GeneralContainer01
            content:
              - _type: FormContainer
                _name: GeneralContainer01A
                content:
                  - _type: IdField
                    _name: InsuranceTypeID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: InsuranceTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: InsuranceTypeCode
                    dataType: STRING
                    useCustomLabel: false
                    value: InsuranceTypeCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: InsuranceTypeName
                    dataType: STRING
                    useCustomLabel: false
                    value: InsuranceTypeName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: GeneralContainer01B
                content:
                  - _type: ReferenceField
                    _name: RiskClass
                    referencedEntity: PropertyAndCasualtyInsurance.entities.RiskClass.RiskClass
                    dataType: STRING
                    useCustomLabel: false
                    value: FDN_RiskClass
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      chipMaxWidth: '300'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Product
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.InsuranceProduct.InsuranceProduct
                    useCustomLabel: false
                    value: FDN_InsuranceProduct
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '300'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption

                  - _type: TextField
                    _name: Description
                    dataType: LONG_TEXT
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: GeneralContainer01C
                content:
                  
                  - _type: DateField
                    _name: EffectiveFrom
                    dataType: DATE
                    useCustomLabel: false
                    value: EffectiveFrom
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: EffectiveTo
                    dataType: DATE
                    useCustomLabel: false
                    value: EffectiveTo
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: AdmittedFlag
                    dataType: BOOLEAN
                    useCustomLabel: false
                    value: AdmittedFlag
                    componentProperties:
                      useSwitch: '1'
                      useSwitchValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: button

                layoutDirection: COLUMN
            layoutDirection: ROW

