_package: PropertyAndCasualtyInsurance.entities.InsuranceType.business_views
_type: BusinessView
_name: InsuranceTypeBusinessView
label: Insurance Type
description: Provides a consolidated view of insurance type information, combining key attributes and related data to support business users in understanding and managing insurance types effectively. This business view aggregates essential details such as insurance type codes, names, risk classifications, and regulatory status to facilitate comprehensive coverage management, underwriting segmentation, and compliance monitoring.
entity: PropertyAndCasualtyInsurance.entities.InsuranceType.InsuranceType
rootLabel: Insurance Types
rootPluralLabel: Insurance Types
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: InsuranceType
  displayCard: PropertyAndCasualtyInsurance.entities.InsuranceType.display_cards.InsuranceTypeDisplayCard
