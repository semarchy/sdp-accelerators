_package: PropertyAndCasualtyInsurance.entities.StateProvince.forms
_type: Form
_name: StateProvinceForm
entity: PropertyAndCasualtyInsurance.entities.StateProvince.StateProvince
default: true
formTabs:
  - _type: FormTab
    _name: StateProvince
    label: "State or Province"
    iconUrl: images://mdi/map-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: StateProvinceSection1
        label: "Jurisdiction Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: StateProvinceSection1Row
            content:
              - _type: FormContainer
                _name: StateProvinceSection1Col1
                content:
                  - _type: IdField
                    _name: StateProvinceID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: StateProvinceID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: StateCode
                    dataType: STRING
                    useCustomLabel: false
                    value: StateCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: StateName
                    dataType: STRING
                    useCustomLabel: false
                    value: StateName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: StateProvinceSection1Col2
                content:
                  - _type: TextField
                    _name: CountryCode
                    dataType: STRING
                    useCustomLabel: false
                    value: CountryCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
