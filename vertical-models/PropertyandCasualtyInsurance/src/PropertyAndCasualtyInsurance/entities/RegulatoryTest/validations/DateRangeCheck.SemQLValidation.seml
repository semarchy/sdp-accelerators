_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.RegulatoryTest.validations
entity: PropertyAndCasualtyInsurance.entities.RegulatoryTest.RegulatoryTest
label: Date Range Check
condition: EffectiveFrom <= EffectiveTo
validationScope: PRE_CONSO
description: Checks that the EffectiveFrom date is less than or equal to the EffectiveTo date for a Regulatory Test entity.
validationLabel: EffectiveTo must be greater than or equal to EffectiveFrom