_package: PropertyAndCasualtyInsurance.entities.RegulatoryTest.forms
_type: Form
_name: RegulatoryTestDEForm
entity: PropertyAndCasualtyInsurance.entities.RegulatoryTest.RegulatoryTest
default: true
description: Form for browsing regulatory tests
formTabs:
  - _type: FormTab
    _name: General
    label: Regulatory Test
    iconUrl: images://mdi/clipboard-check-outline.svg
    documentation: This form provides a comprehensive view of regulatory test details.
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: GeneralContainer01
        content:
          - _type: FormContainer
            _name: GeneralContainer01A
            content:
              - _type: IdField
                _name: RegulatoryTestID
                dataType: LONG_INTEGER
                useCustomLabel: false
                value: RegulatoryTestID
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: RegulatoryTestCode
                dataType: STRING
                useCustomLabel: false
                value: RegulatoryTestCode
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: TestName
                dataType: STRING
                useCustomLabel: false
                value: TestName
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: ReferenceField
                _name: FDN_InsurancePlan
                dataType: STRING
                referencedEntity: PropertyAndCasualtyInsurance.entities.InsurancePlan.InsurancePlan
                useCustomLabel: false
                value: FDN_InsurancePlan
                componentProperties:
                  textAlign: left
                  displayType: chip
                  displayTypeValueInterpreter: LITERAL
                  chipMaxWidth: '300'
                  chipMaxWidthValueInterpreter: LITERAL
                  useAvatarInChip: '1'
                  useAvatarInChipValueInterpreter: LITERAL
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
            layoutDirection: COLUMN
          - _type: FormContainer
            _name: GeneralContainer01B
            content:
              - _type: TextField
                _name: Jurisdiction
                dataType: STRING
                useCustomLabel: false
                value: Jurisdiction
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: TestDescription
                dataType: LONG_TEXT
                useCustomLabel: false
                value: TestDescription
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: MenuField
                _name: Severity
                dataType: STRING
                useCustomLabel: false
                value: Severity
                componentProperties:
                  textAlign: left
                  useAvatarInMenu: '1'
                  useAvatarInMenuValueInterpreter: LITERAL
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
            layoutDirection: COLUMN
          - _type: FormContainer
            _name: GeneralContainer01C
            content:
              - _type: DateField
                _name: EffectiveFrom
                dataType: DATE
                useCustomLabel: false
                value: EffectiveFrom
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: DateField
                _name: EffectiveTo
                dataType: DATE
                useCustomLabel: false
                value: EffectiveTo
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
            layoutDirection: COLUMN
        layoutDirection: ROW
