_package: PropertyAndCasualtyInsurance.entities.VehicleSafetyFeature.forms
_type: Form
_name: VehicleSafetyFeatureForm
entity: PropertyAndCasualtyInsurance.entities.VehicleSafetyFeature.VehicleSafetyFeature
default: true
formTabs:
  - _type: FormTab
    _name: VehicleSafetyFeature
    label: "Vehicle Safety Feature"
    iconUrl: images://mdi/shield-check-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: VehicleSafetyFeatureSection1
        label: "Safety Feature Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: VehicleSafetyFeatureSection1Row
            content:
              - _type: FormContainer
                _name: VehicleSafetyFeatureSection1Col1
                content:
                  - _type: IdField
                    _name: VehicleSafetyFeatureID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: VehicleSafetyFeatureID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FeatureCode
                    dataType: STRING
                    useCustomLabel: false
                    value: FeatureCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FeatureName
                    dataType: STRING
                    useCustomLabel: false
                    value: FeatureName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleSafetyFeatureSection1Col2
                content:
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
