_package: PropertyAndCasualtyInsurance.entities.RiskClass.forms
_type: Form
_name: RiskClassForm
entity: PropertyAndCasualtyInsurance.entities.RiskClass.RiskClass
default: true
formTabs:
  - _type: FormTab
    _name: RiskClass
    label: Risk Class
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: '200'
    content:
      - _type: IdField
        _name: RiskClassID
        value: RiskClassID
        useCustomLabel: false
        dataType: LONG_INTEGER
      - _type: TextField
        _name: RiskClassName
        value: RiskClassName
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: RiskClassDescription
        value: RiskClassDescription
        useCustomLabel: false
        dataType: STRING
