_package: PropertyAndCasualtyInsurance.entities.CoverageStatus.forms
_type: Form
_name: CoverageStatusForm
entity: PropertyAndCasualtyInsurance.entities.CoverageStatus.CoverageStatus
default: true
formTabs:
  - _type: FormTab
    _name: CoverageStatus
    label: Coverage Status
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: '200'
    content:
      - _type: IdField
        _name: CoverageStatusCode
        value: CoverageStatusCode
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: CoverageStatusName
        value: CoverageStatusName
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: CoverageLifecycleStage
        value: CoverageLifecycleStage
        useCustomLabel: false
        dataType: STRING
      - _type: CheckboxField
        _name: SelectableForNewBusinessFlag
        value: SelectableForNewBusinessFlag
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: CheckboxField
        _name: ClaimsPayableFlag
        value: ClaimsPayableFlag
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: CheckboxField
        _name: RequiresUnderwriterReviewFlag
        value: RequiresUnderwriterReviewFlag
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: TextField
        _name: Description
        dataType: LONG_TEXT
        useCustomLabel: false
        value: Description
