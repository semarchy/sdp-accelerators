_package: PropertyAndCasualtyInsurance.entities.VehicleModel
_type: Entity
_name: VehicleModel
label: "Vehicle Model"
pluralLabel: "Vehicle Models"
entityType: BASIC
physicalTableName: VEHICLE_MODEL
iconUrl: images://mdi/car-multiple.svg
description: "Reference record for vehicle models."
documentation: "Reference record for vehicle models."
historizeGolden: false
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: VehicleModelID
    label: "Vehicle Model ID"
    physicalName: VEHICLE_MODEL_ID
    dataType: LongInteger
    precision: 38
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Unique identifier for a vehicle model."
    documentation: "Unique identifier for a vehicle model."
  - _type: EntityAttribute
    _name: ModelCode
    label: "Model Code"
    physicalName: MODEL_CODE
    dataType: String
    length: 50
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Enterprise code for the vehicle model."
    documentation: "Enterprise code for the vehicle model."
  - _type: EntityAttribute
    _name: ModelName
    label: "Model Name"
    physicalName: MODEL_NAME
    dataType: String
    length: 255
    mandatory: true
    mandatoryValidationScope: PRE_CONSO
    searchable: true
    description: "Vehicle model name."
    documentation: "Vehicle model name."
  - _type: EntityAttribute
    _name: Description
    label: "Description"
    physicalName: DESCRIPTION
    dataType: String
    length: 255
    mandatory: false
    searchable: true
    description: "Vehicle model description."
    documentation: "Vehicle model description."
sourceIdGeneration:
  mode: MANUAL
primaryKey: PropertyAndCasualtyInsurance.entities.VehicleModel.VehicleModel.VehicleModelID
