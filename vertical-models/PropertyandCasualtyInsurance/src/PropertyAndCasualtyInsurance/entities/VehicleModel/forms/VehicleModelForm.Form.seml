_package: PropertyAndCasualtyInsurance.entities.VehicleModel.forms
_type: Form
_name: VehicleModelForm
entity: PropertyAndCasualtyInsurance.entities.VehicleModel.VehicleModel
default: true
formTabs:
  - _type: FormTab
    _name: VehicleModel
    label: "Vehicle Model"
    iconUrl: images://mdi/car-multiple.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: VehicleModelSection1
        label: "Model Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: VehicleModelSection1Row
            content:
              - _type: FormContainer
                _name: VehicleModelSection1Col1
                content:
                  - _type: IdField
                    _name: VehicleModelID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: VehicleModelID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ModelCode
                    dataType: STRING
                    useCustomLabel: false
                    value: ModelCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ModelName
                    dataType: STRING
                    useCustomLabel: false
                    value: ModelName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleModelSection1Col2
                content:
                  - _type: ReferenceField
                    _name: FDN_Make
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.VehicleMake.VehicleMake
                    useCustomLabel: false
                    value: FDN_Make
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
