_package: PropertyAndCasualtyInsurance.entities.VehicleMake.forms
_type: Form
_name: VehicleMakeForm
entity: PropertyAndCasualtyInsurance.entities.VehicleMake.VehicleMake
default: true
formTabs:
  - _type: FormTab
    _name: VehicleMake
    label: "Vehicle Make"
    iconUrl: images://mdi/factory.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: VehicleMakeSection1
        label: "Make Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: VehicleMakeSection1Row
            content:
              - _type: FormContainer
                _name: VehicleMakeSection1Col1
                content:
                  - _type: IdField
                    _name: VehicleMakeID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: VehicleMakeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MakeCode
                    dataType: STRING
                    useCustomLabel: false
                    value: MakeCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: MakeName
                    dataType: STRING
                    useCustomLabel: false
                    value: MakeName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleMakeSection1Col2
                content:
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
