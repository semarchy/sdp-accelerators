_package: PropertyAndCasualtyInsurance.entities.DistributionChannel.forms
_type: Form
_name: DistributionChannelForm
entity: PropertyAndCasualtyInsurance.entities.DistributionChannel.DistributionChannel
default: true
formTabs:
  - _type: FormTab
    _name: DistributionChannel
    label: Distribution Channel
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: '200'
    content:
      - _type: IdField
        _name: ChannelCode
        value: ChannelCode
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: ChannelName
        value: ChannelName
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: ChannelType
        value: ChannelType
        useCustomLabel: false
        dataType: STRING
      - _type: CheckboxField
        _name: CommissionEligibleFlag
        value: CommissionEligibleFlag
        useCustomLabel: false
        dataType: BOOLEAN
