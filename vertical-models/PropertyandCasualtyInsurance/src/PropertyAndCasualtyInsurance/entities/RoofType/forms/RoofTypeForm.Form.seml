_package: PropertyAndCasualtyInsurance.entities.RoofType.forms
_type: Form
_name: RoofTypeForm
entity: PropertyAndCasualtyInsurance.entities.RoofType.RoofType
default: true
formTabs:
  - _type: FormTab
    _name: RoofType
    label: "Roof Type"
    iconUrl: images://mdi/home-roof.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: RoofTypeSection1
        label: "Roof Type Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: RoofTypeSection1Row
            content:
              - _type: FormContainer
                _name: RoofTypeSection1Col1
                content:
                  - _type: IdField
                    _name: RoofTypeID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: RoofTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RoofTypeCode
                    dataType: STRING
                    useCustomLabel: false
                    value: RoofTypeCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: RoofTypeName
                    dataType: STRING
                    useCustomLabel: false
                    value: RoofTypeName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: RoofTypeSection1Col2
                content:
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
