_package: PropertyAndCasualtyInsurance.entities.AssetType.forms
_type: Form
_name: AssetTypeForm
entity: PropertyAndCasualtyInsurance.entities.AssetType.AssetType
default: true
formTabs:
  - _type: FormTab
    _name: AssetType
    label: "Asset Type"
    iconUrl: images://mdi/shape-outline.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: AssetTypeSection1
        label: "Asset Type Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: AssetTypeSection1Row
            content:
              - _type: FormContainer
                _name: AssetTypeSection1Col1
                content:
                  - _type: IdField
                    _name: AssetTypeID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: AssetTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AssetTypeCode
                    dataType: STRING
                    useCustomLabel: false
                    value: AssetTypeCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AssetTypeName
                    dataType: STRING
                    useCustomLabel: false
                    value: AssetTypeName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: AssetTypeSection1Col2
                content:
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
