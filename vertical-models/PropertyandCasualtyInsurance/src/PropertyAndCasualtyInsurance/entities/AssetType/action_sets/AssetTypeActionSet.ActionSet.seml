_package: PropertyAndCasualtyInsurance.entities.AssetType.action_sets
_type: ActionSet
_name: AssetTypeActionSet
entity: PropertyAndCasualtyInsurance.entities.AssetType.AssetType
label: "Asset Type Action Set"
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorAssetTypes
    label: Create
    useCustomLabel: true
    stepper: PropertyAndCasualtyInsurance.entities.AssetType.steppers.AuthorAssetTypes
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorAssetTypes
    label: Edit
    useCustomLabel: true
    stepper: PropertyAndCasualtyInsurance.entities.AssetType.steppers.AuthorAssetTypes
