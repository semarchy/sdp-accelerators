_package: PropertyAndCasualtyInsurance.entities.Rating.forms
_type: Form
_name: RatingDEForm
entity: PropertyAndCasualtyInsurance.entities.Rating.Rating
default: true
description: Form for browsing ratings
formTabs:
  - _type: FormTab
    _name: General
    label: Rating
    iconUrl: images://mdi/calculator-variant-outline.svg
    documentation: This form provides a comprehensive view of rating details.
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: GeneralContainer01
        content:
          - _type: FormContainer
            _name: GeneralContainer01A
            content:
              - _type: IdField
                _name: RatingID
                dataType: LONG_INTEGER
                useCustomLabel: false
                value: RatingID
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: RatingPlanCode
                dataType: STRING
                useCustomLabel: false
                value: RatingPlanCode
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: RatingPlanName
                dataType: STRING
                useCustomLabel: false
                value: RatingPlanName
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: ReferenceField
                _name: FDN_InsurancePlan
                dataType: STRING
                referencedEntity: PropertyAndCasualtyInsurance.entities.InsurancePlan.InsurancePlan
                useCustomLabel: false
                value: FDN_InsurancePlan
                componentProperties:
                  textAlign: left
                  displayType: chip
                  displayTypeValueInterpreter: LITERAL
                  chipMaxWidth: '300'
                  chipMaxWidthValueInterpreter: LITERAL
                  useAvatarInChip: '1'
                  useAvatarInChipValueInterpreter: LITERAL
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
            layoutDirection: COLUMN
          - _type: FormContainer
            _name: GeneralContainer01B
            content:
              - _type: TextField
                _name: Version
                dataType: STRING
                useCustomLabel: false
                value: Version
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: MenuField
                _name: RatingMethod
                dataType: STRING
                useCustomLabel: false
                value: RatingMethod
                componentProperties:
                  textAlign: left
                  useAvatarInMenu: '1'
                  useAvatarInMenuValueInterpreter: LITERAL
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: Notes
                dataType: LONG_TEXT
                useCustomLabel: false
                value: Notes
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
            layoutDirection: COLUMN
          - _type: FormContainer
            _name: GeneralContainer01C
            content:
              - _type: DateField
                _name: EffectiveFrom
                dataType: DATE
                useCustomLabel: false
                value: EffectiveFrom
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: DateField
                _name: EffectiveTo
                dataType: DATE
                useCustomLabel: false
                value: EffectiveTo
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
            layoutDirection: COLUMN
        layoutDirection: ROW
