_package: PropertyAndCasualtyInsurance.entities.Rating.business_views
_type: BusinessView
_name: RatingBusinessView
label: Rating
entity: PropertyAndCasualtyInsurance.entities.Rating.Rating
rootLabel: Ratings
rootPluralLabel: Ratings
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Rating
  displayCard: PropertyAndCasualtyInsurance.entities.Rating.display_cards.RatingDisplayCard
  entity: PropertyAndCasualtyInsurance.entities.Rating.Rating
  actionSet: PropertyAndCasualtyInsurance.entities.Rating.action_sets.RatingActionSet
  collection: PropertyAndCasualtyInsurance.entities.Rating.collection_views.RatingCollectionView
  form: PropertyAndCasualtyInsurance.entities.Rating.forms.RatingForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      transitionPath: GoldenHistoryRecords
      description: Transition from Rating to related Golden History Records.
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/av-timer.svg
      label: History
      pluralLabel: History
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _type: BusinessViewEntityReference
        ref: PropertyAndCasualtyInsurance.entities.Rating.business_views.RatingBusinessView.Rating
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true
enableHierarchyView: false
useHierarchyOnOpen: false
