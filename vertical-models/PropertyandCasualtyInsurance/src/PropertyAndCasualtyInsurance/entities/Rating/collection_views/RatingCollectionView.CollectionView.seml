_package: PropertyAndCasualtyInsurance.entities.Rating.collection_views
_type: CollectionView
_name: RatingCollectionView
entity: PropertyAndCasualtyInsurance.entities.Rating.Rating
default: true
displayCard: PropertyAndCasualtyInsurance.entities.Rating.display_cards.RatingDisplayCard
tableDisplayCardColumnWidth: 350
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Rating
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: RatingID
    value: RatingID
    useCustomLabel: false
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: RatingPlanCode
    value: RatingPlanCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    defaultWidth: 300
  - _type: ReferenceColumn
    _name: FDN_InsurancePlan
    columnAlign: LEFT
    dataType: STRING
    label: FDN Insurance Plan
    referencedEntity: PropertyAndCasualtyInsurance.entities.InsurancePlan.InsurancePlan
    useCustomLabel: true
    value: FDN_InsurancePlan
    visibleByDefault: true
    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Version
    value: Version
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: MenuColumn
    _name: RatingMethod
    value: RatingMethod
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    defaultWidth: 250
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: EffectiveFrom
    value: EffectiveFrom
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: EffectiveTo
    value: EffectiveTo
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
