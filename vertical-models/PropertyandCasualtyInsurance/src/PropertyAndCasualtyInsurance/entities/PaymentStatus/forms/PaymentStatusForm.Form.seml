_package: PropertyAndCasualtyInsurance.entities.PaymentStatus.forms
_type: Form
_name: PaymentStatusForm
entity: PropertyAndCasualtyInsurance.entities.PaymentStatus.PaymentStatus
default: true
formTabs:
  - _type: FormTab
    _name: PaymentStatus
    label: Payment Status
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: '200'
    content:
      - _type: IdField
        _name: StatusCode
        value: StatusCode
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: StatusName
        value: StatusName
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: StatusCategory
        value: StatusCategory
        useCustomLabel: false
        dataType: STRING
      - _type: CheckboxField
        _name: DelinquentIndicator
        value: DelinquentIndicator
        useCustomLabel: false
        dataType: BOOLEAN
      - _type: CheckboxField
        _name: ActiveFlag
        value: ActiveFlag
        useCustomLabel: false
        dataType: BOOLEAN
