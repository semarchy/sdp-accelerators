_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.InsurancePlan.validations
entity: PropertyAndCasualtyInsurance.entities.InsurancePlan.InsurancePlan
label: Date Range Check
condition: EffectiveFrom <= EffectiveTo
validationScope: PRE_CONSO
description: Checks that the EffectiveFrom date is less than or equal to the EffectiveTo date for an Insurance Plan entity.
validationLabel: EffectiveTo must be greater than or equal to EffectiveFrom