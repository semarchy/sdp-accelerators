_package: PropertyAndCasualtyInsurance.entities.InsurancePlan.action_sets
_type: ActionSet
_name: InsurancePlanActionSet
entity: PropertyAndCasualtyInsurance.entities.InsurancePlan.InsurancePlan
label: Insurance Plan Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorInsurancePlans
    label: Create
    useCustomLabel: true
    stepper: PropertyAndCasualtyInsurance.entities.InsurancePlan.steppers.AuthorInsurancePlans
