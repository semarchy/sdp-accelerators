_package: PropertyAndCasualtyInsurance.entities.InsurancePlan.forms
_type: Form
_name: InsurancePlanDEForm
entity: PropertyAndCasualtyInsurance.entities.InsurancePlan.InsurancePlan
default: true
description: Form for browsing insurance plans
formTabs:
  - _type: FormTab
    _name: General
    label: Insurance Plan
    iconUrl: images://mdi/book-open-page-variant.svg
    documentation: This form provides a comprehensive view of insurance plan details, allowing users to auther and manage insurance plans effectively. 
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
          - _type: FormContainer
            _name: GeneralContainer01
            content:
              - _type: FormContainer
                _name: GeneralContainer01A
                content:
                  - _type: IdField
                    _name: InsurancePlanID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: InsurancePlanID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PlanCode
                    dataType: STRING
                    useCustomLabel: false
                    value: PlanCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PlanName
                    dataType: STRING
                    useCustomLabel: false
                    value: PlanName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_InsuranceType
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.InsuranceType.InsuranceType
                    useCustomLabel: false
                    value: FDN_InsuranceType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '300'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: GeneralContainer01B
                content:
                  - _type: TextField
                    _name: PlanVersion
                    dataType: STRING
                    useCustomLabel: false
                    value: PlanVersion
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: MenuField
                    _name: PlanStatus
                    dataType: STRING
                    useCustomLabel: false
                    value: PlanStatus
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FilingReference
                    dataType: STRING
                    useCustomLabel: false
                    value: FilingReference
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: GeneralContainer01C
                content:
                  - _type: DateField
                    _name: EffectiveFrom
                    dataType: DATE
                    useCustomLabel: false
                    value: EffectiveFrom
                    componentProperties:
                      textAlign: left
                      useTimePicker: "1"
                      useTimePickerValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: EffectiveTo
                    dataType: DATE
                    useCustomLabel: false
                    value: EffectiveTo
                    componentProperties:
                      textAlign: left
                      useTimePicker: "1"
                      useTimePickerValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    dataType: LONG_TEXT
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
