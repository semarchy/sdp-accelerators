_name: IssueClosedDateCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.Policy.validations
entity: PropertyAndCasualtyInsurance.entities.Policy.Policy
label: Issue Closed Date Check
condition: IssueDate <= CancelDate
validationScope: PRE_CONSO
description: Checks that the IssueDate is less than or equal to the policy close date (stored as CancelDate).
validationLabel: CancelDate must be greater than or equal to IssueDate
