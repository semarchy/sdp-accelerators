_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.Policy.validations
entity: PropertyAndCasualtyInsurance.entities.Policy.Policy
label: Date Range Check
condition: EffectiveDate <= ExpirationDate
validationScope: PRE_CONSO
description: Checks that the EffectiveDate is less than or equal to the ExpirationDate for a Policy entity.
validationLabel: ExpirationDate must be greater than or equal to EffectiveDate