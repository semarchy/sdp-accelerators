_package: PropertyAndCasualtyInsurance.entities.Policy.forms
_type: Form
_name: PolicyDEForm
entity: PropertyAndCasualtyInsurance.entities.Policy.Policy
default: true
formTabs:
  - _type: FormTab
    _name: Policy
    label: Policy
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: FormSection
        _name: PolicyGeneralSection
        label: Policy General
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PolicyGeneralRow
            content:
              - _type: FormContainer
                _name: PolicyGeneralColA
                content:
                  - _type: TextField
                    _name: PolicyNumber
                    value: PolicyNumber
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_PolicyStatus
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.PolicyStatus.PolicyStatus
                    useCustomLabel: false
                    value: FDN_PolicyStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '250'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyGeneralColB
                content:
                  - _type: TextField
                    _name: PolicyVersion
                    value: PolicyVersion
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: JurisdictionState
                    value: JurisdictionState
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyGeneralColC
                content:
                  - _type: TextField
                    _name: CurrencyCode
                    value: CurrencyCode
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_DistributionChannel
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.DistributionChannel.DistributionChannel
                    useCustomLabel: false
                    value: FDN_DistributionChannel
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '250'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN

      - _type: FormSection
        _name: PolicyLifecycleSection
        label: Lifecycle Dates
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PolicyLifecycleRow
            content:
              - _type: FormContainer
                _name: PolicyLifecycleColA
                content:
                  - _type: DateField
                    _name: EffectiveDate
                    value: EffectiveDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: ExpirationDate
                    value: ExpirationDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: IssueDate
                    value: IssueDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyLifecycleColB
                content:
                  - _type: DateField
                    _name: CancelDate
                    value: CancelDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: ReinstatementDate
                    value: ReinstatementDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: GracePeriodEndDate
                    value: GracePeriodEndDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyLifecycleColC
                content:
                  - _type: TextField
                    _name: CancellationReason
                    value: CancellationReason
                    useCustomLabel: false
                    dataType: STRING
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: PolicyLapseIndicator
                    value: PolicyLapseIndicator
                    useCustomLabel: false
                    dataType: BOOLEAN
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: PolicyBillingSection
        label: Billing and Premium
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: PolicyBillingRow
            content:
              - _type: FormContainer
                _name: PolicyBillingColA
                content:
                  - _type: ReferenceField
                    _name: FDN_PaymentPlan
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.PaymentPlan.PaymentPlan
                    useCustomLabel: false
                    value: FDN_PaymentPlan
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '220'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_PaymentStatus
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.PaymentStatus.PaymentStatus
                    useCustomLabel: false
                    value: FDN_PaymentStatus
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '220'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: AutoPayIndicator
                    value: AutoPayIndicator
                    useCustomLabel: false
                    dataType: BOOLEAN

                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyBillingColB
                content:
                  - _type: TextField
                    _name: WrittenPremium
                    value: WrittenPremium
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TotalPremium
                    value: TotalPremium
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: OutstandingPremiumAmount
                    value: OutstandingPremiumAmount
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: PolicyBillingColC
                content:
                  - _type: DateField
                    _name: LastPremiumPaidDate
                    value: LastPremiumPaidDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                      
                  - _type: TextField
                    _name: LastPremiumPaidAmount
                    value: LastPremiumPaidAmount
                    useCustomLabel: false
                    dataType: DECIMAL
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: PaymentDueDate
                    value: PaymentDueDate
                    useCustomLabel: false
                    dataType: DATE
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
