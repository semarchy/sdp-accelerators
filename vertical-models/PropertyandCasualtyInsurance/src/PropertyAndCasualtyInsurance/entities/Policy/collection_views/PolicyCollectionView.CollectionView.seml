_package: PropertyAndCasualtyInsurance.entities.Policy.collection_views
_type: CollectionView
_name: PolicyCollectionView
entity: PropertyAndCasualtyInsurance.entities.Policy.Policy
default: true
displayCard: PropertyAndCasualtyInsurance.entities.Policy.display_cards.PolicyDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Policy
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: PolicyID
    value: PolicyID
    useCustomLabel: false
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: PolicyNumber
    value: PolicyNumber
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

  - _type: TextColumn
    _name: IssueDate
    value: IssueDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FID_PolicyStatus
    columnAlign: LEFT
    dataType: STRING
    label: Policy Status
    referencedEntity: PropertyAndCasualtyInsurance.entities.PolicyStatus.PolicyStatus
    useCustomLabel: true
    value: FDN_PolicyStatus
    visibleByDefault: true
    defaultWidth: 220
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '220'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: WrittenPremium
    value: WrittenPremium
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ ##,###,###.##'
      displayFormatValueInterpreter: LITERAL  
  - _type: TextColumn
    _name: TotalPremium
    value: TotalPremium
    useCustomLabel: false
    dataType: DECIMAL
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:
      displayFormat: '$ ##,###,###.##'
      displayFormatValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FID_DistributionChannel
    columnAlign: LEFT
    dataType: STRING
    label: Distribution Channel
    referencedEntity: PropertyAndCasualtyInsurance.entities.DistributionChannel.DistributionChannel
    useCustomLabel: true
    value: FDN_DistributionChannel
    visibleByDefault: true
    defaultWidth: 240
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '240'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FID_PaymentPlan
    columnAlign: LEFT
    dataType: STRING
    label: Payment Plan
    referencedEntity: PropertyAndCasualtyInsurance.entities.PaymentPlan.PaymentPlan
    useCustomLabel: true
    value: FDN_PaymentPlan
    visibleByDefault: true
    defaultWidth: 220
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '220'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FID_PaymentStatus
    columnAlign: LEFT
    dataType: STRING
    label: Payment Status
    referencedEntity: PropertyAndCasualtyInsurance.entities.PaymentStatus.PaymentStatus
    useCustomLabel: true
    value: FDN_PaymentStatus
    visibleByDefault: true
    defaultWidth: 220
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '220'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: EffectiveDate
    value: EffectiveDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: ExpirationDate
    value: ExpirationDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true

  
  
