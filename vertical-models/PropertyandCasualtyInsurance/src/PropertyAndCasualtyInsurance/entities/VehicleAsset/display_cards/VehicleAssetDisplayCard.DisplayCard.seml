_package: PropertyAndCasualtyInsurance.entities.VehicleAsset.display_cards
_type: DisplayCard
_name: VehicleAssetDisplayCard
entity: PropertyAndCasualtyInsurance.entities.VehicleAsset.VehicleAsset
default: true
primaryTextExpression: SEM_CONCAT('', '1', COALESCE(SEM_NUMBER_TO_CHAR(Year), ''), ' ', COALESCE(Make.MakeName, ''), ' ', COALESCE(Model.ModelName, ''), ' ', COALESCE(VIN, ''))
primaryImageValueInterpreter: LITERAL
avatarImageSourceType: URL
avatarImageValue: images://mdi/car-outline.svg
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValueInterpreter: LITERAL
primaryImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
