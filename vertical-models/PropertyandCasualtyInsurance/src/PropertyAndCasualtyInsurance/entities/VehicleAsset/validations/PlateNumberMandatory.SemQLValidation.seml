_name: PlateNumberMandatory
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.VehicleAsset.validations
entity: PropertyAndCasualtyInsurance.entities.VehicleAsset.VehicleAsset
label: Plate Number Mandatory Check
condition: COALESCE(PlateNumber, '') <> ''
description: Checks that PlateNumber is provided for a Vehicle Asset entity.
validationScope: PRE_CONSO
validationLabel: PlateNumber must be provided and cannot be empty
