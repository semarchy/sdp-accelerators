_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.VehicleAsset.validations
entity: PropertyAndCasualtyInsurance.entities.VehicleAsset.VehicleAsset
label: Date Range Check
condition: StartDate <= EndDate
validationScope: PRE_CONSO
description: Checks that the StartDate is less than or equal to the EndDate for a Vehicle Asset entity.
validationLabel: EndDate must be greater than or equal to StartDate