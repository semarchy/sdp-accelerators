_name: VINMandatory
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.VehicleAsset.validations
entity: PropertyAndCasualtyInsurance.entities.VehicleAsset.VehicleAsset
label: VIN Mandatory Check
condition: COALESCE(VIN, '') <> ''
description: Checks that the VIN (Vehicle Identification Number) is provided for a Vehicle Asset entity.
validationScope: PRE_CONSO
validationLabel: VIN must be provided and cannot be empty
