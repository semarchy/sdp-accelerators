_package: PropertyAndCasualtyInsurance.entities.VehicleAsset.forms
_type: Form
_name: VehicleDEForm
entity: PropertyAndCasualtyInsurance.entities.VehicleAsset.VehicleAsset
default: false
formTabs:
  - _type: FormTab
    _name: VehicleAsset
    label: "Vehicle Asset"
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: FormSection
        _name: VehicleAssetSection1
        label: "Vehicle Identity"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: VehicleAssetSection1Row
            content:
              - _type: FormContainer
                _name: VehicleAssetSection1Col1
                content:
                  - _type: IdField
                    _name: VehicleAssetId
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: VehicleAssetId
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: VIN
                    dataType: STRING
                    useCustomLabel: false
                    value: VIN
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: PlateNumber
                    dataType: STRING
                    useCustomLabel: false
                    value: PlateNumber
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleAssetSection1Col2
                content:
                  - _type: ReferenceField
                    _name: FDN_PlateState
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.StateProvince.StateProvince
                    useCustomLabel: false
                    value: FDN_PlateState
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Year
                    dataType: INTEGER
                    useCustomLabel: false
                    value: Year
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Make
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.VehicleMake.VehicleMake
                    useCustomLabel: false
                    value: FDN_Make
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleAssetSection1Col3
                content:
                  - _type: ReferenceField
                    _name: FDN_Model
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.VehicleModel.VehicleModel
                    useCustomLabel: false
                    value: FDN_Model
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_Trim
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.VehicleTrim.VehicleTrim
                    useCustomLabel: false
                    value: FDN_Trim
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_BodyStyle
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.BodyStyle.BodyStyle
                    useCustomLabel: false
                    value: FDN_BodyStyle
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleAssetSection1Col4
                content:
                  - _type: ReferenceField
                    _name: FDN_VehicleType
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.VehicleType.VehicleType
                    useCustomLabel: false
                    value: FDN_VehicleType
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: MenuField
                    _name: FuelType
                    dataType: STRING
                    useCustomLabel: false
                    value: FuelType
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: EngineSize
                    dataType: STRING
                    useCustomLabel: false
                    value: EngineSize
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: VehicleAssetSection2
        label: "Usage and Driver"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: VehicleAssetSection2Row
            content:
              - _type: FormContainer
                _name: VehicleAssetSection2Col1
                content:
                  - _type: MenuField
                    _name: UsageType
                    dataType: STRING
                    useCustomLabel: false
                    value: UsageType
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AnnualMileage
                    dataType: INTEGER
                    useCustomLabel: false
                    value: AnnualMileage
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleAssetSection2Col2
                content:
                  
                  - _type: MenuField
                    _name: OwnershipType
                    dataType: STRING
                    useCustomLabel: false
                    value: OwnershipType
                    componentProperties:
                      textAlign: left
                      useAvatarInMenu: '1'
                      useAvatarInMenuValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: CheckboxField
                    _name: AntiTheftDeviceFlag
                    dataType: BOOLEAN
                    useCustomLabel: false
                    value: AntiTheftDeviceFlag
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleAssetSection2Col3
                content:
                  - _type: ReferenceField
                    _name: FDN_SafetyFeatures
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.VehicleSafetyFeature.VehicleSafetyFeature
                    useCustomLabel: false
                    value: FDN_SafetyFeatures
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: VehicleAssetSection3
        label: "Valuation and Coverage"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: VehicleAssetSection3Row
            content:
              - _type: FormContainer
                _name: VehicleAssetSection3Col1
                content:
                  - _type: TextField
                    _name: OriginalPurchasePrice
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: OriginalPurchasePrice
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CurrentMarketValue
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: CurrentMarketValue
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: CollisionDeductible
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: CollisionDeductible
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleAssetSection3Col2
                content:
                  - _type: TextField
                    _name: ComprehensiveDeductible
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: ComprehensiveDeductible
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: UninsuredMotoristLimit
                    dataType: DECIMAL
                    useCustomLabel: false
                    value: UninsuredMotoristLimit
                    componentProperties:
                      textAlign: left
                      displayFormat: '$ ##,###,###.##'
                      displayFormatValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
      - _type: FormSection
        _name: VehicleAssetSection4
        label: "Lifecycle"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: VehicleAssetSection4Row
            content:
              - _type: FormContainer
                _name: VehicleAssetSection4Col1
                content:
                  - _type: DateField
                    _name: StartDate
                    dataType: DATE
                    useCustomLabel: false
                    value: StartDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: EndDate
                    dataType: DATE
                    useCustomLabel: false
                    value: EndDate
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
