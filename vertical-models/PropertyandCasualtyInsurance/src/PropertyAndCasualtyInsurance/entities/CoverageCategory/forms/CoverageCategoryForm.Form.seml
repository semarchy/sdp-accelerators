_package: PropertyAndCasualtyInsurance.entities.CoverageCategory.forms
_type: Form
_name: CoverageCategoryForm
entity: PropertyAndCasualtyInsurance.entities.CoverageCategory.CoverageCategory
default: true
formTabs:
  - _type: FormTab
    _name: CoverageCategory
    label: Coverage Category
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: '200'
    content:
      - _type: IdField
        _name: CoverageCategoryID
        value: CoverageCategoryID
        useCustomLabel: false
        dataType: LONG_INTEGER
      - _type: TextField
        _name: CoverageCategoryName
        value: CoverageCategoryName
        useCustomLabel: false
        dataType: STRING
      - _type: TextField
        _name: Description
        value: Description
        useCustomLabel: false
        dataType: STRING
        componentProperties:
          multilineMaxLines: '3'
          multilineMinLines: '1'
          isMultiline: '1'
          multilineMaxLinesValueInterpreter: LITERAL
          multilineMinLinesValueInterpreter: LITERAL
          isMultilineValueInterpreter: LITERAL
