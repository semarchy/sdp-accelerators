_package: PropertyAndCasualtyInsurance.entities.FormEndorsement.collection_views
_type: CollectionView
_name: FormEndorsementCollectionView
entity: PropertyAndCasualtyInsurance.entities.FormEndorsement.FormEndorsement
default: true
displayCard: PropertyAndCasualtyInsurance.entities.FormEndorsement.display_cards.FormEndorsementDisplayCard
tableDisplayCardColumnWidth: 350
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Form Endorsement
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: FormEndorsementID
    value: FormEndorsementID
    useCustomLabel: false
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: FormCode
    value: FormCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    defaultWidth: 250

  - _type: ReferenceColumn
    _name: FDN_InsurancePlan
    columnAlign: LEFT
    dataType: STRING
    label: FDN Insurance Plan
    referencedEntity: PropertyAndCasualtyInsurance.entities.InsurancePlan.InsurancePlan
    useCustomLabel: true
    value: FDN_InsurancePlan
    visibleByDefault: true
    defaultWidth: 350
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '350'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
  - _type: TextColumn
    _name: FormNumber
    value: FormNumber
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    defaultWidth: 300
  - _type: MenuColumn
    _name: FormType
    value: FormType
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    defaultWidth: 200
    componentProperties:
      useAvatarInMenu: '1'
      useAvatarInMenuValueInterpreter: LITERAL
  - _type: TextColumn
    _name: EditionDate
    value: EditionDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: JurisdictionState
    value: JurisdictionState
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: EffectiveFrom
    value: EffectiveFrom
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: EffectiveTo
    value: EffectiveTo
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: CheckboxColumn
    _name: ActiveFlag
    value: ActiveFlag
    useCustomLabel: false
    dataType: BOOLEAN
    columnAlign: LEFT
    visibleByDefault: true
