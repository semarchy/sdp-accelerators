_package: PropertyAndCasualtyInsurance.entities.FormEndorsement.forms
_type: Form
_name: FormEndorsementDEForm
entity: PropertyAndCasualtyInsurance.entities.FormEndorsement.FormEndorsement
default: true
description: Form for browsing form endorsements
formTabs:
  - _type: FormTab
    _name: General
    label: Form Endorsement
    iconUrl: images://mdi/file-document-outline.svg
    documentation: This form provides a comprehensive view of form endorsement details.
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: GeneralContainer01
        content:
          - _type: FormContainer
            _name: GeneralContainer01A
            content:
              - _type: IdField
                _name: FormEndorsementID
                dataType: LONG_INTEGER
                useCustomLabel: false
                value: FormEndorsementID
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: FormCode
                dataType: STRING
                useCustomLabel: false
                value: FormCode
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: FormTitle
                dataType: STRING
                useCustomLabel: false
                value: FormTitle
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: ReferenceField
                _name: FDN_InsurancePlan
                dataType: STRING
                referencedEntity: PropertyAndCasualtyInsurance.entities.InsurancePlan.InsurancePlan
                useCustomLabel: false
                value: FDN_InsurancePlan
                componentProperties:
                  textAlign: left
                  displayType: chip
                  displayTypeValueInterpreter: LITERAL
                  chipMaxWidth: '300'
                  chipMaxWidthValueInterpreter: LITERAL
                  useAvatarInChip: '1'
                  useAvatarInChipValueInterpreter: LITERAL
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
            layoutDirection: COLUMN
          - _type: FormContainer
            _name: GeneralContainer01B
            content:
              - _type: TextField
                _name: FormNumber
                dataType: STRING
                useCustomLabel: false
                value: FormNumber
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: MenuField
                _name: FormType
                dataType: STRING
                useCustomLabel: false
                value: FormType
                componentProperties:
                  textAlign: left
                  useAvatarInMenu: '1'
                  useAvatarInMenuValueInterpreter: LITERAL
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: DateField
                _name: EditionDate
                dataType: DATE
                useCustomLabel: false
                value: EditionDate
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: TextField
                _name: JurisdictionState
                dataType: STRING
                useCustomLabel: false
                value: JurisdictionState
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
            layoutDirection: COLUMN
          - _type: FormContainer
            _name: GeneralContainer01C
            content:
              - _type: DateField
                _name: EffectiveFrom
                dataType: DATE
                useCustomLabel: false
                value: EffectiveFrom
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: DateField
                _name: EffectiveTo
                dataType: DATE
                useCustomLabel: false
                value: EffectiveTo
                componentProperties:
                  textAlign: left
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
              - _type: CheckboxField
                _name: ActiveFlag
                dataType: BOOLEAN
                useCustomLabel: false
                value: ActiveFlag
                componentProperties:
                  useSwitch: '1'
                  useSwitchValueInterpreter: LITERAL
                labelProperties:
                  alignment: left
                  position: top
                  typography: caption
                  authoringLabelPosition: top
                  authoringLabelPositionValueInterpreter: LITERAL
            layoutDirection: COLUMN
        layoutDirection: ROW
