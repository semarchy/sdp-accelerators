_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.FormEndorsement.validations
entity: PropertyAndCasualtyInsurance.entities.FormEndorsement.FormEndorsement
label: Date Range Check
condition: EffectiveFrom <= EffectiveTo
validationScope: PRE_CONSO
description: Checks that the EffectiveFrom date is less than or equal to the EffectiveTo date for a Form Endorsement entity.
validationLabel: EffectiveTo must be greater than or equal to EffectiveFrom