_package: PropertyAndCasualtyInsurance.entities.FoundationType.forms
_type: Form
_name: FoundationTypeForm
entity: PropertyAndCasualtyInsurance.entities.FoundationType.FoundationType
default: true
formTabs:
  - _type: FormTab
    _name: FoundationType
    label: "Foundation Type"
    iconUrl: images://mdi/home-floor-b.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: FoundationTypeSection1
        label: "Foundation Type Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: FoundationTypeSection1Row
            content:
              - _type: FormContainer
                _name: FoundationTypeSection1Col1
                content:
                  - _type: IdField
                    _name: FoundationTypeID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: FoundationTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FoundationTypeCode
                    dataType: STRING
                    useCustomLabel: false
                    value: FoundationTypeCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: FoundationTypeName
                    dataType: STRING
                    useCustomLabel: false
                    value: FoundationTypeName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: FoundationTypeSection1Col2
                content:
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
