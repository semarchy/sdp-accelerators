_package: PropertyAndCasualtyInsurance.entities.InsuranceProduct.forms
_type: Form
_name: InsuranceProductDEForm
entity: PropertyAndCasualtyInsurance.entities.InsuranceProduct.InsuranceProduct
default: true
description: Form for browsing insurance products
formTabs:
  - _type: FormTab
    _name: General
    label: General Details
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
          - _type: FormContainer
            _name: GeneralContainer01
            content:
              - _type: FormContainer
                _name: GeneralContainer01A
                content:
                  - _type: IdField
                    _name: InsuranceProductID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: InsuranceProductID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ProductCode
                    dataType: STRING
                    useCustomLabel: false
                    value: ProductCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ProductName
                    dataType: STRING
                    useCustomLabel: false
                    value: ProductName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: GeneralContainer01B
                content:
                  - _type: TextField
                    _name: ProductDescription
                    dataType: LONG_TEXT
                    useCustomLabel: false
                    value: ProductDescription
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ProductStatus
                    dataType: STRING
                    useCustomLabel: false
                    value: ProductStatus
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: ReferenceField
                    _name: FDN_LOB
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.LineOfBusiness.LineOfBusiness
                    useCustomLabel: false
                    value: FDN_LineOfBusiness
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '300'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: GeneralContainer01C
                content:
                  - _type: DateField
                    _name: EffectiveFrom
                    dataType: DATE
                    useCustomLabel: false
                    value: EffectiveFrom
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: DateField
                    _name: EffectiveTo
                    dataType: DATE
                    useCustomLabel: false
                    value: EffectiveTo
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW

