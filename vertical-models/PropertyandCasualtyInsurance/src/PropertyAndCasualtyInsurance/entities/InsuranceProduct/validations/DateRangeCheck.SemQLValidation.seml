_name: DateRangeCheck
_type: SemQLValidation
_package: PropertyAndCasualtyInsurance.entities.InsuranceProduct.validations
entity: PropertyAndCasualtyInsurance.entities.InsuranceProduct.InsuranceProduct
label: Date Range Check
condition: EffectiveFrom <= EffectiveTo
validationScope: PRE_CONSO
description: Checks that the EffectiveFrom date is less than or equal to the EffectiveTo date for an Insurance Product entity.
validationLabel: EffectiveTo must be greater than or equal to EffectiveFrom