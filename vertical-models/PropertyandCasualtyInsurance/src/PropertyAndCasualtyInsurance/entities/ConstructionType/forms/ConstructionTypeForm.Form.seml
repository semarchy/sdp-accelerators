_package: PropertyAndCasualtyInsurance.entities.ConstructionType.forms
_type: Form
_name: ConstructionTypeForm
entity: PropertyAndCasualtyInsurance.entities.ConstructionType.ConstructionType
default: true
formTabs:
  - _type: FormTab
    _name: ConstructionType
    label: "Construction Type"
    iconUrl: images://mdi/home-floor-1.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: ConstructionTypeSection1
        label: "Construction Type Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: ConstructionTypeSection1Row
            content:
              - _type: FormContainer
                _name: ConstructionTypeSection1Col1
                content:
                  - _type: IdField
                    _name: ConstructionTypeID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: ConstructionTypeID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ConstructionTypeCode
                    dataType: STRING
                    useCustomLabel: false
                    value: ConstructionTypeCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: ConstructionTypeName
                    dataType: STRING
                    useCustomLabel: false
                    value: ConstructionTypeName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: ConstructionTypeSection1Col2
                content:
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
