_package: PropertyAndCasualtyInsurance.entities.AssetStatus.forms
_type: Form
_name: AssetStatusForm
entity: PropertyAndCasualtyInsurance.entities.AssetStatus.AssetStatus
default: true
formTabs:
  - _type: FormTab
    _name: AssetStatus
    label: "Asset Status"
    iconUrl: images://mdi/list-status.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: AssetStatusSection1
        label: "Asset Status Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: AssetStatusSection1Row
            content:
              - _type: FormContainer
                _name: AssetStatusSection1Col1
                content:
                  - _type: IdField
                    _name: AssetStatusID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: AssetStatusID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AssetStatusCode
                    dataType: STRING
                    useCustomLabel: false
                    value: AssetStatusCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: AssetStatusName
                    dataType: STRING
                    useCustomLabel: false
                    value: AssetStatusName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: AssetStatusSection1Col2
                content:
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
