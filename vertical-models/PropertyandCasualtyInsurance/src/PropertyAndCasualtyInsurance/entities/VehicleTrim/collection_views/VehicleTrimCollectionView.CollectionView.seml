_package: PropertyAndCasualtyInsurance.entities.VehicleTrim.collection_views
_type: CollectionView
_name: VehicleTrimCollectionView
entity: PropertyAndCasualtyInsurance.entities.VehicleTrim.VehicleTrim
default: true
displayCard: PropertyAndCasualtyInsurance.entities.VehicleTrim.display_cards.VehicleTrimDisplayCard
tableDisplayCardColumnWidth: 300
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: "Vehicle Trim"
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: VehicleTrimID
    value: VehicleTrimID
    useCustomLabel: false
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: TrimCode
    value: TrimCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    defaultWidth: 200
  - _type: TextColumn
    _name: TrimName
    value: TrimName
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    defaultWidth: 200
  - _type: TextColumn
    _name: Description
    value: Description
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    defaultWidth: 500
  - _type: ReferenceColumn
    _name: FID_Model
    columnAlign: LEFT
    dataType: STRING
    label: "Model"
    referencedEntity: PropertyAndCasualtyInsurance.entities.VehicleModel.VehicleModel
    useCustomLabel: true
    value: FDN_Model
    visibleByDefault: true
    defaultWidth: 240
    componentProperties:
      displayType: chip
      displayTypeValueInterpreter: LITERAL
      chipMaxWidth: '240'
      chipMaxWidthValueInterpreter: LITERAL
      useAvatarInChip: '1'
      useAvatarInChipValueInterpreter: LITERAL
