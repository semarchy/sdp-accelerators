_package: PropertyAndCasualtyInsurance.entities.VehicleTrim.forms
_type: Form
_name: VehicleTrimForm
entity: PropertyAndCasualtyInsurance.entities.VehicleTrim.VehicleTrim
default: true
formTabs:
  - _type: FormTab
    _name: VehicleTrim
    label: "Vehicle Trim"
    iconUrl: images://mdi/car-info.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: VehicleTrimSection1
        label: "Trim Reference"
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        content:
          - _type: FormContainer
            _name: VehicleTrimSection1Row
            content:
              - _type: FormContainer
                _name: VehicleTrimSection1Col1
                content:
                  - _type: IdField
                    _name: VehicleTrimID
                    dataType: LONG_INTEGER
                    useCustomLabel: false
                    value: VehicleTrimID
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TrimCode
                    dataType: STRING
                    useCustomLabel: false
                    value: TrimCode
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: TrimName
                    dataType: STRING
                    useCustomLabel: false
                    value: TrimName
                    componentProperties:
                      textAlign: left
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
              - _type: FormContainer
                _name: VehicleTrimSection1Col2
                content:
                  - _type: ReferenceField
                    _name: FDN_Model
                    dataType: STRING
                    referencedEntity: PropertyAndCasualtyInsurance.entities.VehicleModel.VehicleModel
                    useCustomLabel: false
                    value: FDN_Model
                    componentProperties:
                      textAlign: left
                      displayType: chip
                      displayTypeValueInterpreter: LITERAL
                      chipMaxWidth: '260'
                      chipMaxWidthValueInterpreter: LITERAL
                      useAvatarInChip: '1'
                      useAvatarInChipValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                  - _type: TextField
                    _name: Description
                    dataType: STRING
                    useCustomLabel: false
                    value: Description
                    componentProperties:
                      textAlign: left
                      isMultiline: '1'
                      isMultilineValueInterpreter: LITERAL
                      multilineMaxLines: '3'
                      multilineMaxLinesValueInterpreter: LITERAL
                    labelProperties:
                      alignment: left
                      position: top
                      typography: caption
                layoutDirection: COLUMN
            layoutDirection: ROW
        layoutDirection: COLUMN
