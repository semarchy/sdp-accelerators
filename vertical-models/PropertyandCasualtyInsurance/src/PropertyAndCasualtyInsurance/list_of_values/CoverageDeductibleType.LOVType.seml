_name: CoverageDeductibleType
_type: LOVType
_package: PropertyAndCasualtyInsurance.list_of_values
description: "List of values defining default deductible structures for coverage definitions."
label: Coverage Deductible Type
validationLabel: Incorrect Coverage Deductible Type
length: 128
lovValues:
  - label: Flat
    code: FLAT
    imageUrl: images://mdi/currency-usd.svg
    description: "A fixed deductible amount is applied per covered claim."
  - label: Percentage
    code: PERCENTAGE
    imageUrl: images://mdi/percent.svg
    description: "Deductible is calculated as a percentage of insured value or loss amount."
  - label: Franchise
    code: FRANCHISE
    imageUrl: images://mdi/filter-variant-remove.svg
    description: "No deductible applies once the loss exceeds a defined threshold."
