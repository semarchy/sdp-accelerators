_name: CoverageLimitType
_type: LOVType
_package: PropertyAndCasualtyInsurance.list_of_values
description: "List of values defining default coverage limit structures."
label: Coverage Limit Type
validationLabel: Incorrect Coverage Limit Type
length: 128
lovValues:
  - label: Per Occurrence
    code: PER_OCCURRENCE
    imageUrl: images://mdi/scale-balance.svg
    description: "Limit applies separately to each covered occurrence."
  - label: Aggregate
    code: AGGREGATE
    imageUrl: images://mdi/sigma.svg
    description: "Limit applies to the cumulative total across occurrences during the policy period."
  - label: Combined Single Limit
    code: COMBINED_SINGLE_LIMIT
    imageUrl: images://mdi/vector-union.svg
    description: "One unified limit applies across multiple damage or liability components."
