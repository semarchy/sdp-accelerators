_package: PropertyAndCasualtyInsurance.list_of_values
_name: RatingMethod
_type: LOVType
description: "List of values defining the method used to compute premium for a rating plan."
label: Rating Method
validationLabel: Incorrect Rating Method
length: 128
lovValues:
  - label: Table Driven
    code: TABLE_DRIVEN
    description: Premium is determined based on predefined tables that correlate various factors to premium amounts.
    imageUrl: images://mdi/table.svg
  - label: Formula Based
    code: FORMULA_BASED
    description: Premium is calculated using specific mathematical formulas that take into account various rating factors.
    imageUrl: images://mdi/calculator.svg
  - label: External Engine
    code: EXTERNAL_ENGINE
    description: Premium is determined by an external rating engine or service, which may use complex algorithms and data inputs.
    imageUrl: images://mdi/cloud-sync.svg
