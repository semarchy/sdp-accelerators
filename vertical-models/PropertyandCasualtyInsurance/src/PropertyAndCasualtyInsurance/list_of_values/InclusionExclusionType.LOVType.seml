_name: InclusionExclusionType
_type: LOVType
_package: PropertyAndCasualtyInsurance.list_of_values
description: "List of Values for Inclusion and Exclusion types used in insurance clauses."
label: Inclusion Exclusion Type
validationLabel: Incorrect Inclusion Exclusion Type
length: 128
lovValues:
  - label: Inclusion
    code: INCLUSION
    imageUrl: images://mdi/shield-plus.svg
    description: "Indicates that the clause expands coverage, adding specific protections or benefits to the insurance policy."
  - label: Exclusion
    code: EXCLUSION
    imageUrl: images://mdi/shield-off.svg
    description: "Indicates that the clause restricts coverage, removing specific protections or benefits from the insurance policy."