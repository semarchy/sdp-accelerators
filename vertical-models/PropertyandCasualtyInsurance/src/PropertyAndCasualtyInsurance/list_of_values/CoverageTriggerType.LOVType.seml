_name: CoverageTriggerType
_type: LOVType
_package: PropertyAndCasualtyInsurance.list_of_values
description: "List of values defining claim trigger mechanisms for line of coverage records."
label: Coverage Trigger Type
validationLabel: Incorrect Coverage Trigger Type
length: 64
lovValues:
  - label: Occurrence
    code: OCCURRENCE
    imageUrl: images://mdi/timelapse.svg
    description: "Coverage responds based on when the loss event occurred during the policy period."
  - label: Claims Made
    code: CLAIMS_MADE
    imageUrl: images://mdi/file-clock-outline.svg
    description: "Coverage responds based on when the claim is made and reported, subject to retroactive terms."
  - label: Discovery
    code: DISCOVERY
    imageUrl: images://mdi/magnify-scan.svg
    description: "Coverage includes a discovery period allowing claims to be reported after policy expiration."
