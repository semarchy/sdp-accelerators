_package: PropertyAndCasualtyInsurance.list_of_values
_name: FormEndorsementType
_type: LOVType
description: "List of values classifying policy forms and endorsements."
label: Form Endorsement Type
validationLabel: Incorrect Form Endorsement Type
length: 128
lovValues:
  - label: Coverage Form
    code: COVERAGE_FORM
    description: A form that defines the coverage provided by an insurance policy.
    imageUrl: images://mdi/document.svg
  - label: Endorsement
    code: ENDORSEMENT
    description: A modification to an insurance policy that changes the terms or coverage.
    imageUrl: images://mdi/stamper.svg
  - label: Notice
    code: NOTICE
    description: A formal communication regarding an insurance policy.
    imageUrl: images://mdi/alert-circle.svg
  - label: Other
    code: OTHER
    description: Any other type of form or endorsement not categorized above.
    imageUrl: images://mdi/checkbox-blank-outline.svg
