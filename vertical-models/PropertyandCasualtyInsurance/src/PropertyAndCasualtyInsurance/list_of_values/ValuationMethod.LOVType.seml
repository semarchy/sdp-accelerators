_name: ValuationMethod
_type: LOVType
_package: PropertyAndCasualtyInsurance.list_of_values
description: "List of values defining claim settlement valuation methodologies for line of coverage records."
label: Valuation Method
validationLabel: Incorrect Valuation Method
length: 64
lovValues:
  - label: Actual Cash Value
    code: ACTUAL_CASH_VALUE
    imageUrl: images://mdi/cash-usd-outline.svg
    description: "Settlement is based on replacement cost less depreciation at the time of loss."
  - label: Replacement Cost
    code: REPLACEMENT_COST
    imageUrl: images://mdi/home-edit-outline.svg
    description: "Settlement is based on the current cost to repair or replace with like kind and quality."
  - label: Agreed Value
    code: AGREED_VALUE
    imageUrl: images://mdi/handshake-outline.svg
    description: "Settlement is based on a pre-agreed insured value documented in the policy terms."
  - label: Stated Amount
    code: STATED_AMOUNT
    imageUrl: images://mdi/text-box-check-outline.svg
    description: "Settlement is based on the stated amount, subject to policy conditions and actual loss."
