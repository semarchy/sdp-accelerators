_package: PropertyAndCasualtyInsurance.list_of_values
_name: RegulatoryTestSeverity
_type: LOVType
description: "List of values defining enforcement severity for regulatory test failures."
label: Regulatory Test Severity
validationLabel: Incorrect Regulatory Test Severity
length: 128
lovValues:
  - label: Warning
    code: WARNING
    description: A regulatory test failure that indicates a potential issue but does not prevent further processing.
    imageUrl: images://mdi/alert-outline.svg
  - label: Error
    code: ERROR
    description: A regulatory test failure that indicates a significant issue that may prevent further processing.
    imageUrl: images://mdi/comment-remove-outline.svg
  - label: Blocking
    code: BLOCKING
    description: A regulatory test failure that indicates a critical issue that must be resolved before further processing can continue.
    imageUrl: images://mdi/block-helper.svg
