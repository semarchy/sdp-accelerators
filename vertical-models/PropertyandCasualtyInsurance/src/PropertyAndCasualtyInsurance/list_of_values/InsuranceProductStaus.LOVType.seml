_package: PropertyAndCasualtyInsurance.list_of_values
_name: InsuranceProductStaus
_type: LOVType
description: Current lifecycle state of the product (e.g., Active, Retired, Suspended).
label: Insurance Product Status
length: 128
lovValues:
  - label: Active
    code: ACTIVE
    description: "Plan is currently active and available for new business and renewals."
    imageUrl: images://mdi/checkbox-marked-circle-outline.svg
  - label: Retired
    code: RETIRED
    description: "Plan has been retired and is no longer available for new business, but existing policies may still be in force."
    imageUrl: images://mdi/close-circle-outline.svg
  - label: Suspended
    code: SUSPENDED
    description: "Plan is temporarily suspended and not available for new business or renewals, but existing policies may still be in force."
    imageUrl: images://mdi/pause-circle-outline.svg
