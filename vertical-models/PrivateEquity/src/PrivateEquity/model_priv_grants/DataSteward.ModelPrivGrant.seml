_name: DataSteward
_package: PrivateEquity.model_priv_grants
_type: ModelPrivGrant
allowApiPublishingAsUser: false
allowDataQualityDocumentation: false
allowEnrichmentDocumentation: false
dataAdminRole: false
integrationWsRole: false
label: Data Steward
roleName: DataSteward
description: Data Steward role for initiating portfolio assignment change requests and maintaining the portfolio legal entity relationship used by the demo workflow.
entityPrivGrants:
  - _type: EntityPrivGrant
    entity: PrivateEquity.entities.PortfolioLegalEntity.PortfolioLegalEntity
    _name: PortfolioLegalEntity
    checkoutAllowed: true
    createAllowed: true
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
    defaultAccessType: READ_WRITE
  - _type: EntityPrivGrant
    entity: PrivateEquity.entities.Portfolio.Portfolio
    _name: Portfolio
    checkoutAllowed: false
    createAllowed: false
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
    defaultAccessType: READ
  - _type: EntityPrivGrant
    entity: PrivateEquity.entities.LegalEntity.LegalEntity
    _name: LegalEntity
    checkoutAllowed: false
    createAllowed: false
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
    defaultAccessType: READ
  - _type: EntityPrivGrant
    entity: PrivateEquity.entities.EntityRole.EntityRole
    _name: EntityRole
    checkoutAllowed: false
    createAllowed: false
    deleteAllowed: false
    exportAllowed: true
    removeAllowed: false
    defaultAccessType: READ
