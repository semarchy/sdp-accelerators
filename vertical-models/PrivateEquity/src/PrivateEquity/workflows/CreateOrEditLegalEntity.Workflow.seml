_name: CreateOrEditLegalEntity
_package: PrivateEquity.workflows
_type: Workflow
label: Legal Entity Workflow
generalProperties:
  attachmentMimeTypes: "*"
  attachmentMaxFileCount: 5
  attachmentMaxFileSize: 10000
notifications:
  workflowAdminOnDueDate: false
dataScope:
  - _name: LegalEntity
    _type: RootEntity
    cardinality: SINGLE_RECORD
    displayCard: PrivateEquity.entities.LegalEntity.display_cards.LegalEntityDisplayCard
    entity: PrivateEquity.entities.LegalEntity.LegalEntity
    childEntities:
      - ref: PrivateEquity.references.NamesNameType
      - ref: PrivateEquity.references.DocumentsLegalEntity
      - ref: PrivateEquity.references.ToRelationship
retentionPolicy:
  retentionTimeUnit: DAYS
  retentionType: FOREVER
steps:
  - _name: StartCreate
    _type: StartFromEmptySelectionEvent
    defaultPriority: NORMAL
    position:
      x: -400
      y: -110
    label: Start Create
    transition:
      _name: outgoing
      _type: StartEventTransition
      toStep: PrivateEquity.workflows.CreateOrEditLegalEntity.NewLegalEntity
      bendPoints: []
    startupParameters:
      attachmentParamRequired: false
      attachmentParamSupported: true
      commentParamRequired: false
      commentParamSupported: true
      descriptionParamSupported: true
      dueDateParamRequired: false
      dueDateParamSupported: true
      nextTaskAssigneeRequired: false
      nextTaskAssigneeSupported: false
      priorityParamSupported: true
      showWaitDialog: true
  - _name: StartEdit
    _type: StartFromSelectionEvent
    defaultPriority: NORMAL
    position:
      x: -390
      y: 50
    label: Start Edit
    selectionSourceType: GOLDEN_DATA
    transition:
      _name: outgoing
      _type: StartEventTransition
      toStep: PrivateEquity.workflows.CreateOrEditLegalEntity.EditLegalEntity
      bendPoints: []
    startupParameters:
