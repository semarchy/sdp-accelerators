      toCandidatesOrAssignee: false
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    taskType: DATA_AUTHORING
    application: PrivateEquity.applications.PrivateEquity
    assigneeCondition: Username = StepInstance.WorkflowInstance.InitiatorName
    assigneeRequiredRole: Legal
    entity: PrivateEquity.entities.LegalEntity.LegalEntity
    stepper: PrivateEquity.entities.LegalEntity.steppers.Workflowstep1Legal
    transitions:
      - _name: PublishDraft
        _type: UserTaskTransition
        label: Publish Draft
