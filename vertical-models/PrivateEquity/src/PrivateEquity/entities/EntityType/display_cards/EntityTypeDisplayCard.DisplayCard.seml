_name: EntityTypeDisplayCard
_package: PrivateEquity.entities.EntityType.display_cards
_type: DisplayCard
entity: PrivateEquity.entities.EntityType.EntityType
default: true
primaryTextExpression: EntityType
primaryImageValue: images://mdi/account-question-outline.svg
primaryImageValueInterpreter: LITERAL
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValue: |-
  CASE 
  WHEN EntityType = 'Individual' THEN 'images://mdi/person-box.svg'
  ELSE 'images://mdi/office-building.svg'
  END
avatarImageValueInterpreter: SEMQL
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
