_package: PrivateEquity.entities.PortfolioLegalEntity.forms
_type: Form
_name: PortfolioChangeApprovalForm
entity: PrivateEquity.entities.PortfolioLegalEntity.PortfolioLegalEntity
default: false
formTabs:
  - _name: PortfolioChangeApproval
    _type: FormTab
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    label: Portfolio Change
    displayFormTabAs: LABEL
    content:
      - _type: FormContainer
        _name: Container
        layoutDirection: ROW
        content:
          - _type: FormSection
            _name: CurrentAssignment
            label: Current Assignment
            layoutDirection: COLUMN
            documentationInterpreter: LITERAL
            visibleValue: "1"
            visibleValueInterpreter: LITERAL
            content:
              - _name: GoldenRecord_FDN_LegalEntity
                label: Investment Vehicle
                value: GoldenRecord.FDN_LegalEntity
                dataType: STRING
                useCustomLabel: true
                documentationInterpreter: LITERAL
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                referencedEntity: PrivateEquity.entities.LegalEntity.LegalEntity
                _type: ReferenceField
                authoringMode: READ_ONLY
                authoringModeValueInterpreter: LITERAL
                componentProperties:
                  textAlign: left
                  textAlignValueInterpreter: LITERAL
                  textTypography: body-1
                  textTypographyValueInterpreter: LITERAL
                  displayType: hyperlink
                  displayTypeValueInterpreter: LITERAL
                labelProperties:
                  position: left
                  positionValueInterpreter: LITERAL
                  alignment: right
                  alignmentValueInterpreter: LITERAL
                  typography: caption
                  typographyValueInterpreter: LITERAL
                  isVisible: "1"
                  isVisibleValueInterpreter: LITERAL
