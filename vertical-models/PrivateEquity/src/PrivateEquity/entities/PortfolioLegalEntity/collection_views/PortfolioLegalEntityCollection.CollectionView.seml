_package: PrivateEquity.entities.PortfolioLegalEntity.collection_views
_name: PortfolioLegalEntityCollection
_type: CollectionView
entity: PrivateEquity.entities.PortfolioLegalEntity.PortfolioLegalEntity
default: true
displayCard: PrivateEquity.entities.PortfolioLegalEntity.display_cards.PortfolioLegalEntityDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Portfolio Legal Entity
tableShowDisplayCard: true
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: true
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: ID
    visibleByDefault: false
  - _type: ReferenceColumn
    _name: FDN_Portfolio
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_Portfolio
    visibleByDefault: true
    referencedEntity: PrivateEquity.entities.Portfolio.Portfolio
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FDN_EntityRole
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_EntityRole
    visibleByDefault: true
    referencedEntity: PrivateEquity.entities.EntityRole.EntityRole
    componentProperties:
      textColor: case when FDN_EntityRole = 'Manager' then 'md:red' else 'md:green' end
      textColorValueInterpreter: SEMQL
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FDN_LegalEntity
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_LegalEntity
    visibleByDefault: true
    referencedEntity: PrivateEquity.entities.LegalEntity.LegalEntity
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
