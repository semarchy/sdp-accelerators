_name: PortfolioLegalEntityActionSet
_package: PrivateEquity.entities.PortfolioLegalEntity.action_sets
_type: ActionSet
entity: PrivateEquity.entities.PortfolioLegalEntity.PortfolioLegalEntity
label: Portfolio Legal Entity Action Set
defaultActionSet: true
actions:
  - _name: RequestPortfolioChange
    _type: StartWorkflowEntityAction
    label: Request Portfolio Change
    useCustomLabel: true
    waitDialogEnabled: false
    workflow: PrivateEquity.workflows.PortfolioChangeApproval
    startEvent: PrivateEquity.workflows.PortfolioChangeApproval.StartPortfolioChange
  - _name: CreateAuthorPortfolioLegalEntities
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.PortfolioLegalEntity.steppers.AuthorPortfolioLegalEntities
  - _name: EditAuthorPortfolioLegalEntities
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: PrivateEquity.entities.PortfolioLegalEntity.steppers.AuthorPortfolioLegalEntities
  - _name: MassUpdateAuthorPortfolioLegalEntities
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: PrivateEquity.entities.PortfolioLegalEntity.steppers.AuthorPortfolioLegalEntities
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorPortfolioLegalEntities
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.PortfolioLegalEntity.steppers.AuthorPortfolioLegalEntities
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
