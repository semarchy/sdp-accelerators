      enabledOnParentCreate: true
      enabledOnParentEdit: true
      enableMasterValuePicking: false
      formFieldsMode: AUTO
      label: Portfolio Change
      formTab: PrivateEquity.entities.PortfolioLegalEntity.forms.PortfolioChangeApprovalForm.PortfolioChangeApproval
      formStepEnrichers: []
      referenceFormFieldConfigs:
