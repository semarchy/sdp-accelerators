      validationType: FOREIGN
      attribute: PrivateEquity.references.PortfolioLegalEntitiesPortfolio.Portfolio
    - onStepExit: WARN
      validationType: FOREIGN
      attribute: PrivateEquity.references.PortfolioLegalEntitiesLegalEntity.LegalEntity
