          attribute: PrivateEquity.references.PortfolioLegalEntitiesPortfolio.Portfolio
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: FOREIGN
          attribute: PrivateEquity.references.PortfolioLegalEntitiesLegalEntity.LegalEntity
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: FOREIGN
          attribute: PrivateEquity.references.PortfolioLegalEntitiesEntityRole.EntityRole
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: MANDATORY
          attribute: PrivateEquity.references.PortfolioLegalEntitiesPortfolio.Portfolio
          executedOnDataChange: true
          executedOnFormOpen: true
        - validationType: MANDATORY
          attribute: PrivateEquity.references.PortfolioLegalEntitiesLegalEntity.LegalEntity
          executedOnDataChange: true
          executedOnFormOpen: true
      stepTransitionValidations:
        - onStepExit: WARN
          validationType: FOREIGN
          attribute: PrivateEquity.references.PortfolioLegalEntitiesPortfolio.Portfolio
        - onStepExit: WARN
          validationType: FOREIGN
          attribute: PrivateEquity.references.PortfolioLegalEntitiesLegalEntity.LegalEntity
        - onStepExit: WARN
          validationType: FOREIGN
          attribute: PrivateEquity.references.PortfolioLegalEntitiesEntityRole.EntityRole
        - onStepExit: WARN
          validationType: MANDATORY
          attribute: PrivateEquity.references.PortfolioLegalEntitiesPortfolio.Portfolio
        - onStepExit: WARN
          validationType: MANDATORY
          attribute: PrivateEquity.references.PortfolioLegalEntitiesLegalEntity.LegalEntity
      stepTriggers: []
label: Approve Portfolio Change
stepperFinishValidations:
