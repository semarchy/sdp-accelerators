_package: PrivateEquity.entities.Fund.collection_views
_name: FundCollection
_type: CollectionView
entity: PrivateEquity.entities.Fund.Fund
default: true
displayCard: PrivateEquity.entities.Fund.display_cards.FundDisplayCard
tableAllowed: true
tableRowLines: 1
tableDisplayCardColumnLabel: Fund
tableShowDisplayCard: true
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: true
listShowDivider: true
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ID
    columnAlign: LEFT
    dataType: INTEGER
    useCustomLabel: false
    value: ID
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_Portfolio
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_Portfolio
    visibleByDefault: true
    referencedEntity: PrivateEquity.entities.Portfolio.Portfolio
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Name
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Name
    visibleByDefault: true
  - _type: TextColumn
    _name: ChainID
    columnAlign: LEFT
    dataType: INTEGER
    useCustomLabel: false
    value: ChainID
    visibleByDefault: true
    componentProperties:
      displayFormat: "#####"
      displayFormatValueInterpreter: LITERAL
  - _type: TextColumn
    _name: Description
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Description
    visibleByDefault: true
