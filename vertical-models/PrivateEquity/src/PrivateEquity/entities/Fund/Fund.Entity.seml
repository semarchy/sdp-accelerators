_name: Fund
_package: PrivateEquity.entities.Fund
_type: Entity
primaryKey: PrivateEquity.entities.Fund.Fund.ID
sourceIdGeneration:
  mode: MANUAL
label: Fund
description: "Represents an investment fund used to organize portfolios and related legal entities."
documentation: "Private equity companies offer various investment products to their investors, with the most common being funds. A fund is a pooled investment vehicle that allows investors to pool their capital together, which is then managed by the private equity firm. These funds serve as investment vehicles through which the firm invests in various assets such as private companies, real estate, or other alternative investments."
enableDelete: true
entityType: BASIC
iconUrl: images://mdi/ungroup.svg
pluralLabel: Funds
