_package: PrivateEquity.entities.Document.collection_views
_name: DocumentCollection
_type: CollectionView
entity: PrivateEquity.entities.Document.Document
default: true
displayCard: PrivateEquity.entities.Document.display_cards.DocumentDisplayCard
tableAllowed: true
tableRowLines: 1
tableDisplayCardColumnLabel: Document
tableShowDisplayCard: true
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: true
listShowDivider: true
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: ID
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_Form
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_Form
    visibleByDefault: true
    referencedEntity: PrivateEquity.entities.Form.Form
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: ReferenceColumn
    _name: FDN_LegalEntity
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_LegalEntity
    visibleByDefault: true
    referencedEntity: PrivateEquity.entities.LegalEntity.LegalEntity
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: TextColumn
    _name: DueDate
    columnAlign: LEFT
    dataType: DATE
    useCustomLabel: false
    value: DueDate
    visibleByDefault: true
  - _type: TextColumn
    _name: URL
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: URL
    visibleByDefault: true
