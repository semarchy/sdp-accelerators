_name: DocumentActionSet
_package: PrivateEquity.entities.Document.action_sets
_type: ActionSet
entity: PrivateEquity.entities.Document.Document
label: Document Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorDocuments
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: true
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.Document.steppers.AuthorDocuments
  - _name: EditAuthorDocuments
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: PrivateEquity.entities.Document.steppers.AuthorDocuments
  - _name: MassUpdateAuthorDocuments
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: PrivateEquity.entities.Document.steppers.AuthorDocuments
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorDocuments
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.Document.steppers.AuthorDocuments
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
