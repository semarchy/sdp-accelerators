_name: GroupHierarchyActionSet
_package: PrivateEquity.entities.GroupHierarchy.action_sets
_type: ActionSet
entity: PrivateEquity.entities.GroupHierarchy.GroupHierarchy
label: Group Hierarchy Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorGroupHierarchies
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.GroupHierarchy.steppers.AuthorGroupHierarchies
  - _name: EditAuthorGroupHierarchies
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: PrivateEquity.entities.GroupHierarchy.steppers.AuthorGroupHierarchies
  - _name: MassUpdateAuthorGroupHierarchies
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: PrivateEquity.entities.GroupHierarchy.steppers.AuthorGroupHierarchies
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorGroupHierarchies
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.GroupHierarchy.steppers.AuthorGroupHierarchies
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
