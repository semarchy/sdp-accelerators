_package: PrivateEquity.entities.Portfolio.collection_views
_name: PortfolioCollection
_type: CollectionView
entity: PrivateEquity.entities.Portfolio.Portfolio
default: true
displayCard: PrivateEquity.entities.Portfolio.display_cards.PortfolioDisplayCard
tableAllowed: true
tableRowLines: 1
tableDisplayCardColumnLabel: Portfolio
tableShowDisplayCard: true
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: true
listShowDivider: true
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: ID
    visibleByDefault: true
  - _type: TextColumn
    _name: Name
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Name
    visibleByDefault: true
  - _type: TextColumn
    _name: Description
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Description
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_Fund
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_Fund
    visibleByDefault: true
    referencedEntity: PrivateEquity.entities.Fund.Fund
    componentProperties:
      displayType: hyperlink
      displayTypeValueInterpreter: LITERAL
  - _type: TextColumn
    _name: ChainID
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: ChainID
    visibleByDefault: true
  - _type: ReferenceColumn
    _name: FDN_Industry
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_Industry
    visibleByDefault: true
