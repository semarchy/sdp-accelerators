_name: Portfolio
_package: PrivateEquity.entities.Portfolio.business_views
_type: BusinessView
displayRootNodeAs: ICON_LABEL
enableHierarchyView: true
entity: PrivateEquity.entities.Portfolio.Portfolio
rootLabel: Portfolio
rootPluralLabel: Portfolioes
useHierarchyOnOpen: false
label: Portfolioes
rootBusinessViewEntity:
  _name: PortfolioEO
  _type: BusinessViewEntity
  collection: PrivateEquity.entities.Portfolio.collection_views.PortfolioCollection
  displayRecordCount: ALWAYS
  enableUserDefinedSort: true
  entity: PrivateEquity.entities.Portfolio.Portfolio
  form: PrivateEquity.entities.Portfolio.forms.PortfolioForm
  gridAllowed: true
  listAllowed: true
  outlineVisible: false
  overrideDefaultSort: true
  sortExpression: Name ASC
  tableAllowed: true
  actionSet: PrivateEquity.entities.Portfolio.action_sets.PortfolioActionSet
  businessEntityBuiltInFilters: []
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
      enabled: true
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
      enabled: true
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
      enabled: true
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
      enabled: true
  embeddedCollectionNavigations: []
  referenceAttributeNavigationConfigs: []
  transitions:
    - _name: PortfolioLegalEntities
      _type: BusinessViewTransition
      transitionPath: PortfolioLegalEntities
      transitionType: FULLY_QUALIFIED
      useCustomLabel: true
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: "0"
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/ungroup.svg
      label: Legal Entity
      pluralLabel: Legal Entities
      transitionVisible: "1"
      transitionVisibleInterpreter: LITERAL
      businessViewEntity:
        _name: PortfolioLegalEntity
        _type: BusinessViewEntity
        collection: PrivateEquity.entities.PortfolioLegalEntity.collection_views.PortfolioLegalEntityCollection
        displayRecordCount: ALWAYS
        enableUserDefinedSort: true
        entity: PrivateEquity.entities.PortfolioLegalEntity.PortfolioLegalEntity
        form: PrivateEquity.entities.PortfolioLegalEntity.forms.PortfolioLegalEntityForm
        gridAllowed: true
        listAllowed: true
        outlineVisible: false
        overrideDefaultSort: true
        sortExpression: FDN_LegalEntity ASC
        tableAllowed: true
        businessEntityBuiltInFilters: []
        businessEntitySearchConfigs:
          - _name: TextConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: TEXT
            enabled: true
          - _name: FormConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: BY_FORM
            enabled: true
          - _name: AdvancedConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: ADVANCED
            enabled: true
          - _name: SemqlConfig
            _type: BusinessEntitySearchTypeConfig
            searchType: SEMQL
            enabled: true
        embeddedCollectionNavigations: []
        referenceAttributeNavigationConfigs:
          - formField: PrivateEquity.entities.PortfolioLegalEntity.forms.PortfolioLegalEntityForm.PortfolioLegalEntity.Container.Container2.FDN_LegalEntity
            # navigationMode: MODAL_FORM
            businessView: PrivateEquity.entities.LegalEntity.business_views.LegalEntity
            form: PrivateEquity.entities.LegalEntity.forms.LegalEntityForm
            navigationMode: BUSINESS_OBJECT_VIEW
          - formField: PrivateEquity.entities.PortfolioLegalEntity.forms.PortfolioLegalEntityForm.PortfolioLegalEntity.Container.Container2.FDN_Portfolio
            navigationMode: MODAL_FORM
        transitions: []
