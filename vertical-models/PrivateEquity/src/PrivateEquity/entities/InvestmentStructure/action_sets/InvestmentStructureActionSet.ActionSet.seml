_name: InvestmentStructureActionSet
_package: PrivateEquity.entities.InvestmentStructure.action_sets
_type: ActionSet
entity: PrivateEquity.entities.InvestmentStructure.InvestmentStructure
label: Investment Structure Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorInvestmentStructures
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.InvestmentStructure.steppers.AuthorInvestmentStructures
  - _name: EditAuthorInvestmentStructures
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: PrivateEquity.entities.InvestmentStructure.steppers.AuthorInvestmentStructures
  - _name: MassUpdateAuthorInvestmentStructures
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: PrivateEquity.entities.InvestmentStructure.steppers.AuthorInvestmentStructures
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorInvestmentStructures
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.InvestmentStructure.steppers.AuthorInvestmentStructures
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
