_package: PrivateEquity.entities.Account.collection_views
_name: AccountCollection
_type: CollectionView
entity: PrivateEquity.entities.Account.Account
default: true
displayCard: PrivateEquity.entities.Account.display_cards.AccountDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Account
tableShowDisplayCard: true
listAllowed: true
listItemLines: 2
listShowDisplayCardAvatar: true
listShowDivider: true
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 2
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: ID
    visibleByDefault: false
  - _type: ReferenceColumn
    _name: FDN_AccountType
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FDN_AccountType
    visibleByDefault: true
    referencedEntity: PrivateEquity.entities.AccountType.AccountType
