_name: AccountDisplayCard
_package: PrivateEquity.entities.Account.display_cards
_type: DisplayCard
entity: PrivateEquity.entities.Account.Account
default: true
primaryTextExpression: Name
secondaryTextExpression: AccountKey
primaryImageValue: images://mdi/bank.svg
primaryImageValueInterpreter: LITERAL
primaryImageSourceType: URL
primaryImageAlign: MIDDLE_CENTER
primaryImageMode: FIT
primaryImageFallbackValueInterpreter: LITERAL
primaryImageFallbackSourceType: URL
avatarImageValue: |-
  case when FDN_AccountType = 'Custodian'
  then 'images://mdi/bank-plus.svg'
  else 'images://mdi/bank-check.svg'
  end
avatarImageValueInterpreter: SEMQL
avatarImageSourceType: URL
avatarImageAlign: MIDDLE_CENTER
avatarImageMode: FIT
