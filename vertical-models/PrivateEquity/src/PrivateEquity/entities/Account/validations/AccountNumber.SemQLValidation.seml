_name: AccountNumber
_package: PrivateEquity.entities.Account.validations
entity: PrivateEquity.entities.Account.Account
label: Account Number
description: "Ensures account numbers contain 8 to 12 digits before consolidation."
validationScope: PRE_CONSO
validationLabel: "Account Number has to between 8-12 Digits (Ex: 12345678XXXX)"
_type: SemQLValidation
condition: REGEXP_LIKE(AccountNumber, '^[0-9]{8,12}$')
