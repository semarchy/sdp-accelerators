_name: RoutingNumber
_package: PrivateEquity.entities.Account.validations
entity: PrivateEquity.entities.Account.Account
label: Routing Number
description: "Ensures routing numbers contain exactly 9 digits before consolidation."
validationScope: PRE_CONSO
validationLabel: "Routing Number has to be 9 digits (Ex: 123456789)"
_type: SemQLValidation
condition: REGEXP_LIKE(RoutingNumber, '[0-9]{9}')
