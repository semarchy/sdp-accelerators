_name: Country
_package: PrivateEquity.entities.Country
_type: Entity
primaryKey: PrivateEquity.entities.Country.Country.ID
sourceIdGeneration:
  mode: MANUAL
label: Country
description: "Defines country reference data used for addresses, tax reporting, and geographic classification."
documentation: "Maintains ISO and local country identifiers used by address, region, tax, and reporting workflows."
enableDelete: true
entityType: BASIC
iconUrl: images://mdi/flag-variant.svg
pluralLabel: Countries
historizeGolden: true
historizeMaster: false
physicalTableName: COUNTRY
dataEntryAllowed: true
