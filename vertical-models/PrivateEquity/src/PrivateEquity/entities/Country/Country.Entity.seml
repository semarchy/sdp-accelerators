    _name: ID
    physicalName: ID
    dataType: String
    goldenAttribute: true
    i18ned: false
    label: ID
    description: "Unique identifier for the country record."
    documentation: "Unique identifier for the country record. Use this attribute to support Legal Entity accelerator stewardship, validation, search, and downstream integration."
