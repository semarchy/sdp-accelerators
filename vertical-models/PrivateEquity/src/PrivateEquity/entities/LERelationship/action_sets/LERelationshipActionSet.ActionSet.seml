_name: LERelationshipActionSet
_package: PrivateEquity.entities.LERelationship.action_sets
_type: ActionSet
entity: PrivateEquity.entities.LERelationship.LERelationship
label: LE Relationship Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorLERelationships
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
