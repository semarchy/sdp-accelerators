_name: RelationshipActionSet
_package: PrivateEquity.entities.Relationship.action_sets
_type: ActionSet
entity: PrivateEquity.entities.Relationship.Relationship
label: Relationship Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorRelationships
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: false
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.Relationship.steppers.AuthorRelationships
  - _name: EditAuthorRelationships
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: PrivateEquity.entities.Relationship.steppers.AuthorRelationships
  - _name: MassUpdateAuthorRelationships
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: PrivateEquity.entities.Relationship.steppers.AuthorRelationships
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorRelationships
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.Relationship.steppers.AuthorRelationships
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
