                      multilineMaxLines: "3"
                      multilineMaxLinesValueInterpreter: LITERAL
                      multilineMinLines: "1"
                      multilineMinLinesValueInterpreter: LITERAL
                      isCharCounterVisible: "0"
                      isCharCounterVisibleValueInterpreter: LITERAL
                    labelProperties:
                      position: left
                      positionValueInterpreter: LITERAL
                      alignment: right
                      alignmentValueInterpreter: LITERAL
                      typography: caption
                      typographyValueInterpreter: LITERAL
                      isVisible: "1"
                      isVisibleValueInterpreter: LITERAL
          - _name: FormField
            label: Google Map
            value: >-
              '

              <!DOCTYPE html>

              <html>

              <head>  

              <meta charset="utf-8">

              <script
              src="http://maps.googleapis.com/maps/api/js?key=INSERT_YOUR_API_KEY"></script>
                 
              <script>


              // Javascript ...


              var zoom = 20;

              var mapType = google.maps.MapTypeId.HYBRID

              var useMarker = true;

              var map;



              // Set points to use and convert to Google Maps format

              var ARPPos = new google.maps.LatLng("'||
              GeocodedAddress.CoordLatitude ||'", "'||
              GeocodedAddress.CoordLongitude ||'");

              google.maps.event.addDomListener(window, "load", initialize);


              // Initialise map, centred on a lat/lon at the ARP

              function initialize() {  

              var geocoder = new google.maps.Geocoder();

              displayMap(ARPPos);

              window.onresize = resize;

              }


              function displayMap(latlng) {

              var mapOptions = {

              zoom: zoom,

              center: latlng,

              mapTypeId: mapType
                }
              map = new google.maps.Map(document.getElementById("map_canvas"),
              mapOptions);


              // Markers

              if (useMarker) {

              var marker = new google.maps.Marker({
                  icon: {url: "http://maps.google.com/mapfiles/ms/icons/yellow-dot.png"},
                  map: map,
                  position: ARPPos,
                  opacity: 0.85
                  });
                }
              resize("");

              }


              function resize(e) {

              var center = map.getCenter();

              map.getDiv().style.height = window.innerHeight + "px";

              map.getDiv().style.width =  window.innerWidth + "px";

              google.maps.event.trigger(map, ''resize'');

              map.setCenter(center);

              }


              // End Javascript


              </script>    

              </head>

              <body style="margin:0px;">

              <div id="map_canvas" style="margin:0px;"></div>

              </body>

              </html>

              '
            dataType: STRING
            useCustomLabel: true
            documentationInterpreter: LITERAL
            visibleValue: "1"
            visibleValueInterpreter: LITERAL
            _type: ObjectField
            authoringMode: auto
            authoringModeValueInterpreter: LITERAL
            componentProperties:
              textTypography: body-1
              textTypographyValueInterpreter: LITERAL
              objectHeight: 600px
              objectHeightValueInterpreter: LITERAL
              sourceType: content
              sourceTypeValueInterpreter: LITERAL
            labelProperties:
              position: left
              positionValueInterpreter: LITERAL
              alignment: right
              alignmentValueInterpreter: LITERAL
              typography: caption
              typographyValueInterpreter: LITERAL
              isVisible: "1"
              isVisibleValueInterpreter: LITERAL
