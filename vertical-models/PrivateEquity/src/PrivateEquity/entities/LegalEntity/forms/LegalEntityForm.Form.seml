              - _type: FormContainer
                _name: Container3
                layoutDirection: COLUMN
                content:
                  - _name: QualityIssues
                    label: Quality Issues
                    value: >-
                      case when Revenue is null then  'Missing
                      Revenue'||chr(13)||chr(10) else '' end

                      || case when FDN_Industry is null then  'Missing Industry
                      ' ||chr(13)||chr(10)  else '' end

                      || case when FDN_GeographyType is null then  'Missing
                      Geography ' ||chr(13)||chr(10)  else '' end

                      || case when FDN_Region is null then  'Missing Region '
                      ||chr(13)||chr(10)  else '' end

                      || case when FDN_Country is null then  'Missing Country '
                      ||chr(13)||chr(10)  else '' end

                      || case when FDN_State is null then  'Missing State '
                      ||chr(13)||chr(10)  else '' end

                      || case when FDN_EntityStructure is null then  'Missing
                      Entity Structure ' ||chr(13)||chr(10)  else '' end

                      || case when FiscalYear = '1' and FiscalYearEnd is null
                      then  'Missing FY END ' ||chr(13)||chr(10) else '' end

                      || case when USFEIN is null then  'Missing US FEIN
                      '||chr(13)||chr(10) else '' end
                    dataType: STRING
                    useCustomLabel: true
                    documentationInterpreter: LITERAL
                    visibleValue: >-
                      9 - (

                      case when Revenue is null then 1 else 0 end

                      + case when FDN_Industry is null then 1 else 0 end

                      + case when FDN_GeographyType is null then 1 else 0 end

                      + case when FDN_Region is null then 1 else 0 end

                      + case when FDN_Country is null then 1 else 0 end

                      + case when FDN_State is null then 1 else 0 end

                      + case when FDN_EntityStructure is null then 1 else 0 end

                      + case when FiscalYear = '1' and FiscalYearEnd is null
                      then 1 else 0 end

                      + case when USFEIN is null then 1 else 0 end

                      ) != 9
                    visibleValueInterpreter: SEMQL
                    _type: TextField
                    authoringMode: auto
                    authoringModeValueInterpreter: LITERAL
                    componentProperties:
                      textAlign: left
                      textAlignValueInterpreter: LITERAL
                      textColor: "md: orange"
                      textColorValueInterpreter: LITERAL
