                    authoringMode: auto
                    authoringModeValueInterpreter: LITERAL
                    componentProperties:
                      textAlign: left
                      textAlignValueInterpreter: LITERAL
                      textTypography: body-1
                      textTypographyValueInterpreter: LITERAL
                      contentBackgroundColor: >-
                        case when FID_EntityType = 'Internal' then
                        'md:light-green'

                        when FID_EntityType = 'Investor' then 'md:yellow'

                        else null

                        end
                      contentBackgroundColorValueInterpreter: SEMQL
                      displayType: hyperlink
                      displayTypeValueInterpreter: LITERAL
                    labelProperties:
                      position: left
                      positionValueInterpreter: LITERAL
                      alignment: right
                      alignmentValueInterpreter: LITERAL
                      typography: caption
                      typographyValueInterpreter: LITERAL
                      isVisible: "1"
                      isVisibleValueInterpreter: LITERAL
