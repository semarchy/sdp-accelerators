_type: SemQLEnricher
_package: PrivateEquity.entities.LegalEntity.enrichers
_name: NormalizeEntityName
entity: PrivateEquity.entities.LegalEntity.LegalEntity
label: Normalize Entity Name
description: "Normalizes legal entity names by trimming whitespace and converting values to uppercase for matching and validation."
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
  - attributeName: NormalizedName
    expression: RTRIM(LTRIM(UPPER(Name)))
