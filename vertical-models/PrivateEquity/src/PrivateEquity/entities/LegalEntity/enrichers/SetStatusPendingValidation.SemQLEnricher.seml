_name: SetStatusPendingValidation
entity: PrivateEquity.entities.LegalEntity.LegalEntity
label: Set Status Pending Validation
description: "Sets the legal entity status to Pending Validation during pre-consolidation processing."
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
