_type: SemQLEnricher
_package: PrivateEquity.entities.LegalEntity.enrichers
_name: ReplaceSingleQuotation
entity: PrivateEquity.entities.LegalEntity.LegalEntity
label: Replace Single Quotation
description: "Expands KKR legal entity names to Kohlberg Kravis Roberts in the normalized name field."
enricherExecutionScope: PRE_CONSO
semQlEnricherExpressions:
  - attributeName: NormalizedName
    expression: REGEXP_REPLACE(Name, 'KKR', 'Kohlberg Kravis Roberts')
afterEnrichers: PrivateEquity.entities.LegalEntity.enrichers.NormalizeEntityName
