_name: LegalEntityActionSet
_package: PrivateEquity.entities.LegalEntity.action_sets
_type: ActionSet
entity: PrivateEquity.entities.LegalEntity.LegalEntity
label: Legal Entity Action Set
defaultActionSet: true
actions:
  - _name: CreateWorkflow
    _type: StartWorkflowEntityAction
    label: Create (Workflow)
    useCustomLabel: true
    waitDialogEnabled: false
    startEvent: PrivateEquity.workflows.CreateOrEditLegalEntity.StartCreate
  - _name: CreateAuthorLegalEntities
    label: Direct Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: true
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.LegalEntity.steppers.AuthorLegalEntities
  - _name: EditAuthorLegalEntities
    label: Direct Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: PrivateEquity.entities.LegalEntity.steppers.AuthorLegalEntities
  - _name: StartWorkflow
    _type: StartWorkflowEntityAction
    label: Edit (Workflow)
    useCustomLabel: true
    waitDialogEnabled: false
    startEvent: PrivateEquity.workflows.CreateOrEditLegalEntity.StartEdit
  - _name: MassUpdateAuthorLegalEntities
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: PrivateEquity.entities.LegalEntity.steppers.AuthorLegalEntities
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorLegalEntities
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: MASTER
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.LegalEntity.steppers.AuthorLegalEntities
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
  - _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DirectConfirmDupsAction
  - _name: ReviewAndConfirmDuplicatesManageDuplicatesOnLegalEntity
    label: Review And Confirm Duplicates
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewAndConfirm
    dupsManager: PrivateEquity.entities.LegalEntity.dups_managers.ManageDuplicatesOnLegalEntity
    enableEdit: true
    mandateConfirmAll: false
  - _name: MergeOrSplitDuplicatesManageDuplicatesOnLegalEntity
    label: Merge Or Split Duplicates
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MergeOrSplit
    dupsManager: PrivateEquity.entities.LegalEntity.dups_managers.ManageDuplicatesOnLegalEntity
    enableEdit: true
  - _name: ReviewSuggestionsDuplicatesManageDuplicatesOnLegalEntity
    label: Review Duplicates Suggestions
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ReviewSuggestions
    dupsManager: PrivateEquity.entities.LegalEntity.dups_managers.ManageDuplicatesOnLegalEntity
    enableEdit: true
    mandateResolveAllSuggestions: false
    onAcceptPromptGoldenId: false
  - _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExplainRecordAction
    displayCard: PrivateEquity.entities.LegalEntity.display_cards.LegalEntityDisplayCard
    formTab: PrivateEquity.entities.LegalEntity.forms.LegalEntityForm.LegalEntity
