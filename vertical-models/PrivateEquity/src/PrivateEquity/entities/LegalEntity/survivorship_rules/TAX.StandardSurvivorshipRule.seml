_type: StandardSurvivorshipRule
entity: PrivateEquity.entities.LegalEntity.LegalEntity
_package: PrivateEquity.entities.LegalEntity.survivorship_rules
defaultRule: false
_name: TAX
consolidationSkipNulls: false
consolidationStrategy: PREFERRED_PUBLISHER
label: TAX
description: "Selects surviving tax workflow attributes from preferred publishers, prioritizing TAX before other source systems."
publisherRankings:
  - _type: ConsoPublisherRanking
    publisher: PrivateEquity.publishers.TAX
  - _type: ConsoPublisherRanking
