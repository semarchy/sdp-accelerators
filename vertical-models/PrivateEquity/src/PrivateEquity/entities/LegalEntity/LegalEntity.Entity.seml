matcher:
  _name: SemlQLMatcherLegalEntity
  _type: SemQLMatcher
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: true
  mergeThresholdMergingConfirmed: 85
  mergeThresholdMergingConfirmedWithNewMasters: 85
  mergeThresholdMergingConfirmedWithUnconfirmed: 85
  mergeThresholdMergingUnconfirmed: 85
  mergeThresholdMergingUnconfirmedWithNewMasters: 85
  mergeThresholdNewGroup: 85
  mergeThresholdRemergingPreviouslySplit: 100
  useMultiIterationGrouping: true
  useTransitiveMatchScore: true
  description: LE Matcher
  matchRules:
    - _type: SemQLMatchRule
      _name: ExactEIN
      condition: Record1.USFEIN = Record2.USFEIN
      label: Exact EIN
      matchScore: 100
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: ExactNameAddress
      condition: |-
        Record1.NormalizedName = Record2.NormalizedName
        AND Record1.GeocodedAddress = Record2.GeocodedAddress
      label: Exact Name & Address
      matchScore: 90
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: ExactName
      condition: Record1.Name = Record2.Name
      label: Exact Name
      matchScore: 75
      usingMatchOn: false
