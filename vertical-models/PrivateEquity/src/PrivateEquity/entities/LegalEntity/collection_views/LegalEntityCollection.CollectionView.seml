_package: PrivateEquity.entities.LegalEntity.collection_views
_name: LegalEntityCollection
_type: CollectionView
entity: PrivateEquity.entities.LegalEntity.LegalEntity
default: true
displayCard: PrivateEquity.entities.LegalEntity.display_cards.LegalEntityDisplayCard
tableAllowed: true
tableRowLines: 2
tableDisplayCardColumnLabel: Legal Entity
tableShowDisplayCard: true
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: true
listShowDivider: true
gridAllowed: true
gridColumns: 4
gridTileHeight: 1:1
gridTileLines: 1
gridTextPosition: BOTTOM
tableColumns:
  - _type: IdColumn
    _name: ID
    columnAlign: LEFT
    dataType: LONG_INTEGER
    useCustomLabel: false
    value: ID
    visibleByDefault: true
  - _type: TextColumn
    _name: Name
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: Name
    visibleByDefault: true
  - _type: TextColumn
    _name: NormalizedName
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: NormalizedName
    visibleByDefault: true
  - _type: CheckboxColumn
    _name: FiscalYear
    columnAlign: LEFT
    dataType: BOOLEAN
    useCustomLabel: false
    value: FiscalYear
    visibleByDefault: true
    componentProperties:
      useSwitch: "0"
      useSwitchValueInterpreter: LITERAL
  - _type: MenuColumn
    _name: FiscalYearEnd
    columnAlign: LEFT
    dataType: STRING
    useCustomLabel: false
    value: FiscalYearEnd
    visibleByDefault: true
  - _type: TextColumn
    _name: Revenue
    columnAlign: LEFT
    dataType: INTEGER
    useCustomLabel: false
    value: Revenue
    visibleByDefault: true
    componentProperties:
      displayFormat: $###,###
      displayFormatValueInterpreter: LITERAL
