          executedOnFormOpen: true
        - enricher: PrivateEquity.entities.Contact.enrichers.StandardizeMobilePhone
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: PrivateEquity.entities.Contact.enrichers.AutopopulateOfficePhone
