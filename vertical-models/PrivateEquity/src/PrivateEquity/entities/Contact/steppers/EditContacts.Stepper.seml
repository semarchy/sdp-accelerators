_name: EditContacts
_package: PrivateEquity.entities.Contact.steppers
_type: Stepper
entity: PrivateEquity.entities.Contact.Contact
rootStep:
  _name: EditContact
  _type: CollectionStep
  canFinishSubLevel: true
  childDeleteType: HARD_DELETE
  collectionView: PrivateEquity.entities.Contact.collection_views.ContactCollection
  customSortEnabled: false
  defaultDisplayType: TABLE
  displayGridAllowed: true
  displayListAllowed: true
  displayTableAllowed: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  label: Edit Contact
  linear: false
  useCustomCollectionLabel: false
  userDefinedSortEnabled: true
  stepTransitionValidations:
    - onStepExit: SKIP
      validationType: CHECK
      validator: PrivateEquity.entities.Contact.validations.SSNFormat
    - onStepExit: WARN
      validationType: FOREIGN
      attribute: PrivateEquity.references.ContactsLegalEntity.LegalEntity
    - onStepExit: SKIP
      validationType: UNIQUE
      uniqueKey: PrivateEquity.entities.Contact.unique_keys.UniqueSSN
    - onStepExit: WARN
      validationType: MANDATORY
      attribute: PrivateEquity.entities.Contact.Contact.LastName
    - onStepExit: WARN
      validationType: FOREIGN
      attribute: PrivateEquity.references.ContactsOffice.Office
    - onStepExit: WARN
      validationType: MANDATORY
      attribute: PrivateEquity.references.ContactsOffice.Office
    - onStepExit: WARN
      validationType: MANDATORY
      attribute: PrivateEquity.entities.Contact.Contact.FirstName
  stepTriggers: []
  childSteps:
