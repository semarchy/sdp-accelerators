_name: SSNFormat
_package: PrivateEquity.entities.Contact.validations
entity: PrivateEquity.entities.Contact.Contact
label: SSN Format
description: "Ensures contact Social Security Numbers follow the 123-12-1234 format before consolidation."
validationScope: PRE_CONSO
validationLabel: "SSN Format Error (Ex: 123-12-1234)"
_type: SemQLValidation
condition: REGEXP_LIKE(SSN, '[0-9]{3}[-]{1}[0-9]{2}[-]{1}[0-9]{4}')
