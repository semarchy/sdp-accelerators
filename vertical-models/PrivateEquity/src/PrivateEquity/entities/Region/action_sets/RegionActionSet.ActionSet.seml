_name: RegionActionSet
_package: PrivateEquity.entities.Region.action_sets
_type: ActionSet
entity: PrivateEquity.entities.Region.Region
label: Region Action Set
defaultActionSet: true
actions:
  - _name: CreateAuthorRegions
    label: Create
    useCustomLabel: true
    waitDialogEnabled: false
    _type: CreateAction
    createdRecordType: GOLDEN
    createMultiple: true
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.Region.steppers.AuthorRegions
  - _name: EditAuthorRegions
    label: Edit
    useCustomLabel: true
    waitDialogEnabled: false
    _type: EditAction
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: false
    multipleSelectionAllowed: true
    stepper: PrivateEquity.entities.Region.steppers.AuthorRegions
  - _name: MassUpdateAuthorRegions
    label: Mass Update
    useCustomLabel: true
    waitDialogEnabled: false
    _type: MassUpdateAction
    availableForErrorData: false
    availableForGoldenData: true
    availableForMasterData: false
    stepper: PrivateEquity.entities.Region.steppers.AuthorRegions
  - _name: Delete
    label: Delete
    useCustomLabel: true
    waitDialogEnabled: false
    _type: DeleteAction
    deleteType: HARD_DELETE
    availableForGoldenData: true
    availableForMasterData: false
    multipleSelectionAllowed: true
  - _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ExportAction
  - _name: ImportAuthorRegions
    label: Import
    useCustomLabel: true
    waitDialogEnabled: false
    _type: ImportAction
    importedRecordType: GOLDEN
    importMode: CREATE_AND_UPDATE
    allowOtherPublishers: true
    stepper: PrivateEquity.entities.Region.steppers.AuthorRegions
  - _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
    _type: BrowseGraphAction
