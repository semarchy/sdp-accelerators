_package: PrivateEquity.applications
_name: PrivateEquity
_type: Application
applicationTitle: Private Equity
avatarImageUrl: images://manufacturing/legal-entity-mgmt.svg
coverImageUrl: images://default/cover.png
favIcon: images://manufacturing/legal-entity-mgmt.svg
historyBrowsingEnabled: true
historyBrowsingRequiredRole: ""
logoUrl: images://default/logo.png
visibility: VISIBLE
documentationConfig:
  documentationConfigDiagrams:
    - _name: Groups
      _type: DocumentationConfigDiagram
      modelDiagram: PrivateEquity.model_diagrams.Groups
      label: Groups
    - _name: Relationships
      _type: DocumentationConfigDiagram
      modelDiagram: PrivateEquity.model_diagrams.Relationships
      label: Relationships
    - _name: Account
      _type: DocumentationConfigDiagram
      modelDiagram: PrivateEquity.model_diagrams.Account
      label: Account
    - _name: AllDomains
      _type: DocumentationConfigDiagram
      modelDiagram: PrivateEquity.model_diagrams.AllDomains
      label: All Domains
    - _name: LegalEntityDiagram
      _type: DocumentationConfigDiagram
      modelDiagram: PrivateEquity.model_diagrams.LegalEntity
      label: Legal Entity
label: Private Equity
sortStrategy: POSITION
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: true
  globalSearchBusinessViews:
    - _name: Portfolio
      _type: GlobalSearchBoView
      viewType: GD
      businessView: PrivateEquity.entities.Portfolio.business_views.Portfolio
      label: Portfolio
      maxResults: 5
      searchTypeConfig: PrivateEquity.entities.Portfolio.business_views.Portfolio.PortfolioEO.TextConfig
    - _name: LEGroup
      _type: GlobalSearchBoView
      viewType: GD
      businessView: PrivateEquity.entities.LEGroup.business_views.LEGroup
      label: LE Group
      maxResults: 5
      searchTypeConfig: PrivateEquity.entities.LEGroup.business_views.LEGroup.LEGroupEO.TextConfig
    - _name: Fund
      _type: GlobalSearchBoView
      viewType: GD
      businessView: PrivateEquity.entities.Fund.business_views.Fund
      label: Funds
      maxResults: 5
      searchTypeConfig: PrivateEquity.entities.Fund.business_views.Fund.FundEO.TextConfig
    - _name: LegalEntityView
      _type: GlobalSearchBoView
      viewType: GD
      businessView: PrivateEquity.entities.LegalEntity.business_views.LegalEntity
      label: Legal Entity
      maxResults: 5
      searchTypeConfig: PrivateEquity.entities.LegalEntity.business_views.LegalEntity.LegalEntityEO.TextConfig
rootFolder:
  _name: Root
  icon: images://mdi/folder.svg
  label: Root Folder
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  _type: FolderAction
  appActions:
    - _name: GlobalSearch
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      _type: GlobalSearchAction
    - _name: MyTasks
      iconColor: md:red
      labelColor: md:red
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      _type: MyTasksAction
      badgeVisible: true
      badgeBackgroundColor: md:red
    - _name: Entities
      icon: images://mdi/database-outline.svg
      iconColor: md:green
      image: images://mdi/database-outline.svg
      label: Entities
      labelColor: md:green
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      _type: BrowseEntitiesFolderAction
      lineageEnabled: true
    - _name: LegalEntity
      label: Legal Entities
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      _type: FolderAction
      appActions:
        - _name: BrowseLEGroup
          label: LE Groups
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseBusinessViewAction
          businessView: PrivateEquity.entities.LEGroup.business_views.LEGroup
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          viewType: GD
        - _name: BrowseLegalEntity
          icon: images://mdi/office-building.svg
          image: images://mdi/office-building.svg
          label: Legal Entities
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseBusinessViewAction
          businessView: PrivateEquity.entities.LegalEntity.business_views.LegalEntity
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          viewType: GD
        - _name: BrowseFund
          label: Funds
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseBusinessViewAction
          businessView: PrivateEquity.entities.Fund.business_views.Fund
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          viewType: GD
        - _name: BrowseAccount
          icon: images://mdi/bank.svg
          image: images://mdi/bank.svg
          label: Bank / Custodian Accounts
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          _type: BrowseBusinessViewAction
          businessView: PrivateEquity.entities.Account.business_views.Account
          nbRecordsBadgeVisible: false
          useSearchOnOpen: false
          viewType: GD
