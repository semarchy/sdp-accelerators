defaultAction: PrivateEquity.applications.PrivateEquity.Root.GlobalSearch
navDrawer:
  - _name: PlatformActions
    _type: NavigationGroup
    dividerVisible: true
    label: Platform Actions
    labelVisible: true
    actions:
      - appAction: PrivateEquity.applications.PrivateEquity.Root.GlobalSearch
      - appAction: PrivateEquity.applications.PrivateEquity.Root.MyTasks
      - appAction: PrivateEquity.applications.PrivateEquity.Root.Entities
  - _name: LegalEntity
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: PrivateEquity.applications.PrivateEquity.Root.LegalEntity
  - _name: ReferenceData
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: PrivateEquity.applications.PrivateEquity.Root.ReferenceData
  - _name: DataStewardship
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: PrivateEquity.applications.PrivateEquity.Root.DataStewardship
  - _name: JoinTables
    _type: FolderNavGroup
    dividerVisible: true
    labelVisible: true
    linkedFolder: PrivateEquity.applications.PrivateEquity.Root.ManyToManyRelationships
